*PROCESS INTERRUPT;
 TATTN: PROC OPTIONS(MAIN);
   /* AN ATTENTION AT A TSO TERMINAL (#226), RUN BY TEST/TSO/ATTN.LUA:
      THE PROGRAM LOOPS FOR AT MOST A MINUTE, AND PA1 RAISES ATTENTION,
      WHOSE ON-UNIT ENDS THE LOOP.  COMPILED WITH INTERRUPT, SO THE
      LOOP POLLS AT THE END OF EACH PASS */
   DCL (N, S0, S) FIXED BIN(31) INIT(0);
   DCL HIT BIT(1) INIT('0'B);
   ON ATTENTION BEGIN;
     HIT = '1'B;
     PUT SKIP LIST('ATTENTION RAISED, ONCODE', ONCODE);
   END;
   S0 = SECS();
   S = S0;
   PUT SKIP LIST('LOOPING, PRESS PA1');
   PUT SKIP;
   DO WHILE(HIT = '0'B & S - S0 < 60);
     N = N + 1;
     IF MOD(N, 100000) = 0 THEN DO;
       S = SECS();
       IF S < S0 THEN S = S + 86400;
     END;
   END;
   IF HIT THEN PUT SKIP LIST('LOOP ENDED BY ATTENTION');
   ELSE PUT SKIP LIST('NO ATTENTION IN 60 SECONDS');
   PUT SKIP;
 SECS: PROC RETURNS(FIXED BIN(31));
   DCL T CHAR(9);
   T = TIME;
   RETURN(SUBSTR(T, 1, 2) * 3600 + SUBSTR(T, 3, 2) * 60
          + SUBSTR(T, 5, 2));
 END SECS;
 END TATTN;
