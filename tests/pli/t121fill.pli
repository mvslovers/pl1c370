 T121FIL: PROC OPTIONS(MAIN);
   DCL S CHAR(300) VARYING;
   S = REPEAT('ABCDEFGHIJ', 28);
   PUT SKIP LIST(SUBSTR(S, 1, 120), 'A1');
   PUT SKIP LIST('X', SUBSTR(S, 1, 96), 'A2');
   PUT SKIP LIST('X', 'Y', 'Z', 'W', SUBSTR(S, 1, 24), 'A3');
   PUT SKIP LIST('X', SUBSTR(S, 1, 120), 'A4');
   PUT SKIP LIST(SUBSTR(S, 1, 144), 'A5');
   PUT SKIP LIST('X', SUBSTR(S, 1, 216), 'A6');
   PUT SKIP LIST(SUBSTR(S, 1, 119), 'A7');
   PUT SKIP LIST('X', SUBSTR(S, 1, 95), 'A8');
   PUT SKIP LIST(SUBSTR(S, 1, 121), 'A9');
   PUT SKIP LIST(SUBSTR(S, 1, 140), 'B1', 'B2', 'B3');
 END T121FIL;
