 T89PICC: PROC OPTIONS(MAIN);
   DCL D FIXED DEC(15,5);
   DCL P0 PIC '$$$.$$';
   DCL P1 PIC '$$$9V.99';
   DCL P2 PIC '$$$9V.99';
   DCL P3 PIC '99$';
   DCL P4 PIC '$$$,999';
   DCL P5 PIC '$$$,999';
   DCL P6 PIC 'S999V.99';
   DCL P7 PIC 'S999V.99';
   DCL P8 PIC '+999V.99';
   DCL P9 PIC '-999V.99';
   DCL P10 PIC '999V.99S';
   DCL P11 PIC '++B+9V.99';
   DCL P12 PIC '---9V.99';
   DCL P13 PIC 'SSS9V.99';
   DCL P14 PIC '$Z.99CR';
   DCL P15 PIC '$ZZV.99CR';
   DCL P16 PIC '$ZZV.99DB';
   DCL P17 PIC '$ZZV.99DB';
   DCL P18 PIC '999I';
   DCL P19 PIC 'Z99R';
   DCL P20 PIC '99T9';
   DCL P21 PIC '99T9';
   D = 0; P0 = D;
   PUT SKIP EDIT('$$$.$$', '|', P0, '|')(A(16), A, A, A);
   D = 123.45; P1 = D;
   PUT SKIP EDIT('$$$9V.99', '|', P1, '|')(A(16), A, A, A);
   D = 1.23; P2 = D;
   PUT SKIP EDIT('$$$9V.99', '|', P2, '|')(A(16), A, A, A);
   D = 12; P3 = D;
   PUT SKIP EDIT('99$', '|', P3, '|')(A(16), A, A, A);
   D = 12; P4 = D;
   PUT SKIP EDIT('$$$,999', '|', P4, '|')(A(16), A, A, A);
   D = 1234; P5 = D;
   PUT SKIP EDIT('$$$,999', '|', P5, '|')(A(16), A, A, A);
   D = 123.45; P6 = D;
   PUT SKIP EDIT('S999V.99', '|', P6, '|')(A(16), A, A, A);
   D = -123.45; P7 = D;
   PUT SKIP EDIT('S999V.99', '|', P7, '|')(A(16), A, A, A);
   D = -123.45; P8 = D;
   PUT SKIP EDIT('+999V.99', '|', P8, '|')(A(16), A, A, A);
   D = 123.45; P9 = D;
   PUT SKIP EDIT('-999V.99', '|', P9, '|')(A(16), A, A, A);
   D = 123.45; P10 = D;
   PUT SKIP EDIT('999V.99S', '|', P10, '|')(A(16), A, A, A);
   D = 1.23; P11 = D;
   PUT SKIP EDIT('++B+9V.99', '|', P11, '|')(A(16), A, A, A);
   D = 1.23; P12 = D;
   PUT SKIP EDIT('---9V.99', '|', P12, '|')(A(16), A, A, A);
   D = -1.23; P13 = D;
   PUT SKIP EDIT('SSS9V.99', '|', P13, '|')(A(16), A, A, A);
   D = -1.23; P14 = D;
   PUT SKIP EDIT('$Z.99CR', '|', P14, '|')(A(16), A, A, A);
   D = 12.34; P15 = D;
   PUT SKIP EDIT('$ZZV.99CR', '|', P15, '|')(A(16), A, A, A);
   D = -12.34; P16 = D;
   PUT SKIP EDIT('$ZZV.99DB', '|', P16, '|')(A(16), A, A, A);
   D = 12.34; P17 = D;
   PUT SKIP EDIT('$ZZV.99DB', '|', P17, '|')(A(16), A, A, A);
   D = 1021; P18 = D;
   PUT SKIP EDIT('999I', '|', P18, '|')(A(16), A, A, A);
   D = -1021; P19 = D;
   PUT SKIP EDIT('Z99R', '|', P19, '|')(A(16), A, A, A);
   D = 1021; P20 = D;
   PUT SKIP EDIT('99T9', '|', P20, '|')(A(16), A, A, A);
   D = -1021; P21 = D;
   PUT SKIP EDIT('99T9', '|', P21, '|')(A(16), A, A, A);
 END T89PICC;
