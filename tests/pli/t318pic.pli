 T318PI: PROC OPTIONS(MAIN);
   /* PICTURES: A DO CONTROL VARIABLE, SUBSTR OF A CHARACTER PICTURE
      AS A TARGET, GET DATA OF NUMERIC PICTURES */
   DCL P PIC '99', Q PIC 'XXXX' INIT('WXYZ'), R PIC 'Z9V.9';
   DCL T PIC 'S999', U PIC '$$$9V.99', W PIC '-9';
   DO P = 1 TO 3, 8 TO 12 BY 2;
     PUT SKIP LIST(P);
   END;
   PUT SKIP LIST(P);
   DO W = 3 TO -2 BY -2;
     PUT SKIP LIST(W);
   END;
   SUBSTR(Q, 2, 2) = 'AB';
   PUT SKIP LIST(Q);
   GET DATA(R, T, U);
   PUT SKIP LIST(R, T, U);
   GET DATA(U, R);
   PUT SKIP LIST(R, T, U);
 END T318PI;
