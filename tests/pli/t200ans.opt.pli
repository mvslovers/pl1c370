 T200ANS: PROC OPTIONS(MAIN);
   /* ANSI X3.53-1976 string functions (9.4.4): AFTER, BEFORE,
      DECAT, REVERSE, COPY, COLLATE */
   DCL S CHAR(8) INIT('ABCDEFCD'), V CHAR(20) VARYING;
   DCL E CHAR(1) VARYING INIT(''), N FIXED BIN(15) INIT(2);
   V = AFTER(S, 'CD');   PUT SKIP LIST(V, LENGTH(V));
   V = AFTER(S, 'XY');   PUT SKIP LIST(V, LENGTH(V));
   V = AFTER(S, E);      PUT SKIP LIST(V, LENGTH(V));
   V = AFTER(E, 'A');    PUT SKIP LIST(V, LENGTH(V));
   V = AFTER(S, 'CD') || '|';  PUT SKIP LIST(V);
   V = BEFORE(S, 'CD');  PUT SKIP LIST(V, LENGTH(V));
   V = BEFORE(S, 'XY');  PUT SKIP LIST(V, LENGTH(V));
   V = BEFORE(S, E);     PUT SKIP LIST(V, LENGTH(V));
   V = BEFORE(E, 'A');   PUT SKIP LIST(V, LENGTH(V));
   V = DECAT(S, 'CD', '111'B); PUT SKIP LIST(V);
   V = DECAT(S, 'CD', '100'B); PUT SKIP LIST(V);
   V = DECAT(S, 'CD', '010'B); PUT SKIP LIST(V);
   V = DECAT(S, 'CD', '001'B); PUT SKIP LIST(V);
   V = DECAT(S, 'CD', '101'B); PUT SKIP LIST(V);
   V = DECAT(S, 'CD', '000'B); PUT SKIP LIST(V, LENGTH(V));
   V = DECAT(S, 'XY', '100'B); PUT SKIP LIST(V);
   V = DECAT(S, 'XY', '001'B); PUT SKIP LIST(V, LENGTH(V));
   V = DECAT(S, E, '001'B);    PUT SKIP LIST(V);
   V = REVERSE('ABC');   PUT SKIP LIST(V);
   V = REVERSE(S);       PUT SKIP LIST(V);
   V = REVERSE(E);       PUT SKIP LIST(V, LENGTH(V));
   V = COPY('12', 3);    PUT SKIP LIST(V);
   V = COPY('AB', 0);    PUT SKIP LIST(V, LENGTH(V));
   V = COPY('XY', N);    PUT SKIP LIST(V);
   V = COPY('Q', N + 3); PUT SKIP LIST(V);
   PUT SKIP LIST(LENGTH(COLLATE), SUBSTR(COLLATE, 194, 1),
     SUBSTR(COLLATE, 241, 10), INDEX(COLLATE, 'Z'));
 END T200ANS;
