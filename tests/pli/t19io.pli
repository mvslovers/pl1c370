 P11IO: PROC OPTIONS(MAIN);
    /* GET LIST, GET EDIT, PUT EDIT, ON ENDFILE, A SECOND FILE */
    DCL (A,B) FIXED BIN(31);
    DCL D FIXED DEC(7,2);
    DCL C CHAR(8);
    DCL V CHAR(12) VARYING;
    DCL EOF BIT(1) INIT('0'B);
    DCL REPORT FILE STREAM OUTPUT;
    ON ENDFILE(SYSIN) EOF = '1'B;
    GET LIST(A, B, D);
    PUT SKIP LIST('GOT', A, B, D);
    GET LIST(C, V);
    PUT SKIP LIST(C, V, LENGTH(V));
    PUT SKIP EDIT('A=', A, ' D=', D) (A, F(5), A, F(8,2));
    PUT SKIP EDIT(C, '|') (A(4), A);
    PUT SKIP EDIT('X') (COL(10), A);
    PUT EDIT(A, B) (F(6), X(3), F(6));
    PUT SKIP(2) EDIT(D) (F(10,3));
    GET EDIT(C, A) (COL(1), A(5), F(5));
    PUT SKIP LIST('EDIT IN', C, A);
    DO WHILE(¬EOF);
       GET LIST(A);
       IF ¬EOF THEN PUT SKIP LIST('NUM', A);
    END;
    OPEN FILE(REPORT);
    PUT FILE(REPORT) LIST('TO REPORT', A);
    PUT FILE(REPORT) SKIP EDIT('LINE2') (A);
    CLOSE FILE(REPORT);
    PUT SKIP LIST('DONE');
 END P11IO;
