 T76OVF: PROC OPTIONS(MAIN);
   DCL (X, Y) FLOAT DEC(6), (XL, YL) FLOAT DEC(16),
       N FIXED BIN(15) INIT(0);
   ON OVERFLOW BEGIN; N = N + 1; PUT SKIP LIST('OVERFLOW', ONCODE,
       N); END;
   ON ERROR BEGIN; PUT SKIP LIST('ERROR', ONCODE); GO TO OUT; END;
   Y = 300E0; X = 1;
   X = EXP(Y); PUT SKIP LIST('AFTER S', N);
   YL = 300E0;
   XL = EXP(YL); PUT SKIP LIST('AFTER L', N);
 OUT: PUT SKIP LIST('DONE', N);
 END T76OVF;
