 T246EXC: PROC OPTIONS(MAIN);
   /* TIER 93: EXCLUSIVE, READ NOLOCK, UNLOCK IN ONE TASK, WHERE THEY
      LOCK NOTHING (GC28-8201-4) */
   DCL R FILE RECORD KEYED ENV(REGIONAL(1));
   DCL X FILE RECORD KEYED DIRECT UPDATE EXCLUSIVE
         ENV(REGIONAL(1));
   DCL REC CHAR(20), K FIXED BIN(31), (N, D) FIXED BIN(31);
   DCL B BIT(8);
   ON KEY(X) PUT SKIP LIST('KEY', ONCODE);
   OPEN FILE(R) SEQUENTIAL OUTPUT TITLE('REG');
   DO K = 0 TO 7;
     REC = 'RECORD' || CHAR(K);
     WRITE FILE(R) FROM(REC) KEYFROM(K);
   END;
   CLOSE FILE(R);
   OPEN FILE(X) TITLE('REG');
   READ FILE(X) INTO(REC) KEY(2);
   PUT SKIP LIST('READ 2', REC);
   READ FILE(X) INTO(REC) KEY(2);
   PUT SKIP LIST('AGAIN 2', REC);
   READ FILE(X) INTO(REC) KEY(3) NOLOCK;
   PUT SKIP LIST('NOLOCK 3', REC);
   READ FILE(X) NOLOCK INTO(REC) KEY(4);
   PUT SKIP LIST('NOLOCK 4', REC);
   UNLOCK FILE(X) KEY(2);
   PUT SKIP LIST('UNLOCKED 2');
   UNLOCK FILE(X) KEY(3);
   PUT SKIP LIST('UNLOCKED 3');
   UNLOCK FILE(X) KEY(99999);
   PUT SKIP LIST('UNLOCKED 99999');
   READ FILE(X) INTO(REC) KEY(5);
   REC = 'REWRITTEN 5';
   REWRITE FILE(X) FROM(REC) KEY(5);
   UNLOCK FILE(X) KEY(5);
   DELETE FILE(X) KEY(6);
   UNLOCK FILE(X) KEY(6);
   PUT SKIP LIST('AFTER DELETE 6');
   READ FILE(X) INTO(REC) KEY(6);
   PUT SKIP LIST('READ 6');
   CLOSE FILE(X);
   OPEN FILE(R) SEQUENTIAL INPUT TITLE('REG');
   ON ENDFILE(R) GO TO EOF;
   N = 0;
   D = 0;
   DO WHILE('1'B);
     READ FILE(R) INTO(REC);
     N = N + 1;
     B = UNSPEC(SUBSTR(REC, 1, 1));
     IF B = '11111111'B THEN D = D + 1;
     ELSE PUT SKIP LIST(REC);
   END;
 EOF:
   CLOSE FILE(R);
   PUT SKIP LIST(N, D);
 END T246EXC;
