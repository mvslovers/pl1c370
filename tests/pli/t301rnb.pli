 T301RNB: PROC OPTIONS(MAIN);
   /* ROUND OF FIXED BINARY: PL/I (F) GIVES (16,Q) WHATEVER P, SEEN IN
      THE WIDTH OF THE A ITEM (-LANG=F) */
   DCL B1 FIXED BIN(31,8) INIT(5.6875);
   DCL B2 FIXED BIN(20,3) INIT(5.625);
   DCL B3 FIXED BIN(31) INIT(13);
   DCL B4 FIXED BIN(25,8) INIT(5.6875);
   DCL B5 FIXED BIN(30,8) INIT(5.6875);
   DCL B6 FIXED BIN(16,8) INIT(5.6875);
   PUT EDIT('[', ROUND(B1,2), ']') (A, A, A) SKIP;
   PUT EDIT('[', ROUND(B2,1), ']') (A, A, A) SKIP;
   PUT EDIT('[', ROUND(B3,-1), ']') (A, A, A) SKIP;
   PUT EDIT('[', ROUND(B4,2), ']') (A, A, A) SKIP;
   PUT EDIT('[', ROUND(B5,2), ']') (A, A, A) SKIP;
   PUT EDIT('[', ROUND(B6,2), ']') (A, A, A) SKIP;
   PUT EDIT('[', B1, ']', B6, ']') (A, A, A, A, A) SKIP;
 END T301RNB;
