 T97CTL2: PROC OPTIONS(MAIN);
   DCL V CHAR(10) VARYING CTL;
   DCL 1 R CTL, 2 K(2) FIXED BIN(31), 2 W(2) CHAR(2);
   DCL (I, N) FIXED BIN(15);
   DCL SHOW ENTRY(CHAR(10) VARYING);
   DCL STACK ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15));
   DO I = 1 TO 4;
     ALLOCATE V; V = SUBSTR('ABCDEFGHIJ', 1, I * 2);
   END;
   DO WHILE(ALLOCATION(V));
     CALL SHOW(V); FREE V;
   END;
   ALLOCATE R; R.K = 0; R.W(1) = 'AA'; R.W(2) = 'BB';
   GET LIST(R.K(1), R.K(2));
   PUT SKIP DATA(R);
   DO I = 1 TO 3; N = STACK(I * 10); END;
   DO WHILE(N > 0); N = STACK(0); END;
   PUT SKIP LIST('EMPTY', N);
 SHOW: PROC(S);
   DCL S CHAR(10) VARYING;
   PUT SKIP LIST(S, LENGTH(S));
 END SHOW;
 STACK: PROC(X) RETURNS(FIXED BIN(15));
   DCL X FIXED BIN(15), STK FIXED BIN(15) CTL, CNT FIXED BIN(15)
       STATIC INIT(0);
   IF X > 0 THEN DO;
     ALLOCATE STK; STK = X; CNT = CNT + 1;
     PUT SKIP LIST('PUSH', STK, CNT);
   END;
   ELSE DO;
     PUT SKIP LIST('POP', STK); FREE STK; CNT = CNT - 1;
   END;
   RETURN(CNT);
 END STACK;
 END T97CTL2;
