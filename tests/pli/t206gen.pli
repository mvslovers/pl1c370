 T206GEN: PROC OPTIONS(MAIN);
   DCL H GENERIC (H4 ENTRY(CHAR(4)), HB ENTRY(BIT(*)),
       HV ENTRY(CHAR(*) VARYING), HA ENTRY((*) FIXED DEC(5)),
       H0 ENTRY, H3 ENTRY(FIXED DEC(5), CHAR(*), BIT(*)));
   DCL C4 CHAR(4) INIT('WXYZ'), B5 BIT(5) INIT('10110'B);
   DCL V CHAR(9) VARYING INIT('VAR'), A(3) FIXED DEC(5) INIT(1,2,3);
   DCL D FIXED DEC(5) INIT(9);
   CALL H(C4);
   CALL H(B5);
   CALL H(V);
   CALL H(A);
   CALL H;
   CALL H(D, C4, B5);
 H4: PROC(X); DCL X CHAR(4); PUT SKIP LIST('H4', X); END H4;
 HB: PROC(X); DCL X BIT(*); PUT SKIP LIST('HB', X); END HB;
 HV: PROC(X); DCL X CHAR(*) VARYING; PUT SKIP LIST('HV', X); END HV;
 HA: PROC(X); DCL X(*) FIXED DEC(5); PUT SKIP LIST('HA', X); END HA;
 H0: PROC; PUT SKIP LIST('H0'); END H0;
 H3: PROC(X, Y, Z); DCL X FIXED DEC(5), Y CHAR(*), Z BIT(*);
   PUT SKIP LIST('H3', X, Y, Z); END H3;
 END T206GEN;
