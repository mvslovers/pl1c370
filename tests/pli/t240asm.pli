 T240ASM: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T240ASM.OPT.PLI: ASMTST CALLED WITH FIXED
      BINARY(31) ARGUMENTS, WHICH PL/I (F) PASSES BY ADDRESS TOO; THE
      REST AS SC33-0006-7 GIVES IT */
   DCL ASMTST ENTRY;
   DCL (ONE INIT(1), THREE INIT(3)) FIXED BIN(31);
   DCL (A INIT(40), B INIT(2), C INIT(0), R) FIXED BIN(31);
   DCL (X1 INIT(1), X2 INIT(100), X3 INIT(23)) FIXED BIN(31);
   DCL LV FIXED BIN(15) INIT(-14139);
   CALL ASMTST(ONE, A, B, C);
   R = 4;  PUT SKIP LIST(C, R);
   R = 2;  PUT SKIP LIST('HELLO', R);
   CALL ASMTST(THREE);
   R = 1;  PUT SKIP LIST(R);
   CALL ASMTST(X1, X2, X3, C);
   R = 1;  PUT SKIP LIST(C, R);
   /* VARYING: 'HELLO' FROM THE LENGTH PREFIX ON: X'C8C5', 'LLO' */
   PUT SKIP LIST(LV, 'LLO');
 END T240ASM;
