 T205GEN: PROC OPTIONS(MAIN);
   DCL CALC GENERIC (CFX ENTRY(FIXED DEC(5)), CFL ENTRY(FLOAT DEC(6)),
       CCH ENTRY(CHAR(*)), C2 ENTRY(FIXED DEC(5), FIXED DEC(5)),
       CFB ENTRY(FIXED BIN(15)));
   DCL F2 GENERIC (FA ENTRY(FIXED DEC(5)) RETURNS(FIXED DEC(5)),
       FB ENTRY(FLOAT DEC(6)) RETURNS(FLOAT DEC(6)));
   DCL D FIXED DEC(5) INIT(12), E FLOAT DEC(6) INIT(2.5);
   DCL I FIXED BIN(15) INIT(7), S CHAR(4) INIT('ABCD');
   DCL R FIXED DEC(5), Q FLOAT DEC(6);
   CALL CALC(D);
   CALL CALC(E);
   CALL CALC(S);
   CALL CALC(D, D);
   CALL CALC(I);
   R = F2(D);
   Q = F2(E);
   PUT SKIP LIST(R, Q);
 CFX: PROC(X); DCL X FIXED DEC(5); PUT SKIP LIST('CFX', X); END CFX;
 CFL: PROC(X); DCL X FLOAT DEC(6); PUT SKIP LIST('CFL', X); END CFL;
 CCH: PROC(X); DCL X CHAR(*); PUT SKIP LIST('CCH', X); END CCH;
 C2: PROC(X, Y); DCL (X, Y) FIXED DEC(5);
   PUT SKIP LIST('C2', X + Y); END C2;
 CFB: PROC(X); DCL X FIXED BIN(15); PUT SKIP LIST('CFB', X); END CFB;
 FA: PROC(X) RETURNS(FIXED DEC(5)); DCL X FIXED DEC(5);
   RETURN(X * 2); END FA;
 FB: PROC(X) RETURNS(FLOAT DEC(6)); DCL X FLOAT DEC(6);
   RETURN(X * 3); END FB;
 END T205GEN;
