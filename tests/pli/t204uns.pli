 T204UNS: PROC OPTIONS(MAIN);
   DCL CH CHAR(1), C2 CHAR(2), I FIXED BIN(15), J FIXED BIN(31);
   DCL F FLOAT DEC(6), B BIT(8), D FIXED DEC(3);
   UNSPEC(CH) = '11000001'B;
   PUT SKIP LIST(CH);
   UNSPEC(C2) = '1100001011000011'B;
   PUT SKIP LIST(C2);
   UNSPEC(I) = '0000000000000101'B;
   PUT SKIP LIST(I);
   UNSPEC(J) = '1'B;
   PUT SKIP LIST(J, UNSPEC(J));
   UNSPEC(F) = '01000001000100000000000000000000'B;
   PUT SKIP LIST(F);
   UNSPEC(I) = '1111111111111111111'B;
   PUT SKIP LIST(I);
   UNSPEC(D) = '0000000100101100'B;
   PUT SKIP LIST(D);
   UNSPEC(B) = '1010'B;
   PUT SKIP LIST(B);
   UNSPEC(CH) = UNSPEC(I);
   PUT SKIP LIST(UNSPEC(CH));
 END T204UNS;
