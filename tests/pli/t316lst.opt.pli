 T316LS: PROC OPTIONS(MAIN);
   /* LISTING CONTROL STATEMENTS AND %NOTE: NO EFFECT ON THE PROGRAM
      (THERE IS NO SOURCE LISTING), %NOTE A MESSAGE OF ITS OWN */
 %PAGE;
   DCL I FIXED BIN(15);
 %SKIP(2);
 %NOPRINT;
   DO I = 1 TO 3;
     PUT SKIP LIST('LINE', I);
   END;
 %PRINT;
 %CONTROL(FORMAT);
 %DCL V CHAR;
 %V = '''T316''';
 %NOTE('COMPILING ' || V);
 %NOTE('A WARNING', 4);
 %SKIP;
   PUT SKIP LIST(V);
 END T316LS;
