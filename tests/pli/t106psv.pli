 T106PSV: PROC OPTIONS(MAIN);
   DCL C CHAR(10) INIT('ABCDEFGHIJ'),
       V CHAR(10) VARYING INIT('ABCDEF');
   DCL B BIT(12) INIT('101010101010'B), L BIT(40) INIT((40)'0'B);
   DCL (I, N) FIXED BIN(15), X FIXED DEC(5,2) INIT(-12.5);
   DCL F FLOAT DEC(6) INIT(2.5E0), K FIXED BIN(15) INIT(5);
   SUBSTR(C, 3, 2) = 'XY'; PUT SKIP LIST(C);
   SUBSTR(C, 8) = '1234'; PUT SKIP LIST(C);
   SUBSTR(C, 1, 3) = 'Z'; PUT SKIP LIST(C);
   SUBSTR(V, 2, 3) = '**'; PUT SKIP LIST(V, LENGTH(V));
   SUBSTR(B, 1, 4) = '1111'B; PUT SKIP LIST(B);
   SUBSTR(L, 37) = '1111'B; PUT SKIP LIST(L);
   DO I = 1 TO 3; SUBSTR(C, I, 1) = SUBSTR('123', I, 1); END;
   PUT SKIP LIST(C);
   PUT SKIP LIST(CHAR(K), CHAR(X), CHAR(F));
   PUT SKIP LIST('|' || CHAR(K, 4) || '|', '|' || CHAR('AB',
       5) || '|');
   PUT SKIP LIST(BIT(K), BIT(K, 4), BIT('1011', 6));
   PUT SKIP LIST(BIT(-3), LENGTH(BIT(K)), LENGTH(CHAR(X)));
   N = BIT('0101'B, 8); PUT SKIP LIST(N);
 END T106PSV;
