 P6STR: PROC OPTIONS(MAIN);
    /* NUMBER TO CHARACTER, CONCATENATION, STRING BUILT-INS, MOD ETC */
    DCL C CHAR(12);
    DCL V CHAR(30) VARYING;
    DCL I FIXED BIN(15) INIT(7);
    DCL K FIXED BIN(31) INIT(-1234);
    DCL D FIXED DEC(7,2) INIT(-12.5);
    C = 42;       PUT SKIP LIST('C=42', C, '|');
    C = I;        PUT SKIP LIST('C=I', C, '|');
    C = D;        PUT SKIP LIST('C=D', C, '|');
    V = 'X=' || I;
    PUT SKIP LIST(V, LENGTH(V));
    V = 'AB' || 'CD' || D;
    PUT SKIP LIST(V, LENGTH(V));
    V = K || '/';
    PUT SKIP LIST(V, LENGTH(V));
    PUT SKIP LIST('SUBSTR', SUBSTR('ABCDEF',2,3), SUBSTR('ABCDEF',4));
    C = 'HELLO WORLD';
    PUT SKIP LIST('SUBSTR C', SUBSTR(C,7,5), SUBSTR(C,I));
    PUT SKIP LIST('INDEX', INDEX('ABCDEF','CD'), INDEX(C,'Z'));
    PUT SKIP LIST('MOD', MOD(17,5), MOD(-17,5), MOD(K,100));
    PUT SKIP LIST('ABS', ABS(-5), ABS(K), ABS(D));
    PUT SKIP LIST('MAX', MAX(3,9,4), MAX(I,K), MAX(D,1.25));
    PUT SKIP LIST('MIN', MIN(3,9,4), MIN(I,K), MIN(D,1.25));
    PUT SKIP LIST('LEN', LENGTH('AB' || 'CDE'));
 END P6STR;
