 T102UPD: PROC OPTIONS(MAIN);
   DCL F FILE RECORD;
   DCL 1 R, 2 K FIXED DEC(3), 2 NAME CHAR(8), 2 AMT FIXED BIN(31);
   DCL (I, N) FIXED BIN(15), EOF BIT(1) INIT('0'B);
   OPEN FILE(F) OUTPUT TITLE('REPORT');
   DO I = 1 TO 5;
     R.K = I; R.NAME = SUBSTR('REC1REC2REC3REC4REC5', 4 * I - 3, 4);
     R.AMT = I * 100;
     WRITE FILE(F) FROM(R);
   END;
   CLOSE FILE(F);
   OPEN FILE(F) UPDATE SEQUENTIAL TITLE('REPORT');
   ON ENDFILE(F) EOF = '1'B;
   N = 0;
   READ FILE(F) INTO(R);
   DO WHILE(¬EOF);
     IF MOD(R.K, 2) = 0 THEN DO;
       R.AMT = R.AMT + 1; R.NAME = 'CHANGED';
       REWRITE FILE(F) FROM(R);
       N = N + 1;
     END;
     READ FILE(F) INTO(R);
   END;
   CLOSE FILE(F);
   PUT SKIP LIST('REWRITTEN', N);
   EOF = '0'B;
   OPEN FILE(F) INPUT TITLE('REPORT');
   READ FILE(F) INTO(R);
   DO WHILE(¬EOF);
     PUT SKIP LIST(R.K, R.NAME, R.AMT);
     READ FILE(F) INTO(R);
   END;
   CLOSE FILE(F);
 END T102UPD;
