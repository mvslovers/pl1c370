 P7ARR: PROC OPTIONS(MAIN);
    /* ARRAYS: BOUNDS, SUBSCRIPTS, INITIAL, AGGREGATES, OUTPUT */
    DCL A(5) FIXED BIN(15) INIT(1,2,3,4,5);
    DCL B(0:2,3) FIXED DEC(5,1) INIT((9)0);
    DCL C(-2:2) CHAR(3) INIT('AA','BB','CC','DD','EE');
    DCL D(3) FIXED BIN(31);
    DCL E(4) FIXED BIN(15) INIT((2)7,(2)-1);
    DCL (I,J) FIXED BIN(15);
    PUT SKIP LIST('A', A);
    I = 2;
    PUT SKIP LIST('A(3)', A(3), A(I), A(I+2));
    DO I = 0 TO 2;
       DO J = 1 TO 3;
          B(I,J) = I * 10 + J;
       END;
    END;
    PUT SKIP LIST('B', B);
    PUT SKIP LIST('C', C(-2), C(2), C);
    PUT SKIP LIST('E', E);
    A = 0;
    PUT SKIP LIST('A=0', A);
    D = 5;
    D = D * 2 + 1;
    PUT SKIP LIST('D', D);
    A(2) = 9;
    A(A(2) - 5) = 4;
    PUT SKIP LIST('A NOW', A);
    PUT SKIP LIST('DIM', DIM(B,1), DIM(B,2), LBOUND(C,1), HBOUND(C,1));
 END P7ARR;
