 T305VRC: PROC OPTIONS(MAIN);
   /* A VARYING STRING IN RECORD I/O: ITS CURRENT CHARACTERS ONLY, AND
      ON INPUT THE RECORD LENGTH AS ITS LENGTH (PL/I (F), NO PREFIX) */
   DCL OUTV FILE RECORD OUTPUT ENV(V(84,80));
   DCL INV FILE RECORD INPUT ENV(V(84,80));
   DCL VS CHAR(10) VAR INIT('ABC');
   DCL C CHAR(12);
   DCL W CHAR(12) VAR;
   DCL EOF BIT(1) INIT('0'B);
   ON ENDFILE(INV) EOF = '1'B;
   OPEN FILE(OUTV) TITLE('VDS');
   WRITE FILE(OUTV) FROM(VS);
   VS = 'HELLO WORLD';
   WRITE FILE(OUTV) FROM(VS);
   CLOSE FILE(OUTV);
   OPEN FILE(INV) TITLE('VDS');
   C = (12)'*';
   READ FILE(INV) INTO(C);
   PUT SKIP LIST(UNSPEC(SUBSTR(C,1,4)), C);
   READ FILE(INV) INTO(W);
   PUT SKIP LIST(LENGTH(W), W);
   CLOSE FILE(INV);
 END T305VRC;
