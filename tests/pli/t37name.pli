 T37NAME: PROC OPTIONS(MAIN);
   DCL P ENTRY;
   PUT LIST('A');
   SIGNAL CONDITION(AB);
   PUT LIST('B');
   SIGNAL CONDITION(ABCDEFG);
   SIGNAL CONDITION(ABCDEFGH);
   PUT SKIP LIST('C');
   SIGNAL CONDITION(LONGCONDNAME);
   PUT SKIP(0) LIST('D');
   CALL P;
   PUT LIST('E');
 P: PROC;
   DCL X FIXED DEC(5);
   DCL S CHAR(1) INIT('W');
   DCL S2 CHAR(1) INIT('Q');
   DCL N FIXED BIN(15) INIT(0);
   ON ERROR BEGIN;
     N = N + 1;
     PUT SKIP LIST('ERR IN P', ONCODE, N);
     IF N = 1 THEN GO TO L;
     IF N = 2 THEN GO TO L2;
   END;
   X = S;
   PUT SKIP LIST('NOT REACHED');
 L: PUT SKIP LIST('AT L', ONCODE);
   X = S2;
   PUT SKIP LIST('NOT REACHED 2');
 L2: PUT SKIP LIST('AT L2', N);
   SIGNAL CONDITION(INP);
 END P;
 END T37NAME;
