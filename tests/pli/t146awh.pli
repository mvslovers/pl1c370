 T146AWH: PROC OPTIONS(MAIN);
   /* A(*) parameters as a whole: assignment, expressions, PUT LIST */
   DCL X(0:4) FIXED BIN(31), Y(2:3, -1:1) FIXED DEC(5);
   DCL Z(0:4) FIXED BIN(31), CA(3) CHAR(4) INIT('A', 'BB', 'CCC');
   DCL (I, J) FIXED BIN(15);
   DO I = 0 TO 4; X(I) = I * 10; END;
   DO I = 2 TO 3; DO J = -1 TO 1; Y(I, J) = I * 10 + J; END; END;
   CALL SHOW1(X);
   CALL ZERO(X);
   PUT SKIP LIST('X', X);
   CALL SHOW2(Y);
   CALL COPY(X, Z);
   PUT SKIP LIST('Z', Z);
   CALL SHOWC(CA);
 SHOW1: PROC(A);
   DCL A(*) FIXED BIN(31);
   PUT SKIP LIST('SHOW1', A);
   A = A * 2 + 1;
   PUT SKIP LIST('TWICE', A);
 END SHOW1;
 ZERO: PROC(A);
   DCL A(*) FIXED BIN(31);
   A = 0;
   A(2) = 5;
 END ZERO;
 SHOW2: PROC(B);
   DCL B(*, *) FIXED DEC(5);
   PUT SKIP LIST('SHOW2', B);
   B = -B;
   PUT SKIP LIST('NEG', B);
 END SHOW2;
 COPY: PROC(S, T);
   DCL (S, T)(*) FIXED BIN(31);
   T = S + 100;
 END COPY;
 SHOWC: PROC(C);
   DCL C(*) CHAR(*);
   PUT SKIP LIST('SHOWC', C);
   C = 'Z';
   PUT SKIP LIST('SET', C);
 END SHOWC;
 END T146AWH;
