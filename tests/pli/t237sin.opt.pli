 %PROCESS LANGLVL(SPROG);
 T237SIN: PROC OPTIONS(MAIN);
   /* STATIC POINTERS WITH INITIAL: NULL (THE OPTIMIZER, GC33-0009-4),
      SYSNULL AND POINTERVALUE(16) (SC26-3114-01) */
   DCL P PTR STATIC INIT(NULL);
   DCL Q PTR STATIC INIT(SYSNULL);
   DCL R PTR STATIC INIT(POINTERVALUE(16));
   PUT SKIP LIST(P = NULL, BINARYVALUE(Q), BINARYVALUE(R));
 END T237SIN;
