 T75ATB: PROC OPTIONS(MAIN);
   DCL C16 FLOAT DEC(16), S6 FLOAT DEC(6), B25 FLOAT BIN(25);
   DCL B53 FLOAT BIN(53), B10 FLOAT BIN(10), B40 FLOAT BIN(40);
   DCL X FLOAT DEC(16);
   C16 = 1; S6 = 1; B25 = 0; B53 = 1; B10 = 1; B40 = 1;
   PUT SKIP LIST(ATAN(C16, S6) + B25, ATAN(B53, B10));
   PUT SKIP LIST(ATAN(B10, B40), ATAN(B53, B40));
   PUT SKIP LIST(ATAN(S6, B53), ATAND(B10, C16));
   X = ATAN(C16, S6); PUT SKIP LIST(X);
 END T75ATB;
