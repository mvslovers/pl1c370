 T325FVM: PROC OPTIONS(MAIN);
   /* TIER 129: FILE MEMBERS OF A STRUCTURE AND FILE ARRAYS, FILE
      VARIABLES BY IMPLICATION (SC26-3114-01, VARIABLE ATTRIBUTE) */
   DCL REPORT FILE STREAM OUTPUT;
   DCL 1 W, 2 TAG CHAR(4) INIT('WORK'),
         2 N FIXED BIN(15) INIT(7);
   DCL I FIXED BIN(15);
   PUT FILE(REPORT) LIST('TO REPORT', N);
   DO I = 1 TO 2;
      IF I = 1 THEN PUT FILE(SYSPRINT) SKIP LIST(TAG, I);
      ELSE PUT FILE(REPORT) SKIP LIST(TAG, I);
   END;
   CALL SHOW(SYSPRINT, 'TO SYSPRINT');
   CALL SHOW(REPORT, 'TO REPORT');
 SHOW: PROC(F, S);
   DCL F FILE, S CHAR(*);
   PUT FILE(F) SKIP LIST(S);
 END SHOW;
 END T325FVM;
