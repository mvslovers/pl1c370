 T278EVT: PROC OPTIONS(MAIN);
   /* EVENT VARIABLES WITHOUT TASKS (#3 TIER 0): COMPLETION AND
      STATUS AS FUNCTIONS AND PSEUDO-VARIABLES, EVENT ASSIGNMENT,
      WAIT ON COMPLETE EVENTS, WAIT WITH A COUNT, ARRAYS OF EVENTS */
   DCL (E1, E2, E3) EVENT;
   DCL EA(3) EVENT;
   DCL 1 S, 2 C CHAR(1), 2 EV EVENT;
   PUT SKIP LIST('INITIAL', COMPLETION(E1), STATUS(E1));
   COMPLETION(E1) = '1'B;
   STATUS(E1) = 5;
   PUT SKIP LIST('SET', COMPLETION(E1), STATUS(E1));
   E2 = E1;
   PUT SKIP LIST('E2 = E1', COMPLETION(E2), STATUS(E2));
   WAIT(E1);
   PUT SKIP LIST('WAITED E1');
   WAIT(E1, E2);
   PUT SKIP LIST('WAITED E1, E2');
   WAIT(E1, E3) (1);
   PUT SKIP LIST('WAITED E1, E3 (1)');
   COMPLETION(EA) = '1'B;
   STATUS(EA) = 7;
   PUT SKIP LIST(COMPLETION(EA(2)), STATUS(EA(3)));
   WAIT(EA);
   PUT SKIP LIST('WAITED EA');
   COMPLETION(S.EV) = '1'B;
   S.C = 'C';
   WAIT(S.EV);
   PUT SKIP LIST('WAITED S.EV', S.C, STATUS(S.EV));
   STATUS(E3) = -1;
   COMPLETION(E3) = '0'B;
   PUT SKIP LIST(COMPLETION(E3), STATUS(E3));
   E3 = E2;
   PUT SKIP LIST(COMPLETION(E3), STATUS(E3));
   PUT SKIP LIST(UNSPEC(COMPLETION(E3)));
 END T278EVT;
