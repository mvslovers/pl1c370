 T142AST: PROC OPTIONS(MAIN);
   /* A(*) and A(*, *) parameters: bounds, DIM, elements, passed on */
   DCL X(0:4) FIXED BIN(31), Y(2:3, -1:1) FIXED DEC(5);
   DCL Z(5) FLOAT DEC(6), CA(2:4) CHAR(3) INIT('AB', 'CDE', 'F');
   DCL (I, J, TWO) FIXED BIN(15), T FIXED BIN(31);
   DO I = 0 TO 4; X(I) = I * 10; END;
   DO I = 2 TO 3; DO J = -1 TO 1; Y(I, J) = I * 10 + J; END; END;
   DO I = 1 TO 5; Z(I) = I / 4E0; END;
   CALL SUM1(X, T);
   PUT SKIP LIST('SUM X', T);
   CALL SHOW2(Y);
   TWO = 2;
   CALL SCALE(Z, TWO);
   PUT SKIP LIST('Z', Z(1), Z(5));
   CALL PASSON(CA);
   PUT SKIP LIST('CA', CA(2), CA(3), CA(4));
   CALL SUM1(X, T);
   PUT SKIP LIST('SUM X AGAIN', T);
   CALL BAD(X);
 SUM1: PROC(A, S);
   DCL A(*) FIXED BIN(31), S FIXED BIN(31), K FIXED BIN(15);
   S = 0;
   DO K = LBOUND(A, 1) TO HBOUND(A, 1);
     S = S + A(K);
   END;
   PUT SKIP LIST('SUM1', LBOUND(A, 1), HBOUND(A, 1), DIM(A, 1));
   A(LBOUND(A, 1)) = 99;
 END SUM1;
 SHOW2: PROC(B);
   DCL B(*, *) FIXED DEC(5), (K, L) FIXED BIN(15);
   PUT SKIP LIST('SHOW2', LBOUND(B, 1), HBOUND(B, 1),
     LBOUND(B, 2), HBOUND(B, 2), DIM(B, 2));
   DO K = LBOUND(B, 1) TO HBOUND(B, 1);
     DO L = LBOUND(B, 2) TO HBOUND(B, 2);
       PUT SKIP LIST('B', K, L, B(K, L));
     END;
   END;
 END SHOW2;
 SCALE: PROC(V, F);
   DCL V(*) FLOAT DEC(6), F FIXED BIN(15), K FIXED BIN(15);
   DO K = 1 TO DIM(V, 1);
     V(K) = V(K) * F;
   END;
 END SCALE;
 PASSON: PROC(C);
   DCL C(*) CHAR(*);
   PUT SKIP LIST('PASSON', LBOUND(C, 1), LENGTH(C(2)));
   CALL SETC(C);
 END PASSON;
 SETC: PROC(D);
   DCL D(*) CHAR(*), K FIXED BIN(15);
   DO K = LBOUND(D, 1) TO HBOUND(D, 1);
     D(K) = '*' || D(K);
   END;
 END SETC;
 BAD: PROC(A);
   DCL A(*) FIXED BIN(31);
   (SUBSCRIPTRANGE): A(5) = 1;
   PUT SKIP LIST('NOT REACHED');
 END BAD;
 END T142AST;
