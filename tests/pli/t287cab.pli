 T287CAB: PROC OPTIONS(MAIN);
   /* ABS OF COMPLEX FLOAT VALUES (#2): SHORT AND LONG, A ZERO PART,
      EQUAL PARTS, IN EXPRESSIONS, ABS OF A PRODUCT, OVERFLOW */
   DCL A COMPLEX FLOAT DEC(6);
   DCL D COMPLEX FLOAT DEC(16);
   DCL B COMPLEX FLOAT BIN(21);
   DCL Y FLOAT DEC(6);
   DCL L FLOAT DEC(16);
   DCL NO FIXED BIN(15) INIT(0);
   ON OVERFLOW NO = NO + 1;
   A = 3+4I; Y = ABS(A); PUT SKIP LIST(ABS(A), UNSPEC(Y));
   A = 1+1I; Y = ABS(A); PUT SKIP LIST(ABS(A), UNSPEC(Y));
   A = 0; PUT SKIP LIST(ABS(A));
   A = -2I; PUT SKIP LIST(ABS(A));
   A = -5; PUT SKIP LIST(ABS(A));
   A = 0.1+0.7I; Y = ABS(A); PUT SKIP LIST(ABS(A), UNSPEC(Y));
   A = -0.7-0.1I; Y = ABS(A); PUT SKIP LIST(UNSPEC(Y));
   A = 1E70+1E70I; PUT SKIP LIST(ABS(A));
   A = 1E-70+1E-70I; PUT SKIP LIST(ABS(A));
   A = 12.5-0.03I; PUT SKIP LIST(ABS(A), ABS(A)*2, ABS(A*A));
   D = 1+1I; PUT SKIP LIST(ABS(D));
   D = 0.1+0.7I; L = ABS(D); PUT SKIP LIST(ABS(D), UNSPEC(L));
   D = 3+4I; PUT SKIP LIST(ABS(D));
   D = 1.234567890123E10-9.87654321E-3I; PUT SKIP LIST(ABS(D));
   B = 1.5+2I; PUT SKIP LIST(ABS(B));
   PUT SKIP LIST(ABS(A+D), ABS(CONJG(A)));
   A = 7E75+7E75I;
   Y = ABS(A); PUT SKIP LIST('OVERFLOW', NO);
 END T287CAB;
