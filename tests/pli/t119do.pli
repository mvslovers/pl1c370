 T119DO: PROC OPTIONS(MAIN);
   DCL (I, J, N, B) FIXED BIN(31), X FLOAT DEC(6), D FIXED DEC(5,2);
   DCL S CHAR(200) VARYING;
   S = '';
   DO I = 0, 2, 5, 3;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('LIST', S, I);
   S = '';
   DO I = 1 TO 3, 7, 10 TO 6 BY -2, 20 BY 5 TO 30;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('MIXED', S, I);
   S = '';
   DO I = 1 TO 10 WHILE(I * I < 20), 50 WHILE(I > 100), 60;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('WHILE', S, I);
   S = '';
   N = 0;
   DO I = 1 BY 3 WHILE(N < 4);
     N = N + 1;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('BY ONLY', S, I, N);
   S = '';
   B = -1;
   DO I = 5 TO 1 BY B;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('BY VAR', S, I);
   N = 3;
   S = '';
   DO I = 1 TO N;
     N = 10;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('TO ONCE', S, I, N);
   S = '';
   DO I = 5 TO 1;
     S = S || 'X';
   END;
   PUT SKIP LIST('NONE', S, I);
   DO X = 0 TO 1 BY 0.25;
     PUT SKIP LIST('FLOAT', X);
   END;
   PUT SKIP LIST('FLOAT AFTER', X);
   DO D = 1.5 TO 0 BY -0.75, 9.99;
     PUT SKIP LIST('DEC', D);
   END;
   J = 4;
   S = '';
   DO I = J TO J + 2, J * 10;
     J = 0;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('EXPR', S, I, J);
   S = '';
   DO I = 1 TO 3;
     DO J = I, I * 10;
       S = S || CHAR(J);
     END;
   END;
   PUT SKIP LIST('NEST', S);
   S = '';
   DO I = 1 TO 4 BY 0 WHILE(LENGTH(S) < 20);
     S = S || '*';
   END;
   PUT SKIP LIST('BY 0', S, I);
   S = '';
   DO I = 1, 2 WHILE('0'B), 3;
     IF I = 3 THEN GO TO OUT;
     S = S || CHAR(I);
   END;
 OUT: PUT SKIP LIST('GOTO', S, I);
 END T119DO;
