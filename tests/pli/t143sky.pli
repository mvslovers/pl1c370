 T143SKY: PROC OPTIONS(MAIN);
   /* LOCATE KEYFROM (INDEXED), READ SET with KEY and KEYTO */
   DCL R1 FILE RECORD KEYED ENV(REGIONAL(1));
   DCL IX FILE RECORD KEYED ENV(INDEXED);
   DCL 1 S BASED(P), 2 A CHAR(4), 2 B CHAR(16);
   DCL P POINTER, KC CHAR(5), I FIXED BIN(31), C CHAR(20);
   DCL PC PIC'9999', L LABEL, NE FIXED BIN(31) INIT(0);
   ON ERROR BEGIN;
     NE = NE + 1;
     PUT SKIP LIST('ERROR', ONCODE);
     IF NE < 10 THEN GO TO L;
   END;
   ON KEY(R1) PUT SKIP LIST('KEY R1', ONCODE, ONKEY);
   ON KEY(IX) PUT SKIP LIST('KEY IX', ONCODE, ONKEY);
   L = S1;
   OPEN FILE(R1) SEQUENTIAL OUTPUT;
   ALLOCATE S;
   DO I = 0, 2, 5;
     PC = I;
     A = 'WRI ';
     B = 'REGION ' || PC;
     WRITE FILE(R1) FROM(S) KEYFROM(I);
   END;
 S1: L = S2;
   CLOSE FILE(R1);
   OPEN FILE(R1) DIRECT UPDATE;
   PUT SKIP LIST('R1 DIRECT');
   READ FILE(R1) SET(P) KEY(2);
   PUT SKIP LIST('R1 SET 2', A, B);
   B = 'CHANGED';
   REWRITE FILE(R1) FROM(S) KEY(2);
   READ FILE(R1) SET(P) KEY(5);
   PUT SKIP LIST('R1 SET 5', A, B);
   READ FILE(R1) SET(P) KEY(99999);
   PUT SKIP LIST('R1 SET X', A, B);
 S2: L = S3;
   CLOSE FILE(R1);
   OPEN FILE(R1) SEQUENTIAL INPUT;
   DO I = 1 TO 4;
     READ FILE(R1) INTO(C) KEYTO(KC);
     PUT SKIP LIST('R1 SEQ', KC, C);
   END;
 S3: L = S4;
   CLOSE FILE(R1);
   OPEN FILE(IX) SEQUENTIAL OUTPUT;
   DO I = 1 TO 4;
     PC = I * 3;
     LOCATE S FILE(IX) KEYFROM('K' || PC);
     A = 'IX  ';
     B = 'KEY ' || PC;
   END;
   LOCATE S FILE(IX) KEYFROM('K0001');
   A = 'LOW ';
   B = 'OUT OF ORDER';
 S4: L = S5;
   CLOSE FILE(IX);
   PUT SKIP LIST('IX DIRECT');
   OPEN FILE(IX) DIRECT INPUT;
   READ FILE(IX) SET(P) KEY('K0006');
   PUT SKIP LIST('IX SET 6', A, B);
   READ FILE(IX) SET(P) KEY('K0007');
   PUT SKIP LIST('IX SET 7', A, B);
 S5: L = S6;
   CLOSE FILE(IX);
   PUT SKIP LIST('IX SEQ');
   OPEN FILE(IX) SEQUENTIAL INPUT;
   READ FILE(IX) SET(P) KEY('K0009');
   PUT SKIP LIST('IX SEQ SET 9', A, B);
   READ FILE(IX) SET(P) KEYTO(KC);
   PUT SKIP LIST('IX SEQ NEXT', KC, A, B);
 S6: CLOSE FILE(IX);
   PUT SKIP LIST('DONE');
 END T143SKY;
