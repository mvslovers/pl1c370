 T36CONV: PROC OPTIONS(MAIN);
   DCL X FIXED DEC(5);
   DCL N FIXED BIN(15) INIT(0);
   DCL S CHAR(2) INIT('1Q');
   ON CONVERSION BEGIN;
     N = N + 1;
     PUT SKIP LIST('CONV', ONCODE, N);
     IF N > 3 THEN GO TO OUT;
   END;
   X = S;
   PUT SKIP LIST('AFTER', X);
 OUT:
   PUT SKIP LIST('OUT', N);
   ON CONVERSION SYSTEM;
   S = 'C';
   X = S;
   PUT SKIP LIST('NOT REACHED');
 END T36CONV;
