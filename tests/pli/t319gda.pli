 T319GD: PROC OPTIONS(MAIN);
   /* GET DATA OF ARRAYS OF MORE THAN ONE DIMENSION, OF ARRAYS OF
      STRUCTURES AND OF ARRAYS OF PICTURES */
   DCL M(2,3) FIXED BIN(15) INIT((6)0);
   DCL C(-1:0,2,2) CHAR(2) INIT((8)(1)'..');
   DCL 1 S(3),
         2 A FIXED DEC(5,1),
         2 B CHAR(3),
         2 T(2),
           3 U FIXED BIN(31),
           3 V FLOAT DEC(6);
   DCL P(2) PIC 'ZZ9V.9';
   S.A = 0; S.B = ''; S.U = 0; S.V = 0; P = 0;
   GET DATA(M, C);
   PUT DATA(M, C);
   GET DATA(S, P);
   PUT SKIP DATA(S, P);
   GET DATA(M, S);
   PUT SKIP DATA(M, S.A);
 END T319GD;
