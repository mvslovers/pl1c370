 T249STL: PROC OPTIONS(MAIN);
   /* TIER 96: STERLING CONSTANTS AND PICTURES (GC28-8201-4,
      SECTION D; #219), AS PROBES Q1STL TO Q4STL MEASURED THEM */
   DCL P1 PIC 'GMZ9M.8M.99V.9CR', P2 PIC 'GMZZM.ZZM.ZZP';
   DCL P3 PIC 'GM99M/99M/99', P4 PIC 'GMZZ9M8M7', P5 PIC 'GMZZ9M8M6';
   DCL P6 PIC 'G$MZZZM.ZZMH99V9P', P7 PIC 'GM$$$9M.99M.9T';
   DCL P8 PIC 'GMZ9M.99M.99V99', P9 PIC 'GMZ9MBY9MB99B';
   DCL Q PIC 'ZZ9', D FIXED DEC(7,1), C CHAR(40) VARYING;
   DCL I FIXED BIN(15), N FIXED BIN(15) INIT(0);
   DCL V(7) FIXED DEC(7,1) INIT(534, 19, 131, -534, 0, 131.5, 2399);
   PUT LIST(2.4.6L, 101.13.8L, 0.0.2.5L, 1.10.0L);
   D = 2.4.6L + 1; PUT SKIP LIST(D);
   PUT SKIP LIST(2.4.6L * 2, 1.0.0L / 3, 0.0.2.5L + 1.0.0L);
   DO I = 1 TO 7;
     P1 = V(I); P2 = V(I); P3 = V(I); P4 = V(I); P5 = V(I);
     PUT SKIP EDIT(P1, '|', P2, '|', P3, '|', P4, '|', P5) (9 A);
     P6 = V(I); P7 = V(I); P8 = V(I); P9 = V(I);
     PUT SKIP EDIT(P6, '|', P7, '|', P8, '|', P9) (7 A);
   END;
   P3 = 534; D = P3; PUT SKIP LIST(D, P3 + 1, P3);
   C = P3 + 0; PUT SKIP LIST(LENGTH(C), C);
   C = P8 + 0; PUT SKIP LIST(LENGTH(C), C);
   C = P4; PUT SKIP LIST(LENGTH(C), C);
   P2 = -19; PUT SKIP LIST(P2, P2 + 0);
   PUT SKIP DATA(P4, P2);
   PUT SKIP EDIT(534, 131) (P'GMZZ9M8M7', X(1), P'GMZZ9M8M6');
   PUT SKIP EDIT(-534, 2.5)
     (P'GMZ9M.99M.99CR', X(1), P'GMZ9M.99M.99V.9');
   GET EDIT(P3) (P'GM99M/99M/99');
   PUT SKIP LIST(P3, P3 + 0);
   GET EDIT(P4) (P'GMZZ9M8M7');
   PUT SKIP LIST(P4, P4 + 0);
   GET EDIT(P8) (P'GMZ9M.99M.99V99');
   PUT SKIP LIST(P8, P8 + 0);
   ON CONVERSION BEGIN;
     N = N + 1;
     PUT SKIP LIST('CONVERSION', ONCODE, ONSOURCE);
     IF N > 2 THEN STOP;
     ONSOURCE = '0';
   END;
   GET LIST(D);
   PUT SKIP LIST(D);
   ON SIZE PUT SKIP LIST('SIZE', ONCODE);
   D = 240000;
   (SIZE): P4 = D;
   PUT SKIP LIST(P4, P4 + 0);
   D = 239999;
   (SIZE): P4 = D;
   PUT SKIP LIST(P4, P4 + 0);
   D = 1234;
   (SIZE): Q = D;
   PUT SKIP LIST(Q, Q + 0);
 END T249STL;
