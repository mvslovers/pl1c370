 T86DEF2: PROC OPTIONS(MAIN);
   DCL 1 A, 2 X FIXED BIN(15) INIT(5), 2 Y CHAR(8) INIT('ABCDEFGH');
   DCL Y2 CHAR(2) DEFINED A.Y POSITION(7);
   DCL ST CHAR(6) STATIC INIT('STATIC');
   DCL S3 CHAR(3) DEFINED ST POSITION(4);
   DCL M(4,4) FIXED DEC(5);
   DCL E(2) FIXED DEC(5) DEFINED M(2*1SUB, 1SUB+1);
   DCL K2(2,2) FIXED DEC(5) DEFINED M;
   DCL (I, J) FIXED BIN(15);
   DO I = 1 TO 4; DO J = 1 TO 4; M(I,J) = 100 * I + J; END; END;
   PUT SKIP LIST(Y2, S3);
   PUT SKIP LIST(E);
   PUT SKIP LIST(K2);
   CALL SHOW;
   Y2 = 'YZ'; S3 = '***'; E(1) = 0; K2(2,2) = 7;
   PUT SKIP LIST(A.Y, ST);
   PUT SKIP LIST(M);
 SHOW: PROC;
   PUT SKIP LIST('IN SHOW', E(2), K2(1,2), Y2);
 END SHOW;
 END T86DEF2;
