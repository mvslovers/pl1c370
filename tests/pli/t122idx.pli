 T122IDX: PROC OPTIONS(MAIN);
   DCL IX FILE RECORD KEYED ENV(INDEXED);
   DCL REC CHAR(20), K CHAR(5), KC CHAR(8), N FIXED BIN(31);
   DCL TT CHAR(8);
   ON KEY(IX) PUT SKIP LIST('KEY', ONCODE);
   OPEN FILE(IX) SEQUENTIAL OUTPUT;
   K = 'B0010'; CALL WR;
   K = 'B0030'; CALL WR;
   K = 'B0050'; CALL WR;
   K = 'B0040'; CALL WR;
   K = 'B0050'; CALL WR;
   K = 'B0070'; CALL WR;
   REC = 'SHORT KEY';
   WRITE FILE(IX) FROM(REC) KEYFROM('B008');
   REC = 'LONG KEY';
   WRITE FILE(IX) FROM(REC) KEYFROM('B0090XYZ');
   CLOSE FILE(IX);
   TT = 'CREATED'; CALL LIST;
   OPEN FILE(IX) DIRECT INPUT;
   K = 'B0030'; CALL RD;
   K = 'B0031'; CALL RD;
   K = 'B008 '; CALL RD;
   K = 'B0090'; CALL RD;
   CLOSE FILE(IX);
   OPEN FILE(IX) DIRECT UPDATE;
   REC = 'REWRITTEN 30';
   REWRITE FILE(IX) FROM(REC) KEY('B0030');
   REC = 'ADDED 20';
   WRITE FILE(IX) FROM(REC) KEYFROM('B0020');
   REC = 'ADDED 99';
   WRITE FILE(IX) FROM(REC) KEYFROM('B0099');
   REC = 'DUPLICATE';
   WRITE FILE(IX) FROM(REC) KEYFROM('B0010');
   DELETE FILE(IX) KEY('B0050');
   DELETE FILE(IX) KEY('B0051');
   REC = 'NOT THERE';
   REWRITE FILE(IX) FROM(REC) KEY('B0060');
   K = 'B0050'; CALL RD;
   CLOSE FILE(IX);
   TT = 'UPDATED'; CALL LIST;
   OPEN FILE(IX) SEQUENTIAL UPDATE;
   READ FILE(IX) INTO(REC);
   READ FILE(IX) INTO(REC);
   REC = 'SEQ REWRITE';
   REWRITE FILE(IX) FROM(REC);
   READ FILE(IX) INTO(REC);
   DELETE FILE(IX);
   CLOSE FILE(IX);
   TT = 'SEQUPD'; CALL LIST;
   SIGNAL KEY(IX);
 WR: PROC;
   REC = 'RECORD ' || K;
   WRITE FILE(IX) FROM(REC) KEYFROM(K);
 END WR;
 RD: PROC;
   REC = (20)'?';
   READ FILE(IX) INTO(REC) KEY(K);
   PUT SKIP LIST('READ', K, REC);
 END RD;
 LIST: PROC;
   N = 0;
   OPEN FILE(IX) SEQUENTIAL INPUT;
   ON ENDFILE(IX) GO TO EOF;
   DO WHILE('1'B);
     KC = (8)'*';
     READ FILE(IX) INTO(REC) KEYTO(KC);
     N = N + 1;
     PUT SKIP LIST(TT, KC, REC);
   END;
 EOF:
   CLOSE FILE(IX);
   PUT SKIP LIST(TT, N);
 END LIST;
 END T122IDX;
