 T264ATT: PROC OPTIONS(MAIN);
   /* ATTENTION'S TWIN: WHAT THE ON-UNITS OF T264ATT.OPT.PLI PRINT,
      WRITTEN OUT -- PL/I (F) HAS NO ATTENTION CONDITION */
   DCL (N, C) FIXED BIN(15) INIT(0);
   C = 1400;
   PUT SKIP LIST('START');
   PUT SKIP LIST('NO UNIT, IGNORED');
   N = N + 1;
   PUT SKIP LIST('ATTENTION', N, C);
   PUT SKIP LIST('AFTER THE UNIT', N);
   PUT SKIP LIST('INNER UNIT', C);
   N = N + 1;
   PUT SKIP LIST('ATTENTION', N, C);
   PUT SKIP LIST('REVERTED', N);
 END T264ATT;
