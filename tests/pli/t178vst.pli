 T178VST: PROC OPTIONS(MAIN);
   DCL V CHAR(12) VARYING INIT('VARY'), W CHAR(8) VARYING INIT('');
   DCL C CHAR(3) INIT('ABC');
   CALL SHOWS(V);
   CALL SHOWS(W);
   CALL SHOWS(V || 'X');
   CALL SHOWS(V || C);
   CALL SHOWS(SUBSTR(V, 2));
   CALL SHOWS((V));
   V = 'ABCDEFGHIJKL';
   CALL SHOWS(V);
   CALL SHOWV(V);
 SHOWS: PROC(S);
   DCL S CHAR(*);
   PUT SKIP LIST('SHOWS', S || '|', LENGTH(S));
 END SHOWS;
 SHOWV: PROC(S);
   DCL S CHAR(*) VARYING;
   PUT SKIP LIST('SHOWV', S || '|', LENGTH(S));
 END SHOWV;
 END T178VST;
