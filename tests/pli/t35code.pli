 T35CODE: PROC OPTIONS(MAIN);
   DCL X FIXED DEC(5);
   DCL N FIXED BIN(15) INIT(0);
   ON CONVERSION BEGIN;
     PUT SKIP LIST('CONV', ONCODE, ONSOURCE, ONCHAR);
     ONSOURCE = '9';
   END;
   ON ENDFILE(SYSIN) BEGIN;
     N = N + 1;
     PUT SKIP LIST('EOF', ONCODE, N);
     IF N = 1 THEN GO TO DONE;
   END;
   ON ERROR PUT SKIP LIST('ERR', ONCODE);
   GET LIST(X);
   PUT SKIP LIST('X', X);
   GET LIST(X);
   PUT SKIP LIST('X', X);
   GET LIST(X);
   PUT SKIP LIST('X', X);
 DONE:
   SIGNAL ENDFILE(SYSIN);
   PUT SKIP LIST('AFTER SIG EOF');
   SIGNAL CONVERSION;
   PUT SKIP LIST('AFTER SIG CONV', ONCODE);
   SIGNAL ERROR;
   PUT SKIP LIST('NOT REACHED');
 END T35CODE;
