 T266SRT: PROC OPTIONS(MAIN);
   /* PLISRTA (SC33-0006-7, CHAPTER 12; #233): SORTIN TO SORTOUT,
      THEN TWO FIELDS, ONE DESCENDING, WITH THE PREFIX TASK (TASKIN,
      TASKOUT, TASKWKNN).  THE PROGRAM READS EACH RESULT BACK, A FILE
      OF THE SORT'S DDNAME, NOT OPEN WHILE THE SORT RUNS */
   DCL RC FIXED BIN(31) INIT(-1);
   DCL STOR FIXED BIN(31) INIT(50000);
   DCL (SORTOUT, TASKOUT) FILE RECORD INPUT;
   DCL LINE CHAR(80);
   DCL EOF BIT(1) INIT('0'B);
   ON ENDFILE(SORTOUT) EOF = '1'B;
   ON ENDFILE(TASKOUT) EOF = '1'B;
   CALL PLISRTA(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', STOR, RC);
   PUT SKIP LIST('RETCODE', RC);
   READ FILE(SORTOUT) INTO(LINE);
   DO WHILE(EOF = '0'B);
     PUT SKIP LIST(SUBSTR(LINE, 1, 12));
     READ FILE(SORTOUT) INTO(LINE);
   END;
   CLOSE FILE(SORTOUT);
   RC = -1;
   EOF = '0'B;
   CALL PLISRTA(' SORT FIELDS=(10,1,CH,D,1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 60000, RC, 'TASK');
   PUT SKIP LIST('RETCODE', RC);
   READ FILE(TASKOUT) INTO(LINE);
   DO WHILE(EOF = '0'B);
     PUT SKIP LIST(SUBSTR(LINE, 1, 12));
     READ FILE(TASKOUT) INTO(LINE);
   END;
 END T266SRT;
