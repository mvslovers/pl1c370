 T93LAB: PROC OPTIONS(MAIN);
   DCL (L, L2) LABEL, LA(3) LABEL, G LABEL;
   DCL K FIXED BIN(15), Z FIXED BIN(15) INIT(0);
   L = A1; GO TO L;
   PUT SKIP LIST('SKIPPED');
 A1: PUT SKIP LIST('AT A1');
   L = A2;
   IF Z = 0 THEN GO TO L;
 A2: PUT SKIP LIST('AT A2');
   L2 = A3; L = L2; GO TO L;
   PUT SKIP LIST('SKIPPED 2');
 A3: PUT SKIP LIST('AT A3');
   LA(1) = B1; LA(2) = B2; LA(3) = B3;
   DO K = 3 TO 1 BY -1;
     GO TO LA(K);
 B1: PUT SKIP LIST('B1', K); GO TO NXT;
 B2: PUT SKIP LIST('B2', K); GO TO NXT;
 B3: PUT SKIP LIST('B3', K);
 NXT: END;
   G = OUT; CALL SUB;
   PUT SKIP LIST('NOT HERE');
 OUT: PUT SKIP LIST('OUT');
   CALL SUB2(OUT2);
   PUT SKIP LIST('NOT HERE 2');
 OUT2: PUT SKIP LIST('OUT2');
   L = REC;
   ON ZERODIVIDE BEGIN; PUT SKIP LIST('ZDIV'); GO TO L; END;
   K = 1 / Z;
   PUT SKIP LIST('NOT HERE 3');
 REC: PUT SKIP LIST('RECOVERED', K);
 SUB: PROC;
   PUT SKIP LIST('IN SUB');
   GO TO G;
 END SUB;
 SUB2: PROC(X);
   DCL X LABEL;
   PUT SKIP LIST('IN SUB2');
   GO TO X;
 END SUB2;
 END T93LAB;
