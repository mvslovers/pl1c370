 T231ABN: PROC OPTIONS(MAIN);
   /* AN ABNORMAL TERMINATION BY THE SYSTEM (D37: THE DATA SET OF
      OUT IS FULL, ONE TRACK, NO SECONDARY): IHE012I, NO ERROR OR
      FINISH ON-UNIT, THE ABEND GOES ON (JOB01328, JOB01330) */
   DCL OUT FILE STREAM OUTPUT, I FIXED BIN(31);
   DCL K FIXED BIN(15) INIT(0);
   ON ERROR BEGIN;
     K = K + 1;
     PUT SKIP LIST('ERROR ON-UNIT', K, ONCODE);
   END;
   ON FINISH PUT SKIP LIST('FINISH ON-UNIT');
   PUT SKIP LIST('START');
   DO I = 1 TO 100000;
     PUT FILE(OUT) SKIP LIST('A LINE THAT FILLS THE DATA SET', I);
   END;
   PUT SKIP LIST('NOT REACHED', I);
 END T231ABN;
