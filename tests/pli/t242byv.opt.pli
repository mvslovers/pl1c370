 PFUNCT: PROC(EFPLCOM,EFPLBARG,EFPLEARG,
  EFPLFB,EFPLARG,EFPLEVAL) OPTIONS(MAIN BYVALUE);
 /* FCONCAT (T226FCT) WITH OPTIONS(MAIN BYVALUE), PL/I FOR MVS & VM'S
    FORM (SC26-3114-01): EACH PARAMETER IS A WORD OF THE EFPL ITSELF,
    SO EFPLARG IS THE ADDRESS OF THE ARGUMENT TABLE AND EFPLEVAL THE
    ADDRESS OF THE WORD THAT HOLDS THE EVALUATION BLOCK'S */
 DCL (EFPLCOM, EFPLBARG, EFPLEARG, EFPLFB) FIXED BIN(31);
 DCL (EFPLARG, EFPLEVAL) PTR;
 DCL 1 ARGTABLE BASED(EFPLARG),
       2 ARGTABLE_ENTRY(10),
         3 ARGSTRING_PTR PTR,
         3 ARGSTRING_LENGTH FIXED BIN(31);
 DCL EVPTR PTR BASED(EFPLEVAL);
 DCL 1 EVALBLOCK BASED(EVPTR),
       2 EVALBLOCK_EVPAD1 FIXED BIN(31),
       2 EVALBLOCK_EVSIZE FIXED BIN(31),
       2 EVALBLOCK_EVLEN FIXED BIN(31),
       2 EVALBLOCK_EVPAD2 FIXED BIN(31),
       2 EVALBLOCK_EVDATA CHAR(256);
 DCL ARGSTRING CHAR(256) BASED(Q), Q PTR;
 DCL RESULT CHAR(256) BASED(ADDR_EVDATA), ADDR_EVDATA PTR;
 DCL (I, J) FIXED BIN(31), K FIXED BIN(31) INIT(1);
 ADDR_EVDATA = ADDR(EVALBLOCK_EVDATA);
 DO I = 1 BY 1 WHILE(ARGSTRING_LENGTH(I) > 0);
   J = ARGSTRING_LENGTH(I);
   Q = ARGSTRING_PTR(I);
   SUBSTR(RESULT,K,J) = SUBSTR(ARGSTRING,1,J);
   K = K + J;
 END;
 PUT SKIP LIST ('RESULT',SUBSTR(RESULT,1,K));
 EVALBLOCK_EVLEN = K;
 END;
