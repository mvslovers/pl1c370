 T87PICA: PROC OPTIONS(MAIN);
   DCL D FIXED DEC(15,5);
   DCL P0 PIC '99999';
   DCL P1 PIC '99999V';
   DCL P2 PIC '999V99';
   DCL P3 PIC 'V99999';
   DCL P4 PIC '99999';
   DCL P5 PIC '99999';
   DCL P6 PIC '999V99';
   DCL P7 PIC '9V9';
   DCL P8 PIC '99999';
   DCL P9 PIC 'ZZZ99';
   DCL P10 PIC 'ZZZ99';
   DCL P11 PIC 'ZZZ99';
   DCL P12 PIC 'ZZZZZ';
   DCL P13 PIC 'ZZZZZ';
   DCL P14 PIC 'ZZZ99';
   DCL P15 PIC 'ZZZV99';
   DCL P16 PIC 'ZZZV99';
   DCL P17 PIC 'ZZZVZZ';
   DCL P18 PIC '*****';
   DCL P19 PIC '*****';
   DCL P20 PIC '***V**';
   DCL P21 PIC 'YYYYY';
   DCL P22 PIC '9Y9Y9';
   D = 12345; P0 = D;
   PUT SKIP EDIT('99999', '|', P0, '|')(A(16), A, A, A);
   D = 12345; P1 = D;
   PUT SKIP EDIT('99999V', '|', P1, '|')(A(16), A, A, A);
   D = 12345; P2 = D;
   PUT SKIP EDIT('999V99', '|', P2, '|')(A(16), A, A, A);
   D = 12345; P3 = D;
   PUT SKIP EDIT('V99999', '|', P3, '|')(A(16), A, A, A);
   D = 1234567; P4 = D;
   PUT SKIP EDIT('99999', '|', P4, '|')(A(16), A, A, A);
   D = 123; P5 = D;
   PUT SKIP EDIT('99999', '|', P5, '|')(A(16), A, A, A);
   D = 123.45; P6 = D;
   PUT SKIP EDIT('999V99', '|', P6, '|')(A(16), A, A, A);
   D = 12345.67; P7 = D;
   PUT SKIP EDIT('9V9', '|', P7, '|')(A(16), A, A, A);
   D = 123.45; P8 = D;
   PUT SKIP EDIT('99999', '|', P8, '|')(A(16), A, A, A);
   D = 12345; P9 = D;
   PUT SKIP EDIT('ZZZ99', '|', P9, '|')(A(16), A, A, A);
   D = 00100; P10 = D;
   PUT SKIP EDIT('ZZZ99', '|', P10, '|')(A(16), A, A, A);
   D = 00000; P11 = D;
   PUT SKIP EDIT('ZZZ99', '|', P11, '|')(A(16), A, A, A);
   D = 00100; P12 = D;
   PUT SKIP EDIT('ZZZZZ', '|', P12, '|')(A(16), A, A, A);
   D = 00000; P13 = D;
   PUT SKIP EDIT('ZZZZZ', '|', P13, '|')(A(16), A, A, A);
   D = 1.23; P14 = D;
   PUT SKIP EDIT('ZZZ99', '|', P14, '|')(A(16), A, A, A);
   D = 1.23; P15 = D;
   PUT SKIP EDIT('ZZZV99', '|', P15, '|')(A(16), A, A, A);
   D = 12345; P16 = D;
   PUT SKIP EDIT('ZZZV99', '|', P16, '|')(A(16), A, A, A);
   D = 0; P17 = D;
   PUT SKIP EDIT('ZZZVZZ', '|', P17, '|')(A(16), A, A, A);
   D = 100; P18 = D;
   PUT SKIP EDIT('*****', '|', P18, '|')(A(16), A, A, A);
   D = 0; P19 = D;
   PUT SKIP EDIT('*****', '|', P19, '|')(A(16), A, A, A);
   D = 0.01; P20 = D;
   PUT SKIP EDIT('***V**', '|', P20, '|')(A(16), A, A, A);
   D = 100; P21 = D;
   PUT SKIP EDIT('YYYYY', '|', P21, '|')(A(16), A, A, A);
   D = 10203; P22 = D;
   PUT SKIP EDIT('9Y9Y9', '|', P22, '|')(A(16), A, A, A);
 END T87PICA;
