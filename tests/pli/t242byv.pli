 PFUNCT: PROC(EFPLCOM,EFPLBARG,EFPLEARG,
  EFPLFB,EFPLARG,EFPLEVAL) OPTIONS(MAIN);
 /* THE TWIN OF T242BYV.OPT.PLI (AS OF T226FCT.OPT.PLI) FOR PL/I (F):
    WITHOUT BYVALUE, WHICH PL/I (F) DOES NOT HAVE; LINKED WITH ENTRY
    IHESAPB, R1 TO THE MAIN PROCEDURE AS IT IS (JOB01267) */
 /* declarations */
 DCL 1 EFPLCOM FIXED BIN(31); /* reserved */
 DCL 1 EFPLBARG FIXED BIN(31); /* reserved */
 DCL 1 EFPLEARG FIXED BIN(31); /* reserved */
 DCL 1 EFPLFB FIXED BIN(31);  /* reserved */
 DCL 1 ARGTABLE BASED(P),
       2 ARGTABLE_ENTRY(10),
         3 ARGSTRING_PTR PTR, /* address of argument */
         3 ARGSTRING_LENGTH FIXED BIN(31); /* length of argument */
 DCL 1 EFPLEVAL PTR; /* pointer to address of EVALBLOCK */
 DCL 1 EVALBLOCK BASED(EFPLEVAL),
       2 EVALBLOCK_EVPAD1 FIXED BIN(31),
       2 EVALBLOCK_EVSIZE FIXED BIN(31),
       2 EVALBLOCK_EVLEN FIXED BIN(31),
       2 EVALBLOCK_EVPAD2 FIXED BIN(31),
       2 EVALBLOCK_EVDATA CHAR(256);
 DCL 1 SHVBLOCK, /* F: NO UNALIGNED PTR (IEM3181I) */
      2 SHVNEXT FIXED BIN(31) INIT(0),
      2 SHVUSER FIXED BIN(31) INIT(0),
      2 SHVCODE CHAR(1),
      2 SHVRET CHAR(1),
      2 FILLER CHAR(2),
      2 SHVBUFL FIXED BIN(31),
      2 SHVNAMA PTR,
      2 SHVNAML FIXED BIN(31),
      2 SHVVALA PTR,
      2 SHVVALL FIXED BIN(31);
 DCL 1 ARGSTRING CHAR(256) BASED(Q); /* F: IEM0603I ON PTR(I) */
 DCL 1 Q PTR;
 DCL 1 RESULT CHAR(256) BASED(ADDR_EVDATA); /* result data */
 DCL 1 P PTR;
 DCL 1 ADDR_EVDATA PTR;
 DCL 1 I FIXED BIN(31);
 DCL 1 J FIXED BIN(31);
 DCL 1 K FIXED BIN(31) INIT(1);
 DCL 1 VARNAME CHAR(8) INIT('CONCAT');
 /* execution code */
 ADDR_EVDATA = ADDR(EVALBLOCK_EVDATA);
 P = ADDR(EFPLARG);
 DO I = 1 BY 1 WHILE(ARGSTRING_LENGTH(I) > 0);
   J = ARGSTRING_LENGTH(I);
   Q = ARGSTRING_PTR(I);
   SUBSTR(RESULT,K,J) = SUBSTR(ARGSTRING,1,J);
   K = K + J;
 END;
 PUT SKIP LIST ('RESULT',SUBSTR(RESULT,1,K));
 EVALBLOCK_EVLEN = K;
 END;
