 T11MIX: PROC OPTIONS(MAIN);
    /* DECIMAL FRACTIONS IN BINARY ARITHMETIC, MULTI-BIT CONDITIONS, */
    /* COMPUTED STRINGS                                             */
    DCL I FIXED BIN(15) INIT(3);
    DCL K FIXED BIN(31);
    DCL D FIXED DEC(5,2) INIT(2.75);
    DCL V VARYING CHAR(20) INIT('AB');
    DCL W VARYING CHAR(20);
    DCL C CHAR(10) INIT('ABCDEFGHIJ');
    DCL F STATIC BIT(4) INIT('1001'B);
    DCL N FIXED BIN(15) INIT(4);
    PUT SKIP LIST('I+0.5', I + 0.5);
    PUT SKIP LIST('I*1.1', I * 1.1);
    PUT SKIP LIST('I+D', I + D);
    K = I * 1.1;    PUT SKIP LIST('K=I*1.1', K);
    K = D * I;      PUT SKIP LIST('K=D*I', K);
    PUT SKIP LIST('MAX', MAX(I, D), MIN(I/2, 1));
    IF ¬'10'B THEN PUT SKIP LIST('NOT 10 TRUE');
    IF '10'B & '01'B THEN PUT SKIP LIST('WRONG AND');
    ELSE PUT SKIP LIST('10 AND 01 FALSE');
    IF F THEN PUT SKIP LIST('F', F, ¬F);
    W = V || V || 'C';
    PUT SKIP LIST(W, LENGTH(W));
    W = SUBSTR(C, 2, N);
    PUT SKIP LIST(W, LENGTH(W));
    IF SUBSTR(C, 1, 2) = V THEN PUT SKIP LIST('SUBSTR EQ');
    IF 'X' || I > 'X' THEN PUT SKIP LIST('CAT CMP');
    W = I * 100;
    PUT SKIP LIST(W, LENGTH(W));
    PUT SKIP LIST('INDEX', INDEX(C || 'XYZ', 'JX'));
 END T11MIX;
