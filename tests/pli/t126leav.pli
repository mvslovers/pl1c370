 T126LEA: PROC OPTIONS(MAIN);
   DCL (I, J, N) FIXED BIN(31), S CHAR(100) VARYING;
   DCL 1 E BASED(P), 2 V FIXED BIN(31), 2 NX PTR;
   DCL (P, HEAD, LAST) PTR;
   /* the expansions of GC33-0009-4 (DO statement, section J) */
   DO I = 1 TO 10;
     IF I = 4 THEN GO TO L1;
     PUT SKIP LIST('LOOP', I);
   END;
 L1: PUT SKIP LIST('AFTER', I);
   DO I = 1 TO 3;
     DO J = 1 TO 3;
       IF J = 2 THEN GO TO L2;
       IF I = 3 THEN GO TO L3;
       PUT SKIP LIST('INNER', I, J);
     END;
 L2: PUT SKIP LIST('OUTER', I);
   END;
 L3: PUT SKIP LIST('LEFT A', I, J);
   PUT SKIP LIST('GROUP');
   N = 0;
 U1: N = N + 2;
   IF N > 5 THEN; ELSE GO TO U1;
   PUT SKIP LIST('UNTIL', N);
   N = 10;
 U2: N = N + 1;
   IF N > 5 THEN; ELSE GO TO U2;
   PUT SKIP LIST('AT LEAST ONCE', N);
 U3: IF N < 40 THEN; ELSE GO TO U4;
   N = N + 1;
   IF MOD(N, 7) = 0 THEN; ELSE GO TO U3;
 U4: PUT SKIP LIST('WHILE UNTIL', N);
   I = 1;
 T1: IF I > 10 THEN GO TO T2;
   IF I * I > 30 THEN GO TO T2;
   I = I + 1;
   GO TO T1;
 T2: PUT SKIP LIST('TO UNTIL', I);
   S = '';
   I = 1;
 R1: S = S || CHAR(I);
   IF I = 64 THEN GO TO R2;
   I = 2 * I;
   GO TO R1;
 R2: PUT SKIP LIST('REPEAT', S, I);
   S = '';
   I = 1;
 R3: IF I < 100 THEN; ELSE GO TO R4;
   S = S || CHAR(I);
   I = I * 3;
   GO TO R3;
 R4: PUT SKIP LIST('REPEAT WHILE', S, I);
   S = '';
   DO I = 1 TO 3;
     S = S || CHAR(I);
   END;
   I = 10;
 R5: S = S || CHAR(I);
   IF I >= 20 THEN GO TO R6;
   I = I + 5;
   GO TO R5;
 R6: PUT SKIP LIST('SPECS', S, I);
   HEAD = NULL;
   DO I = 1 TO 4;
     ALLOCATE E SET(P);
     P->V = I * 100;
     P->NX = NULL;
     IF HEAD = NULL THEN HEAD = P;
     ELSE LAST->NX = P;
     LAST = P;
   END;
   P = HEAD;
 C1: IF P ¬= NULL THEN; ELSE GO TO C2;
   PUT SKIP LIST('CHAIN', P->V);
   P = P->NX;
   GO TO C1;
 C2: DO I = 1 TO 5;
     IF I = 3 THEN GO TO S1;
     PUT SKIP LIST('SELECT IN DO', I);
   END;
 S1: PUT SKIP LIST('END', I);
 END T126LEA;
