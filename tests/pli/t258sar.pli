 T258SAR: PROC OPTIONS(MAIN);
   /* TIER 101: A STRUCTURE AS AN ARGUMENT TO PROCEDURES COMPILED
      APART, WITH A STRUCTURE DESCRIPTOR AND WITHOUT ONE (#273;
      T258SAR.SEP) */
   DCL PSUB ENTRY(CHAR(*) VARYING, 1, 2 FIXED BIN(15), 2 BIT(9))
     RETURNS(FIXED BIN(15));
   DCL QSUB ENTRY RETURNS(FIXED BIN(15));
   DCL 1 CMD, 2 N FIXED BIN(15) INIT(5), 2 B BIT(9) INIT('101'B);
   DCL 1 T(2), 2 X FIXED BIN(31) INIT(1, 2),
         2 Y CHAR(3) INIT('AB', 'CD');
   DCL TXT CHAR(10) VARYING INIT('HELLO'), RC FIXED BIN(15);
   RC = PSUB(TXT, CMD);
   PUT SKIP LIST(RC, N, B);
   RC = QSUB(CMD, T(2));
   PUT SKIP LIST(RC, N, B, X(2), Y(2));
 END T258SAR;
*PROCESS;
 PSUB: PROC(S, C) RETURNS(FIXED BIN(15));
   DCL S CHAR(*) VARYING, 1 C, 2 N FIXED BIN(15), 2 B BIT(9);
   PUT SKIP LIST('PSUB', S, N, B);
   N = N + LENGTH(S);
   B = '111'B;
   RETURN(N * 2);
 END PSUB;
*PROCESS;
 QSUB: PROC(C, E) RETURNS(FIXED BIN(15));
   DCL 1 C, 2 N FIXED BIN(15), 2 B BIT(9);
   DCL 1 E, 2 X FIXED BIN(31), 2 Y CHAR(3);
   PUT SKIP LIST('QSUB', N, B, X, Y);
   N = 0; X = 99; Y = 'ZZ';
   RETURN(-1);
 END QSUB;
