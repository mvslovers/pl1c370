 T85DEF: PROC OPTIONS(MAIN);
   DCL S CHAR(10) INIT('ABCDEFGHIJ');
   DCL T CHAR(4) DEFINED S;
   DCL U CHAR(3) DEFINED S POSITION(5);
   DCL W CHAR(1) DEF S POS(10);
   DCL B BIT(16) INIT('1100101011110000'B);
   DCL C BIT(4) DEFINED B POSITION(9);
   DCL M(3,3) FIXED BIN(15);
   DCL G(3) FIXED BIN(15) DEFINED M(1SUB,1SUB);
   DCL TR(3,3) FIXED BIN(15) DEFINED M(2SUB,1SUB);
   DCL R2(3) FIXED BIN(15) DEFINED M(2,1SUB);
   DCL K(3,3) FIXED BIN(15) DEFINED M;
   DCL (I, J) FIXED BIN(15);
   PUT SKIP LIST(T, U, W, C);
   T = 'WXYZ'; U = '123'; W = '*';
   PUT SKIP LIST(S);
   C = '0000'B; PUT SKIP LIST(B);
   B = '1111111111111111'B; C = '0101'B; PUT SKIP LIST(B, C);
   DO I = 1 TO 3; DO J = 1 TO 3; M(I,J) = 10 * I + J; END; END;
   PUT SKIP LIST(G); PUT SKIP LIST(R2);
   PUT SKIP LIST(TR);
   G(2) = 0; TR(1,3) = -1; K(3,3) = 99;
   PUT SKIP LIST(M);
   PUT SKIP DATA(M);
 END T85DEF;
