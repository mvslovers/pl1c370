 T116REG: PROC OPTIONS(MAIN);
   DCL REG FILE RECORD KEYED ENV(REGIONAL(1));
   DCL REC CHAR(20), K FIXED BIN(31), KC CHAR(8), N FIXED BIN(31);
   DCL (D, Z) FIXED BIN(31), B BIT(8), TT CHAR(8);
   ON KEY(REG) BEGIN;
     PUT SKIP LIST('KEY', ONCODE);
     Z = Z + 1;
   END;
   Z = 0;
   OPEN FILE(REG) SEQUENTIAL OUTPUT;
   K = 0; CALL WR;
   K = 2; CALL WR;
   K = 5; CALL WR;
   K = 3; CALL WR;
   K = 5; CALL WR;
   K = 7; CALL WR;
   CLOSE FILE(REG);
   TT = 'CREATED'; CALL LIST;
   OPEN FILE(REG) DIRECT INPUT;
   DO K = 0 TO 3;
     CALL RD;
   END;
   K = 99999999; CALL RD;
   K = 123456; CALL RD;
   CLOSE FILE(REG);
   OPEN FILE(REG) DIRECT UPDATE;
   REC = 'REWRITTEN 2';
   REWRITE FILE(REG) FROM(REC) KEY(2);
   REC = 'WRITTEN 4';
   WRITE FILE(REG) FROM(REC) KEYFROM(4);
   DELETE FILE(REG) KEY(5);
   REC = 'KEYS';
   READ FILE(REG) INTO(REC) KEY(' 7');
   PUT SKIP LIST('CHAR KEY', REC);
   READ FILE(REG) INTO(REC) KEY('X7');
   CLOSE FILE(REG);
   TT = 'UPDATED'; CALL LIST;
   OPEN FILE(REG) SEQUENTIAL UPDATE;
   READ FILE(REG) INTO(REC);
   READ FILE(REG) INTO(REC);
   REC = 'SEQ REWRITE';
   REWRITE FILE(REG) FROM(REC);
   CLOSE FILE(REG);
   TT = 'SEQUPD'; CALL LIST;
   OPEN FILE(REG) DIRECT OUTPUT;
   REC = 'DIRECT 3';
   WRITE FILE(REG) FROM(REC) KEYFROM(3);
   REC = 'DIRECT 1';
   WRITE FILE(REG) FROM(REC) KEYFROM(1);
   CLOSE FILE(REG);
   TT = 'DIRECT'; CALL LIST;
   SIGNAL KEY(REG);
 WR: PROC;
   REC = 'RECORD' || CHAR(K);
   WRITE FILE(REG) FROM(REC) KEYFROM(K);
 END WR;
 RD: PROC;
   REC = (20)'?';
   READ FILE(REG) INTO(REC) KEY(K);
   B = UNSPEC(SUBSTR(REC, 1, 1));
   PUT SKIP LIST('READ', K, B, SUBSTR(REC, 2, 12));
 END RD;
 LIST: PROC;
   N = 0;
   D = 0;
   OPEN FILE(REG) SEQUENTIAL INPUT;
   ON ENDFILE(REG) GO TO EOF;
   DO WHILE('1'B);
     READ FILE(REG) INTO(REC) KEYTO(KC);
     N = N + 1;
     B = UNSPEC(SUBSTR(REC, 1, 1));
     IF B = '11111111'B THEN D = D + 1;
     ELSE PUT SKIP LIST(TT, KC, REC);
   END;
 EOF:
   CLOSE FILE(REG);
   PUT SKIP LIST(TT, N, D);
 END LIST;
 END T116REG;
