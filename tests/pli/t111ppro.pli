 T111PPR: PROC OPTIONS(MAIN);
   %DECLARE A CHARACTER, N FIXED;
   %DECLARE VALUE ENTRY(CHARACTER, FIXED) RETURNS(CHARACTER);
   %DECLARE TWICE ENTRY(FIXED) RETURNS(FIXED);
   %DECLARE MAX2 ENTRY(FIXED, FIXED) RETURNS(FIXED);
   DCL Z(10) FIXED BIN(31), (Q, R) FIXED BIN(31);
   %A = 'Z';
   Z(3) = 4;
   Q = 6 + VALUE(A, 3);
   PUT SKIP LIST('Q', Q);
   %N = TWICE(21);
   R = N + TWICE(2); PUT SKIP LIST('R', R);
   R = MAX2(7, TWICE(5)); PUT SKIP LIST('MAX', R);
   %VALUE: PROCEDURE(ARG1, ARG2) RETURNS(CHARACTER);
     DECLARE ARG1 CHARACTER, ARG2 FIXED;
     RETURN(ARG1 || '(' || ARG2 || ')');
   %END VALUE;
   %TWICE: PROC(X) RETURNS(FIXED);
     DECLARE X FIXED;
     RETURN(X + X);
   %END TWICE;
   %MAX2: PROC(U, V) RETURNS(FIXED);
     DECLARE (U, V) FIXED;
     IF U > V THEN RETURN(U);
     RETURN(V);
   %END;
 END T111PPR;
