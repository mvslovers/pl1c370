 T197REF: PROC OPTIONS(MAIN);
   DCL 1 S BASED(P), 2 N FIXED BIN(31), 2 A(M REFER(N)) FIXED BIN(31);
   DCL 1 T BASED(Q), 2 L FIXED BIN(31), 2 C CHAR(K REFER(L));
   DCL 1 R BASED(U), 2 H FIXED BIN(31), 2 D, 3 E FIXED BIN(31),
         3 F(0:J REFER(D.E), 2) CHAR(2);
   DCL (M, K, J) FIXED BIN(31), I FIXED BIN(15), (P, P2, Q, U) PTR;
   M = 5;
   ALLOCATE S;
   PUT SKIP LIST(N, HBOUND(A, 1), DIM(A, 1), LBOUND(A, 1));
   DO I = 1 TO N; A(I) = I * I; END;
   PUT SKIP LIST(A);
   N = 3;
   PUT SKIP LIST(A, SUM(A), HBOUND(A, 1));
   N = 5;
   M = 2;
   ALLOCATE S SET(P2);
   P2->A = 7;
   PUT SKIP LIST(P->N, P2->N, P2->A, P->A(5));
   K = 7;
   ALLOCATE T;
   C = 'ABCDEFGHIJ';
   PUT SKIP LIST(L, C, LENGTH(C));
   L = 3;
   PUT SKIP LIST(C, LENGTH(C), C || '|');
   C = 'XY';
   L = 7;
   PUT SKIP LIST(C || '|');
   J = 2;
   ALLOCATE R;
   H = 99;
   DO I = 0 TO 2;
     F(I, 1) = 'A' || CHAR(I);
     F(I, 2) = 'B' || CHAR(I);
   END;
   PUT SKIP LIST(H, E, HBOUND(F, 1), HBOUND(F, 2));
   PUT SKIP LIST(F);
   FREE S; FREE P2->S; FREE T; FREE R;
   PUT SKIP LIST('DONE');
 END T197REF;
