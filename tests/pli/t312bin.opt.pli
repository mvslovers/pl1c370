 T312BI: PROC OPTIONS(MAIN);
   /* INITIAL ON BASED VARIABLES: APPLIED AT ALLOCATE AND LOCATE,
      THROUGH THE POINTER SET OR THE BASED ATTRIBUTE'S OWN */
   DCL (P, Q, R) POINTER;
   DCL X FIXED BIN(31) BASED(P) INIT(42);
   DCL A(4) FIXED DEC(5,1) BASED(P) INIT(1.5, (2)2.5, 9);
   DCL 1 S BASED(P),
         2 N CHAR(4) INIT('ABCD'),
         2 V(4) FIXED BIN(15) INIT((4)7),
         2 W FLOAT DEC(6);
   DCL REPORT FILE RECORD OUTPUT;
   ALLOCATE X;
   PUT SKIP LIST(X);
   X = 1;
   ALLOCATE X SET(Q);
   PUT SKIP LIST(X, Q -> X);
   ALLOCATE A SET(R);
   PUT SKIP LIST(R -> A);
   ALLOCATE S SET(Q);
   Q -> W = 0;
   PUT SKIP LIST(Q -> N, Q -> V, Q -> W);
   OPEN FILE(REPORT);
   LOCATE S FILE(REPORT) SET(R);
   R -> W = 1;
   PUT SKIP LIST(R -> N, R -> V);
   CLOSE FILE(REPORT);
 END T312BI;
