 T61GDAT: PROC OPTIONS(MAIN);
   DCL REPORT FILE STREAM OUTPUT;
   DCL 1 R, 2 X FIXED DEC(5,1) INIT(0), 2 Y CHAR(4) INIT(''),
         2 Z FLOAT DEC(6) INIT(0);
   DCL B BIT(4) INIT('0000'B), V CHAR(10) VAR INIT('');
   DCL C CHAR(40), K FIXED BIN(15) INIT(0);
   ON ENDFILE(SYSIN) BEGIN;
     PUT SKIP LIST('EOF', K);
     GO TO DONE;
   END;
   GET DATA(R, B, V);
   PUT SKIP DATA(R, B, V);
   GET DATA(R);
   PUT SKIP DATA(R);
   C = 'K=12, R.Y=''XY'';';
   GET STRING(C) DATA(K, R);
   PUT SKIP DATA(K, R.Y);
   PUT FILE(REPORT) DATA(K, R.X);
   PUT FILE(REPORT) SKIP DATA(V);
   GET DATA(K);
   PUT SKIP LIST('NOT REACHED');
 DONE:
   PUT SKIP LIST('DONE');
 END T61GDAT;
