 T300RNM: PROC OPTIONS(MAIN);
   /* ROUND IN THE DEFAULT LANGUAGE: PL/I FOR MVS & VM'S PRECISION
      (MAX(1,MIN(P-Q+1+Y,N)),Y); THE .PLI SPELLS IT OUT FOR F */
   DCL X FIXED DEC(5,4) INIT(6.6666);
   DCL Y FIXED DEC(7,2) INIT(-12345.67);
   DCL B FIXED BIN(31,8) INIT(5.6875);
   DCL C FIXED BIN(15,4) INIT(-2.8125);
   PUT SKIP LIST(ROUND(X,2), ROUND(Y,0), ROUND(Y,1));
   PUT SKIP LIST(ROUND(B,2), ROUND(C,1), ROUND(X,6));
 END T300RNM;
