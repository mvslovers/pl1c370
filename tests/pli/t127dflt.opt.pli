 T127DFT: PROC OPTIONS(MAIN);
   DEFAULT RANGE(A:C) FIXED BINARY;
   DCL A1, B2 FIXED, C3 DECIMAL;
   DEFAULT RANGE(S) VARYING VALUE(CHARACTER(10));
   DCL S1 CHAR, S2 CHAR(3), S3 BIT;
   DEFAULT RANGE(PREC) VALUE(FIXED DECIMAL(9,3), FLOAT DECIMAL(12));
   DCL PRECA FIXED, PRECB FLOAT, PRECC FIXED BINARY;
   DCL XP, XQ FIXED;
   DEFAULT RANGE(X) POINTER, (RANGE(G), RANGE(H)) FLOAT BINARY;
   DCL G1, H1 FIXED;
   A1 = 7.9;
   B2 = -30000;
   C3 = 2.5;
   PUT SKIP LIST('A', A1, B2, C3);
   S1 = 'ABCDEFGHIJKLMNOP';
   S2 = 'XYZW';
   S3 = '101'B;
   PUT SKIP LIST('S', S1, LENGTH(S1), S2, LENGTH(S2), S3, LENGTH(S3));
   PRECA = 1 / 3;
   PRECB = 1E0 / 3;
   PRECC = 12345;
   PUT SKIP LIST('PREC', PRECA, PRECB, PRECC);
   XP = ADDR(A1);
   XQ = 4.5;
   PUT SKIP LIST('X', XP = ADDR(A1), XQ);
   G1 = 1E0 / 3;
   H1 = 3.7;
   PUT SKIP LIST('G H', G1, H1);
   BETA = 3.9;
   ZETA = 3.9;
   PUT SKIP LIST('IMPLICIT', BETA, ZETA);
   CALL INNER;
 INNER: PROC;
   DEFAULT RANGE(A) FLOAT;
   DCL A9, B9;
   A9 = 1E0 / 3;
   B9 = 2.6;
   PUT SKIP LIST('INNER', A9, B9);
 END INNER;
 END T127DFT;
