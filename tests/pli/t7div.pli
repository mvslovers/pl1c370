 P4DIV: PROC OPTIONS(MAIN);
    /* DIVISION: DECIMAL AND BINARY PRECISION, SCALED BINARY RESULTS */
    DCL (A,B) FIXED DEC(5,2);
    DCL D72 FIXED DEC(7,2);
    DCL D50 FIXED DEC(5,0);
    DCL (I,J) FIXED BIN(15);
    DCL (K,L) FIXED BIN(31);
    A = 10; B = 3;
    PUT SKIP LIST('A/B', A/B);
    D72 = A/B;  PUT SKIP LIST('D72=A/B', D72);
    PUT SKIP LIST('7/2', 7/2);
    PUT SKIP LIST('1/3', 1/3);
    PUT SKIP LIST('-7/2', -7/2);
    I = 7; J = 2;
    PUT SKIP LIST('I/J', I/J);
    K = I/J;    PUT SKIP LIST('K=I/J', K);
    I = -7;
    PUT SKIP LIST('-I/J', I/J);
    K = I/J;    PUT SKIP LIST('K=-I/J', K);
    K = 1000; L = 7;
    PUT SKIP LIST('K/L', K/L);
    PUT SKIP LIST('J/K', J/K);
    D50 = 100;
    PUT SKIP LIST('D50/J', D50/J);
    D72 = I/J;  PUT SKIP LIST('D72=I/J', D72);
    PUT SKIP LIST('I/3', I/3);
    PUT SKIP LIST('A/2', A/2);
    PUT SKIP LIST('(A+B)/B', (A+B)/B);
 END P4DIV;
