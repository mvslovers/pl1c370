 T137RG3: PROC OPTIONS(MAIN);
   /* REGIONAL(3): a region is a track; WRITE takes the first dummy
      record from the start of the track on, over the whole data set */
   DCL REG FILE RECORD KEYED ENV(REGIONAL(3));
   DCL REC CHAR(20), KC CHAR(12), N FIXED BIN(31);
   DCL (I, STOPW) FIXED BIN(31), P PIC'99999999';
   DCL KS(7) CHAR(12) INIT('AAAA00000000', 'BBBB00000000',
     'CCCC00000001', 'DDDD00000000', 'EEEE00000001', 'BBBB00000001',
     'FFFF00000002');
   ON KEY(REG) BEGIN;
     PUT SKIP LIST('KEY', ONCODE);
     IF ONCODE ¬= 51 THEN STOPW = 1;
   END;
   OPEN FILE(REG) SEQUENTIAL OUTPUT;
   DO I = 1 TO 7;
     REC = 'REC ' || KS(I);
     WRITE FILE(REG) FROM(REC) KEYFROM(KS(I));
   END;
   CLOSE FILE(REG);
   CALL LIST('CREATED');
   OPEN FILE(REG) DIRECT INPUT;
   CALL RD('BBBB00000000');
   CALL RD('BBBB00000001');
   CALL RD('CCCC00000000');
   CALL RD('AAAA00000001');
   CALL RD('FFFF00000002');
   CALL RD('FFFF00000003');
   CALL RD('GGGG00000002');
   CLOSE FILE(REG);
   OPEN FILE(REG) DIRECT UPDATE;
   DELETE FILE(REG) KEY('AAAA00000000');
   REC = 'NEW GGGG';
   WRITE FILE(REG) FROM(REC) KEYFROM('GGGG00000000');
   REC = 'REWR EEEE';
   REWRITE FILE(REG) FROM(REC) KEY('EEEE00000001');
   STOPW = 0;
   DO I = 1 TO 200 WHILE(STOPW = 0);
     P = I;
     REC = 'F' || P;
     WRITE FILE(REG) FROM(REC) KEYFROM('XXXX00000001');
   END;
   PUT SKIP LIST('LAST I', I);
   CALL RD('XXXX00000001');
   CALL RD('XXXX00000002');
   CALL RD('XXXX00000000');
   CALL RD('FFFF00000000');
   CLOSE FILE(REG);
   CALL LIST('UPDATED');
   OPEN FILE(REG) SEQUENTIAL UPDATE;
   READ FILE(REG) INTO(REC) KEYTO(KC);
   REC = 'SEQ REWRITE';
   REWRITE FILE(REG) FROM(REC);
   CLOSE FILE(REG);
   OPEN FILE(REG) DIRECT INPUT;
   CALL RD('GGGG00000002');
   CLOSE FILE(REG);
   OPEN FILE(REG) DIRECT OUTPUT;
   REC = 'DIRECT 1';
   WRITE FILE(REG) FROM(REC) KEYFROM('JJJJ00000001');
   REC = 'DIRECT 1B';
   WRITE FILE(REG) FROM(REC) KEYFROM('KKKK00000001');
   CLOSE FILE(REG);
   CALL LIST('DIRECT');
 RD: PROC(K);
   DCL K CHAR(*);
   REC = (20)'?';
   READ FILE(REG) INTO(REC) KEY(K);
   PUT SKIP LIST('READ', K, REC);
 END RD;
 LIST: PROC(T);
   DCL T CHAR(*);
   N = 0;
   OPEN FILE(REG) SEQUENTIAL INPUT;
   ON ENDFILE(REG) GO TO EOF;
   DO WHILE('1'B);
     KC = (12)'?';
     READ FILE(REG) INTO(REC) KEYTO(KC);
     N = N + 1;
     IF N < 4 | N > 54 & N < 61 | N > 111 & N < 118 | N > 168 THEN
       PUT SKIP LIST(T, N, '<' || KC || '>', REC);
   END;
 EOF:
   CLOSE FILE(REG);
   PUT SKIP LIST(T, N);
 END LIST;
 END T137RG3;
