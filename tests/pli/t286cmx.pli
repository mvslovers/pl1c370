 T286CMX: PROC OPTIONS(MAIN);
   /* COMPLEX FLOAT * AND / (#2), CONTINUED: THE TARGET IN ITS OWN
      SOURCE, IF AND DO WHILE, ARRAYS, A STRUCTURE MEMBER; HOW OFTEN
      OVERFLOW, UNDERFLOW AND ZERODIVIDE ARE RAISED */
   DCL (A,B,C) COMPLEX FLOAT DEC(6);
   DCL (D,E,F) COMPLEX FLOAT DEC(16);
   DCL ZA(3) COMPLEX FLOAT DEC(6) INIT(1+2I, -0.5I, 3);
   DCL ZB(3) COMPLEX FLOAT DEC(6) INIT(2-1I, 4+4I, 0.25+0.5I);
   DCL 1 S, 2 N CHAR(1), 2 Z COMPLEX FLOAT BIN(21);
   DCL X FLOAT DEC(6) INIT(2.5);
   DCL Y FLOAT DEC(6);
   DCL I FIXED BIN(15);
   DCL (NO, NU, NZ) FIXED BIN(15) INIT(0);
   ON OVERFLOW NO = NO + 1;
   ON UNDERFLOW NU = NU + 1;
   ON ZERODIVIDE NZ = NZ + 1;
   A = 0.1+0.7I; B = 0.3+0.9I; D = 0.1+0.7I; E = 0.3+0.9I;
   C = D*E; PUT SKIP LIST(C);
   A = A*B; PUT SKIP LIST(A);
   B = A/B; PUT SKIP LIST(B);
   A = B/A; PUT SKIP LIST(A);
   IF A*B = B*A THEN PUT SKIP LIST('EQUAL');
   IF A*B ¬= A/B THEN PUT SKIP LIST('NOT EQUAL');
   C = 1+1I; I = 0;
   DO WHILE(REAL(C*C) < 1000);
     C = C*(1.5+0.5I);
     I = I + 1;
   END;
   PUT SKIP LIST(I, C);
   DO I = 1 TO 3;
     ZA(I) = ZA(I)*ZB(I) + ZA(I)/ZB(I);
   END;
   PUT SKIP LIST(ZA);
   S.N = 'S';
   S.Z = 0.75-1.25I;
   S.Z = S.Z*S.Z/(1+1I);
   PUT SKIP LIST(S.Z, REAL(S.Z*2I), IMAG(ZB(2)/ZB(3)));
   Y = REAL(A*B) + IMAG(A/B);
   PUT SKIP LIST(Y);
   A = 1E40+1E40I; B = 1E40+1E40I;
   PUT SKIP LIST(A/B);
   B = 1E40-1E39I;
   PUT SKIP LIST(A/B);
   A = 1E-40+1E-40I; B = 1E-40+3E-40I;
   PUT SKIP LIST(A/B);
   A = 1E50+1E50I;
   C = A*A; PUT SKIP LIST('OVERFLOW', NO);
   A = 1E-50+1E-50I;
   C = A*A; PUT SKIP LIST('UNDERFLOW', NU, C);
   A = 1+1I; B = 0;
   C = A/B; PUT SKIP LIST('ZERODIVIDE', NZ);
   D = 1+1I; E = 0;
   F = D/E; PUT SKIP LIST('ZERODIVIDE', NZ);
   X = 0;
   C = A/X; PUT SKIP LIST('ZERODIVIDE', NZ);
 END T286CMX;
