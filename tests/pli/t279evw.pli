 T279EVW: PROC OPTIONS(MAIN);
   /* WAIT ON AN INCOMPLETE EVENT THAT NOTHING WILL COMPLETE (#3):
      IHE550I, THEN ERROR WITH ONCODE 3900 (T228 Q2EVT) */
   DCL E EVENT;
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE);
     STOP;
   END;
   PUT SKIP LIST('BEFORE');
   WAIT(E);
   PUT SKIP LIST('AFTER');
 END T279EVW;
