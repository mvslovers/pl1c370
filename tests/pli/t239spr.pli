 T239SPR: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T239SPR.OPT.PLI: THE VALUES SC26-3114-01
      GIVES THE POINTER OPERATIONS */
   DCL A(4) FIXED BIN(31) INIT(10, 20, 30, 40), N FIXED BIN(31);
   PUT SKIP LIST(A(3));
   PUT SKIP LIST(A(2));
   PUT SKIP LIST(A(4));
   PUT SKIP LIST(A(2));
   N = 4;  PUT SKIP LIST(N);
   PUT SKIP LIST('1'B, '0'B, '1'B, '1'B);
   PUT SKIP LIST('1'B);
 END T239SPR;
