 T103UPD: PROC OPTIONS(MAIN);
   DCL H FILE RECORD OUTPUT, G FILE RECORD SEQUENTIAL UPDATE;
   DCL REC CHAR(12), (I, N) FIXED BIN(15), EOF BIT(1) INIT('0'B);
   OPEN FILE(H) TITLE('REPORT');
   DO I = 1 TO 4;
     REC = SUBSTR('ABCDEFGHIJKL', I, 3) || '-ORIGINAL';
     WRITE FILE(H) FROM(REC);
   END;
   CLOSE FILE(H);
   OPEN FILE(G) TITLE('REPORT');
   ON ENDFILE(G) EOF = '1'B;
   N = 0;
   READ FILE(G) INTO(REC);
   DO WHILE(¬EOF);
     N = N + 1;
     REC = SUBSTR(REC, 1, 4) || 'UPDATED' || SUBSTR('12345', N, 1);
     REWRITE FILE(G) FROM(REC);
     READ FILE(G) INTO(REC);
   END;
   CLOSE FILE(G);
   PUT SKIP LIST('RECORDS', N);
 END T103UPD;
