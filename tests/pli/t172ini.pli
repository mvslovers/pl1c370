 T172INI: PROC OPTIONS(MAIN);
   DCL S1 CHAR(8) INIT((3)'AB');
   DCL S3 CHAR(8) VARYING INIT((3)'AB');
   DCL S4 CHAR(8) STATIC INIT((3)'AB');
   DCL B1 BIT(8) INIT((4)'1'B);
   DCL B2 BIT(8) STATIC INIT((4)'10'B);
   PUT SKIP LIST(S1 || '|', S3 || '|', LENGTH(S3));
   PUT SKIP LIST(S4 || '|', B1, B2);
 END T172INI;
