 T105UND: PROC OPTIONS(MAIN);
   DCL NODD FILE RECORD INPUT, R FILE RECORD;
   DCL BUF CHAR(20), SHORT CHAR(4), LONG CHAR(40);
   DCL N FIXED BIN(15) INIT(0);
   LONG = (40)'*';
   ON UNDEFINEDFILE(NODD) BEGIN;
     N = N + 1;
     PUT SKIP LIST('UNDF', ONCODE, ONFILE, N);
     GO TO NEXT;
   END;
   OPEN FILE(NODD);
   PUT SKIP LIST('NOT HERE');
 NEXT: PUT SKIP LIST('AFTER UNDF');
   OPEN FILE(R) OUTPUT TITLE('REPORT');
   BUF = 'TWENTY CHARACTERS..';
   WRITE FILE(R) FROM(BUF); WRITE FILE(R) FROM(BUF);
   CLOSE FILE(R);
   ON RECORD(R) PUT SKIP LIST('RECORD', ONCODE, ONFILE);
   OPEN FILE(R) INPUT TITLE('REPORT');
   READ FILE(R) INTO(SHORT); PUT SKIP LIST(SHORT);
   READ FILE(R) INTO(LONG); PUT SKIP LIST(LONG);
   CLOSE FILE(R);
   REVERT RECORD(R);
   OPEN FILE(R) INPUT TITLE('REPORT');
   READ FILE(R) INTO(SHORT); PUT SKIP LIST('NO UNIT', SHORT);
   CLOSE FILE(R);
   OPEN FILE(NODD);
   PUT SKIP LIST('END');
 END T105UND;
