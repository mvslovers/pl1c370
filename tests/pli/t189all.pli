 T189ALL: PROC OPTIONS(MAIN);
   DCL S(3) BIT(4) INIT('1100'B, '1010'B, '1110'B);
   DCL T(2) BIT(40) INIT('1'B, '11'B);
   DCL V(3) BIT(8) VARYING INIT('1'B, '101'B, '11111'B);
   DCL N(3) FIXED BIN(15) INIT(7, 5, 13);
   DCL C(2) CHAR(3) INIT('101', '111');
   DCL B BIT(8) VARYING;
   PUT SKIP LIST(ALL(S), ANY(S));
   PUT SKIP LIST(ALL(T), ANY(T));
   PUT SKIP LIST(ALL(V), ANY(V));
   PUT SKIP LIST(ALL(N), ANY(N));
   PUT SKIP LIST(ALL(C), ANY(C));
   B = ANY(V);
   PUT SKIP LIST(LENGTH(B), LENGTH(ALL(S)));
   IF ALL(S) THEN PUT SKIP LIST('ALL TRUE');
   ELSE PUT SKIP LIST('ALL FALSE');
   IF ANY(S) THEN PUT SKIP LIST('ANY TRUE');
   PUT SKIP LIST(ALL(S = '1100'B), ANY(S = '1100'B));
 END T189ALL;
