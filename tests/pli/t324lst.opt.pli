 T324LST: PROC OPTIONS(MAIN);
   /* TIER 128: AN INITIAL LIST OF MORE THAN 256 ITEMS, LOWER CASE
      HEXADECIMAL DIGITS, A LISTING CONTROL STATEMENT IN TEXT A
      PREPROCESSOR PROCEDURE RETURNS */
   DCL A(300) FIXED BIN(31) INIT((299)(7), 9);
   DCL B BIT(12) INIT('af0'b4);
 %DCL P ENTRY RETURNS(CHAR);
 %P: PROC RETURNS(CHAR);
   RETURN('PUT SKIP LIST(1); %PAGE; PUT SKIP LIST(2);');
 %END P;
 %ACTIVATE P;
   PUT SKIP LIST(A(1), A(256), A(299), A(300), SUM(A));
   PUT SKIP LIST(B, B & 'F0f'BX);
   P;
 END T324LST;
