 T100EFP: PROC OPTIONS(MAIN);
   DCL OUT FILE STREAM OUTPUT PRINT;
   DCL SQ ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL TWO ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL APPLY ENTRY(ENTRY, FIXED BIN(31));
   DCL TELL ENTRY(FILE, CHAR(5));
   CALL APPLY(SQ, 7);
   CALL APPLY(TWO, 7);
   CALL TELL(SYSPRINT, 'HELLO');
   OPEN FILE(OUT) TITLE('REPORT');
   CALL TELL(OUT, 'WORLD');
   CALL RUN(GREET);
   CLOSE FILE(OUT);
 SQ: PROC(N) RETURNS(FIXED BIN(31));
   DCL N FIXED BIN(31);
   RETURN(N * N);
 END SQ;
 TWO: PROC(N) RETURNS(FIXED BIN(31));
   DCL N FIXED BIN(31);
   RETURN(N + N);
 END TWO;
 APPLY: PROC(F, X);
   DCL F ENTRY RETURNS(FIXED BIN(31)), X FIXED BIN(31);
   PUT SKIP LIST('APPLY', X, F(X));
 END APPLY;
 TELL: PROC(G, S);
   DCL G FILE, S CHAR(5);
   PUT FILE(G) SKIP LIST('TELL', S);
 END TELL;
 GREET: PROC;
   PUT SKIP LIST('GREET');
 END GREET;
 RUN: PROC(E);
   DCL E ENTRY;
   CALL E;
 END RUN;
 END T100EFP;
