 T58PUTD: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31) INIT(42), D FIXED DEC(7,2) INIT(-3.5);
   DCL S CHAR(5) INIT('AB''CD'), V CHAR(8) VAR INIT('XY');
   DCL B BIT(4) INIT('1010'B), F FLOAT DEC(6) INIT(1.25);
   DCL A(3) FIXED BIN(15) INIT(1, 2, 3);
   DCL 1 R, 2 X FIXED DEC(3) INIT(7), 2 Y CHAR(2) INIT('QQ');
   PUT DATA(I, D, S);
   PUT SKIP DATA(V, B, F);
   PUT SKIP DATA(A);
   PUT SKIP DATA(A(2));
   PUT SKIP DATA(R);
   PUT SKIP DATA(R.X, Y);
   PUT SKIP DATA;
   PUT SKIP LIST('END');
 END T58PUTD;
