 T135LOC: PROC OPTIONS(MAIN);
   DCL REPORT FILE RECORD;
   DCL 1 R BASED(P), 2 K FIXED BIN(31), 2 T CHAR(12);
   DCL 1 S BASED(Q), 2 L FIXED BIN(15), 2 U CHAR(6);
   DCL (P, Q) PTR, I FIXED BIN(31), N FIXED BIN(31), X CHAR(16);
   OPEN FILE(REPORT) OUTPUT;
   DO I = 1 TO 3;
     LOCATE R FILE(REPORT) SET(P);
     P->K = I * 10;
     P->T = 'LOCATED ' || SUBSTR('ABC', I, 1);
   END;
   X = 'WRITTEN 1234567';
   WRITE FILE(REPORT) FROM(X);
   LOCATE S FILE(REPORT);
   Q->L = 99;
   Q->U = 'SHORT';
   CLOSE FILE(REPORT);
   OPEN FILE(REPORT) INPUT;
   ON ENDFILE(REPORT) GO TO EOF;
   DO N = 1 TO 3;
     READ FILE(REPORT) SET(P);
     PUT SKIP LIST(N, P->K, P->T);
   END;
   READ FILE(REPORT) INTO(X);
   PUT SKIP LIST('INTO', X);
   READ FILE(REPORT) SET(Q);
   PUT SKIP LIST('LAST', Q->L, Q->U);
   READ FILE(REPORT) SET(Q);
 EOF:
   CLOSE FILE(REPORT);
   PUT SKIP LIST('EOF', N);
   OPEN FILE(REPORT) UPDATE;
   READ FILE(REPORT) SET(P);
   READ FILE(REPORT) SET(P);
   P->T = 'CHANGED';
   P->K = -5;
   REWRITE FILE(REPORT);
   CLOSE FILE(REPORT);
   OPEN FILE(REPORT) INPUT;
   DO N = 1 TO 3;
     READ FILE(REPORT) SET(P);
     PUT SKIP LIST('AGAIN', P->K, P->T);
   END;
   CLOSE FILE(REPORT);
 END T135LOC;
