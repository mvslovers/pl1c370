 T166BLT: PROC OPTIONS(MAIN);
   DCL (SUBSTR, LENGTH, NULL, INDEX) BUILTIN;
   DCL P POINTER, S CHAR(8) INIT('ABCDEFGH');
   DCL HALF ENTRY(FIXED DEC(5)), TWICE ENTRY(FIXED DEC(5));
   DCL KOUNT ENTRY(FIXED DEC(5)), XSQ ENTRY(FLOAT DEC(6));
   P = NULL;
   PUT SKIP LIST(SUBSTR(S, 2, 3), LENGTH(S), INDEX(S, 'D'), P = NULL);
   PUT SKIP LIST('KOUNT', KOUNT(7), 'XSQ', XSQ(1.5E0));
   CALL TWICE(4);
   CALL HALF(9);
   BEGIN;
     DCL SUBSTR FIXED BIN(15) INIT(5);
     PUT SKIP LIST('INNER SUBSTR', SUBSTR);
   END;
 KOUNT: PROC(N);
   DCL N FIXED DEC(5);
   RETURN(N * 3);
 END KOUNT;
 XSQ: PROC(Y);
   DCL Y FLOAT DEC(6);
   RETURN(Y * Y);
 END XSQ;
 TWICE: PROC(V);
   DCL V FIXED DEC(5);
   PUT SKIP LIST('TWICE', V * 2);
   RETURN;
 HALF: ENTRY(V);
   PUT SKIP LIST('HALF', V / 2);
 END TWICE;
 END T166BLT;
