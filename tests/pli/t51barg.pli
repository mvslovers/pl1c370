 T51BARG: PROC OPTIONS(MAIN);
   DCL P POINTER;
   DCL V(5) FIXED BIN(31) BASED(P);
   DCL W(5) FIXED BIN(31) INIT(1, 2, 3, 4, 5);
   DCL S ENTRY(POINTER) RETURNS(FIXED BIN(31));
   DCL 1 R BASED(P), 2 A CHAR(2), 2 B FIXED BIN(15);
   DCL T CHAR(4) INIT('AB12');
   P = ADDR(W);
   PUT SKIP LIST(V(3), S(P));
   ALLOCATE V;
   V = 7;
   PUT SKIP LIST(V(1), V(5), S(P));
   FREE V;
   P = ADDR(T);
   PUT SKIP LIST(A);
 S: PROC(Q) RETURNS(FIXED BIN(31));
   DCL Q POINTER, Z(5) FIXED BIN(31) BASED(Q), (K, N) FIXED BIN(31);
   N = 0;
   DO K = 1 TO 5; N = N + Z(K); END;
   RETURN(N);
 END S;
 END T51BARG;
