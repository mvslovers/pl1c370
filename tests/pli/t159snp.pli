 (SIZE, SUBSCRIPTRANGE, STRINGRANGE):
 T159SNP: PROC OPTIONS(MAIN);
   DCL A(3) FIXED BIN(15), S CHAR(4) INIT('ABCD'), K FIXED BIN(15);
   ON SIZE SNAP BEGIN; END;
   ON SUBSCRIPTRANGE SNAP BEGIN; END;
   ON STRINGRANGE SNAP BEGIN; END;
   SIGNAL SIZE;
   SIGNAL SUBSCRIPTRANGE;
   SIGNAL STRINGRANGE;
   ON ZERODIVIDE SNAP SYSTEM;
   K = 0;
   K = 5 / K;
   PUT SKIP LIST('AFTER ZERODIVIDE', K);
   ON CONVERSION SNAP SYSTEM;
   S = 'X1';
   K = S;
   PUT SKIP LIST('NOT REACHED');
 END T159SNP;
