 P10SCOP: PROC OPTIONS(MAIN);
    /* NESTED PROCEDURES, OUTER VARIABLES, LOCAL NAMES */
    DCL V FIXED BIN(15) INIT(1);
    DCL N FIXED DEC(5,1) INIT(2.5);
    DCL K FIXED BIN(15);
    CALL OUTER;
    PUT SKIP LIST('MAIN V', V, N);
    K = 4;
    K = INC(K);
    PUT SKIP LIST('INC', K, INC(K), INC(INC(K)));
 OUTER: PROC;
    DCL N FIXED BIN(15) INIT(7);
    CALL INNER;
    CALL INNER;
    PUT SKIP LIST('OUTER', V, N);
 INNER: PROC;
    V = V * 10;
    N = N + 1;
 END INNER;
 END OUTER;
 INC: PROC(J) RETURNS(FIXED BIN(15));
    DCL J FIXED BIN(15);
    RETURN(J + 1);
 END INC;
 END P10SCOP;
