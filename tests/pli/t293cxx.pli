 T293CXX: PROC OPTIONS(MAIN);
   /* COMPLEX POWERS, THE GENERAL CASE (#2 C3): A COMPLEX OR A NOT
      INTEGRAL EXPONENT, A REAL BASE; 0**Z; THE ERRORS OF ATAN, ATANH,
      LOG, SIN, TAN AND ** WITH THEIR ONCODES */
   DCL (A,C) COMPLEX FLOAT DEC(6);
   DCL (D,E) COMPLEX FLOAT DEC(16);
   DCL L LABEL;
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE);
     GO TO L;
   END;
   A = 0.3+0.1I; C = 2-1I;
   PUT SKIP LIST(A**C, A**0.5, 2**C);
   PUT SKIP LIST(C**(1+1I), A**2.5E0);
   D = 0.3+0.1I; E = 2-1I;
   PUT SKIP LIST(D**E, E**(1+1I));
   A = 0; PUT SKIP LIST(A**(2+0I), A**1.5);
   A = 0; D = 0;
   L = N1; PUT SKIP LIST(A**(0+1I));
 N1: L = N2; PUT SKIP LIST(D**(-1+0I));
 N2: L = N3; PUT SKIP LIST(ATAN(1I));
 N3: L = N4; E = 1; PUT SKIP LIST(ATANH(-E));
 N4: L = N5; PUT SKIP LIST(LOG(A));
 N5: L = N6; PUT SKIP LIST(LOG(D));
 N6: L = N7; PUT SKIP LIST(SIN(1E7+0I));
 N7: L = N8; PUT SKIP LIST(EXP(0+1E7I));
 N8: L = N9; PUT SKIP LIST(TAN(1E7+1I));
 N9: PUT SKIP LIST('END');
 END T293CXX;
