 T48BEG: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31) INIT(1), S CHAR(5) INIT('OUTER');
   PUT SKIP LIST('MAIN', I, S);
   BEGIN;
     DCL I FIXED BIN(31) INIT(2);
     DCL T CHAR(5) INIT('INNER');
     PUT SKIP LIST('BLOCK', I, S, T);
     S = 'CHANG';
     BEGIN;
       DCL I FIXED DEC(5) INIT(3);
       PUT SKIP LIST('INNER BLOCK', I, T);
       GO TO OUT;
     END;
     PUT SKIP LIST('NOT REACHED');
   END;
 OUT:
   PUT SKIP LIST('AFTER', I, S);
   ON ZERODIVIDE PUT SKIP LIST('MAIN ZD');
   BEGIN;
     DCL K FIXED BIN(31) INIT(0);
     ON ZERODIVIDE PUT SKIP LIST('BLOCK ZD');
     K = 1 / K;
   END;
   I = 0;
   I = 1 / I;
   ON FINISH PUT SKIP LIST('FINISH', ONCODE);
   CALL P;
   PUT SKIP LIST('NOT REACHED');
 P: PROC;
   PUT SKIP LIST('IN P');
   STOP;
 END P;
 END T48BEG;
