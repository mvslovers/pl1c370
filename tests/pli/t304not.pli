 T304NOT: PROC OPTIONS(MAIN);
   /* THE NOT AND OR OPTIONS (PL/I FOR MVS & VM): ~ FOR NOT, ! FOR OR
      AND !! FOR CONCATENATION; THE .PLI SPELLS THEM OUT FOR F */
   DCL (A, B) BIT(1) INIT('1'B);
   DCL S CHAR(10) VAR INIT('X|Y~Z');
   DCL I FIXED BIN(15) INIT(3);
   IF ¬A | B THEN PUT SKIP LIST('ONE');
   IF I ¬= 3 THEN PUT SKIP LIST('TWO'); ELSE PUT SKIP LIST('THREE');
   IF I ¬< 2 & I ¬> 4 THEN PUT SKIP LIST('FOUR');
   PUT SKIP LIST(S || '!' || 'W', ¬B, A | ¬B);
 END T304NOT;
