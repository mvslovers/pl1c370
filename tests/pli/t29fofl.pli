 T29FOFL: PROC OPTIONS(MAIN);
   /* FIXEDOVERFLOW: binary +, -, * beyond 31 bits, decimal beyond 15
      digits; truncation in assignment raises nothing (SIZE) */
   DCL I FIXED BIN(31) INIT(2147483647);
   DCL D FIXED DEC(15) INIT(999999999999999);
   DCL E4 FIXED DEC(4) INIT(9999);
   DCL E5 FIXED DEC(5);
   DCL D6 FIXED DEC(15) INIT(123456);
   DCL H FIXED BIN(15) INIT(32767);
   DCL (P,Q) FIXED DEC(15) INIT(99999999);
   DCL R FIXED DEC(3,1) INIT(99.9);
   ON FIXEDOVERFLOW PUT SKIP LIST('FOFL', ONCODE);
   I = I + 1;
   PUT SKIP LIST('AFTER BIN');
   D = D + 1;
   PUT SKIP LIST('AFTER DEC15');
   I = 2147483647;
   I = I * 2;
   PUT SKIP LIST('AFTER MUL');
   I = -2147483647;
   I = I - 2;
   PUT SKIP LIST('AFTER SUB');
   E4 = E4 + 1;
   PUT SKIP LIST('A E4', E4);
   E5 = D6;
   PUT SKIP LIST('B E5', E5);
   H = H + 1;
   PUT SKIP LIST('C H', H);
   P = P * Q;
   PUT SKIP LIST('E P', P);
   R = R + 1;
   PUT SKIP LIST('F R', R);
   E5 = 99999;
   E5 = E5 * 10;
   PUT SKIP LIST('G E5', E5);
   E4 = 9999;
   E4 = E4 * 10;
   PUT SKIP LIST('I E4', E4);
   REVERT FIXEDOVERFLOW;
   I = 2147483647;
   I = I + 1;
   PUT SKIP LIST('NOT REACHED');
 END T29FOFL;
