 T113ARE: PROC OPTIONS(MAIN);
   DCL A AREA(300) BASED(AP), B AREA(300) BASED(BP), C AREA(40);
   DCL AA AREA(300), (AP, BP) POINTER;
   DCL 1 N BASED(P), 2 V FIXED BIN(31), 2 NX OFFSET(A);
   DCL (P, Q, R) POINTER, (O1, O2, O3) OFFSET(A), OB OFFSET(B);
   DCL X CHAR(20) BASED(R), K FIXED BIN(31), Z FIXED BIN(31);
   AP = ADDR(AA);
   ALLOCATE B;
   ALLOCATE N IN(A) SET(P);
   P->V = 1;
   O1 = P;
   ALLOCATE N IN(A) SET(Q);
   Q->V = 2;
   P->NX = Q;
   Q->NX = NULLO;
   O2 = NULLO;
   PUT SKIP LIST('CHAIN', O1 = P, O2 = NULLO, P->NX = Q);
   P = O1;
   K = 0;
   DO WHILE(P ¬= NULL);
     PUT SKIP LIST('ITEM', P->V);
     K = K + 1;
     IF P->NX = NULLO THEN P = NULL;
     ELSE P = P->NX;
   END;
   B = A;
   OB = O1;
   P = OB;
   PUT SKIP LIST('COPY', P->V);
   P->V = 11;
   P = O1;
   PUT SKIP LIST('ORIG', P->V);
   P = OB;
   P = P->NX;
   PUT SKIP LIST('NEXT', P->V);
   ON AREA BEGIN;
     PUT SKIP LIST('AREA', ONCODE);
     Z = Z + 1;
     IF Z > 5 THEN GO TO OUT;
   END;
   Z = 0;
   DO K = 1 TO 20;
     ALLOCATE X IN(A) SET(R);
   END;
 OUT:
   PUT SKIP LIST('FILLED', K, Z);
   Z = 0;
   C = A;
   PUT SKIP LIST('ASSIGNED', Z);
   SIGNAL AREA;
   A = EMPTY;
   ALLOCATE N IN(A) SET(P);
   O3 = P;
   PUT SKIP LIST('EMPTY', O3 = O1);
   ALLOCATE N IN(A) SET(Q);
   FREE P->N IN(A);
   ALLOCATE N IN(A) SET(R);
   O3 = R;
   PUT SKIP LIST('REUSE', O3 = O1);
   C = EMPTY;
   B = C;
   ALLOCATE N IN(B) SET(Q);
   OB = Q;
   PUT SKIP LIST('BEMPTY', OB = O1);
   CALL MORE;
 MORE: PROC;
   DCL S STATIC AREA(40), SA AREA(40) BASED(SP), SP PTR;
   DCL CA AREA(24) CONTROLLED, Y CHAR(8) BASED(YP), YP PTR;
   DCL (SO, SO2) OFFSET(SA), W FIXED BIN(31) BASED(WP), WP PTR;
   SP = ADDR(S);
   ALLOCATE Y IN(S) SET(YP);
   YP->Y = 'STATIC';
   SO = YP;
   ALLOCATE Y IN(SA) SET(YP);
   SO2 = YP;
   WP = ADDR(SO2);
   PUT SKIP LIST('STATIC', W, SO = SO2, SO ¬= SO2);
   YP = SO;
   PUT SKIP LIST(YP->Y);
   ALLOCATE CA;
   ALLOCATE Y IN(CA) SET(YP);
   ALLOCATE Y IN(CA) SET(YP);
   CA = S;
   PUT SKIP LIST('CTL', ALLOCATION(CA));
   FREE CA;
   PUT SKIP LIST('CTL', ALLOCATION(CA));
 END MORE;
 END T113ARE;
