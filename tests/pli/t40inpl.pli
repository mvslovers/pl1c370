 T40INPL: PROC OPTIONS(MAIN);
   DCL (E5,F5) FIXED DEC(5);
   DCL E4 FIXED DEC(4) INIT(9999);
   DCL E7 FIXED DEC(7) INIT(99999);
   ON FIXEDOVERFLOW PUT SKIP LIST('FOFL', ONCODE);
   E5 = 99999;  E5 = E5 + 1;   PUT SKIP LIST('A', E5);
   E5 = -99999; E5 = E5 - 1;   PUT SKIP LIST('B', E5);
   E5 = 99999;  F5 = -99999;
   E5 = E5 - F5;               PUT SKIP LIST('C', E5);
   E5 = 99999;  E5 = 1 + E5;   PUT SKIP LIST('D', E5);
   E5 = 99999;  E5 = E7 + 1;   PUT SKIP LIST('E', E5);
   E5 = 99999;  E5 = E5 + E4;  PUT SKIP LIST('F', E5);
   E5 = 99999;  F5 = E5 + 1;   PUT SKIP LIST('G', F5);
   E4 = 9999;   E4 = E4 + 1;   PUT SKIP LIST('H', E4);
   E4 = 9999;   E4 = E4 + 1000; PUT SKIP LIST('I', E4);
   E4 = 9999;   E4 = E4 + 90001; PUT SKIP LIST('J', E4);
 END T40INPL;
