 T259ICL: PROC OPTIONS(MAIN);
   /* TIER 102: INITIAL CALL (GC33-0009-4, INITIAL ATTRIBUTE; #222):
      THE PROCEDURE CALLED WHEN THE VARIABLE IS ALLOCATED */
   DCL A(4) FIXED BIN(15) INIT CALL FILL(A, 7);
   DCL C(3) FIXED BIN(15) CONTROLLED INIT CALL FILL(C, 2);
   DCL N FIXED BIN(15) STATIC INIT(0);
   PUT SKIP LIST(A);
   ALLOCATE C;
   PUT SKIP LIST(C, N);
   C(1) = 99;
   ALLOCATE C;
   PUT SKIP LIST(C, N);
   FREE C; PUT SKIP LIST(C(1));
   CALL INNER;
 INNER: PROC;
   DCL B(2) CHAR(3) INIT CALL NAME(B);
   PUT SKIP LIST(B);
 END INNER;
 FILL: PROC(X, V);
   DCL X(*) FIXED BIN(15), V FIXED DEC(1), I FIXED BIN(15);
   N = N + 1;
   DO I = LBOUND(X, 1) TO HBOUND(X, 1);
     X(I) = V * I;
   END;
 END FILL;
 NAME: PROC(X);
   DCL X(*) CHAR(3);
   X(1) = 'ONE'; X(2) = 'TWO';
 END NAME;
 END T259ICL;
