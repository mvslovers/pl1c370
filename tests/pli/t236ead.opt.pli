 T236EAD: PROC OPTIONS(MAIN);
   /* ENTRYADDR, FUNCTION AND PSEUDOVARIABLE (SC26-3114-01): THE
      ADDRESS OF AN EXTERNAL ENTRY, AND AN ENTRY VARIABLE SET FROM IT */
   DCL SUB ENTRY;
   DCL (E, E2) ENTRY VARIABLE, (P, Q) PTR;
   P = ENTRYADDR(SUB);
   E = SUB;
   Q = ENTRYADDR(E);
   PUT SKIP LIST(P = Q, P = NULL, P = SYSNULL);
   ENTRYADDR(E2) = P;
   CALL E2;
   PUT SKIP LIST(ENTRYADDR(E2) = P);
 END T236EAD;
*PROCESS;
 SUB: PROC;
   PUT SKIP LIST('IN SUB');
 END SUB;
