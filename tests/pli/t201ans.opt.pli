 T201ANS: PROC OPTIONS(MAIN);
   /* ANSI X3.53-1976 functions (9.4.4): ASIN, ACOS, SUBTRACT,
      DOT, EVERY, SOME */
   DCL X FLOAT DEC(6) INIT(0.5), Y FLOAT DEC(16) INIT(-0.25E0);
   DCL D FIXED DEC(5,2) INIT(1.25), I FIXED BIN(15) INIT(0);
   DCL U(3) FLOAT DEC(6) INIT(1, 2, 3);
   DCL W(3) FLOAT DEC(6) INIT(4, 5, 6);
   DCL F(3) FIXED DEC(5,1) INIT(1.5, 2, 2.5), G(3) FIXED DEC(5,1)
       INIT(2, 3, 4);
   DCL B(3) BIT(4) INIT('1111'B, '1011'B, '1111'B), C BIT(4);
   DCL N(2) FIXED BIN(15) INIT(5, 0);
   PUT SKIP LIST(ASIN(X), ACOS(X));
   PUT SKIP LIST(ASIN(Y), ACOS(Y));
   PUT SKIP LIST(ASIN(1), ACOS(-1), ASIN(0), ACOS(1));
   PUT SKIP LIST(ASIN(D - 1), ACOS(I));
   PUT SKIP LIST(SUBTRACT(D, 0.5, 5, 2), SUBTRACT(7, 9, 3, 0));
   PUT SKIP LIST(SUBTRACT(X, 1E0, 6), SUBTRACT(D, D, 4, 1));
   PUT SKIP LIST(DOT(U, W), DOT(F, G, 7, 2), DOT(U, U));
   PUT SKIP LIST(EVERY(B), SOME(B));
   C = '0000'B;
   PUT SKIP LIST(EVERY(C), SOME(C), EVERY('1'B), SOME(B(2)));
   PUT SKIP LIST(EVERY(N), SOME(N), EVERY(B = B), SOME(B ^= B));
   IF EVERY(B(1)) THEN PUT SKIP LIST('B(1) ALL ONES');
   IF ^SOME(C) THEN PUT SKIP LIST('C ALL ZEROS');
 END T201ANS;
