 T288CPW: PROC OPTIONS(MAIN);
   /* COMPLEX FLOAT TO AN INTEGER POWER (#2): CONSTANT AND VARIABLE
      EXPONENTS, NEGATIVE AND ZERO; A FIXED BASE TAKEN AS FLOAT; 0**N;
      ERROR FOR 0**0 AND 0**-1 (ONCODE 1554, 1555); OVERFLOW */
   DCL A COMPLEX FLOAT DEC(6);
   DCL D COMPLEX FLOAT DEC(16);
   DCL C COMPLEX FLOAT DEC(6);
   DCL P COMPLEX FIXED DEC(2);
   DCL U COMPLEX FIXED BIN(15);
   DCL N FIXED BIN(15);
   DCL M FIXED DEC(3);
   DCL NO FIXED BIN(15) INIT(0);
   DCL L LABEL;
   ON OVERFLOW NO = NO + 1;
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE);
     GO TO L;
   END;
   A = 1+1I;
   PUT SKIP LIST(A**0, A**1, A**2);
   PUT SKIP LIST(A**-2, A**3, A**15);
   PUT SKIP LIST(A**-1, A**16, A**-15);
   A = 0.1+0.7I;
   C = A**2; PUT SKIP LIST(C, UNSPEC(C));
   C = A**5; PUT SKIP LIST(C, UNSPEC(C));
   C = A**-3; PUT SKIP LIST(C, UNSPEC(C));
   C = A**13; PUT SKIP LIST(UNSPEC(C));
   N = -7; C = A**N; PUT SKIP LIST(UNSPEC(C));
   N = 3; PUT SKIP LIST(A**N);
   N = 0; PUT SKIP LIST(A**N);
   M = 4; PUT SKIP LIST(A**M, A**(N+2));
   D = 0.1+0.7I;
   D = D**5; PUT SKIP LIST(D, UNSPEC(D));
   D = 0.1+0.7I;
   D = D**-3; PUT SKIP LIST(D, UNSPEC(D));
   P = 1+1I;
   PUT SKIP LIST(P**7, P**0, P**-1);
   U = 2+1I;
   PUT SKIP LIST(U**3);
   N = 2;
   PUT SKIP LIST(U**N, P**N);
   C = 1+1I;
   DO N = 1 TO 4;
     PUT SKIP LIST(N, C**N, (C*2)**-N);
   END;
   A = 0;
   PUT SKIP LIST(A**1, A**2);
   A = 1E20+1E20I;
   A = A**4; PUT SKIP LIST('OVERFLOW', NO);
   A = 0; D = 0;
   L = N1;
   PUT SKIP LIST(A**0);
 N1: L = N2;
   PUT SKIP LIST(A**-1);
 N2: L = N3;
   PUT SKIP LIST(D**-2);
 N3: PUT SKIP LIST('END');
 END T288CPW;
