 T225ADJ: PROC OPTIONS(MAIN);
   /* ADJUSTABLE BOUNDS OF AUTOMATIC ARRAYS; MULTIPLE ASSIGNMENT */
   DCL (N, M, I) FIXED BIN(15), (A, B) FIXED BIN(15);
   DCL P ENTRY(FIXED BIN(15));
   N = 5; M = 2;
   A = 1; B = 10;
   A, B = A + 1;
   PUT LIST(A, B);
   A = 1; B = 10;
   B, A = A + 1;
   PUT SKIP LIST(A, B);
   CALL P(N);
   CALL P(1);
   BEGIN;
     DCL X(N) FIXED BIN(15), Y(M:N, 2) FIXED DEC(5), C(N) CHAR(3);
     N = 9;
     X = 7;
     PUT SKIP LIST(DIM(X, 1), HBOUND(Y, 1), LBOUND(Y, 1), X);
     DO I = 1 TO 5; X(I) = I * I; END;
     Y = 0; Y(3, 2) = 32;
     PUT SKIP LIST(Y, SUM(X));
     C = 'AB'; C(5) = 'XYZ';
     PUT SKIP LIST(C);
   END;
 P: PROC(K);
   DCL K FIXED BIN(15);
   DCL Z(K + 1) FIXED BIN(31);
   Z = K;
   PUT SKIP LIST(HBOUND(Z, 1), Z);
 END P;
 END T225ADJ;
