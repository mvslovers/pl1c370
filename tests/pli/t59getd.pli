 T59GETD: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31) INIT(0), D FIXED DEC(7,2) INIT(0);
   DCL S CHAR(5) INIT(' '), A(3) FIXED BIN(15) INIT((3)0);
   GET DATA(I, D, S);
   PUT SKIP LIST(I, D, S);
   GET DATA(A);
   PUT SKIP LIST(A(1), A(2), A(3));
   GET DATA(I, D);
   PUT SKIP LIST(I, D);
 END T59GETD;
