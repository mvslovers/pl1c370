 T3IF: PROC OPTIONS(MAIN);
    /* COMPARISONS, AND, OR, NESTED IF, DO GROUPS */
    DCL (A,B) FIXED BIN(31);
    DCL D FIXED DEC(5,2);
    DCL C CHAR(4);
    DCL V CHAR(10) VARYING;
    A = 5;
    B = 7;
    IF A < B THEN PUT SKIP LIST('A<B');
    IF A > B THEN PUT SKIP LIST('A>B'); ELSE PUT SKIP LIST('NOT A>B');
    IF A = 5 & B = 7 THEN PUT SKIP LIST('AND');
    IF A = 6 | B = 7 THEN PUT SKIP LIST('OR');
    IF A = 6 | B = 8 THEN PUT SKIP LIST('WRONG OR');
    IF A <= 5 THEN DO;
       PUT SKIP LIST('GROUP 1');
       PUT LIST('GROUP 2');
    END;
    IF A >= 6 THEN PUT SKIP LIST('WRONG GE');
    ELSE IF B >= 7 THEN PUT SKIP LIST('ELSE IF');
    D = 1.25;
    IF D > 1.2 THEN PUT SKIP LIST('DEC GT');
    IF D = 1.250 THEN PUT SKIP LIST('DEC EQ SCALE');
    IF D < 2 THEN PUT SKIP LIST('DEC LT CONST');
    C = 'AB';
    IF C = 'AB' THEN PUT SKIP LIST('PADDED EQ');
    IF C < 'AC' THEN PUT SKIP LIST('CHAR LT');
    V = 'XYZ';
    IF V = 'XYZ   ' THEN PUT SKIP LIST('VARYING EQ');
    IF V > C THEN PUT SKIP LIST('XYZ GT AB');
    IF A < B & (B < 10 | A > 100) THEN PUT SKIP LIST('MIX');
 END T3IF;
