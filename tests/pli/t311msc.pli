 T311MSC: PROC OPTIONS(MAIN);
   /* RETURN OUT OF BEGIN, PUT LINE, ARRAY EXPRESSIONS IN PUT,
      BIT || CHAR, BIT OF FLOAT, GET INTO A PICTURE, STATIC PICTURE */
   DCL F ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15));
   DCL S ENTRY(FIXED BIN(15));
   DCL A(3) FIXED BIN(15) INIT(1, 2, 3);
   DCL B BIT(4) INIT('1010'B);
   DCL C CHAR(3) INIT('XYZ');
   DCL X FLOAT DEC(6) INIT(5.75);
   DCL P FIXED DEC(5,2) INIT(6.5);
   DCL Q PIC '99V.99';
   DCL R PIC 'ZZ9V.9' STATIC INIT(12.3);
   PUT SKIP LIST(F(1), F(5), F(2));
   CALL S(2);
   PUT SKIP LIST(A + 1, A * 2);
   PUT SKIP LIST(-A, A, 'END A');
   PUT LINE(10) LIST('LINE 10');
   PUT SKIP LIST(B || C, C || B);
   PUT SKIP LIST(BIT(X), BIT(P), BIT(X, 8));
   GET LIST(Q);
   PUT SKIP LIST(Q, R);
 F: PROC(N) RETURNS(FIXED BIN(15));
   DCL N FIXED BIN(15);
   BEGIN;
     IF N > 3 THEN RETURN(N * 10);
     BEGIN;
       IF N = 1 THEN RETURN(-1);
     END;
   END;
   RETURN(N);
 END F;
 S: PROC(N);
   DCL N FIXED BIN(15);
   BEGIN;
     PUT SKIP LIST('S IN BEGIN', N);
     IF N = 2 THEN RETURN;
     PUT SKIP LIST('NOT HERE');
   END;
   PUT SKIP LIST('NOR HERE');
 END S;
 END T311MSC;
