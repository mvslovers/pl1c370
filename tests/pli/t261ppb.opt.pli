 T261PPB: PROC OPTIONS(MAIN);
   /* TIER 104: THE OPTIMIZER'S PREPROCESSOR (#224): INDEX, LENGTH,
      COUNTER, COMPILETIME, PARMSET, NORESCAN */
   DCL B CHAR(2) INIT('B1'), YY CHAR(2) INIT('Y2');
 %DCL (A, B, C, T) CHAR, (N, M) FIXED;
 %N = INDEX('ABCD', 'C');
 %M = LENGTH('ABCDE');
 %A = 'B'; %B = 'YY'; %C = 'B';
 %ACTIVATE A NORESCAN;
 %DCL COUNTER BUILTIN;
 %T = '''' || COMPILETIME || '''';
 %DCL P ENTRY(CHAR, CHAR) RETURNS(CHAR);
 %P: PROC(X, Y) RETURNS(CHAR);
   DCL (X, Y) CHAR;
   IF PARMSET(Y) THEN RETURN('''' || X || '+' || Y || '''');
   RETURN('''' || X || ' ALONE''');
 %END P;
 %ACTIVATE P;
   PUT SKIP LIST(N, M, A, C, COUNTER, COUNTER);
   PUT SKIP LIST(P(Q, R), P(S), P(U,));
   PUT SKIP LIST(LENGTH(T));
 END T261PPB;
