 T222C48.. PROC OPTIONS(MAIN),.
   /* THE 48-CHARACTER SET, WITH CHAR48 AND MACRO */
   //DCL K FIXED,. //K = 4,.
   DCL (A, B) FIXED BIN(15) INIT(3),.
   DCL S CHAR(6) VARYING INIT('A;B:'),.
   DCL P PTR, X FIXED BIN(15) BASED(P),.
   DCL C(2..4) FIXED BIN(15) INIT(7, 8, 9),.
   B = 5,.
   IF A LT B AND NOT (A GE B) THEN PUT LIST('LT AND NOT GE'),.
   IF A NE B OR A GT B THEN PUT SKIP LIST('NE OR GT'),.
   IF A LE 3 THEN PUT SKIP LIST('LE'),.
   IF B NL A THEN PUT SKIP LIST('NL'),.
   IF A NG B THEN PUT SKIP LIST('NG'),.
   PUT SKIP LIST(S CAT 'XY', LENGTH(S)),.
   P = ADDR(A),.
   PUT SKIP LIST(P PT X, C(3), K),.
   PUT SKIP LIST(1.5,.5),.
   PUT SKIP LIST(A * B ** 2 / 5 - 1);
 L.. PUT SKIP LIST('END'),.
 END T222C48,.
