 T94LAB2: PROC OPTIONS(MAIN);
   DCL 1 S, 2 L LABEL, 2 N FIXED BIN(15);
   DCL (SAVED, M) LABEL, D FIXED BIN(15) INIT(0);
   DCL REC ENTRY(FIXED BIN(15));
   S.N = 1; S.L = X1; GO TO S.L;
   PUT SKIP LIST('SKIPPED');
 X1: PUT SKIP LIST('X1', S.N);
   BEGIN;
     DCL K FIXED BIN(15) INIT(5);
     M = INB; GO TO M;
     K = 0;
 INB: PUT SKIP LIST('IN BEGIN', K);
   END;
   M = BACK; CALL P1(M);
   PUT SKIP LIST('NOT HERE');
 BACK: PUT SKIP LIST('BACK');
   CALL REC(3);
   PUT SKIP LIST('END', D);
 P1: PROC(A);
   DCL A LABEL;
   PUT SKIP LIST('P1');
   CALL P2(A);
 END P1;
 P2: PROC(B);
   DCL B LABEL;
   PUT SKIP LIST('P2');
   GO TO B;
 END P2;
 REC: PROC(N) RECURSIVE;
   DCL N FIXED BIN(15);
   IF N = 2 THEN SAVED = HERE;
   IF N = 0 THEN GO TO SAVED;
   CALL REC(N - 1);
   PUT SKIP LIST('NOT HERE', N);
 HERE: PUT SKIP LIST('HERE AT', N);
   D = D + N;
 END REC;
 END T94LAB2;
