 T323PPE: PROC OPTIONS(MAIN);
   /* TIER 128: NESTED IF/ELSE IN A PREPROCESSOR PROCEDURE, IF AND
      DO GROUPS SKIPPED AS UNITS, RETURNS FROM THE %PROCEDURE */
   /* CÔTE D'IVOIRE, SÃO TOMÉ, CURAÇAO                               */
 %DCL F ENTRY;
 %F: PROC(N) RETURNS(CHAR);
   DCL N FIXED, S CHAR;
   IF N = 1 THEN
     S = 'ONE';
   ELSE
     IF N = 2 THEN
       S = 'TWO';
     ELSE
       IF N = 3 THEN DO;
         IF N > 9 THEN S = 'BIG'; ELSE S = 'THREE';
       END;
       ELSE
         S = 'MANY';
   RETURN('''' || S || '''');
 %END F;
 %DCL G ENTRY;
 %G: PROC(N) RETURNS(FIXED);
   DCL N FIXED;
   IF N > 0 THEN DO;
     IF N > 5 THEN RETURN(50);
     ELSE DO; RETURN(5); END;
   END;
   ELSE IF N < 0 THEN RETURN(-1);
   RETURN(0);
 %END G;
 %ACTIVATE F, G;
   PUT SKIP LIST(F(1), F(2), F(3), F(4));
   PUT SKIP LIST(G(7), G(2), G(0), G(-3));
 END T323PPE;
