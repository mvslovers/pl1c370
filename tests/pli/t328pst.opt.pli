 T328PST: PROC OPTIONS(MAIN);
   /* TIER 131: PREPROCESSOR PROCEDURES WITH THE STATEMENT OPTION,
      KEYWORD ARGUMENTS, A WHEN UNIT FROM ONE; CLOSE OF MANY FILES */
   DCL (F1, F2, F3, F4, F5, F6, F7, F8, F9) FILE STREAM OUTPUT;
   DCL (I, J) FIXED BIN(15);
 %DCL SHOW ENTRY;
 %SHOW: PROC(A, B, C) STATEMENT RETURNS(CHAR);
   DCL (A, B, C) CHAR;
   IF ^PARMSET(C) THEN C = '0';
   RETURN('PUT SKIP LIST(' || A || ',' || B || ',' || C || ');');
 %END SHOW;
 %ACTIVATE SHOW;
   DO I = 1 TO 3;
      SELECT(I);
      WHEN(1) SHOW(I, 10);
      WHEN(2) SHOW(I) C(30) B(20);
      OTHERWISE SHOW B(-1) A(I);
      END;
   END;
   CLOSE FILE(F1), FILE(F2), FILE(F3), FILE(F4), FILE(F5), FILE(F6),
         FILE(F7), FILE(F8), FILE(F9);
   PUT SKIP LIST('CLOSED');
 END T328PST;
