 T214ATT: PROC OPTIONS(MAIN);
   /* ANSI X3.53-1976's attributes that spell out what PL/I (F)
      implies (CM23, CM24): CONSTANT, VARIABLE, PARAMETER, LOCAL,
      STRUCTURE, MEMBER, NONVARYING, DIMENSION, CONDITION */
   DCL A FIXED BIN(15) DIMENSION(3) INIT(1, 2, 3);
   DCL B(2:4) CHAR(2) NONVARYING INIT('X', 'YY', 'ZZZ');
   DCL M FIXED DEC(5) DIM(2, 2) VARIABLE INIT(11, 12, 21, 22);
   DCL 1 S STRUCTURE, 2 T CHAR(3) MEMBER INIT('TTT'),
       2 U STRUCTURE MEMBER, 3 V FIXED BIN(15) MEMBER INIT(7);
   DCL L LABEL LOCAL VARIABLE;
   DCL SYSPRINT FILE CONSTANT STREAM OUTPUT PRINT;
   DCL F ENTRY(FIXED BIN(15) PARAMETER) RETURNS(FIXED BIN(15))
       CONSTANT;
   DCL OOPS CONDITION;
   ON CONDITION(OOPS) PUT SKIP LIST('OOPS RAISED');
   PUT LIST(A, B, M);
   PUT SKIP LIST(T, V, F(5));
   SIGNAL CONDITION(OOPS);
   L = DONE;
   GO TO L;
   PUT SKIP LIST('NOT HERE');
 DONE: PUT SKIP LIST('DONE');
 F: PROC(X) RETURNS(FIXED BIN(15));
   DCL X FIXED BIN(15) PARAMETER;
   RETURN(X * 2);
 END F;
 END T214ATT;
