 T187SGT: PROC OPTIONS(MAIN);
   /* GET into scaled FIXED BINARY variables */
   DCL T FIXED BIN(15,3), U FIXED BIN(31,16), V FIXED BIN(15,6);
   DCL W FIXED BIN(31,4), D FIXED DEC(9,6);
   GET LIST(T, U, V);
   PUT SKIP LIST(T, U, V, UNSPEC(V));
   GET LIST(T, U, V);
   PUT SKIP LIST(T, U, V);
   GET SKIP EDIT(U, W) (F(8,3), F(8));
   PUT SKIP LIST(U, W);
   GET SKIP DATA(T, U);
   PUT SKIP LIST(T, U);
   GET SKIP LIST(T, U, D);
   PUT SKIP LIST(T, U, D);
 END T187SGT;
