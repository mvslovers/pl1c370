 T202ANS: PROC OPTIONS(MAIN);
   /* the PL/I (F) twin of t202ans.opt.pli: OFFSET and POINTER as
      the assignments that convert by the area, ONFIELD as DATAFIELD,
      PAGENO and VALID their values by ANSI 9.4.4.62 and 9.4.4.86 */
   DCL A AREA(200) BASED(Q), X FIXED BIN(31) BASED(P), (P, P2, Q) PTR;
   DCL O OFFSET(A), O1 OFFSET(A);
   DCL N1 PIC '999', C1 CHAR(3) DEF N1;
   DCL N2 PIC 'ZZ9', C2 CHAR(3) DEF N2;
   DCL N3 PIC '99.9', C3 CHAR(4) DEF N3;
   DCL K PIC 'AA99X', CK CHAR(5) DEF K;
   DCL (I, J) FIXED BIN(15) INIT(0), D CHAR(20) VARYING;
   DCL PG FIXED BIN(15);
   ALLOCATE A;
   ALLOCATE X IN(A) SET(P);
   ALLOCATE X IN(A) SET(P);
   P->X = 77;
   O1 = P;
   P2 = O1;
   PUT SKIP LIST(UNSPEC(O1), P2->X, P2 = P);
   O = P2;
   P = O;
   PUT SKIP LIST(O = O1, P->X);
   ON NAME(SYSIN) BEGIN;
     D = DATAFIELD;
     PUT SKIP LIST('ONFIELD', D);
   END;
   GET DATA(I, J);
   PUT SKIP LIST(I, J);
   PG = 1;  PUT SKIP LIST('PAGE', PG);
   PG = 2;  PUT PAGE LIST('PAGE', PG);
   PG = 10; PUT SKIP LIST('PAGE', PG);
   PG = 11; PUT PAGE LIST('PAGE', PG);
   N1 = 123;
   PUT SKIP LIST('1'B, N1);
   C1 = '1A3';
   PUT SKIP LIST('0'B, C1);
   N2 = 12;
   PUT SKIP LIST('1'B, C2);
   C2 = '012';
   PUT SKIP LIST('0'B, C2);
   N3 = 45;
   PUT SKIP LIST('1'B, C3);
   C3 = '4.50';
   PUT SKIP LIST('0'B, C3);
   CK = 'AB12%';
   PUT SKIP LIST('1'B, CK);
   CK = 'A112%';
   PUT SKIP LIST('0'B, CK);
   CK = ' B 2Z';
   PUT SKIP LIST('1'B, CK);
 END T202ANS;
