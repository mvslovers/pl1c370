 T88PICB: PROC OPTIONS(MAIN);
   DCL D FIXED DEC(15,5);
   DCL P0 PIC '9,999';
   DCL P1 PIC '9,999V.99';
   DCL P2 PIC 'ZZ.VZZ';
   DCL P3 PIC 'ZZ.VZZ';
   DCL P4 PIC 'ZZV.ZZ';
   DCL P5 PIC 'ZZV.ZZ';
   DCL P6 PIC 'ZZV.ZZ';
   DCL P7 PIC '9,999,999.V99';
   DCL P8 PIC '**,999V.99';
   DCL P9 PIC '**,999V.99';
   DCL P10 PIC '9.999.999V,99';
   DCL P11 PIC '99/99/99';
   DCL P12 PIC '99.9/99.9';
   DCL P13 PIC 'ZZ/ZZ/ZZ';
   DCL P14 PIC 'ZZ/ZZ/ZZ';
   DCL P15 PIC 'ZZ/ZZ/ZZ';
   DCL P16 PIC '**/**/**';
   DCL P17 PIC '99B99B99';
   DCL P18 PIC '9BB9BB9';
   DCL P19 PIC '9BB/9BB';
   DCL P20 PIC '$999V.99';
   DCL P21 PIC '$ZZZV.99';
   DCL P22 PIC '$ZZZV.ZZ';
   D = 1234; P0 = D;
   PUT SKIP EDIT('9,999', '|', P0, '|')(A(16), A, A, A);
   D = 1234.56; P1 = D;
   PUT SKIP EDIT('9,999V.99', '|', P1, '|')(A(16), A, A, A);
   D = 12.34; P2 = D;
   PUT SKIP EDIT('ZZ.VZZ', '|', P2, '|')(A(16), A, A, A);
   D = 0.03; P3 = D;
   PUT SKIP EDIT('ZZ.VZZ', '|', P3, '|')(A(16), A, A, A);
   D = 0.03; P4 = D;
   PUT SKIP EDIT('ZZV.ZZ', '|', P4, '|')(A(16), A, A, A);
   D = 12.34; P5 = D;
   PUT SKIP EDIT('ZZV.ZZ', '|', P5, '|')(A(16), A, A, A);
   D = 0; P6 = D;
   PUT SKIP EDIT('ZZV.ZZ', '|', P6, '|')(A(16), A, A, A);
   D = 1234567.89; P7 = D;
   PUT SKIP EDIT('9,999,999.V99', '|', P7, '|')(A(16), A, A, A);
   D = 12345.67; P8 = D;
   PUT SKIP EDIT('**,999V.99', '|', P8, '|')(A(16), A, A, A);
   D = 123.45; P9 = D;
   PUT SKIP EDIT('**,999V.99', '|', P9, '|')(A(16), A, A, A);
   D = 1234567.89; P10 = D;
   PUT SKIP EDIT('9.999.999V,99', '|', P10, '|')(A(16), A, A, A);
   D = 123456; P11 = D;
   PUT SKIP EDIT('99/99/99', '|', P11, '|')(A(16), A, A, A);
   D = 123456; P12 = D;
   PUT SKIP EDIT('99.9/99.9', '|', P12, '|')(A(16), A, A, A);
   D = 1234; P13 = D;
   PUT SKIP EDIT('ZZ/ZZ/ZZ', '|', P13, '|')(A(16), A, A, A);
   D = 12; P14 = D;
   PUT SKIP EDIT('ZZ/ZZ/ZZ', '|', P14, '|')(A(16), A, A, A);
   D = 0; P15 = D;
   PUT SKIP EDIT('ZZ/ZZ/ZZ', '|', P15, '|')(A(16), A, A, A);
   D = 0; P16 = D;
   PUT SKIP EDIT('**/**/**', '|', P16, '|')(A(16), A, A, A);
   D = 123456; P17 = D;
   PUT SKIP EDIT('99B99B99', '|', P17, '|')(A(16), A, A, A);
   D = 123; P18 = D;
   PUT SKIP EDIT('9BB9BB9', '|', P18, '|')(A(16), A, A, A);
   D = 12; P19 = D;
   PUT SKIP EDIT('9BB/9BB', '|', P19, '|')(A(16), A, A, A);
   D = 123.45; P20 = D;
   PUT SKIP EDIT('$999V.99', '|', P20, '|')(A(16), A, A, A);
   D = 1.23; P21 = D;
   PUT SKIP EDIT('$ZZZV.99', '|', P21, '|')(A(16), A, A, A);
   D = 0; P22 = D;
   PUT SKIP EDIT('$ZZZV.ZZ', '|', P22, '|')(A(16), A, A, A);
 END T88PICB;
