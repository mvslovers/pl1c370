 T254ARG: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T254ARG.OPT.PLI: THE CONVERSIONS TO Q'S
      PARAMETERS WRITTEN OUT, AS PL/I (F) PASSES THEM UNCONVERTED */
   DCL NW FIXED BIN(15) INIT(0), A(3) FIXED BIN(15) INIT(1, 2, 3);
   DCL I FIXED BIN(15) INIT(2);
   DCL (T1, T2, T3) FIXED BIN(15), T4 FIXED DEC(5,2);
   CALL P((NW));
   PUT SKIP LIST(NW);
   CALL P(NW);
   PUT SKIP LIST(NW);
   CALL P((A(I)));
   PUT SKIP LIST(A);
   T1 = NW + 0; T2 = 5; T3 = '7'; T4 = 2.5E0;
   CALL Q(T1, T2, T3, T4);
 P: PROC(N);
   DCL N FIXED BIN(15);
   N = N + 3;
 END P;
 Q: PROC(N, M, K, F);
   DCL (N, M, K) FIXED BIN(15), F FIXED DEC(5,2);
   PUT SKIP LIST(N, M, K, F);
 END Q;
 END T254ARG;
