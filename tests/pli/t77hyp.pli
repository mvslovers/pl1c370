 T77HYP: PROC OPTIONS(MAIN);
   DCL X(14) FLOAT DEC(6) INIT(0E0, 1E-5, 0.1E0, 0.5E0, 0.7E0,
       0.9999E0, 1E0, 1.5E0, 3E0, 9E0, 9.5E0, 20E0, 87E0, -2.5E0);
   DCL I FIXED BIN(15);
   DO I = 1 TO 14;
     PUT SKIP LIST(X(I), SINH(X(I)), COSH(X(I)), TANH(X(I)));
     PUT SKIP LIST(-X(I), SINH(-X(I)), COSH(-X(I)), TANH(-X(I)));
   END;
   DO I = 1 TO 6;
     PUT SKIP LIST(X(I), ATANH(X(I)), ATANH(-X(I)));
   END;
   PUT SKIP LIST(ATANH(0.99999E0), ATANH(-0.3E0));
 END T77HYP;
