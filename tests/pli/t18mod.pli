 T18MOD: PROC OPTIONS(MAIN);
    /* BINARY MOD OF BOTH SIGNS; A BIT FUNCTION USED DURING A PUT */
    DCL (M, N) FIXED BIN(31);
    DCL ODD ENTRY(FIXED BIN(31)) RETURNS(BIT(1));
    DCL V FIXED BIN(31) INIT(15);
    DCL B BIT(1);
    PUT SKIP LIST('MOD', MOD(V, 2), MOD(V, 2) = 1);
    B = ODD(V);
    PUT SKIP LIST('ODD', B, ODD(V));
    IF ODD(V) THEN PUT SKIP LIST('IF ODD');
    M = 17; N = 5;
    PUT SKIP LIST('MODS', MOD(M,N), MOD(-M,N), MOD(M,-N), MOD(-M,-N));
 ODD: PROC(X) RETURNS(BIT(1));
    DCL X FIXED BIN(31);
    PUT SKIP LIST('IN ODD', X, MOD(X, 2) = 1);
    RETURN(MOD(X, 2) = 1);
 END ODD;
 END T18MOD;
