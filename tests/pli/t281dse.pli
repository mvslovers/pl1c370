 T281DSE: PROC OPTIONS(MAIN);
   /* DISPLAY ... REPLY ... EVENT (GC28-8201-4; #228 TIER 1): THE
      PROGRAM GOES ON WHILE THE REPLY IS OUTSTANDING, AND WAIT WAITS
      FOR IT.  THE REPLIES COME FROM T281DSE.REPLY */
   DCL (E1, E2) EVENT;
   DCL (R1, R2) CHAR(8);
   DISPLAY('T281DSE FIRST') REPLY(R1) EVENT(E1);
   PUT SKIP LIST('AFTER THE FIRST DISPLAY');
   WAIT(E1);
   PUT SKIP LIST('<' || R1 || '>', COMPLETION(E1), STATUS(E1));
   DISPLAY('T281DSE SECOND') REPLY(R2) EVENT(E2);
   DISPLAY('T281DSE THIRD') REPLY(R1) EVENT(E1);
   PUT SKIP LIST('TWO OUTSTANDING');
   WAIT(E1, E2);
   PUT SKIP LIST('<' || R1 || '>', '<' || R2 || '>');
   PUT SKIP LIST(COMPLETION(E1), COMPLETION(E2));
 END T281DSE;
