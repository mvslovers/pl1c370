 (CHECK(A, B, C, ARR, S, L1, L2, SUB, E)):
 T199CHK: PROC OPTIONS(MAIN);
   DCL A FIXED BIN(15) INIT(1), B FLOAT DEC(6), C CHAR(5);
   DCL ARR(3) FIXED BIN(15) INIT((3)0), 1 S, 2 X FIXED BIN(15),
       2 Y CHAR(2), D FIXED BIN(15), E FLOAT DEC(6) STATIC;
   PUT SKIP LIST('START');
   A = 2;
   A = A;
   B = 1.5;
   C = 'HELLO';
   ARR(2) = 7;
   ARR = 1;
   S.X = 3;
   D = 4;
 L1: PUT SKIP LIST('AT L1');
   CALL SUB;
   DO A = 1 TO 2;
   END;
   GET LIST(A, C);
   ON CHECK(A) PUT SKIP LIST('ON CHECK A', A, ONCODE);
   A = 5;
   SIGNAL CHECK(A);
   ON CHECK(L2) PUT SKIP LIST('ON CHECK L2', ONCODE);
 L2: PUT SKIP LIST('AT L2');
   ON CHECK(SUB) PUT SKIP LIST('ON CHECK SUB', ONCODE);
   CALL SUB;
   REVERT CHECK(A);
   A = 6;
   SIGNAL CHECK(A);
   SIGNAL CHECK(L2);
   E = 1.25E0;
   PUT SKIP LIST('END');
   RETURN;
 SUB: PROC;
   PUT SKIP LIST('IN SUB');
   A = 9;
 END SUB;
 END T199CHK;
