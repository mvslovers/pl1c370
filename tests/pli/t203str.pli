 T203STR: PROC OPTIONS(MAIN);
   DCL 1 S, 2 A CHAR(2) INIT('AB'), 2 B CHAR(3) INIT('CDE');
   DCL 1 T, 2 X(3) CHAR(1) INIT('X', 'Y', 'Z'), 2 Y CHAR(2) INIT('PQ');
   DCL 1 BS, 2 B1 BIT(3) INIT('101'B), 2 B2 BIT(5) INIT('11000'B);
   DCL R(3) CHAR(2) INIT('R1', 'R2', 'R3'), C CHAR(5) INIT('HELLO');
   DCL V CHAR(20) VARYING, BV BIT(16) VARYING;
   V = STRING(S);
   PUT SKIP LIST(V, LENGTH(STRING(S)));
   PUT SKIP LIST(STRING(T), STRING(R), STRING(C));
   BV = STRING(BS);
   PUT SKIP LIST(BV, LENGTH(BV));
   STRING(S) = 'VWXYZ';
   PUT SKIP LIST(A, B);
   STRING(S) = 'QR';
   PUT SKIP LIST(A || '|', B || '|');
   STRING(T) = '1234567';
   PUT SKIP LIST(X, Y);
   STRING(R) = 'ABCDEF';
   PUT SKIP LIST(R);
   STRING(BS) = '01110011'B;
   PUT SKIP LIST(B1, B2);
   PUT SKIP LIST(STRING(S) || '!', SUBSTR(STRING(T), 2, 3));
 END T203STR;
