 T66SQRT: PROC OPTIONS(MAIN);
   DCL (A,B) FLOAT DEC(6), (C,D) FLOAT DEC(16),
       N FIXED BIN(15) INIT(0);
   DCL I FIXED BIN(31) INIT(2), P FIXED DEC(5,2) INIT(2.25);
   ON ERROR BEGIN;
     N = N + 1;
     PUT SKIP LIST('ERR', ONCODE, N);
     IF N = 1 THEN GO TO L1;
     GO TO L2;
   END;
   A = 2; C = 2; B = SQRT(A); D = SQRT(C); PUT SKIP LIST(A, B, D);
   A = 0.5; C = 0.5; B = SQRT(A); D = SQRT(C); PUT SKIP LIST(A, B, D);
   A = 1E10; C = 1E10; B = SQRT(A); D = SQRT(C); PUT SKIP LIST(A, B,
       D);
   A = 0; C = 0; B = SQRT(A); D = SQRT(C); PUT SKIP LIST(A, B, D);
   PUT SKIP LIST(SQRT(I), SQRT(P), SQRT(2.0E0), SQRT(16));
   B = SQRT(-1E0);
 L1: D = SQRT(-4.000000000000000E0);
 L2: PUT SKIP LIST('DONE');
 END T66SQRT;
