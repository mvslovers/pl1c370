 T283EIW: PROC OPTIONS(MAIN);
   /* WRITE ... EVENT TO AN UNBUFFERED FILE, THEN READ IT BACK
      (#228) */
   DCL F FILE RECORD SEQUENTIAL UNBUFFERED;
   DCL R CHAR(80);
   DCL (E1, E2) EVENT;
   OPEN FILE(F) OUTPUT;
   R = 'ONE';
   WRITE FILE(F) FROM(R) EVENT(E1);
   WAIT(E1);
   R = 'TWO';
   WRITE FILE(F) FROM(R) EVENT(E2);
   WAIT(E2);
   PUT SKIP LIST('WRITTEN', COMPLETION(E1), COMPLETION(E2));
   CLOSE FILE(F);
   OPEN FILE(F) INPUT;
   READ FILE(F) INTO(R) EVENT(E1);
   WAIT(E1);
   PUT SKIP LIST(SUBSTR(R, 1, 5));
   READ FILE(F) INTO(R) EVENT(E1);
   WAIT(E1);
   PUT SKIP LIST(SUBSTR(R, 1, 5));
   CLOSE FILE(F);
 END T283EIW;
