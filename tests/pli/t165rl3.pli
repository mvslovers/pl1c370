 T165RL3: PROC OPTIONS(MAIN);
   /* matrices, recursion, BY NAME, BOOL, pictures, GET LIST */
   DCL M(3,3) FLOAT DEC(6), V(3) FLOAT DEC(6), R(3) FLOAT DEC(6);
   DCL (I, J, N) FIXED BIN(15);
   DCL 1 IN, 2 QTY FIXED DEC(5), 2 PRICE FIXED DEC(7,2),
         2 NAME CHAR(8);
   DCL 1 OUT, 2 NAME CHAR(8), 2 FLAG BIT(1), 2 QTY FIXED DEC(7);
   DCL AMT PIC'$$$,$$9V.99CR', B8 BIT(8);
   DCL FACT ENTRY(FIXED BIN(15)) RETURNS(FIXED DEC(15));
   DCL FIB ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(31));
   GET LIST(N);
   DO I = 1 TO 3;
     DO J = 1 TO 3;
       GET LIST(M(I, J));
     END;
   END;
   GET LIST(V);
   DO I = 1 TO 3;
     R(I) = 0;
     DO J = 1 TO 3;
       R(I) = R(I) + M(I, J) * V(J);
     END;
   END;
   PUT SKIP LIST('M*V', R);
   M = M * 2;
   PUT SKIP LIST('DIAG', M(1,1), M(2,2), M(3,3));
   PUT SKIP LIST('FACT', N, FACT(N));
   PUT SKIP LIST('FIB', FIB(10));
   IN.QTY = 12; IN.PRICE = 3.75; IN.NAME = 'BOLTS';
   OUT = IN, BY NAME;
   PUT SKIP LIST(OUT.NAME, OUT.QTY);
   AMT = -1234.5;
   PUT SKIP EDIT(AMT) (A);
   AMT = 98765.43;
   PUT SKIP EDIT(AMT) (A);
   B8 = BOOL('11001010'B, '10101100'B, '0110');
   PUT SKIP LIST('BOOL XOR', B8);
   DO I = 10 TO 1 BY -3;
     PUT SKIP LIST('DOWN', I);
   END;
 FACT: PROC(K) RETURNS(FIXED DEC(15)) RECURSIVE;
   DCL K FIXED BIN(15);
   IF K <= 1 THEN RETURN(1);
   RETURN(K * FACT(K - 1));
 END FACT;
 FIB: PROC(K) RETURNS(FIXED BIN(31)) RECURSIVE;
   DCL K FIXED BIN(15);
   IF K < 2 THEN RETURN(K);
   RETURN(FIB(K - 1) + FIB(K - 2));
 END FIB;
 END T165RL3;
