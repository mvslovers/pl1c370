 T259ICL: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T259ICL.OPT.PLI: THE CALLS WRITTEN OUT AT
      THE BLOCK'S ENTRY AND AFTER EACH ALLOCATE */
   DCL A(4) FIXED BIN(15);
   DCL C(3) FIXED BIN(15) CONTROLLED;
   DCL N FIXED BIN(15) STATIC INIT(0);
   CALL FILL(A, 7);
   PUT SKIP LIST(A);
   ALLOCATE C; CALL FILL(C, 2);
   PUT SKIP LIST(C, N);
   C(1) = 99;
   ALLOCATE C; CALL FILL(C, 2);
   PUT SKIP LIST(C, N);
   FREE C; PUT SKIP LIST(C(1));
   CALL INNER;
 INNER: PROC;
   DCL B(2) CHAR(3);
   CALL NAME(B);
   PUT SKIP LIST(B);
 END INNER;
 FILL: PROC(X, V);
   DCL X(*) FIXED BIN(15), V FIXED DEC(1), I FIXED BIN(15);
   N = N + 1;
   DO I = LBOUND(X, 1) TO HBOUND(X, 1);
     X(I) = V * I;
   END;
 END FILL;
 NAME: PROC(X);
   DCL X(*) CHAR(3);
   X(1) = 'ONE'; X(2) = 'TWO';
 END NAME;
 END T259ICL;
