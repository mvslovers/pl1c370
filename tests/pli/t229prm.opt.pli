 T229PRM: PROC(PARM) OPTIONS(MAIN);
   /* THE PARM IN THE DEFAULT LANGUAGE (PL/I FOR MVS & VM, SC26-3113-01;
      THE OPTIMIZER, SC33-0006-7): RUN-TIME OPTIONS, '/', THE ARGUMENT.
      THE PARAMETER IS WHAT FOLLOWS THE FIRST '/' */
   DCL PARM CHAR(100) VARYING;
   PUT SKIP LIST(LENGTH(PARM), '<' || PARM || '>');
 END T229PRM;
