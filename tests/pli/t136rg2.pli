 T136RG2: PROC OPTIONS(MAIN);
   /* REGIONAL(2): recorded keys, the search from the start of the
      region's track over the whole data set, dummies left out */
   DCL REG FILE RECORD KEYED ENV(REGIONAL(2));
   DCL REC CHAR(20), KC CHAR(12), K2 CHAR(2), N FIXED BIN(31);
   DCL I FIXED BIN(31), P PIC'99999999';
   DCL KS(7) CHAR(12) INIT('AAAA00000000', 'BBBB00000002',
     'CCCC00000002', 'DDDD00000001', 'EEEE00000005', 'BBBB00000005',
     'FFFF00000006');
   ON KEY(REG) PUT SKIP LIST('KEY', ONCODE);
   OPEN FILE(REG) SEQUENTIAL OUTPUT;
   DO I = 1 TO 7;
     REC = 'REC ' || KS(I);
     WRITE FILE(REG) FROM(REC) KEYFROM(KS(I));
   END;
   CLOSE FILE(REG);
   CALL LIST('CREATED');
   OPEN FILE(REG) DIRECT INPUT;
   CALL RD('AAAA00000000');
   CALL RD('CCCC00000002');
   CALL RD('ZZZZ00000002');
   CALL RD('FFFF00000006');
   CALL RD('FFFF00000100');
   CALL RD('FFFF00000170');
   CALL RD('FFFF00000171');
   CALL RD('AAAA');
   CALL RD('AAAA0');
   CALL RD('AA00000000');
   CALL RD('AAAAAA00000000');
   CALL RD('AAAAX0000000');
   CALL RD('    ');
   CLOSE FILE(REG);
   OPEN FILE(REG) DIRECT UPDATE;
   REC = 'NEW GGGG 0';
   WRITE FILE(REG) FROM(REC) KEYFROM('GGGG00000000');
   REC = 'NEW AAAA 0';
   WRITE FILE(REG) FROM(REC) KEYFROM('AAAA00000040');
   REC = 'REWR EEEE';
   REWRITE FILE(REG) FROM(REC) KEY('EEEE00000005');
   DELETE FILE(REG) KEY('BBBB00000002');
   REC = 'NEW HHHH 2';
   WRITE FILE(REG) FROM(REC) KEYFROM('HHHH00000002');
   DELETE FILE(REG) KEY('QQQQ00000002');
   REWRITE FILE(REG) FROM(REC) KEY('QQQQ00000002');
   REC = 'Z60';
   WRITE FILE(REG) FROM(REC) KEYFROM('ZZZZ00000060');
   REC = 'Y170';
   WRITE FILE(REG) FROM(REC) KEYFROM('YYYY00000170');
   REC = 'SHORT 7';
   WRITE FILE(REG) FROM(REC) KEYFROM('7');
   REC = 'NUM 9';
   I = 9;
   WRITE FILE(REG) FROM(REC) KEYFROM(I);
   CALL RD('AAAA00000003');
   CALL RD('AAAA00000100');
   CALL RD('7   00000005');
   CALL RD('    00000009');
   CALL RD('9');
   CLOSE FILE(REG);
   CALL LIST('UPDATED');
   OPEN FILE(REG) SEQUENTIAL UPDATE;
   READ FILE(REG) INTO(REC) KEYTO(KC);
   READ FILE(REG) INTO(REC) KEYTO(KC);
   REC = 'SEQ REWRITE';
   REWRITE FILE(REG) FROM(REC);
   CLOSE FILE(REG);
   CALL LIST('SEQUPD');
   OPEN FILE(REG) DIRECT OUTPUT;
   DO I = 1 TO 60;
     P = I;
     REC = 'F' || P;
     WRITE FILE(REG) FROM(REC) KEYFROM('FFFF00000100');
   END;
   CLOSE FILE(REG);
   OPEN FILE(REG) DIRECT INPUT;
   CALL RD('FFFF00000100');
   CALL RD('FFFF00000000');
   CALL RD('FFFF00000120');
   CLOSE FILE(REG);
   CALL LIST('DIRECT');
 RD: PROC(K);
   DCL K CHAR(*);
   REC = (20)'?';
   READ FILE(REG) INTO(REC) KEY(K);
   PUT SKIP LIST('READ', K, REC);
 END RD;
 LIST: PROC(T);
   DCL T CHAR(*);
   N = 0;
   OPEN FILE(REG) SEQUENTIAL INPUT;
   ON ENDFILE(REG) GO TO EOF;
   DO WHILE('1'B);
     KC = (12)'?';
     READ FILE(REG) INTO(REC) KEYTO(KC);
     N = N + 1;
     IF N < 12 | N > 56 THEN
       PUT SKIP LIST(T, N, '<' || KC || '>', REC);
   END;
 EOF:
   CLOSE FILE(REG);
   PUT SKIP LIST(T, N);
   OPEN FILE(REG) SEQUENTIAL INPUT;
   READ FILE(REG) INTO(REC) KEYTO(K2);
   PUT SKIP LIST(T, 'K2', '<' || K2 || '>');
   CLOSE FILE(REG);
 END LIST;
 END T136RG2;
