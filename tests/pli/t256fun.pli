 T256FUN: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T256FUN.OPT.PLI: THE FUNCTIONS DECLARED IN
      THE INVOKING BLOCK, CALLED WITHOUT () */
   DCL X FIXED BIN(15), C CHAR(5) VARYING, B BIT(1);
   DCL TWICE ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15)),
       WORD ENTRY RETURNS(CHAR(5) VARYING), NXT ENTRY RETURNS(BIT(1)),
       NXT2 ENTRY RETURNS(FIXED BIN(15));
   X = TWICE(3);
   C = WORD;
   B = NXT;
   PUT SKIP LIST(X, C, B, TWICE(NXT2), NXT2, WORD || '!');
   IF NXT THEN PUT SKIP LIST('NXT');
 TWICE: PROC(N) RETURNS(FIXED BIN(15));
   DCL N FIXED BIN(15);
   RETURN(N + N);
 END TWICE;
 WORD: PROC RETURNS(CHAR(5) VARYING);
   RETURN('AB');
 END WORD;
 NXT: PROC RETURNS(BIT(1));
   RETURN('1'B);
 END NXT;
 NXT2: PROC RETURNS(FIXED BIN(15));
   RETURN(21);
 END NXT2;
 END T256FUN;
