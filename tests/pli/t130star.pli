 T130STR: PROC OPTIONS(MAIN);
   DCL A CHAR(5) INIT('ABCDE'), B CHAR(12) INIT('HELLO WORLD!');
   DCL V CHAR(20) VARYING INIT('VARIABLE'), W CHAR(8) VARYING;
   DCL N FIXED BIN(31);
   DCL SHOW ENTRY(CHAR(*)), FILL ENTRY(CHAR(*), CHAR(*));
   DCL GROW ENTRY(CHAR(*) VARYING);
   DCL LEN ENTRY(CHAR(*)) RETURNS(FIXED BIN(31));
   CALL SHOW(A);
   CALL SHOW(B);
   CALL SHOW('CONSTANT');
   CALL FILL(A, 'XY');
   PUT SKIP LIST('AFTER FILL', A);
   CALL FILL(B, B);
   PUT SKIP LIST('SAME', B);
   CALL GROW(V);
   PUT SKIP LIST('GROWN', V, LENGTH(V));
   W = 'AB';
   CALL GROW(W);
   PUT SKIP LIST('GROWN W', W, LENGTH(W));
   N = LEN(B) + LEN('ABC');
   PUT SKIP LIST('LEN', N);
 SHOW: PROC(S);
   DCL S CHAR(*);
   PUT SKIP LIST('SHOW', S, LENGTH(S), SUBSTR(S, 2, 3));
   IF S = 'ABCDE' THEN PUT LIST('IS ABCDE');
   PUT LIST(S || '!', LENGTH(S || '!'));
   CALL INNER(S);
 END SHOW;
 INNER: PROC(T);
   DCL T CHAR(*);
   PUT SKIP LIST('INNER', T, LENGTH(T));
 END INNER;
 FILL: PROC(T, X);
   DCL (T, X) CHAR(*);
   T = X;
   PUT SKIP LIST('FILL', T, LENGTH(T), X, LENGTH(X));
 END FILL;
 GROW: PROC(G);
   DCL G CHAR(*) VARYING;
   G = G || '+MORE+MORE';
 END GROW;
 LEN: PROC(Z) RETURNS(FIXED BIN(31));
   DCL Z CHAR(*);
   RETURN(LENGTH(Z));
 END LEN;
 END T130STR;
