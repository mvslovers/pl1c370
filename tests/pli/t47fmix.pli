 T47FMIX: PROC OPTIONS(MAIN);
   /* FLOAT in structures, records, STATIC, functions and defaults */
   DCL REPORT FILE RECORD OUTPUT;
   DCL 1 R, 2 C CHAR(1), 2 S FLOAT DEC(6), 2 L FLOAT DEC(16),
            2 H FIXED BIN(15), 2 B FLOAT BIN(21);
   DCL T(3) FLOAT STATIC INIT(1.5, -2.25E1, 0.1);
   DCL U FLOAT DEC(16) STATIC INIT(0.1);
   DCL (V, W) DECIMAL, Q BINARY;
   DCL (X, KK);
   DCL F ENTRY(FLOAT DEC(16)) RETURNS(FLOAT DEC(16));
   DCL G ENTRY(FLOAT) RETURNS(FLOAT);
   DCL ST CHAR(30) VAR;
   R.C = 'A'; R.S = 3.25; R.L = -1.5E-3; R.H = 7; R.B = 1E-2;
   WRITE FILE(REPORT) FROM(R);
   PUT SKIP LIST(T(1), T(2), T(3), U);
   V = 2; W = V / 3; Q = W * 3; X = 4; KK = 9;
   PUT SKIP LIST(V, W, Q, X, KK);
   PUT SKIP LIST(F(2.5E0), G(2), F(U));
   ST = 'S=' || R.S;
   PUT SKIP LIST(ST, LENGTH(ST));
   IF R.S > 3 THEN PUT SKIP LIST('GT 3');
   IF R.L < R.H THEN PUT SKIP LIST('L LT H');
   IF T(3) = U THEN PUT SKIP LIST('EQ'); ELSE PUT SKIP LIST('NE');
   ST = '1.5';
   PUT SKIP LIST(R.S + ST, G(ST), R.S * '2.5');
   IF R.S > '3.2' THEN PUT SKIP LIST('GT STR');
 F: PROC(Y) RETURNS(FLOAT DEC(16));
   DCL Y FLOAT DEC(16);
   RETURN(Y * Y - 1);
 END F;
 G: PROC(Z) RETURNS(FLOAT);
   DCL Z FLOAT;
   RETURN(Z / 3);
 END G;
 END T47FMIX;
