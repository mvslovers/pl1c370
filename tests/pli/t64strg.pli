 (STRG): T64STRG: PROC OPTIONS(MAIN);
   DCL S CHAR(6) INIT('ABCDEF'), T CHAR(10) VAR, (I, J) FIXED BIN(15);
   ON STRINGRANGE PUT SKIP LIST('STRG', ONCODE);
   I = 5; J = 4;
   T = SUBSTR(S, I, J);
   PUT SKIP LIST('A', T, LENGTH(T));
   I = 0; J = 2;
   T = SUBSTR(S, I, J);
   PUT SKIP LIST('B', T, LENGTH(T));
   I = 7;
   T = SUBSTR(S, I);
   PUT SKIP LIST('C', T, LENGTH(T));
   I = 3; J = -1;
   T = SUBSTR(S, I, J);
   PUT SKIP LIST('D', T, LENGTH(T));
   REVERT STRINGRANGE;
   I = 5; J = 9;
   T = SUBSTR(S, I, J);
   PUT SKIP LIST('E', T, LENGTH(T));
 END T64STRG;
