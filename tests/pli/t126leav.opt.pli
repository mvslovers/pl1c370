 T126LEA: PROC OPTIONS(MAIN);
   DCL (I, J, N) FIXED BIN(31), S CHAR(100) VARYING;
   DCL 1 E BASED(P), 2 V FIXED BIN(31), 2 NX PTR;
   DCL (P, HEAD, LAST) PTR;
   DO I = 1 TO 10;
     IF I = 4 THEN LEAVE;
     PUT SKIP LIST('LOOP', I);
   END;
   PUT SKIP LIST('AFTER', I);
   A: DO I = 1 TO 3;
     DO J = 1 TO 3;
       IF J = 2 THEN LEAVE;
       IF I = 3 THEN LEAVE A;
       PUT SKIP LIST('INNER', I, J);
     END;
     PUT SKIP LIST('OUTER', I);
   END A;
   PUT SKIP LIST('LEFT A', I, J);
   DO;
     PUT SKIP LIST('GROUP');
     LEAVE;
     PUT SKIP LIST('NOT REACHED');
   END;
   N = 0;
   DO UNTIL(N > 5);
     N = N + 2;
   END;
   PUT SKIP LIST('UNTIL', N);
   N = 10;
   DO UNTIL(N > 5);
     N = N + 1;
   END;
   PUT SKIP LIST('AT LEAST ONCE', N);
   DO WHILE(N < 40) UNTIL(MOD(N, 7) = 0);
     N = N + 1;
   END;
   PUT SKIP LIST('WHILE UNTIL', N);
   DO I = 1 TO 10 UNTIL(I * I > 30);
   END;
   PUT SKIP LIST('TO UNTIL', I);
   S = '';
   DO I = 1 REPEAT 2 * I UNTIL(I = 64);
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('REPEAT', S, I);
   S = '';
   DO I = 1 REPEAT I * 3 WHILE(I < 100);
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('REPEAT WHILE', S, I);
   S = '';
   DO I = 1 TO 3, 10 REPEAT I + 5 UNTIL(I >= 20);
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('SPECS', S, I);
   HEAD = NULL;
   DO I = 1 TO 4;
     ALLOCATE E SET(P);
     P->V = I * 100;
     P->NX = NULL;
     IF HEAD = NULL THEN HEAD = P;
     ELSE LAST->NX = P;
     LAST = P;
   END;
   DO P = HEAD REPEAT P->NX WHILE(P ¬= NULL);
     PUT SKIP LIST('CHAIN', P->V);
   END;
   DO I = 1 TO 5;
     SELECT;
       WHEN (I = 3) LEAVE;
       OTHERWISE PUT SKIP LIST('SELECT IN DO', I);
     END;
   END;
   PUT SKIP LIST('END', I);
 END T126LEA;
