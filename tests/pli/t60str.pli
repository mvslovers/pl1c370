 T60STR: PROC OPTIONS(MAIN);
   DCL L CHAR(40) VAR, C CHAR(30), I FIXED BIN(31), D FIXED DEC(5,1);
   DCL (P, Q) CHAR(4);
   PUT STRING(C) LIST(12, 'AB', 3.5);
   PUT SKIP LIST('[' || C || ']');
   PUT STRING(L) EDIT('X=', 42, 'Y') (A, F(4), A);
   PUT SKIP LIST('[' || L || ']', LENGTH(L));
   C = '17 2.5 ''TEXT''';
   GET STRING(C) LIST(I, D, P);
   PUT SKIP LIST(I, D, P);
   C = 'ABCD1234';
   GET STRING(C) EDIT(P, Q) (A(4), A(4));
   PUT SKIP LIST(P, Q);
   PUT STRING(C) DATA(I, D);
   PUT SKIP LIST('[' || C || ']');
   PUT STRING(L) LIST(12, 'AB');
   PUT SKIP LIST('[' || L || ']', LENGTH(L));
   PUT STRING(L) DATA(I);
   PUT SKIP LIST('[' || L || ']', LENGTH(L));
 END T60STR;
