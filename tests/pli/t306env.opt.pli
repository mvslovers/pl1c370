 T306ENV: PROC OPTIONS(MAIN);
   /* ENVIRONMENT THE WAY OF PL/I FOR MVS & VM: FB, VB WITH RECSIZE
      AND BLKSIZE, SCALARVARYING, TOTAL; THE .PLI SPELLS IT OUT */
   DCL O1 FILE RECORD OUTPUT ENV(FB RECSIZE(20) BLKSIZE(100) TOTAL);
   DCL I1 FILE RECORD INPUT ENV(FB RECSIZE(20) BLKSIZE(100));
   DCL O2 FILE RECORD OUTPUT ENV(VB RECSIZE(40) BLKSIZE(200));
   DCL I2 FILE RECORD INPUT ENV(VB RECSIZE(40) BLKSIZE(200));
   DCL O3 FILE RECORD OUTPUT
         ENV(V RECSIZE(40) BLKSIZE(44) SCALARVARYING);
   DCL I3 FILE RECORD INPUT
         ENV(V RECSIZE(40) BLKSIZE(44) SCALARVARYING);
   DCL I4 FILE RECORD INPUT ENV(V RECSIZE(40) BLKSIZE(44));
   DCL C CHAR(20);
   DCL VS CHAR(30) VAR;
   DCL W CHAR(40) VAR;
   DCL I FIXED BIN(15);
   OPEN FILE(O1) TITLE('D1');
   DO I = 1 TO 3;
     C = 'RECORD ' || CHAR(I);
     WRITE FILE(O1) FROM(C);
   END;
   CLOSE FILE(O1);
   OPEN FILE(I1) TITLE('D1');
   DO I = 1 TO 3;
     READ FILE(I1) INTO(C);
     PUT SKIP LIST(C);
   END;
   CLOSE FILE(I1);
   OPEN FILE(O2) TITLE('D2');
   VS = 'SHORT'; WRITE FILE(O2) FROM(VS);
   VS = 'A LONGER ONE, 25 LETTERS'; WRITE FILE(O2) FROM(VS);
   CLOSE FILE(O2);
   OPEN FILE(I2) TITLE('D2');
   READ FILE(I2) INTO(W); PUT SKIP LIST(LENGTH(W), W);
   READ FILE(I2) INTO(W); PUT SKIP LIST(LENGTH(W), W);
   CLOSE FILE(I2);
   OPEN FILE(O3) TITLE('D3');
   VS = 'ABC'; WRITE FILE(O3) FROM(VS);
   VS = 'HELLO WORLD'; WRITE FILE(O3) FROM(VS);
   CLOSE FILE(O3);
   OPEN FILE(I3) TITLE('D3');
   READ FILE(I3) INTO(VS); PUT SKIP LIST(LENGTH(VS), VS);
   READ FILE(I3) INTO(VS); PUT SKIP LIST(LENGTH(VS), VS);
   CLOSE FILE(I3);
   OPEN FILE(I4) TITLE('D3');
   READ FILE(I4) INTO(W);
   PUT SKIP LIST(LENGTH(W), UNSPEC(SUBSTR(W,1,2)), SUBSTR(W,3));
   CLOSE FILE(I4);
 END T306ENV;
