 T280DLY: PROC OPTIONS(MAIN);
   /* THE COUNT OF WAIT (#3): 0, NEGATIVE, LARGER THAN THE LIST, ALL
      EVENTS COMPLETE; AND DELAY */
   DCL (E1, E2) EVENT;
   DCL N FIXED BIN(15);
   COMPLETION(E1) = '1'B;
   COMPLETION(E2) = '1'B;
   WAIT(E1, E2) (0);
   PUT SKIP LIST('COUNT 0');
   N = -1;
   WAIT(E1, E2) (N);
   PUT SKIP LIST('COUNT -1');
   N = 5;
   WAIT(E1, E2) (N);
   PUT SKIP LIST('COUNT 5');
   DELAY(0);
   PUT SKIP LIST('DELAY 0');
   DELAY(-1);
   PUT SKIP LIST('DELAY -1');
   DELAY(10.7);
   PUT SKIP LIST('DELAY 10.7');
   DELAY(250);
   PUT SKIP LIST('DELAY 250');
 END T280DLY;
