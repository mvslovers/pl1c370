 T28CONV: PROC OPTIONS(MAIN);
   DCL X FIXED DEC(5);
   DCL N FIXED BIN(15) INIT(0);
   DCL S CHAR(4) INIT('12A4');
   DCL T CHAR(2) INIT('ZZ');
   DCL U CHAR(1) INIT('Q');
   ON CONVERSION BEGIN;
     N = N + 1;
     PUT SKIP LIST('CONV', ONCODE, ONCHAR, ONSOURCE);
     ONCHAR = '3';
   END;
   X = S;
   PUT SKIP LIST('X', X, N, S);
   ON CONVERSION BEGIN;
     N = N + 1;
     PUT SKIP LIST('CONV2', ONCODE, ONSOURCE);
     ONSOURCE = '77';
   END;
   X = T;
   PUT SKIP LIST('X', X, N, T);
   X = U || '1';
   PUT SKIP LIST('X', X, N);
   X = 5 + T;
   PUT SKIP LIST('X', X, N);
 END T28CONV;
