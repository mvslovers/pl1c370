 T133ARC: PROC OPTIONS(MAIN);
   DCL REPORT FILE RECORD;
   DCL A AREA(64) BASED(AP), B AREA(64) BASED(BP), (AP, BP) PTR;
   DCL 1 N BASED(P), 2 V FIXED BIN(31), 2 NX OFFSET(A);
   DCL (P, Q) PTR, (O1, O2) OFFSET(A), OB OFFSET(B);
   ALLOCATE A;
   ALLOCATE B;
   ALLOCATE N IN(A) SET(P);
   P->V = 111;
   O1 = P;
   ALLOCATE N IN(A) SET(Q);
   Q->V = 222;
   P->NX = Q;
   Q->NX = NULLO;
   OPEN FILE(REPORT) OUTPUT;
   WRITE FILE(REPORT) FROM(A);
   CLOSE FILE(REPORT);
   OPEN FILE(REPORT) INPUT;
   READ FILE(REPORT) INTO(B);
   CLOSE FILE(REPORT);
   OB = O1;
   P = OB;
   PUT SKIP LIST('FIRST', P->V);
   P = P->NX;
   PUT SKIP LIST('SECOND', P->V, P->NX = NULLO);
   ALLOCATE N IN(B) SET(P);
   OB = P;
   PUT SKIP LIST('THIRD', UNSPEC(OB));
 END T133ARC;
