 T309LIN: PROC OPTIONS(MAIN);
   /* THE LINE OPTION AND THE LINE FORMAT ITEM */
   DCL N FIXED BIN(15) INIT(0);
   PUT PAGE LIST('PAGE 1');
   PUT LINE(5) LIST('LINE 5');
   PUT LIST('MORE');
   PUT LINE(5) LIST('LINE 5 AGAIN');
   PUT LINE(3) LIST('LINE 3');
   PUT SKIP(0) LIST('OVER');
   PUT LINE(0) LIST('LINE 0');
   PUT SKIP LIST('NEXT');
   PUT LINE(9) EDIT('EDIT 9')(A);
   PUT EDIT('X', 'Y')(A, LINE(12), A);
   PUT EDIT('Z')(LINE(12), A);
   PUT SKIP;
   PUT LINE(14);
   PUT LINE(14) LIST('L14');
   PUT LINE(70) LIST('LINE 70');
   PUT SKIP LIST('END');
 END T309LIN;
