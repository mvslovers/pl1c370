 T138OKY: PROC OPTIONS(MAIN);
   /* ONKEY: the key of a KEY or RECORD condition, by organisation */
   DCL R1 FILE RECORD KEYED ENV(REGIONAL(1));
   DCL R2 FILE RECORD KEYED ENV(REGIONAL(2));
   DCL IX FILE RECORD KEYED ENV(INDEXED);
   DCL REC CHAR(20), OK CHAR(30) VARYING, I FIXED BIN(31);
   DCL KC CHAR(5);
   OK = ONKEY;
   PUT SKIP LIST('OUTSIDE', '<' || OK || '>', LENGTH(OK));
   ON KEY(R1) BEGIN;
     OK = ONKEY;
     PUT SKIP LIST('R1', ONCODE, '<' || OK || '>', LENGTH(OK));
   END;
   ON KEY(R2) BEGIN;
     OK = ONKEY;
     PUT SKIP LIST('R2', ONCODE, '<' || OK || '>', LENGTH(OK));
   END;
   ON KEY(IX) BEGIN;
     OK = ONKEY;
     PUT SKIP LIST('IX', ONCODE, '<' || OK || '>', LENGTH(OK));
   END;
   ON RECORD(R1) BEGIN;
     OK = ONKEY;
     PUT SKIP LIST('R1 RECORD', ONCODE, '<' || OK || '>', LENGTH(OK));
   END;
   ON ENDFILE(IX) BEGIN;
     OK = ONKEY;
     PUT SKIP LIST('IX ENDFILE', '<' || OK || '>', LENGTH(OK));
     GO TO DONE;
   END;
   OPEN FILE(R1) DIRECT OUTPUT;
   CLOSE FILE(R1);
   OPEN FILE(R1) DIRECT INPUT;
   READ FILE(R1) INTO(REC) KEY('X7');
   READ FILE(R1) INTO(REC) KEY('AB00000099999');
   READ FILE(R1) INTO(REC) KEY('9999');
   READ FILE(R1) INTO(REC) KEY(' 9999 ');
   I = 12345;
   READ FILE(R1) INTO(REC) KEY(I);
   READ FILE(R1) INTO(KC) KEY('3');
   CLOSE FILE(R1);
   SIGNAL KEY(R1);
   OPEN FILE(R2) DIRECT OUTPUT;
   CLOSE FILE(R2);
   OPEN FILE(R2) DIRECT INPUT;
   READ FILE(R2) INTO(REC) KEY('AAAA00000001');
   READ FILE(R2) INTO(REC) KEY('AA00000000');
   READ FILE(R2) INTO(REC) KEY('AAAAAAAAA00000000');
   READ FILE(R2) INTO(REC) KEY('AAAAX');
   READ FILE(R2) INTO(REC) KEY('AAAA00099999');
   I = 3;
   READ FILE(R2) INTO(REC) KEY(I);
   READ FILE(R2) INTO(REC) KEY('7');
   CLOSE FILE(R2);
   OPEN FILE(IX) SEQUENTIAL OUTPUT;
   REC = 'ONE';
   WRITE FILE(IX) FROM(REC) KEYFROM('K0001');
   WRITE FILE(IX) FROM(REC) KEYFROM('K0001');
   WRITE FILE(IX) FROM(REC) KEYFROM('K0000XYZ');
   CLOSE FILE(IX);
   OPEN FILE(IX) DIRECT INPUT;
   READ FILE(IX) INTO(REC) KEY('ZZ');
   READ FILE(IX) INTO(REC) KEY('K0009ABCDEF');
   CLOSE FILE(IX);
   OPEN FILE(IX) SEQUENTIAL INPUT;
   READ FILE(IX) INTO(REC) KEYTO(KC);
   READ FILE(IX) INTO(REC) KEYTO(KC);
 DONE:
   OK = ONKEY;
   PUT SKIP LIST('AFTER', '<' || OK || '>', LENGTH(OK));
 END T138OKY;
