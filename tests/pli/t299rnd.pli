 T299RND: PROC OPTIONS(MAIN);
   /* ROUND OF FIXED BINARY AT A BINARY DIGIT, AND OF FIXED DECIMAL
      WITH A NEGATIVE DIGIT: PL/I (F)S PRECISION (P+1,Q), -LANG=F */
   DCL B FIXED BIN(31,8) INIT(5.6875);
   DCL C FIXED BIN(15,4) INIT(-2.8125);
   DCL D FIXED BIN(15) INIT(13);
   DCL X FIXED DEC(5,4) INIT(6.6666);
   DCL Y FIXED DEC(7,2) INIT(-12345.67);
   DCL R FIXED BIN(31,8);
   PUT SKIP LIST(ROUND(B,2), ROUND(B,0), ROUND(B,5));
   PUT SKIP LIST(ROUND(C,1), ROUND(C,3), ROUND(D,-1));
   R = ROUND(B,2); PUT SKIP LIST(R, UNSPEC(R));
   R = ROUND(C,1); PUT SKIP LIST(R, UNSPEC(R));
   PUT SKIP LIST(ROUND(X,2), ROUND(Y,-2), ROUND(Y,0), ROUND(Y,1));
   PUT SKIP LIST(ROUND(X,2) + 0, ROUND(6.6666,2));
 END T299RND;
