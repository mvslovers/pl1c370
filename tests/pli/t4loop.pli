 T4LOOP: PROC OPTIONS(MAIN);
    /* ITERATIVE DO, DO WHILE, NESTING */
    DCL (I,J,N) FIXED BIN(15);
    DCL S FIXED DEC(9,2);
    DCL K FIXED BIN(31);
    DO I = 1 TO 5;
       PUT SKIP LIST('I', I);
    END;
    DO I = 10 TO 1 BY -3;
       PUT SKIP LIST('DOWN', I);
    END;
    PUT SKIP LIST('AFTER', I);
    DO I = 5 TO 1;
       PUT SKIP LIST('NEVER');
    END;
    N = 3;
    DO I = 1 TO N * 2 BY 2;
       DO J = 1 TO I;
          PUT LIST(J);
       END;
       PUT SKIP;
    END;
    S = 0;
    DO I = 1 TO 10;
       S = S + 0.25;
    END;
    PUT SKIP LIST('SUM', S);
    K = 1;
    DO WHILE(K < 1000);
       K = K * 3;
    END;
    PUT SKIP LIST('K', K);
 END T4LOOP;
