 T27ZDIV: PROC OPTIONS(MAIN);
   DCL (I,J) FIXED BIN(31);
   DCL (D,E) FIXED DEC(7,2);
   PUT SKIP LIST('ONCODE OUTSIDE', ONCODE);
   ON ZERODIVIDE BEGIN;
     PUT SKIP LIST('ZD UNIT', ONCODE);
   END;
   I = 0; J = 7;
   J = 5 / I;
   PUT SKIP LIST('AFTER BIN');
   D = 0; E = 1;
   E = 3.5 / D;
   PUT SKIP LIST('AFTER DEC');
   J = MOD(5, I);
   PUT SKIP LIST('AFTER MOD');
   SIGNAL ZERODIVIDE;
   PUT SKIP LIST('AFTER SIGNAL', ONCODE);
   ON ZERODIVIDE SYSTEM;
   PUT SKIP LIST('SYSTEM NOW');
   J = 5 / I;
   PUT SKIP LIST('NOT REACHED');
 END T27ZDIV;
