 T53STR: PROC OPTIONS(MAIN);
   DCL S CHAR(10) INIT('HELLO WORL'), V CHAR(12) VAR INIT('ABCABC');
   DCL T CHAR(4), B BIT(8), U BIT(32), H FIXED BIN(31) INIT(193);
   DCL W CHAR(20) VAR, F FLOAT DEC(6) INIT(1.5), D FIXED DEC(5,2);
   PUT SKIP LIST(VERIFY(S, 'HELO'), VERIFY('ABC', 'CBA'));
   PUT SKIP LIST(VERIFY(V, 'AB'), VERIFY(S, ' '), VERIFY('', 'A'));
   PUT SKIP LIST(TRANSLATE(S, 'xy', 'LO'), TRANSLATE(V, 'Q', 'B'));
   W = TRANSLATE(V, 'Z');
   PUT SKIP LIST(LENGTH(W), VERIFY(W, ' '));
   PUT SKIP LIST(REPEAT('AB', 2), REPEAT('X', 0), LENGTH(REPEAT(V,
       1)));
   T = HIGH(4); U = UNSPEC(T); PUT SKIP LIST(U);
   T = LOW(3); U = UNSPEC(T); PUT SKIP LIST(U);
   B = UNSPEC(SUBSTR(S, 1, 1)); PUT SKIP LIST(B);
   U = UNSPEC(H); PUT SKIP LIST(U);
   U = UNSPEC(F); PUT SKIP LIST(U);
   D = -1.25; U = UNSPEC(D); PUT SKIP LIST(U);
   PUT SKIP LIST(LENGTH(HIGH(3)), INDEX(V, 'CA'), SUBSTR(V, 3));
   IF HIGH(2) > 'ZZ' THEN PUT SKIP LIST('HIGH GT');
   IF LOW(1) < ' ' THEN PUT SKIP LIST('LOW LT');
 END T53STR;
