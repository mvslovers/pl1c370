 T117RKY: PROC OPTIONS(MAIN);
   DCL REG FILE RECORD KEYED ENV(REGIONAL(1));
   DCL REC CHAR(20), NXT LABEL, KC CHAR(3);
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE);
     GO TO NXT;
   END;
   OPEN FILE(REG) SEQUENTIAL OUTPUT;
   REC = 'ONE';
   WRITE FILE(REG) FROM(REC) KEYFROM(4);
   NXT = L1;
   WRITE FILE(REG) FROM(REC) KEYFROM(2);
 L1: NXT = L2;
   WRITE FILE(REG) FROM(REC) KEYFROM(4);
 L2: NXT = L3;
   WRITE FILE(REG) FROM(REC) KEYFROM('A');
 L3: CLOSE FILE(REG);
   OPEN FILE(REG) DIRECT INPUT;
   NXT = L4;
   READ FILE(REG) INTO(REC) KEY(999);
 L4: NXT = L5;
   SIGNAL KEY(REG);
 L5: CLOSE FILE(REG);
   OPEN FILE(REG) SEQUENTIAL INPUT;
   READ FILE(REG) INTO(REC) KEYTO(KC);
   READ FILE(REG) INTO(REC) KEYTO(KC);
   PUT SKIP LIST('KC', KC);
   CLOSE FILE(REG);
   PUT SKIP LIST('END');
 END T117RKY;
