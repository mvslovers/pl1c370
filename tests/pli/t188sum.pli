 T188SUM: PROC OPTIONS(MAIN);
   DCL A(5) FIXED DEC(5,2) INIT(1.5, 2.25, -3, 4, 0.75);
   DCL B(4) FIXED BIN(15) INIT(1, 2, 3, 4);
   DCL F(3) FLOAT DEC(6) INIT(1.5E0, 2E0, 4E0);
   DCL L(3) FLOAT DEC(16) INIT(1.1E0, 2.2E0, 3.3E0);
   DCL M(2,3) FIXED BIN(31) INIT(1, 2, 3, 4, 5, 6);
   DCL C(3) CHAR(2) INIT('12', '3', '45');
   DCL X FLOAT DEC(6), U(2) BIT(3) UNAL INIT((2)(1)'101'B);
   PUT SKIP LIST(SUM(A), PROD(A));
   PUT SKIP LIST(SUM(B), PROD(B));
   PUT SKIP LIST(SUM(F), PROD(F));
   PUT SKIP LIST(SUM(L), PROD(L));
   PUT SKIP LIST(SUM(M), PROD(M));
   PUT SKIP LIST(SUM(B * 2), SUM(A + B(1)));
   PUT SKIP LIST(SUM(C), U(2));
   X = SUM(B) / 4;
   PUT SKIP LIST(X);
   PUT SKIP EDIT(SUM(A), PROD(B)) (F(10,3), F(6));
   DCL K FIXED BIN(15) INIT(0), Q(3) FLOAT DEC(6) INIT(1, 3, 4);
 AGAIN:
   PUT SKIP LIST(K, SUM(B) + K);
   K = K + 1;
   IF K < 3 THEN GO TO AGAIN;
   IF K = 3 THEN PUT SKIP LIST(PROD(B) - SUM(B));
   ELSE PUT SKIP LIST(0);
   Q = Q / SUM(Q);
   PUT SKIP LIST(Q);
   PUT SKIP LIST(SUM(Q * SUM(B)));
 END T188SUM;
