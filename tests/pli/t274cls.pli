 T274CLS: PROC OPTIONS(MAIN);
   /* PUT LIST AND PUT DATA OF COMPLEX VALUES (#227, PROBE T227
      Q2CLIST) */
   DCL A COMPLEX DEC FLOAT(5) INIT(17.3+1.5I);
   DCL B COMPLEX DEC FIXED(4,3) INIT(0.133+0.007I);
   DCL C COMPLEX DEC FIXED(5,1) INIT(-12.5-3.25I);
   DCL D COMPLEX DEC FLOAT(6) INIT(-1E10+0I);
   DCL E COMPLEX BIN FIXED(15) INIT(7-8I);
   DCL F COMPLEX BIN FLOAT(53) INIT(1+1I);
   DCL G COMPLEX DEC FIXED(3,0) INIT(0);
   PUT SKIP LIST(A, B, C);
   PUT SKIP LIST(D, E, F, G);
   PUT SKIP LIST(2I);
   PUT SKIP LIST(1+2I);
   PUT SKIP LIST(0.133+0.007I);
   PUT SKIP LIST(-1-1I);
   PUT SKIP LIST(1.5E0+2.5E1I);
   PUT SKIP LIST('ABCDEFGHIJKLMNOPQRSTUVWXYZ',
                 'ABCDEFGHIJKLMNOPQRSTUVW',
                 'ABCDEFGHIJKLMNOPQRSTUVWXY', A, B);
   PUT SKIP DATA(A, C, E);
 END T274CLS;
