 T243FET: PROC OPTIONS(MAIN);
   /* FETCH AND RELEASE OF OPTIONS(ASSEMBLER) ENTRIES (THE OPTIMIZER,
      GC33-0009-4): ASMTST AND ASMVAL ARE LOADED FROM THE STEPLIB AT
      THE FETCH, OR AT THE FIRST CALL OF AN ENTRY THAT A FETCH OR
      RELEASE NAMES, AND DELETED AT THE RELEASE */
   DCL ASMTST ENTRY OPTIONS(ASM RETCODE);
   DCL VAL ENTRY(FIXED BIN(31), FIXED BIN(31)) EXTERNAL('ASMVAL')
     OPTIONS(ASM BYVALUE RETCODE);
   DCL (ONE INIT(1), A INIT(40), B INIT(2), C INIT(0)) FIXED BIN(31);
   FETCH ASMTST;
   CALL ASMTST(ONE, A, B, C);  PUT SKIP LIST(C, PLIRETV);
   RELEASE ASMTST;
   CALL ASMTST(ONE, C, B, A);  PUT SKIP LIST(A, PLIRETV);
   CALL VAL(A, 1);             PUT SKIP LIST(PLIRETV);
   RELEASE VAL, ASMTST;
   RELEASE ASMTST;
   CALL PLIRETC(0);
 END T243FET;
