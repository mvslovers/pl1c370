 T268SRG: PROC OPTIONS(MAIN);
   /* LEAVING A SORT EXIT BY GO TO (#233): AFTER TWO RECORDS E35 GOES
      TO A LABEL OF THE MAIN PROCEDURE.  THE SORT IS FINISHED FIRST,
      THE RETURN CODE VARIABLE IS NOT SET, AND A SECOND SORT WORKS.
      THEN ON-UNITS OF THE MAIN PROCEDURE RAISED IN E35: ZERODIVIDE BY
      A FLOATING DIVIDE AND CONVERSION, BOTH RETURNING NORMALLY */
   DCL RC FIXED BIN(31) INIT(-1);
   DCL (K, N) FIXED BIN(15) STATIC INIT(0);
   DCL (X, Z) FLOAT STATIC INIT(0);
   DCL GONE BIT(1) STATIC INIT('0'B);
   ON ZERODIVIDE PUT SKIP LIST('ZERODIVIDE ON-UNIT');
   ON CONVERSION BEGIN;
     PUT SKIP LIST('CONVERSION ON-UNIT', ONSOURCE);
     ONSOURCE = '0';
   END;
   ON FINISH PUT SKIP LIST('FINISH');
   CALL PLISRTD(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, E15, E35);
   PUT SKIP LIST('RETURNED', RC);
 OUT: PUT SKIP LIST('AT OUT', RC, N);
   N = 0;
   CALL PLISRTD(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, E15, E35);
   PUT SKIP LIST('SECOND SORT', RC, N);
   K = 0;
   CALL PLISRTD(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, E15B, E35B);
   PUT SKIP LIST('THIRD SORT', RC);
 E15: PROC RETURNS(CHAR(80));
   K = K + 1;
   IF MOD(K, 6) = 0 THEN DO;
     CALL PLIRETC(8);
     RETURN('');
   END;
   CALL PLIRETC(12);
   RETURN(SUBSTR('EDCBA', MOD(K, 6), 1));
 END E15;
 E35: PROC(REC);
   DCL REC CHAR(80);
   N = N + 1;
   PUT SKIP LIST('E35', SUBSTR(REC, 1, 1));
   IF N = 2 & GONE = '0'B THEN DO;
     GONE = '1'B;
     GO TO OUT;
   END;
   CALL PLIRETC(4);
 END E35;
 E15B: PROC RETURNS(CHAR(80));
   K = K + 1;
   IF K > 3 THEN DO;
     CALL PLIRETC(8);
     RETURN('');
   END;
   CALL PLIRETC(12);
   RETURN(SUBSTR('C1BXA ', 2 * K - 1, 2));
 END E15B;
 E35B: PROC(REC);
   DCL REC CHAR(80);
   DCL D FIXED DEC(3);
   PUT SKIP LIST('E35B', SUBSTR(REC, 1, 2));
   IF SUBSTR(REC, 1, 1) = 'A' THEN X = 1 / Z;
   IF SUBSTR(REC, 1, 1) = 'B' THEN D = SUBSTR(REC, 2, 1);
   CALL PLIRETC(4);
 END E35B;
 END T268SRG;
