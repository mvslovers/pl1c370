 T233MVS: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T233MVS.OPT.PLI: THE VALUES SC26-3114-01
      GIVES (DATETIME: 17 DIGITS, THE DATE OF DATE, THIS CENTURY) */
   DCL C CHAR(4) INIT('PL/I'), C1 CHAR(1) INIT('A'), B BIT(8);
   DCL N FIXED BIN(31), (L3 INIT(3), L17 INIT(17), V0 INIT(0))
     FIXED BIN(15);
   DCL A(4) FIXED BIN(31) INIT(10, 20, 30, 40);
   PUT SKIP LIST(C, L3, '1'B);
   PUT SKIP LIST('''');
   PUT SKIP LIST(UNSPEC(C1));
   B = '10100101'B;  PUT SKIP LIST(B);
   PUT SKIP LIST((32)'0'B);
   N = 0;
   PUT SKIP LIST('0'B, N);
   PUT SKIP LIST(A(3));
   PUT SKIP LIST(A(2));
   N = 8;  PUT SKIP LIST(N);
   PUT SKIP LIST(A(4));
   PUT SKIP LIST(A(3));
   PUT SKIP LIST(L17, V0, '1'B, '1'B);
 END T233MVS;
