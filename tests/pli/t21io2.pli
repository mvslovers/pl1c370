 T21IO2: PROC OPTIONS(MAIN);
    /* GET EDIT IMPLIED POINT, GET LIST TYPES, BEGIN ON-UNIT, GO TO, */
    /* PUT EDIT WITH ARRAYS, TITLE, TWO ON STATEMENTS                */
    DCL D FIXED DEC(7,2);
    DCL E FIXED DEC(7,2);
    DCL C CHAR(4);
    DCL B BIT(3);
    DCL T(4) FIXED BIN(15) INIT(1,22,333,4444);
    DCL N FIXED BIN(15) INIT(0);
    DCL K FIXED BIN(31);
    DCL OUT FILE STREAM OUTPUT;
    GET EDIT(D, E) (F(5,2), X(1), F(6,2));
    PUT SKIP LIST('IMPLIED', D, E);
    GET LIST(D, C, B);
    PUT SKIP LIST('LIST', D, C, B);
    PUT SKIP EDIT(T) (F(6));
    PUT SKIP EDIT(T, 'END') ((4)(F(5), X(1)), A);
    PUT FILE(SYSPRINT) SKIP EDIT('VIA FILE(SYSPRINT)') (A);
    OPEN FILE(OUT) TITLE('REPORT');
    PUT FILE(OUT) EDIT('TITLED', N) (A, F(4));
    CLOSE FILE(OUT);
    ON ENDFILE(SYSIN) BEGIN;
       PUT SKIP LIST('FIRST ON-UNIT', N);
       GO TO DONE;
    END;
 READ: GET LIST(K);
    N = N + 1;
    PUT SKIP LIST('READ', K);
    IF N = 2 THEN ON ENDFILE(SYSIN) BEGIN;
       PUT SKIP LIST('SECOND ON-UNIT');
       GO TO DONE;
    END;
    GO TO READ;
 DONE: PUT SKIP LIST('DONE', N);
 END T21IO2;
