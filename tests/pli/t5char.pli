 T5CHAR: PROC OPTIONS(MAIN);
    /* CHARACTER AND VARYING ASSIGNMENT, LENGTH, STATIC */
    DCL C3 CHAR(3);
    DCL C8 CHAR(8);
    DCL V VARYING CHAR(5);
    DCL W VARYING CHAR(20) INIT('START');
    DCL S STATIC CHAR(6) INIT('STATIC');
    DCL N STATIC FIXED BIN(31) INIT(-17);
    DCL D STATIC FIXED DEC(5,2) INIT(3.5);
    C3 = 'ABCDEF';  PUT SKIP LIST('TRUNC', C3, '|');
    C8 = 'XY';      PUT SKIP LIST('PAD', C8, '|');
    V = 'LONGER THAN FIVE';
    PUT SKIP LIST('VTRUNC', V, LENGTH(V));
    V = '';
    PUT SKIP LIST('VEMPTY', V, LENGTH(V));
    C8 = W;         PUT SKIP LIST('C8=W', C8, '|');
    W = C3;         PUT SKIP LIST('W=C3', W, LENGTH(W));
    PUT SKIP LIST('STATIC', S, N, D);
    N = N + 20;
    PUT SKIP LIST('N', N);
    PUT SKIP LIST('LEN', LENGTH(C8), LENGTH('LITERAL'));
 END T5CHAR;
