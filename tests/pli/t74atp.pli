 T74ATP: PROC OPTIONS(MAIN);
   DCL C16 FLOAT DEC(16), C10 FLOAT DEC(10), C8 FLOAT DEC(8);
   DCL S6 FLOAT DEC(6), S3 FLOAT DEC(3), B53 FLOAT BIN(53);
   C16 = 1; C10 = 1; C8 = 1; S6 = 1; S3 = 1; B53 = 1;
   PUT SKIP LIST(ATAN(C16, 3E0), ATAN(C16, S6));
   PUT SKIP LIST(ATAN(S6, C16), ATAN(C16, C16));
   PUT SKIP LIST(ATAN(C10, S3), ATAN(C8, S3));
   PUT SKIP LIST(ATAN(S3, 3E0), ATAN(S6, 3E0));
   PUT SKIP LIST(ATAN(C16, 3.0E0), ATAN(C16, 3.00000000E0));
   PUT SKIP LIST(ATAN(B53, 3E0), ATAND(C16, C8));
   PUT SKIP LIST(ATAN(C16), ATAN(3E0, C16));
 END T74ATP;
