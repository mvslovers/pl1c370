 T289CFX: PROC OPTIONS(MAIN);
   /* COMPLEX FIXED * AND / (#2): DECIMAL AND BINARY, THE RESULT
      PRECISIONS (THE PUT LIST FIELDS), TRUNCATION, BASES MIXED, REAL
      OPERANDS, FIXEDOVERFLOW, ZERODIVIDE LEFT BY GO TO */
   DCL (P,Q) COMPLEX FIXED DEC(5,2);
   DCL R COMPLEX FIXED DEC(15,4);
   DCL S COMPLEX FIXED DEC(7,1);
   DCL (U,V) COMPLEX FIXED BIN(15);
   DCL W COMPLEX FIXED BIN(31);
   DCL B COMPLEX FIXED BIN(20,4);
   DCL (G,H) COMPLEX FIXED DEC(8);
   DCL K FIXED DEC(5,2) INIT(2.5);
   DCL J FIXED BIN(15) INIT(3);
   DCL NF FIXED BIN(15) INIT(0);
   ON FIXEDOVERFLOW NF = NF + 1;
   P = 1.5+2.25I; Q = 3-0.5I;
   PUT SKIP LIST(P*Q, P/Q);
   R = P/Q; PUT SKIP LIST(R);
   P = 1+2I; Q = 3+4I;
   PUT SKIP LIST(P/Q, Q/P);
   P = 1+1I; Q = 3;
   PUT SKIP LIST(P/Q, Q/P);
   P = 2+3I; Q = 7-5I;
   PUT SKIP LIST(P/Q, -P/Q, P*Q);
   PUT SKIP LIST(P*K, K*P, P/K);
   PUT SKIP LIST(K/P, P*J, J/P);
   U = 3+4I; V = 1-2I;
   PUT SKIP LIST(U*V, U/V, V/U);
   W = U/V; PUT SKIP LIST(W);
   B = 2.5-1.25I;
   PUT SKIP LIST(B*U, U/B, B*P);
   S = P*Q*P; PUT SKIP LIST(S);
   P = P*Q; PUT SKIP LIST(P);
   Q = P/Q; PUT SKIP LIST(Q);
   IF P*Q = Q*P THEN PUT SKIP LIST('EQUAL');
   PUT SKIP LIST(REAL(U*V), IMAG(U*V) + 1, REAL(P/Q));
   G = 12345678+1I; H = 2+3I;
   PUT SKIP LIST(G*H);
   G = 99999999+1I; H = 99999999-1I;
   PUT SKIP LIST(G*H, NF);
   ON ZERODIVIDE BEGIN;
     PUT SKIP LIST('ZERODIVIDE');
     GO TO DONE;
   END;
   Q = 0;
   PUT SKIP LIST(P/Q);
 DONE: PUT SKIP LIST('END');
 END T289CFX;
