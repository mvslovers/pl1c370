*PROCESS INTERRUPT;
 T265INT: PROC OPTIONS(MAIN);
   /* THE INTERRUPT OPTION (SC33-0006-7; #226) IN BATCH: NO ATTENTION
      CAN COME, SO THE EXIT IS NOT ESTABLISHED AND THE POLLS AT THE
      LOOPS, THE GO TO AND THE STREAM I/O FIND NOTHING -- THE PROGRAM
      RUNS AS WITHOUT THE OPTION.  AN ON-UNIT IS THERE, NEVER ENTERED */
   DCL (I, J, N) FIXED BIN(31) INIT(0);
   ON ATTENTION PUT SKIP LIST('ATTENTION?');
   DO I = 1 TO 1000;
     N = N + I;
   END;
   J = 0;
   DO WHILE(J < 500);
     J = J + 1;
   END;
 L: N = N + 1;
   IF N < 500505 THEN GO TO L;
   PUT SKIP LIST(I, J, N);
 END T265INT;
