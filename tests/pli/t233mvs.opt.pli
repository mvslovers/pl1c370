 %PROCESS LANGLVL(SPROG);
 T233MVS: PROC OPTIONS(MAIN);
   /* PL/I FOR MVS & VM (SC26-3114-01): %PROCESS, X AND BX CONSTANTS,
      SYSNULL, POINTERADD, POINTERVALUE, BINARYVALUE (THESE THREE
      WITH LANGLVL(SPROG)), DATETIME */
   DCL C CHAR(4), C1 CHAR(1), B BIT(8), (P, Q, P0) PTR;
   DCL N FIXED BIN(31), X FIXED BIN(31) BASED;
   DCL A(4) FIXED BIN(31) INIT(10, 20, 30, 40);
   DCL D CHAR(17), D6 CHAR(6);
   C = 'D7D361C9'X;
   PUT SKIP LIST(C, LENGTH('C1C2C3'X), ''X = '');
   PUT SKIP LIST('7D'X);
   C1 = 'C1'X;  PUT SKIP LIST(UNSPEC(C1));
   B = 'A5'BX;  PUT SKIP LIST(B);
   P0 = SYSNULL; PUT SKIP LIST(UNSPEC(P0));
   P0 = SYSNULL(); PUT SKIP LIST(P0 = NULL, BINARYVALUE(SYSNULL));
   P = ADDR(A(1));
   Q = POINTERADD(P, 8);         PUT SKIP LIST(Q -> X);
   PUT SKIP LIST(PTRADD(P, 4) -> X);
   N = BINARYVALUE(Q) - BINVALUE(P); PUT SKIP LIST(N);
   Q = POINTERVALUE(BINARYVALUE(P) + 12); PUT SKIP LIST(Q -> X);
   Q = PTRADD(Q, -4);            PUT SKIP LIST(Q -> X);
   D = DATETIME; D6 = DATE;
   PUT SKIP LIST(LENGTH(DATETIME()), VERIFY(D, '0123456789'),
     SUBSTR(D, 3, 6) = D6, SUBSTR(D, 1, 2) = '20');
 END T233MVS;
