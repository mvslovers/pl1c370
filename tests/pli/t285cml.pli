 T285CML: PROC OPTIONS(MAIN);
   /* COMPLEX FLOAT * AND / (#2): SHORT AND LONG, BOTH BRANCHES OF
      THE DIVISION, REAL OPERANDS, NESTING; THE BITS THROUGH UNSPEC */
   DCL (A,B,C) COMPLEX FLOAT DEC(6);
   DCL (D,E,F) COMPLEX FLOAT DEC(16);
   DCL ZA(3) COMPLEX FLOAT DEC(6) INIT(1+2I, -0.5I, 3);
   DCL ZB(3) COMPLEX FLOAT DEC(6) INIT(2-1I, 4+4I, 0.25+0.5I);
   DCL 1 S, 2 N CHAR(1), 2 Z COMPLEX FLOAT BIN(21);
   DCL X FLOAT DEC(6) INIT(2.5);
   DCL Y FLOAT DEC(6);
   DCL I FIXED BIN(15);
   DCL (NO, NU, NZ) FIXED BIN(15) INIT(0);
   ON OVERFLOW NO = NO + 1;
   ON UNDERFLOW NU = NU + 1;
   ON ZERODIVIDE NZ = NZ + 1;
   A = 1.5+2.25I; B = 3-0.5I;
   C = A*B; PUT SKIP LIST(C, UNSPEC(C));
   C = A/B; PUT SKIP LIST(C, UNSPEC(C));
   B = 0.5-3I;
   C = A/B; PUT SKIP LIST(C, UNSPEC(C));
   A = 0.1+0.7I; B = 0.3+0.9I;
   C = A*B; PUT SKIP LIST(C, UNSPEC(C));
   C = A/B; PUT SKIP LIST(C, UNSPEC(C));
   C = B/A; PUT SKIP LIST(C, UNSPEC(C));
   C = A*X; PUT SKIP LIST(C, UNSPEC(C));
   C = X/A; PUT SKIP LIST(C, UNSPEC(C));
   C = A/X; PUT SKIP LIST(C, UNSPEC(C));
   C = A*(X+1); PUT SKIP LIST(C, UNSPEC(C));
   C = A/(X-1); PUT SKIP LIST(C, UNSPEC(C));
   PUT SKIP LIST(A*B*A, (A+B)*(A-B)/(B*2I), A*1I);
   PUT SKIP LIST(A*CONJG(B)/(B+1), 2/A, -A*B);
   D = 0.1+0.7I; E = 0.3+0.9I;
   F = D*E; PUT SKIP LIST(F, UNSPEC(F));
   F = D/E; PUT SKIP LIST(F, UNSPEC(F));
   F = E/D; PUT SKIP LIST(F, UNSPEC(F));
   F = D*A; PUT SKIP LIST(F);
 END T285CML;
