 T306ENV: PROC OPTIONS(MAIN);
   /* ENVIRONMENT THE WAY OF PL/I FOR MVS & VM: FB, VB WITH RECSIZE
      AND BLKSIZE, SCALARVARYING, TOTAL; THE .PLI SPELLS IT OUT */
   DCL O1 FILE RECORD OUTPUT ENV(F(100,20));
   DCL I1 FILE RECORD INPUT ENV(F(100,20));
   DCL O2 FILE RECORD OUTPUT ENV(V(200,40));
   DCL I2 FILE RECORD INPUT ENV(V(200,40));
   DCL O3 FILE RECORD OUTPUT ENV(V(44));
   DCL I4 FILE RECORD INPUT ENV(V(44));
   DCL C CHAR(20);
   DCL VS CHAR(30) VAR;
   DCL W CHAR(40) VAR;
   DCL I FIXED BIN(15);
   DCL 1 R1 UNALIGNED, 2 L FIXED BIN(15) INIT(3),
         2 D CHAR(3) INIT('ABC');
   DCL 1 R2 UNALIGNED, 2 L FIXED BIN(15) INIT(11),
         2 D CHAR(11) INIT('HELLO WORLD');
   OPEN FILE(O1) TITLE('D1');
   DO I = 1 TO 3;
     C = 'RECORD ' || CHAR(I);
     WRITE FILE(O1) FROM(C);
   END;
   CLOSE FILE(O1);
   OPEN FILE(I1) TITLE('D1');
   DO I = 1 TO 3;
     READ FILE(I1) INTO(C);
     PUT SKIP LIST(C);
   END;
   CLOSE FILE(I1);
   OPEN FILE(O2) TITLE('D2');
   VS = 'SHORT'; WRITE FILE(O2) FROM(VS);
   VS = 'A LONGER ONE, 25 LETTERS'; WRITE FILE(O2) FROM(VS);
   CLOSE FILE(O2);
   OPEN FILE(I2) TITLE('D2');
   READ FILE(I2) INTO(W); PUT SKIP LIST(LENGTH(W), W);
   READ FILE(I2) INTO(W); PUT SKIP LIST(LENGTH(W), W);
   CLOSE FILE(I2);
   OPEN FILE(O3) TITLE('D3');
   WRITE FILE(O3) FROM(R1);
   WRITE FILE(O3) FROM(R2);
   CLOSE FILE(O3);
   I = 3; PUT SKIP LIST(I, 'ABC');
   I = 11; PUT SKIP LIST(I, 'HELLO WORLD');
   OPEN FILE(I4) TITLE('D3');
   READ FILE(I4) INTO(W);
   PUT SKIP LIST(LENGTH(W), UNSPEC(SUBSTR(W,1,2)), SUBSTR(W,3));
   CLOSE FILE(I4);
 END T306ENV;
