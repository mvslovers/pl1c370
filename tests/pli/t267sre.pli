 T267SRE: PROC OPTIONS(MAIN);
   /* THE SORT'S EXITS (GC28-6594-7, SORT INTERFACE; #233): IHESRTD,
      E15 AND E35, IHESRTC WITH SORTIN AND AN E35 THAT STOPS AFTER
      TWO RECORDS, IHESRTD WITH NO RECORDS (E35 IS NOT CALLED), AND
      V RECORDS FROM A VARYING E15 TO AN E35 OF CHAR(*) */
   DCL IHESRTD ENTRY(CHAR(30), CHAR(30), FIXED BIN(31), FIXED BIN(31),
                     ENTRY, ENTRY);
   DCL IHESRTC ENTRY(CHAR(30), CHAR(30), FIXED BIN(31), FIXED BIN(31),
                     ENTRY);
   DCL IHESARC ENTRY(FIXED BIN(31));
   DCL RC FIXED BIN(31);
   DCL (K, N) FIXED BIN(15) STATIC INIT(0);
   DCL NAMES(5) CHAR(8) STATIC INIT('DELTA', 'ALPHA', 'ECHO',
                                    'CHARLIE', 'BRAVO');
   DCL W(4) CHAR(12) VARYING STATIC INIT('PEAR', 'APPLEPIE', 'FIG',
                                       'BANANASPLIT');
   RC = -1;
   CALL IHESRTD(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, E15, E35);
   PUT SKIP LIST('RETCODE', RC);
   RC = -1;
   CALL IHESRTC(' SORT FIELDS=(1,8,CH,D) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, E35S);
   PUT SKIP LIST('RETCODE', RC, 'N', N);
   RC = -1;
   CALL IHESRTD(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, NONE, E35);
   PUT SKIP LIST('RETCODE', RC);
   RC = -1;
   K = 0;
   CALL IHESRTD(' SORT FIELDS=(5,3,CH,A) ',
                ' RECORD TYPE=V,LENGTH=(104) ', 50000, RC, E15V, E35V);
   PUT SKIP LIST('RETCODE', RC);
 E15: PROC RETURNS(CHAR(80));
   K = K + 1;
   IF K > 5 THEN DO;
     PUT SKIP LIST('E15 END');
     CALL IHESARC(8);
     RETURN('');
   END;
   PUT SKIP LIST('E15', K);
   CALL IHESARC(12);
   RETURN(NAMES(K));
 END E15;
 E35: PROC(REC);
   DCL REC CHAR(80);
   PUT SKIP LIST('E35', SUBSTR(REC, 1, 8));
   CALL IHESARC(4);
 END E35;
 E35S: PROC(REC);
   DCL REC CHAR(80);
   N = N + 1;
   PUT SKIP LIST('E35S', SUBSTR(REC, 1, 10));
   IF N = 2 THEN CALL IHESARC(8);
   ELSE CALL IHESARC(4);
 END E35S;
 NONE: PROC RETURNS(CHAR(80));
   PUT SKIP LIST('NONE');
   CALL IHESARC(8);
   RETURN('');
 END NONE;
 E15V: PROC RETURNS(CHAR(20) VARYING);
   K = K + 1;
   IF K > 4 THEN DO;
     CALL IHESARC(8);
     RETURN('');
   END;
   CALL IHESARC(12);
   RETURN(W(K));
 END E15V;
 E35V: PROC(REC);
   DCL REC CHAR(*);
   PUT SKIP LIST('E35V <' || REC || '>', LENGTH(REC));
   CALL IHESARC(4);
 END E35V;
 END T267SRE;
