 T44FIM: PROC OPTIONS(MAIN);
   DCL F FLOAT BIN(21) INIT(0.5), G FLOAT BIN(53) INIT(0.5);
   X = 2; Z = X * 1.5;
   PUT SKIP LIST(X, Z);
   F = F / 3; G = G / 3; PUT SKIP LIST(F, G);
   F = 1E0; G = 1E0;
   DO I = 1 TO 5; F = F * 10.5; G = G * 10.5; END;
   PUT SKIP LIST(F, G);
   ON ZERODIVIDE PUT SKIP LIST('ZD', ONCODE);
   F = F / 0;
   PUT SKIP LIST('AFTER');
   F = 2.5E0; G = F - F; PUT SKIP LIST('SIGNIFICANCE', G);
   G = 1E-40; G = G * G; PUT SKIP LIST('UNDERFLOW', G);
   ON UNDERFLOW PUT SKIP LIST('UFL UNIT', ONCODE);
   F = 1E-40; F = F / 1E40; PUT SKIP LIST('AFTER UFL', F);
 END T44FIM;
