 T282EIO: PROC OPTIONS(MAIN);
   /* READ ... EVENT ON AN UNBUFFERED SEQUENTIAL FILE TO ITS END
      (#228 TIER 1): IS ENDFILE RAISED AT THE WAIT OR AT THE READ?
      AND COMPLETION BETWEEN THE READ AND THE WAIT */
   DCL F FILE RECORD SEQUENTIAL UNBUFFERED;
   DCL R CHAR(80);
   DCL E EVENT;
   DCL N FIXED BIN(15) INIT(0);
   OPEN FILE(F) OUTPUT;
   R = 'FIRST';
   WRITE FILE(F) FROM(R);
   R = 'SECOND';
   WRITE FILE(F) FROM(R);
   CLOSE FILE(F);
   OPEN FILE(F) INPUT;
   ON ENDFILE(F) BEGIN;
     PUT SKIP LIST('ENDFILE', ONCODE, COMPLETION(E));
     GO TO DONE;
   END;
   DO WHILE('1'B);
     READ FILE(F) INTO(R) EVENT(E);
     PUT SKIP LIST('READ ISSUED', COMPLETION(E));
     WAIT(E);
     N = N + 1;
     PUT SKIP LIST('WAITED', SUBSTR(R, 1, 8), COMPLETION(E),
                   STATUS(E));
   END;
 DONE: PUT SKIP LIST('RECORDS', N, COMPLETION(E));
 END T282EIO;
