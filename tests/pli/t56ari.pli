 T56ARI: PROC OPTIONS(MAIN);
   DCL D FIXED DEC(7,2) INIT(-12.75), E FIXED DEC(7,2) INIT(3.45);
   DCL I FIXED BIN(31) INIT(-7), J FIXED BIN(15) INIT(5);
   DCL F FLOAT DEC(6) INIT(-2.5), G FLOAT DEC(16) INIT(7.75);
   PUT SKIP LIST(SIGN(D), SIGN(I), SIGN(0), SIGN(F));
   PUT SKIP LIST(BINARY(D, 15, 3), BINARY(E, 20, 5), DECIMAL(I, 5, 0));
   PUT SKIP LIST(DECIMAL(J, 3, 0), DECIMAL(F, 4), BINARY(F, 10));
   PUT SKIP LIST(PRECISION(D, 5, 1), PRECISION(I, 7, 0));
   PUT SKIP LIST(PRECISION(F, 2), PRECISION(E, 3, 2));
   PUT SKIP LIST(ADD(D, E, 9, 3), MULTIPLY(D, E, 10, 4));
   PUT SKIP LIST(DIVIDE(D, E, 10, 4), DIVIDE(I, J, 15, 0));
   PUT SKIP LIST(DIVIDE(F, G, 8), ADD(F, G, 10), MULTIPLY(F, F, 3));
   PUT SKIP LIST(FIXED(F), FLOAT(D), BINARY(D), DECIMAL(I));
   PUT SKIP LIST(FIXED(E), FLOAT(I), DECIMAL(F), BINARY(G));
   PUT SKIP LIST(FLOOR(-0.5E0), CEIL(-0.5E0), TRUNC(-2.5E0),
       CEIL(2.25E0));
   DCL Z FLOAT DEC(6) INIT(0);
   PUT SKIP LIST(FLOOR(-Z), CEIL(-Z), TRUNC(-Z), -Z);
 END T56ARI;
