 T273CDC: PROC OPTIONS(MAIN);
   /* COMPLEX LAYOUT (#227, PROBE T227 Q1CDCL): UNSPEC OF EACH KIND
      WITH KNOWN VALUES, AND A COMPLEX MEMBER AFTER A CHAR(1) IN A
      STRUCTURE */
   DCL A COMPLEX FLOAT DEC(6) INIT(1.5+2I);
   DCL B COMPLEX FLOAT DEC(16) INIT(-1-0.5I);
   DCL C COMPLEX FLOAT BIN(21) INIT(3+4I);
   DCL D COMPLEX FIXED BIN(15) INIT(5-6I);
   DCL E COMPLEX FIXED BIN(31,5) INIT(1.5+0.25I);
   DCL F COMPLEX FIXED DEC(5,2) INIT(12.34-5.67I);
   DCL G COMPLEX FIXED DEC(6,2) INIT(-1.5+2I);
   DCL 1 S, 2 K CHAR(1) INIT('K'), 2 Z COMPLEX FLOAT DEC(6) INIT(1I);
   DCL P POINTER;
   DCL Q FIXED BIN(31) BASED(P);
   PUT SKIP LIST(UNSPEC(A));
   PUT SKIP LIST(UNSPEC(B));
   PUT SKIP LIST(UNSPEC(C));
   PUT SKIP LIST(UNSPEC(D));
   PUT SKIP LIST(UNSPEC(E));
   PUT SKIP LIST(UNSPEC(F));
   PUT SKIP LIST(UNSPEC(G));
   PUT SKIP LIST(A, B, C, D, E, F, G, Z);
 END T273CDC;
