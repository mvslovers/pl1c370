 T104END: PROC OPTIONS(MAIN);
   DCL (I, PG) FIXED BIN(15) INIT(0);
   DCL OUT FILE STREAM OUTPUT PRINT;
   ON ENDPAGE(SYSPRINT) BEGIN;
     PG = PG + 1;
     PUT PAGE LIST('HEADING', PG);
     PUT SKIP;
   END;
   SIGNAL ENDPAGE(SYSPRINT);
   DO I = 1 TO 130;
     PUT SKIP LIST('LINE', I);
   END;
   OPEN FILE(OUT) TITLE('REPORT') PAGESIZE(10);
   DO I = 1 TO 25;
     PUT FILE(OUT) SKIP LIST('OUT', I);
   END;
   CLOSE FILE(OUT);
   PUT SKIP LIST('PAGES', PG);
 END T104END;
