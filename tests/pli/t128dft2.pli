 T128DF2: PROC OPTIONS(MAIN);
   /* what the DEFAULT statements of t128dft2.opt.pli give */
   DCL P1 FIXED DECIMAL(7,2), Q1 FLOAT DECIMAL(10),
       I1 FIXED BINARY(31), R1 CHAR(4), NUMA PICTURE '9999',
       NUMB CHAR(2);
   DCL XY1 FIXED DECIMAL, XYZ1 FIXED DECIMAL;
   P1 = 12345.678;
   Q1 = 1E0 / 7;
   I1 = 123456;
   R1 = 'ABCDEFG';
   NUMA = 42;
   NUMB = 'ABC';
   XY1 = 3.14159;
   XYZ1 = 2.5;
   PUT SKIP LIST('MAIN', P1, Q1, I1, R1, NUMA, NUMB, XY1, XYZ1);
   CALL B;
 B: PROC;
   DCL XYZ2 FLOAT DECIMAL(6), XY2 FIXED DECIMAL,
       P2 FIXED DECIMAL(7,2);
   XYZ2 = 1E0 / 3;
   XY2 = 2.75;
   P2 = 1.555;
   PUT SKIP LIST('B', XYZ2, XY2, P2);
   CALL C;
 C: PROC;
   DCL P3 FIXED DECIMAL(5), Q3 FLOAT DECIMAL(6), J3 FIXED BINARY(15);
   P3 = 1.555;
   Q3 = 1E0 / 3;
   J3 = 7000;
   PUT SKIP LIST('C', P3, Q3, J3);
 END C;
 END B;
 END T128DF2;
