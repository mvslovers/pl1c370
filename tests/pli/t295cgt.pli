 T295CGT: PROC OPTIONS(MAIN);
   /* GET OF COMPLEX TARGETS (#2 C4): GET LIST OF COMPLEX CONSTANTS,
      A REAL TARGET TAKING ONE, GET EDIT WITH C AND WITH F, A REAL
      TARGET MEETING C, GET DATA, A BLANK BEFORE THE CENTRAL SIGN */
   DCL (A,B,C,D,E) COMPLEX FLOAT DEC(6);
   DCL P COMPLEX FIXED DEC(5,2);
   DCL X FLOAT DEC(6);
   DCL N FIXED BIN(15) INIT(0);
   ON CONVERSION BEGIN;
     N = N + 1;
     PUT SKIP LIST('CONVERSION', ONSOURCE, ONCHAR);
     IF N > 6 THEN STOP;
     ONSOURCE = '0';
   END;
   GET LIST(A, B, C, D, E);
   PUT SKIP LIST(A, B, C);
   PUT SKIP LIST(D, E);
   GET LIST(P, X);
   PUT SKIP LIST(P, X);
   GET SKIP EDIT(A, B)(C(F(5),F(5)), C(F(4,1)));
   PUT SKIP LIST(A, B);
   GET SKIP EDIT(C, X)(F(5), F(5));
   PUT SKIP LIST(C, X);
   GET SKIP EDIT(X)(C(F(4)));
   PUT SKIP LIST(X);
   GET SKIP DATA(A, P);
   PUT SKIP LIST(A, P);
   GET SKIP LIST(A);
   PUT SKIP LIST(A);
   PUT SKIP LIST('END');
 END T295CGT;
