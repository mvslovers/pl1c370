 T302BIN: PROC OPTIONS(MAIN);
   /* BINARY CONSTANTS: FIXED BINARY(P,Q) AND FLOAT BINARY(P), IN
      EXPRESSIONS, STATIC AND AUTOMATIC INITIAL, IMAGINARY ONES */
   DCL A FIXED BIN(31,8);
   DCL S FIXED BIN(15) STATIC INIT(1011B);
   DCL T FIXED BIN(31,4) INIT(-101.0111B);
   DCL F FLOAT BIN(21);
   DCL L FLOAT BIN(53) INIT(0.1E-3B);
   DCL Z COMPLEX FIXED BIN(15) INIT(11B+101BI);
   DCL D FIXED DEC(7,3) STATIC INIT(101.011B);
   DCL G FLOAT DEC(6) STATIC INIT(1.1B);
   PUT SKIP LIST(1011B, 101.11B, 0.0001B, -1B);
   PUT SKIP LIST(1011B + 1, 101.11B * 2, 1B / 3);
   A = 101.11B; PUT SKIP LIST(A, UNSPEC(A));
   PUT SKIP LIST(S, T, L);
   PUT SKIP LIST(101.1E5B, 1E-2B, 11111111111111111111111E0B);
   F = 0.1011E2B; PUT SKIP LIST(F, UNSPEC(F));
   PUT SKIP LIST(Z, 101BI, 1.1BI + 1);
   PUT SKIP LIST(1111111111111111111111111111111B);
   PUT SKIP LIST(0.000000000000000000000000000001B);
   PUT SKIP LIST(D, G, -1.1E-1B);
 END T302BIN;
