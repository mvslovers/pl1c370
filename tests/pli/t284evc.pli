 T284EVC: PROC OPTIONS(MAIN);
   /* A CHAR(*) PARAMETER OF A PROCEDURE CALLED ONLY THROUGH AN ENTRY
      PARAMETER (#284): ITS TEMPORARIES MUST HOLD THE ARGUMENT */
   DCL S20 CHAR(20) INIT('ABCDEFGHIJKLMNOPQRST');
   CALL Q(P);
 Q: PROC(E);
   DCL E ENTRY;
   CALL E('ABCDEFGHIJKL');
   CALL E(S20);
   CALL E(S20 || S20 || S20);
 END Q;
 P: PROC(S);
   DCL S CHAR(*);
   PUT SKIP LIST('<' || S || '>', LENGTH(S));
 END P;
 END T284EVC;
