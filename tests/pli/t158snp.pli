 T158SNP: PROC OPTIONS(MAIN);
   DCL F FILE RECORD INPUT, S CHAR(4), X FLOAT DEC(6);
   ON OVERFLOW SNAP BEGIN; END;
   ON UNDERFLOW SNAP BEGIN; END;
   ON FIXEDOVERFLOW SNAP BEGIN; END;
   ON SIZE SNAP BEGIN; END;
   ON CONVERSION SNAP BEGIN; END;
   ON SUBSCRIPTRANGE SNAP BEGIN; END;
   ON STRINGRANGE SNAP BEGIN; END;
   ON ENDFILE(F) SNAP BEGIN; END;
   ON KEY(F) SNAP BEGIN; END;
   ON RECORD(F) SNAP BEGIN; END;
   ON UNDEFINEDFILE(F) SNAP BEGIN; END;
   ON AREA SNAP BEGIN; END;
   ON CONDITION(MINE) SNAP BEGIN; END;
   ON ENDPAGE(SYSPRINT) SNAP BEGIN; END;
   ON FINISH SNAP BEGIN; PUT SKIP LIST('FINISH UNIT'); END;
   SIGNAL OVERFLOW;
   SIGNAL UNDERFLOW;
   SIGNAL FIXEDOVERFLOW;
   SIGNAL SIZE;
   SIGNAL CONVERSION;
   SIGNAL SUBSCRIPTRANGE;
   SIGNAL STRINGRANGE;
   SIGNAL ENDFILE(F);
   SIGNAL KEY(F);
   SIGNAL RECORD(F);
   SIGNAL UNDEFINEDFILE(F);
   SIGNAL AREA;
   SIGNAL CONDITION(MINE);
   SIGNAL ENDPAGE(SYSPRINT);
   BEGIN;
     CALL P;
   END;
 P: PROC;
   ON ZERODIVIDE SNAP BEGIN;
     CALL Q;
   END;
   SIGNAL ZERODIVIDE;
 END P;
 Q: PROC;
   ON CONDITION(INQ) SNAP BEGIN; END;
   SIGNAL CONDITION(INQ);
 END Q;
 END T158SNP;
