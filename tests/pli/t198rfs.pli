 T198RFS: PROC OPTIONS(MAIN);
   /* REFER with READ SET: the bound comes from the record */
   DCL REPORT FILE RECORD;
   DCL 1 W, 2 WN FIXED BIN(31), 2 WV(4) FIXED BIN(31);
   DCL 1 R BASED(P), 2 N FIXED BIN(31), 2 V(K REFER(N)) FIXED BIN(31);
   DCL P PTR, (I, J, K) FIXED BIN(31);
   OPEN FILE(REPORT) OUTPUT;
   DO I = 2, 4, 1;
     WN = I;
     DO J = 1 TO 4; WV(J) = 10 * I + J; END;
     WRITE FILE(REPORT) FROM(W);
   END;
   CLOSE FILE(REPORT);
   OPEN FILE(REPORT) INPUT;
   DO I = 1 TO 3;
     READ FILE(REPORT) SET(P);
     PUT SKIP LIST(P->N, HBOUND(P->V, 1), DIM(P->V, 1));
     PUT SKIP LIST(P->V);
     PUT SKIP LIST(SUM(P->V));
   END;
   CLOSE FILE(REPORT);
 END T198RFS;
