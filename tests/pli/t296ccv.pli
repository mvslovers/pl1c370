 T296CCV: PROC OPTIONS(MAIN);
   /* CHARACTER TO COMPLEX (#2 C4): THE FORMS OF A COMPLEX STRING,
      CONVERSION WITH ONSOURCE AND ONCHAR, FIXED AND FLOAT TARGETS, A
      REAL TARGET TAKING THE REAL PART */
   DCL A COMPLEX FLOAT DEC(6);
   DCL P COMPLEX FIXED DEC(7,2);
   DCL X FLOAT DEC(6);
   DCL S CHAR(20) VAR;
   DCL T(12) CHAR(20) VAR INIT('1+2I', '  -1.5E0+2.5E1I  ', '3I',
       '7', '', '12.345-6.789I', '4+ZZI', '1 +2I', '1+2',
       '-2.5E-1-3I', '+I', '5E2I');
   DCL (I, N) FIXED BIN(15) INIT(0);
   ON CONVERSION BEGIN;
     N = N + 1;
     PUT SKIP LIST('CONVERSION', ONSOURCE, ONCHAR);
     IF N > 6 THEN STOP;
     ONSOURCE = '0';
   END;
   DO I = 1 TO 12;
     S = T(I);
     A = S;
     PUT SKIP LIST(I, A);
   END;
   S = T(6); P = S; PUT SKIP LIST(P);
   S = T(1); X = S; PUT SKIP LIST(X);
   S = T(7); X = S; PUT SKIP LIST(X);
   S = T(1); X = S + 1; PUT SKIP LIST(X);
   PUT SKIP LIST('END');
 END T296CCV;
