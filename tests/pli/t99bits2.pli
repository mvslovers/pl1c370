 T99BITS2: PROC OPTIONS(MAIN);
   DCL V BIT(100) VARYING, U BIT(100) VARYING, B8 BIT(8);
   DCL LONG BIT(36) INIT('111100001111000011110000111100001111'B);
   DCL 1 S, 2 F BIT(40), 2 G BIT(12) VARYING;
   DCL (I, J) FIXED BIN(15);
   DCL SHOW ENTRY(BIT(100) VARYING);
   V = ''B;
   DO I = 1 TO 5;
     V = V || '10'B || SUBSTR(LONG, I, I);
   END;
   PUT SKIP LIST(V, LENGTH(V));
   DO I = 1 TO 3;
     J = 2 * I;
     PUT SKIP LIST(SUBSTR(V, I, J), SUBSTR(LONG, 30 + I));
   END;
   U = ¬V; PUT SKIP LIST(U);
   IF U < V THEN PUT SKIP LIST('U LT V');
   IF SUBSTR(U, 1, 3) = '011'B THEN PUT SKIP LIST('PREFIX');
   B8 = LONG; PUT SKIP LIST(B8);
   B8 = SUBSTR(LONG, 3, 8) & '11110000'B; PUT SKIP LIST(B8);
   S.F = LONG; S.G = SUBSTR(LONG, 5, 12) | '1'B;
   PUT SKIP DATA(S);
   CALL SHOW(V);
   CALL SHOW(SUBSTR(LONG, 1, 4) || S.G);
 SHOW: PROC(X);
   DCL X BIT(100) VARYING;
   PUT SKIP LIST('SHOW', X, LENGTH(X));
 END SHOW;
 END T99BITS2;
