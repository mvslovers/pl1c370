 T219INI: PROC OPTIONS(MAIN);
   /* INITIAL: '*' leaves an element as it is, iteration factors of
      '*' and expressions (Q1INIA, Q4INIX, Q5INIF) */
   DCL P ENTRY(FIXED BIN(15));
   DCL A(4) FIXED BIN(15) INIT(1, *, 3, *);
   DCL B(5) FIXED BIN(15) INIT((2) *, (3) 9);
   DCL S(3) FIXED BIN(15) STATIC INIT(5, *, 7);
   A(2) = 22; A(4) = 44; B(1) = 1; B(2) = 2; S(2) = 6;
   PUT LIST(A, B, S);
   CALL P(3);
   CALL P(1);
   CALL P(6);
   CALL P(0);
 P: PROC(M);
   DCL M FIXED BIN(15);
   DCL D(4) FIXED BIN(15) INIT((M) 7, (4) 8);
   DCL E FIXED BIN(15) INIT(-5), F FIXED DEC(5,1) INIT(+2.5);
   PUT SKIP LIST(D, E, F);
 END P;
 END T219INI;
