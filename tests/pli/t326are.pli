 T326ARE: PROC OPTIONS(MAIN);
   /* TIER 130: A CONTROLLED AREA WHOSE SIZE IS AN EXPRESSION,
      EVALUATED AT EACH ALLOCATE */
   DCL N FIXED BIN(15) INIT(3);
   DCL 1 L BASED(P), 2 K FIXED BIN(31), 2 C CHAR(12);
   DCL (P, Q) PTR;
   DCL A AREA((16 + 8) * N) CTL;
   DCL I FIXED BIN(15), Z FIXED BIN(31);
   ALLOCATE A;
   Z = (16 + 8) * N + 16; PUT SKIP LIST(Z);
   ON AREA GO TO FULL;
   DO I = 1 TO 5;
      ALLOCATE L IN(A) SET(P);
      K = I; C = 'ITEM';
      IF I = 1 THEN Q = P;
   END;
 FULL:
   PUT SKIP LIST(I, Q -> K);
   N = 10;
   ALLOCATE A;
   Z = (16 + 8) * N + 16; PUT SKIP LIST(Z);
   A = EMPTY;
   ALLOCATE L IN(A) SET(P);
   K = 42;
   PUT SKIP LIST(P -> K);
   FREE A;
   Z = (16 + 8) * 3 + 16; PUT SKIP LIST(Z, ALLOCATION(A));
   FREE A;
 END T326ARE;
