 T263NOD: PROC OPTIONS(MAIN);
   /* PLIDUMP WITHOUT A DD, SPELLED OUT: THE MESSAGE IBM013I EACH TIME,
      THEN GOING ON (C) OR THE END WITHOUT FINISH (S, CODE 1000:
      T263NOD.CC); PL/I (F)'S IHEDUMX WOULD END IN AN ABEND */
   DCL QUIET BIT(1) INIT('0'B);
   ON FINISH BEGIN;
     IF QUIET = '0'B THEN PUT SKIP LIST('FINISH');
   END;
   PUT SKIP LIST('BEFORE');
   PUT SKIP;
   PUT SKIP LIST('IBM013I NO SUITABLE PLIDUMP DD CARD.');
   PUT SKIP;
   PUT SKIP LIST('AFTER C');
   PUT SKIP;
   PUT SKIP LIST('IBM013I NO SUITABLE PLIDUMP DD CARD.');
   QUIET = '1'B;
   STOP;
 END T263NOD;
