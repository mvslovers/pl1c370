 T190POL: PROC OPTIONS(MAIN);
   DCL A(0:3) FLOAT DEC(6) INIT(1, 2, 3, 4);
   DCL X(1:3) FLOAT DEC(6) INIT(2, 3, 5);
   DCL Y(2) FLOAT DEC(6) INIT(10, 100);
   DCL E FLOAT DEC(6) INIT(2);
   DCL D(3) FIXED DEC(5,1) INIT(1.5, 2, 2.5);
   DCL K(1) FLOAT DEC(6) INIT(7);
   PUT SKIP LIST(POLY(A, X));
   PUT SKIP LIST(POLY(A, Y));
   PUT SKIP LIST(POLY(A, E));
   PUT SKIP LIST(POLY(D, E));
   PUT SKIP LIST(POLY(K, X));
   PUT SKIP LIST(PREC(3.14159, 4, 2));
 END T190POL;
