 T22PAGE: PROC OPTIONS(MAIN);
    /* AUTOMATIC PAGE EJECT AFTER 60 LINES, WITH SKIP(2) AND PAGE */
    DCL I FIXED BIN(15);
    DO I = 1 TO 75;
       PUT SKIP LIST('LINE', I);
    END;
    DO I = 1 TO 40;
       PUT SKIP(2) LIST('DOUBLE', I);
    END;
    PUT PAGE LIST('PAGE');
    DO I = 1 TO 62;
       PUT SKIP LIST('AFTER PAGE', I);
    END;
    PUT SKIP(3) LIST('TRIPLE');
 END T22PAGE;
