 T317BT: PROC OPTIONS(MAIN);
   /* BIT STRINGS AS ARITHMETIC OPERANDS AND IN COMPARISONS */
   DCL B BIT(4) INIT('1010'B), C CHAR(4) INIT('1010');
   DCL L BIT(40) INIT('0000000011'B), M BIT(20) INIT('1'B);
   DCL N BIT(4) VARYING INIT(''B), S BIT(1) INIT('1'B);
   DCL X FIXED BIN(31), D FIXED DEC(7,2) INIT(2.5), F FLOAT INIT(1.5);
   PUT SKIP LIST(B + 1, B * 2, B / 3, -B, +B);
   PUT SKIP LIST(B + 1.5, B + D, B * F, B + C, S + S);
   PUT SKIP LIST(M + 0, M * 2, N + 1, B ** 2);
   PUT SKIP LIST(L + 0, S ** 2, 2 ** S);
   IF B = C THEN PUT SKIP LIST('B = C');
   IF B = 10 THEN PUT SKIP LIST('B = 10');
   IF B > 9.5 THEN PUT SKIP LIST('B > 9.5');
   IF B < 'A' THEN PUT SKIP LIST('B < A');
   IF C = B THEN PUT SKIP LIST('C = B');
   IF 10 = B THEN PUT SKIP LIST('10 = B');
   IF S = 1 THEN PUT SKIP LIST('S = 1');
   X = B + B;
   PUT SKIP LIST(X, B || B, ABS(B), MAX(B, 3), MOD(B, 3));
 END T317BT;
