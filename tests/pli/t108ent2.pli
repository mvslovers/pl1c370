 T108EN: PROC OPTIONS(MAIN);
   DCL P3 ENTRY(FIXED BIN(31), FIXED BIN(31), CHAR(4));
   DCL Q2 ENTRY(CHAR(4), FIXED BIN(31));
   DCL R1 ENTRY(FIXED BIN(31));
   DCL F2 ENTRY(FIXED BIN(31), FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL G1 ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL (I, S) FIXED BIN(31);
   CALL P3(1, 2, 'ABCD');
   CALL Q2('WXYZ', 30);
   CALL R1(40);
   S = 0;
   DO I = 1 TO 4;
     S = S + F2(I, 10) + G1(I);
   END;
   PUT SKIP LIST('SUM', S);
 P3: PROC(A, B, T);
   DCL (A, B, C) FIXED BIN(31), T CHAR(4);
   PUT SKIP LIST('P3', A, B, T);
   RETURN;
 Q2: ENTRY(T, C);
   PUT SKIP LIST('Q2', T, C);
   RETURN;
 R1: ENTRY(B);
   PUT SKIP LIST('R1', B);
 END P3;
 F2: PROC(X, Y) RETURNS(FIXED BIN(31));
   DCL (X, Y, Z) FIXED BIN(31);
   RETURN(X * Y);
 G1: ENTRY(Z) RETURNS(FIXED BIN(31));
   RETURN(Z + 100);
 END F2;
 END T108EN;
