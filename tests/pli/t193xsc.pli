 T193XSC: PROC OPTIONS(MAIN);
   DCL M(3,4) FIXED BIN(15), I FIXED BIN(15), J FIXED BIN(15);
   DCL V(4) FIXED BIN(15), W(3) FIXED BIN(15);
   DCL C(2,3) CHAR(2) INIT('AA','AB','AC','BA','BB','BC');
   DCL K(0:1,2:3,2) FIXED BIN(15);
   DO I = 1 TO 3; DO J = 1 TO 4; M(I,J) = 10 * I + J; END; END;
   PUT SKIP LIST(M(2,*));
   PUT SKIP LIST(M(*,3));
   V = M(3,*);
   W = M(*,1) + M(*,4);
   PUT SKIP LIST(V, W);
   M(1,*) = 0;
   M(*,2) = M(*,2) * 2;
   PUT SKIP LIST(M);
   I = 2;
   M(I,*) = V;
   PUT SKIP LIST(M(I,*), SUM(M(*,2)), SUM(M(I + 1,*)));
   PUT SKIP LIST(C(*,2), C(2,*));
   PUT SKIP EDIT(C(1,*)) (3 A(3));
   DO I = 0 TO 1; DO J = 2 TO 3;
     K(I,J,1) = 100 * I + J; K(I,J,2) = -K(I,J,1);
   END; END;
   PUT SKIP LIST(K(1,*,*));
   PUT SKIP LIST(K(*,*,2));
   CALL SHOW(M(2,*));
   CALL SHOW(M(*,4));
   CALL DBL(M(*,4));
   PUT SKIP LIST(M(*,4), M(3,*));
 DBL: PROC(A);
   DCL A(*) FIXED BIN(15);
   A = A * 2;
 END DBL;
 SHOW: PROC(A);
   DCL A(*) FIXED BIN(15);
   PUT SKIP LIST(LBOUND(A,1), HBOUND(A,1), A);
 END SHOW;
 END T193XSC;
