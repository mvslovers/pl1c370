 T42FAR: PROC OPTIONS(MAIN);
   DCL A FLOAT DEC(6) INIT(2.5), B FLOAT DEC(16) INIT(1E-3);
   DCL I FIXED BIN(31) INIT(7), P FIXED DEC(7,2) INIT(12.34);
   DCL K FIXED BIN(15);
   DCL Q FIXED DEC(7,2);
   PUT SKIP LIST(A + I, A * P, P / A, I / A);
   PUT SKIP LIST(A + B, A * B, A - B);
   PUT SKIP LIST(-A, A * A * A, A / 0.7);
   K = A * 3.3; Q = A / 3; PUT SKIP LIST(K, Q);
   K = -A; Q = -A * 1.23456; PUT SKIP LIST(K, Q);
   I = 1E9 * 2.1; PUT SKIP LIST(I);
   A = I; PUT SKIP LIST(A);
   A = P; B = P; PUT SKIP LIST(A, B);
   IF A < B THEN PUT SKIP LIST('LT'); ELSE PUT SKIP LIST('GE');
   A = 0.1; B = 0.1;
   IF A = B THEN PUT SKIP LIST('EQ'); ELSE PUT SKIP LIST('NE');
   PUT SKIP LIST(ABS(-A), MAX(A, B, 3), MIN(A, I));
   PUT SKIP LIST(1E0 + 1, 3.0E0 * 1.1);
 END T42FAR;
