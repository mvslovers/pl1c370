 T54ARI: PROC OPTIONS(MAIN);
   DCL D FIXED DEC(7,2) INIT(-12.75), E FIXED DEC(7,2) INIT(3.45);
   DCL I FIXED BIN(31) INIT(-7), J FIXED BIN(15) INIT(5);
   DCL F FLOAT DEC(6) INIT(-2.5), G FLOAT DEC(16) INIT(7.75);
   PUT SKIP LIST(SIGN(D), SIGN(I), SIGN(0), SIGN(F));
   PUT SKIP LIST(FLOOR(D), CEIL(D), TRUNC(D));
   PUT SKIP LIST(FLOOR(E), CEIL(E), TRUNC(E));
   PUT SKIP LIST(FLOOR(F), CEIL(F), TRUNC(F), FLOOR(G));
   PUT SKIP LIST(FLOOR(I), CEIL(J), TRUNC(I));
   PUT SKIP LIST(ROUND(D, 1), ROUND(E, 1), ROUND(D, 0));
   PUT SKIP LIST(ROUND(E, -1), ROUND(12.345, 2), ROUND(-0.005, 2));
   PUT SKIP LIST(FIXED(G, 5, 2), FIXED(D, 4), FIXED(E, 9, 4));
   PUT SKIP LIST(FIXED(F, 3), FIXED(I, 5), FIXED(D, 5, 0));
   PUT SKIP LIST(FLOAT(D, 6), FLOAT(I, 16), FLOAT(E, 3));
 END T54ARI;
