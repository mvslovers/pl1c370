 P9PROC: PROC OPTIONS(MAIN);
    /* CALL, FUNCTIONS, PARAMETERS, RECURSION, GO TO, RETURN */
    DCL (A,B) FIXED BIN(31);
    DCL TOTAL FIXED BIN(31) INIT(0);
    DCL W(3) FIXED BIN(31) INIT(1,2,3);
    DCL S CHAR(6) INIT('ABCDEF');
    DCL FACT ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
    DCL ADDTO ENTRY(FIXED BIN(31));
    DCL SWAP ENTRY(FIXED BIN(31), FIXED BIN(31));
    DCL TWICE ENTRY(FIXED DEC(7,2)) RETURNS(FIXED DEC(7,2));
    DCL PART ENTRY(CHAR(6), FIXED BIN(15)) RETURNS(CHAR(3));
    A = 5;
    PUT SKIP LIST('FACT', FACT(A), FACT(10));
    CALL ADDTO(7);
    CALL ADDTO(A);
    CALL ADDTO(W(2));
    PUT SKIP LIST('TOTAL', TOTAL);
    B = 9;
    CALL SWAP(A, B);
    PUT SKIP LIST('SWAP', A, B);
    CALL SWAP(W(1), W(3));
    PUT SKIP LIST('W', W);
    PUT SKIP LIST('TWICE', TWICE(1.25), TWICE(A));
    PUT SKIP LIST('PART', PART(S, 2), PART('XYZXYZ', 4));
    CALL LOOPER;
    CALL UPCASE(S);
    PUT SKIP LIST('S', S);
 FACT: PROC(N) RETURNS(FIXED BIN(31)) RECURSIVE;
    DCL N FIXED BIN(31);
    IF N <= 1 THEN RETURN(1);
    RETURN(N * FACT(N - 1));
 END FACT;
 ADDTO: PROC(X);
    DCL X FIXED BIN(31);
    TOTAL = TOTAL + X;
 END ADDTO;
 SWAP: PROC(X, Y);
    DCL (X, Y, T) FIXED BIN(31);
    T = X;
    X = Y;
    Y = T;
 END SWAP;
 TWICE: PROC(D) RETURNS(FIXED DEC(7,2));
    DCL D FIXED DEC(7,2);
    RETURN(D * 2);
 END TWICE;
 PART: PROC(C, K) RETURNS(CHAR(3));
    DCL C CHAR(6);
    DCL K FIXED BIN(15);
    RETURN(SUBSTR(C, K, 3));
 END PART;
 LOOPER: PROC;
    DCL I FIXED BIN(15);
    I = 0;
 AGAIN: I = I + 1;
    IF I < 3 THEN GO TO AGAIN;
    PUT SKIP LIST('LOOPER', I);
    IF I = 3 THEN RETURN;
    PUT SKIP LIST('NOT REACHED');
 END LOOPER;
 UPCASE: PROC(T);
    DCL T CHAR(6);
    T = 'X' || SUBSTR(T, 2, 5);
 END UPCASE;
 END P9PROC;
