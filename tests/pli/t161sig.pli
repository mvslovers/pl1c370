 T161SIG: PROC OPTIONS(MAIN);
   ON SIZE PUT SKIP LIST('SIZE UNIT');
   ON SUBSCRIPTRANGE PUT SKIP LIST('SUBRG UNIT');
   ON ZERODIVIDE PUT SKIP LIST('ZDIV UNIT');
   SIGNAL SIZE;
   SIGNAL SUBSCRIPTRANGE;
   (NOZERODIVIDE): SIGNAL ZERODIVIDE;
   SIGNAL ZERODIVIDE;
   PUT SKIP LIST('DONE');
 END T161SIG;
