 T125SEL: PROC OPTIONS(MAIN);
   DCL (I, N, CALLS) FIXED BIN(31), MONTH CHAR(3), YEAR FIXED BIN(15);
   DCL NO_DAYS FIXED BIN(15), M(5) CHAR(3) INIT('JAN', 'FEB', 'APR',
       'SEP', 'DEC'), NXT LABEL;
   DCL F ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL (E, E2) FIXED BIN(31), MC CHAR(3);
   /* the expansion of each select-group (GC33-0009-4, SELECT
      statement): E once, the WHEN values in turn */
   CALLS = 0;
   DO I = 1 TO 6;
     E = I;
     IF E = 1 THEN GO TO W1;
     IF E = 3 THEN GO TO W1;
     IF E = 2 THEN GO TO W2;
     IF E = 5 THEN GO TO W3;
     PUT SKIP LIST(I, 'OTHER');
     GO TO SE1;
 W1: PUT SKIP LIST(I, 'ONE OR THREE');
     GO TO SE1;
 W2: N = I * 10;
     PUT SKIP LIST(I, 'TWO', N);
     GO TO SE1;
 W3: ;
 SE1: ;
   END;
   DO I = 1 TO 5;
     MONTH = M(I);
     DO YEAR = 1975, 1976;
       MC = MONTH;
       IF MC = 'FEB' THEN GO TO V1;
       IF MC = 'APR' THEN GO TO V2;
       IF MC = 'JUN' THEN GO TO V2;
       IF MC = 'SEP' THEN GO TO V2;
       IF MC = 'NOV' THEN GO TO V2;
       NO_DAYS = 31;
       GO TO SE2;
 V1:   E2 = MOD(YEAR, 4);
       IF E2 = 0 THEN NO_DAYS = 29;
       ELSE NO_DAYS = 28;
       GO TO SE2;
 V2:   NO_DAYS = 30;
 SE2:  PUT SKIP LIST(MONTH, YEAR, NO_DAYS);
     END;
   END;
   DO I = -2 TO 2;
     IF I < 0 THEN PUT SKIP LIST(I, 'NEGATIVE');
     ELSE IF I = 0 THEN PUT SKIP LIST(I, 'ZERO');
     ELSE PUT SKIP LIST(I, 'POSITIVE');
   END;
   E = F(2);
   IF E = F(1) THEN GO TO X1;
   IF E = F(2) THEN GO TO X1;
   IF E = F(3) THEN GO TO X1;
   SIGNAL ERROR;
 X1: PUT SKIP LIST('MATCHED', CALLS);
   PUT SKIP LIST('ONLY OTHERWISE');
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR');
     GO TO NXT;
   END;
   NXT = OUT;
   E = 7;
   IF E = 1 THEN PUT SKIP LIST('NO');
   ELSE SIGNAL ERROR;
 OUT: PUT SKIP LIST('END');
 F: PROC(X) RETURNS(FIXED BIN(31));
   DCL X FIXED BIN(31);
   CALLS = CALLS + 1;
   PUT SKIP LIST('F', X);
   RETURN(X);
 END F;
 END T125SEL;
