 T303CPC: PROC OPTIONS(MAIN);
   /* PICTURE COMPLEX (#2 C5): STORAGE, ASSIGNMENT, ARITHMETIC, PUT
      LIST, PUT DATA, PUT EDIT WITH C AND A, TO CHARACTER, STRING */
   DCL A PIC '99V.99' COMPLEX INIT(12.34+5.6I);
   DCL B PIC 'S999V.9' COMPLEX;
   DCL C PIC 'ZZ9' COMPLEX;
   DCL Z COMPLEX FLOAT DEC(6);
   DCL 1 S, 2 X CHAR(1) INIT('['), 2 P PIC '99V.99' COMPLEX,
         2 Y CHAR(1) INIT(']');
   DCL CH CHAR(12);
   PUT SKIP LIST(A, UNSPEC(A));
   B = -12.5+3I;
   PUT SKIP LIST(B, A + B, A * 2);
   C = 7-8I;
   PUT SKIP LIST(C, REAL(C), IMAG(B));
   Z = A; PUT SKIP LIST(Z);
   P = 1.5+2.25I; PUT SKIP LIST(STRING(S));
   CH = A; PUT SKIP LIST(CH);
   PUT SKIP DATA(A);
   PUT SKIP EDIT(A)(C(P'99V.99'));
   PUT SKIP EDIT(B)(C(F(7,1)));
   PUT SKIP EDIT(A)(A);
   REAL(A) = 99.99; PUT SKIP LIST(A);
 END T303CPC;
