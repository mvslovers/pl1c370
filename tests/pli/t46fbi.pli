 T46FBI: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31), (A,T) FLOAT DEC(6), (B,C,D) FLOAT DEC(16);
   DCL E FLOAT BIN(21);
   I = 2147483647; A = I; D = A; PUT SKIP LIST(D);
   I = 16777217; A = I; D = A; PUT SKIP LIST(D);
   I = -16777219; E = I; D = E; PUT SKIP LIST(D);
   A = 1.1E0; B = A * A * A; T = A * A; C = T * A;
   PUT SKIP LIST(B, C);
   A = 1.1E0; T = A * A * A; D = T; PUT SKIP LIST(D);
   A = 1.7E0; T = A * A + A; D = T; PUT SKIP LIST(D);
   A = 1.7E0; T = A / 3 * A; D = T; PUT SKIP LIST(D);
   A = 0.5E0; B = 2.5E0;
   PUT SKIP EDIT(A, B, 1.5E0, -0.5E0) (F(3), F(3), F(3), F(4));
   A = 3.14159;
   PUT SKIP EDIT(A, A, B) (E(14,8), X(1), E(18,9,11), X(1), F(20,15));
   B = 0.125E0;
   PUT SKIP EDIT(B, B) (F(6,2), X(1), E(9,1));
   B = A - A; PUT SKIP LIST(B);
 END T46FBI;
