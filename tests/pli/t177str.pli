 T177STR: PROC OPTIONS(MAIN);
   /* string parameters of procedures compiled apart (t177str.sep) */
   DCL SHOWC ENTRY(CHAR(6)), SHOWV ENTRY(CHAR(12) VARYING);
   DCL SHOWB ENTRY(BIT(4)), SHOWS ENTRY(CHAR(*)), SHOWX ENTRY(BIT(*));
   DCL UPPER ENTRY(CHAR(6)) RETURNS(CHAR(6));
   DCL C CHAR(6) INIT('ABCDEF'), V CHAR(12) VARYING INIT('VARY');
   DCL B BIT(4) INIT('1010'B), L CHAR(3) INIT('XYZ');
   CALL SHOWC(C);
   CALL SHOWC(L);
   CALL SHOWC('Q');
   CALL SHOWV(V);
   CALL SHOWV(C || L);
   CALL SHOWB(B);
   CALL SHOWB('11'B);
   CALL SHOWS(L);
   CALL SHOWX(B);
   CALL SHOWX('110'B);
   PUT SKIP LIST('C AFTER', C, 'V AFTER', V);
   PUT SKIP LIST(UPPER(C) || '|');
   CALL PASSON(C, V);
   PUT SKIP LIST('C NOW', C, 'V NOW', V, LENGTH(V));
 END T177STR;
*PROCESS;
 SHOWC: PROC(S);
   DCL S CHAR(6);
   PUT SKIP LIST('SHOWC', S || '|');
   S = 'CHANGED';
 END SHOWC;
*PROCESS;
 SHOWV: PROC(S);
   DCL S CHAR(12) VARYING;
   PUT SKIP LIST('SHOWV', S || '|', LENGTH(S));
   S = S || '+';
 END SHOWV;
*PROCESS;
 SHOWB: PROC(S);
   DCL S BIT(4);
   PUT SKIP LIST('SHOWB', S);
 END SHOWB;
*PROCESS;
 SHOWS: PROC(S);
   DCL S CHAR(*);
   PUT SKIP LIST('SHOWS', S || '|', LENGTH(S));
 END SHOWS;
*PROCESS;
 SHOWX: PROC(S);
   DCL S BIT(*);
   PUT SKIP LIST('SHOWX', S, LENGTH(S));
 END SHOWX;
*PROCESS;
 UPPER: PROC(S) RETURNS(CHAR(6));
   DCL S CHAR(6);
   RETURN(TRANSLATE(S, 'XYZW', 'ABCD'));
 END UPPER;
*PROCESS;
 PASSON: PROC(A, W);
   DCL A CHAR(6), W CHAR(12) VARYING;
   DCL SHOWC ENTRY(CHAR(6)), SHOWV ENTRY(CHAR(12) VARYING);
   CALL SHOWC(A);
   CALL SHOWV(W);
   A = 'PASSED';
 END PASSON;
