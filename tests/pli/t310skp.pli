 T310SKP: PROC OPTIONS(MAIN);
   /* SKIP(N) FOR N = 5 TO 10, LINE PAST THE PAGE */
   DCL N FIXED BIN(15) INIT(0);
   ON ENDPAGE(SYSPRINT) BEGIN;
     N = N + 1;
     PUT PAGE LIST('NEW PAGE', N);
   END;
   PUT PAGE LIST('A');
   PUT SKIP(5) LIST('S5');
   PUT SKIP(6) LIST('S6');
   PUT SKIP(7) LIST('S7');
   PUT SKIP(8) LIST('S8');
   PUT SKIP(10) LIST('S10');
   PUT LINE(3) LIST('LINE 3');
   PUT SKIP LIST('AFTER');
   PUT LINE(65) LIST('LINE 65');
   PUT SKIP LIST('END', N);
 END T310SKP;
