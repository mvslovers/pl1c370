 T254ARG: PROC OPTIONS(MAIN);
   /* TIER 98: DUMMY ARGUMENTS (SC26-3114-01, "DUMMY ARGUMENTS"): (X)
      IS A DUMMY; AN ARGUMENT TO AN INTERNAL PROCEDURE IS CONVERTED TO
      ITS PARAMETER'S ATTRIBUTES */
   DCL NW FIXED BIN(15) INIT(0), A(3) FIXED BIN(15) INIT(1, 2, 3);
   DCL I FIXED BIN(15) INIT(2);
   CALL P((NW));
   PUT SKIP LIST(NW);
   CALL P(NW);
   PUT SKIP LIST(NW);
   CALL P((A(I)));
   PUT SKIP LIST(A);
   CALL Q(NW + 0, 5, '7', 2.5E0);
 P: PROC(N);
   DCL N FIXED BIN(15);
   N = N + 3;
 END P;
 Q: PROC(N, M, K, F);
   DCL (N, M, K) FIXED BIN(15), F FIXED DEC(5,2);
   PUT SKIP LIST(N, M, K, F);
 END Q;
 END T254ARG;
