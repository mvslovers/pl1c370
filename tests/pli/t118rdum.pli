 T118RDU: PROC OPTIONS(MAIN);
   DCL REG FILE RECORD KEYED ENV(REGIONAL(1));
   DCL REC CHAR(20), K FIXED BIN(31), N FIXED BIN(31), TT CHAR(4);
   ON KEY(REG) PUT SKIP LIST('KEY', ONCODE);
   OPEN FILE(REG) SEQUENTIAL OUTPUT;
   REC = 'AAAAAAAAAAAAAAAAAAAA';
   WRITE FILE(REG) FROM(REC) KEYFROM(0);
   REC = 'BBBBBBBBBBBBBBBBBBBB';
   WRITE FILE(REG) FROM(REC) KEYFROM(3);
   REC = 'CCCCCCCCCCCCCCCCCCCC';
   WRITE FILE(REG) FROM(REC) KEYFROM('    6');
   CLOSE FILE(REG);
   TT = 'SEQ'; CALL SHOW;
   OPEN FILE(REG) DIRECT UPDATE;
   DELETE FILE(REG) KEY(3);
   DELETE FILE(REG) KEY(86);
   CLOSE FILE(REG);
   TT = 'DEL'; CALL SHOW;
   N = 0;
   OPEN FILE(REG) SEQUENTIAL INPUT;
   ON ENDFILE(REG) GO TO EOF;
   DO WHILE('1'B);
     READ FILE(REG) INTO(REC);
     N = N + 1;
   END;
 EOF:
   CLOSE FILE(REG);
   PUT SKIP LIST('RECORDS', N);
 SHOW: PROC;
   OPEN FILE(REG) DIRECT INPUT;
   DO K = 0 TO 8;
     CALL ONE;
   END;
   K = 85;
   CALL ONE;
   CLOSE FILE(REG);
 END SHOW;
 ONE: PROC;
   REC = (20)'?';
   READ FILE(REG) INTO(REC) KEY(K);
   PUT SKIP LIST(TT, K, UNSPEC(SUBSTR(REC, 1, 2)));
   PUT LIST(UNSPEC(SUBSTR(REC, 19, 2)), SUBSTR(REC, 3, 8));
 END ONE;
 END T118RDU;
