 T240ASM: PROC OPTIONS(MAIN);
   /* OPTIONS(ASSEMBLER) AND RETCODE (THE OPTIMIZER, SC33-0006-7
      CHAPTER 11), EXTERNAL('NAME') (SC26-3114-01): ASMTST GETS THE
      ADDRESSES OF THE DATA, THE LAST WITH ITS HIGH-ORDER BIT ON, AND
      RETURNS THE NUMBER OF ARGUMENTS IN R15 */
   DCL ASMTST ENTRY OPTIONS(ASM RETCODE);
   DCL TEST2 ENTRY EXTERNAL('ASMTST') OPTIONS(ASSEMBLER, RETCODE);
   DCL TEST3 ENTRY(FIXED BIN(31), FIXED BIN(31), FIXED BIN(31),
     FIXED BIN(31)) EXTERNAL('ASMTST') OPTIONS(ASM);
   DCL (ONE INIT(1), TWO INIT(2), THREE INIT(3)) FIXED BIN(31);
   DCL (A INIT(40), B INIT(2), C INIT(0)) FIXED BIN(31);
   DCL S CHAR(5) INIT('-----'), V CHAR(8) VARYING INIT('ABC');
   CALL ASMTST(ONE, A, B, C);
   PUT SKIP LIST(C, PLIRETV);
   CALL TEST2(TWO, S);
   PUT SKIP LIST(S, PLIRETV);
   CALL TEST2(THREE);
   PUT SKIP LIST(PLIRETV);
   CALL TEST3(1, 100, 23, C);
   PUT SKIP LIST(C, PLIRETV);
   CALL TEST2(TWO, V);
   PUT SKIP LIST(LENGTH(V), SUBSTR(V, 1, 3));
 END T240ASM;
