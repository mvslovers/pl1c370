 T271CKP: PROC OPTIONS(MAIN);
   /* IHECKPS, IHECKPT, IHERESN (GC28-6594-7; #233), THE CASES
      THAT TAKE NO CHECKPOINT: AN ORGANIZATION OF NEITHER PS NOR PO
      GIVES 8, A DDNAME WITHOUT A DD 12, AND IHECKPT
      TAKES SYSCHK, WHICH IS NOT THERE.  (A CHECKPOINT ITSELF CANNOT BE
      TAKEN ON THE TEST SYSTEM: ITS DISKS ARE SHARED, IHJ000I 214) */
   DCL IHECKPS ENTRY(CHAR(8) VAR, CHAR(16) VAR, CHAR(2),
                     FIXED BIN(31));
   DCL (IHECKPT, IHERESN) ENTRY;
   DCL CODE FIXED BIN(31);
   CODE = -1;
   CALL IHECKPS('', 'CKPTONE', 'XX', CODE);
   PUT SKIP LIST('XX', CODE);
   CODE = -1;
   CALL IHECKPS('', 'CKPTTWO', 'P', CODE);
   PUT SKIP LIST('P', CODE);
   CODE = -1;
   CALL IHECKPS('NODD', 'CKPTTHR', 'PS', CODE);
   PUT SKIP LIST('NODD PS', CODE);
   CODE = -1;
   CALL IHECKPS('NODDNAME', 'MEMBER1', 'PO', CODE);
   PUT SKIP LIST('NODD PO', CODE);
   CALL IHECKPT;
   PUT SKIP LIST('NO ARGUMENTS');
   CALL IHERESN;
   PUT SKIP LIST('CANCELLED');
 END T271CKP;
