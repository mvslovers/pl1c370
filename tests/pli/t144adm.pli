 T144ADM: PROC OPTIONS(MAIN);
   /* an area argument of another size: by reference, its own size */
   DCL A AREA(100), B AREA(300);
   DCL X FIXED BIN(31) BASED(P), (P, Q) POINTER;
   DCL W(2) FIXED BIN(31) BASED(R), R POINTER;
   DCL (I, J) FIXED BIN(31);
   ALLOCATE X IN(A) SET(P);
   X = 11;
   CALL USE(A);
   PUT SKIP LIST('A AFTER', X, SUBSTR(UNSPEC(A), 1, 64));
   ALLOCATE W IN(B) SET(R);
   W(1) = 7;
   CALL USE(B);
   PUT SKIP LIST('B AFTER', W(1));
   CALL BIG(A);
 USE: PROC(Z);
   DCL Z AREA(200), Y FIXED BIN(31) BASED(S), S POINTER;
   PUT SKIP LIST('USE IN', SUBSTR(UNSPEC(Z), 1, 64));
   ALLOCATE Y IN(Z) SET(S);
   Y = 22;
   PUT SKIP LIST('USE ALLOC', Y);
 END USE;
 BIG: PROC(Z);
   DCL Z AREA(50), V(20) FIXED BIN(31) BASED(S), S POINTER;
   ON AREA PUT SKIP LIST('AREA', ONCODE);
   ALLOCATE V IN(Z) SET(S);
   PUT SKIP LIST('BIG DONE');
 END BIG;
 END T144ADM;
