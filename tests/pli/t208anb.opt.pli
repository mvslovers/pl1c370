 T208ANB: PROC OPTIONS(MAIN);
   /* ANSI's string functions of bit strings (9.4.4): the result a bit
      string when every string argument is one, else characters */
   DCL B BIT(8) INIT('10110110'B), V BIT(16) VARYING;
   DCL N FIXED BIN(15) INIT(3), C CHAR(10) VARYING;
   V = AFTER(B, '11'B);   PUT SKIP LIST(V, LENGTH(V));
   V = BEFORE(B, '11'B);  PUT SKIP LIST(V, LENGTH(V));
   V = AFTER(B, '000'B);  PUT SKIP LIST(V, LENGTH(V));
   V = BEFORE(B, '000'B); PUT SKIP LIST(V, LENGTH(V));
   V = DECAT(B, '11'B, '101'B); PUT SKIP LIST(V);
   V = DECAT(B, '11'B, '010'B); PUT SKIP LIST(V);
   V = REVERSE(B);        PUT SKIP LIST(V);
   V = REVERSE('1'B);     PUT SKIP LIST(V);
   V = COPY('10'B, 3);    PUT SKIP LIST(V, LENGTH(V));
   V = COPY('1'B, N);     PUT SKIP LIST(V);
   V = COPY('01'B, 0);    PUT SKIP LIST(V, LENGTH(V));
   C = AFTER('XY0110Z', '11'B);  PUT SKIP LIST(C);
   C = REVERSE(B);       PUT SKIP LIST(C);
 END T208ANB;
