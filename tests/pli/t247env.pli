 T247ENV: PROC OPTIONS(MAIN);
   /* TIER 95: THE RECORD FORMAT OF THE ENVIRONMENT ATTRIBUTE, ON
      DATA SETS WHOSE DD GIVES NO DCB, READ BACK RECORD BY RECORD */
   DCL P1 FILE PRINT ENV(F(41));
   DCL S2 FILE STREAM OUTPUT ENV(V(64,60));
   DCL R3 FILE RECORD OUTPUT ENV(F(800,80));
   DCL R4 FILE RECORD OUTPUT ENV(U(100));
   DCL (I1, I2, I3, I4) FILE RECORD INPUT;
   DCL L CHAR(100), B CHAR(80), C CHAR(30);
   DCL V CHAR(120) VARYING;
   L = (10)'ABCDEFGHI ';
   PUT FILE(P1) LIST(L);
   PUT FILE(S2) LIST(L);
   B = 'RECORD OF EIGHTY';
   WRITE FILE(R3) FROM(B);
   WRITE FILE(R3) FROM(B);
   C = 'UNDEFINED THIRTY';
   WRITE FILE(R4) FROM(C);
   CLOSE FILE(P1), FILE(S2), FILE(R3), FILE(R4);
   OPEN FILE(I1) TITLE('P1');
   CALL BACK(I1, 'P1');
   OPEN FILE(I2) TITLE('S2');
   CALL BACK(I2, 'S2');
   OPEN FILE(I3) TITLE('R3');
   CALL BACK(I3, 'R3');
   OPEN FILE(I4) TITLE('R4');
   CALL BACK(I4, 'R4');
 BACK: PROC(F, T);
   DCL F FILE RECORD INPUT, T CHAR(2);
   ON ENDFILE(F) GO TO EOF;
   DO WHILE('1'B);
     READ FILE(F) INTO(V);
     PUT SKIP LIST(T, LENGTH(V));
     PUT SKIP LIST(V);
   END;
 EOF:
   CLOSE FILE(F);
 END BACK;
 END T247ENV;
