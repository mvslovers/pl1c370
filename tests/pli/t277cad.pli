 T277CAD: PROC OPTIONS(MAIN);
   /* COMPLEX + AND - (#2): ARRAYS AND STRUCTURE MEMBERS, CONJG,
      PREFIX MINUS, THE TARGET IN ITS OWN SOURCE, IF WITH = AND ¬=,
      STATIC AND AUTOMATIC ARRAYS WITH INITIAL, FIXED BINARY PARTS */
   DCL ZA(3) COMPLEX FLOAT DEC(6) INIT(1+1I, 2-2I, -3I);
   DCL ZS(2) COMPLEX FIXED DEC(4,1) STATIC INIT(10.5+1I, (1)-0.5I);
   DCL 1 S(2), 2 N CHAR(2), 2 C COMPLEX FIXED DEC(5,2);
   DCL Z COMPLEX FLOAT DEC(6) STATIC INIT(1.5-2.5I);
   DCL W COMPLEX FIXED BIN(31) INIT(100000+2I);
   DCL X FLOAT DEC(6) INIT(4);
   DCL I FIXED BIN(15);
   DO I = 1 TO 3;
     ZA(I) = ZA(I) + CONJG(ZA(I));
   END;
   PUT SKIP LIST(ZA);
   PUT SKIP LIST(ZS);
   S(1).N = 'AB';
   S(1).C = 1.25+2.5I;
   S(2).N = 'CD';
   S(2).C = -S(1).C;
   PUT SKIP LIST(S(1).C, S(2).C, S(2).N);
   Z = COMPLEX(IMAG(Z), REAL(Z));
   PUT SKIP LIST(Z);
   Z = -Z + 1;
   PUT SKIP LIST(Z);
   IF Z = 3.5-1.5I THEN PUT SKIP LIST('Z = 3.5-1.5I');
   ELSE PUT SKIP LIST('Z NOT 3.5-1.5I');
   IF Z ¬= 3.5+1.5I THEN PUT SKIP LIST('Z NE 3.5+1.5I');
   W = W + W - 3I;
   PUT SKIP LIST(W);
   W = X - 1I;
   PUT SKIP LIST(W, X + 2I, X - Z);
   IMAG(ZA(2)) = REAL(S(1).C);
   PUT SKIP LIST(ZA(2), REAL(W), IMAG(W));
 END T277CAD;
