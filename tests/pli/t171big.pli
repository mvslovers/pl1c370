 T171BIG: PROC OPTIONS(MAIN);
   DCL (I, J) FIXED BIN(15), S FLOAT DEC(6);
   DCL A(40,40) FLOAT DEC(6);
   DCL B(2000) FIXED BIN(15);
   DCL 1 R(10), 2 K FIXED BIN(31), 2 N CHAR(500), 2 Z FIXED DEC(5);
   DCL C CHAR(3000) VARYING;
   DCL T FIXED BIN(31) INIT(7);
   DCL INNER ENTRY(FIXED BIN(15));
   DCL SUM2 ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(31));
   DO I = 1 TO 40; DO J = 1 TO 40; A(I,J) = I + J / 100E0; END; END;
   DO I = 1 TO 2000; B(I) = I * 3; END;
   PUT SKIP LIST(A(1,1), A(40,40), A(17,23), B(1), B(2000), B(1234));
   DO I = 1 TO 10; R(I).K = I; R(I).N = 'N' || CHAR(I); R(I).Z = -I;
   END;
   R(10).N = (500)'X';
   PUT SKIP LIST(R(3).K, SUBSTR(R(3).N, 1, 10), R(10).Z, R(7).Z);
   PUT SKIP LIST(SUBSTR(R(10).N, 495), T);
   C = (2500)'C' || 'END';
   PUT SKIP LIST(LENGTH(C), SUBSTR(C, 2495));
   S = 0;
   DO I = 1 TO 40; S = S + A(I,I); END;
   PUT SKIP LIST(S);
   CALL INNER(5);
   PUT SKIP LIST(SUM2(3), B(3), A(40,1));
 INNER: PROC(N) RECURSIVE;
   DCL N FIXED BIN(15), L(1200) FIXED BIN(31), M CHAR(1000);
   DO J = 1 TO 1200; L(J) = J + N; END;
   M = (1000)'M';
   B(3) = L(1200);
   A(40,1) = L(1);
   IF N > 1 THEN CALL INNER(N - 1);
   PUT SKIP LIST(N, L(1), L(1200), SUBSTR(M, 999), B(2000));
 END INNER;
 SUM2: PROC(X) RETURNS(FIXED BIN(31));
   DCL X FIXED BIN(15), (Q, W) FIXED BIN(31), V(1500) FIXED BIN(31);
   W = 0;
   DO Q = 1 TO 1500; V(Q) = Q * X; END;
   DO Q = 1 TO 1500; W = W + V(Q); END;
   RETURN(W);
 END SUM2;
 END T171BIG;
