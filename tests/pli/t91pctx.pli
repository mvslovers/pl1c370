 T91PCTX: PROC OPTIONS(MAIN);
   DCL P PIC '$$$9V.99', Q PIC 'S99V9', R PIC 'ZZ9';
   DCL C CHAR(12), X FIXED DEC(7,2), E FLOAT DEC(6), B FIXED BIN(31);
   DCL CP PIC 'XXAA99', PA(3) PIC '99', K FIXED BIN(15) INIT(0);
   P = 12.5; PUT SKIP LIST(P); PUT SKIP DATA(P);
   X = P + 1; PUT SKIP LIST(X, P + 0, P * 2);
   C = P; PUT SKIP LIST('|' || C || '|');
   C = P || '*'; PUT SKIP LIST(C, LENGTH(P), SUBSTR(P, 4, 2));
   Q = -3.25; PUT SKIP LIST(Q, Q * 2, -Q);
   IF P > 10 THEN PUT SKIP LIST('GT 10');
   IF P = '12.5' THEN PUT SKIP LIST('EQ STR');
   IF P = 12.5 THEN PUT SKIP LIST('EQ NUM');
   P = '7.25'; PUT SKIP LIST(P);
   E = P; B = P; PUT SKIP LIST(E, B);
   Q = P; R = P; PUT SKIP LIST(Q, R);
   PUT SKIP EDIT(P, P, X)(A, F(8,2), P'$$$9V.99');
   PUT SKIP EDIT(-5, 123.456)(P'S99', P'ZZ9V.99');
   PUT SKIP EDIT('|', R, '|')(A, A(5), A);
   CP = 'AB C12'; PUT SKIP LIST(CP);
   ON CONVERSION BEGIN;
     K = K + 1; IF K > 8 THEN STOP;
     PUT SKIP LIST('CONV', ONCODE, '|' || ONSOURCE || '|');
     ONSOURCE = 'XYAB12';
   END;
   C = 'ABCDE1'; CP = C; PUT SKIP LIST(CP);
   C = 'AB$C12'; CP = C; PUT SKIP LIST(CP);
   PUT SKIP DATA(CP);
   IF P > Q THEN PUT SKIP LIST('P GT Q');
   PA = 7; PA(2) = PA(1) + 35; PUT SKIP LIST(PA);
   PUT SKIP DATA(PA, Q);
   P = -1; PUT SKIP LIST(P);
 END T91PCTX;
