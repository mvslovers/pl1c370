 T141STR: PROC OPTIONS(MAIN);
   /* BIT(*) parameters, arrays of CHAR(*) and CHAR(*) VARYING */
   DCL B8 BIT(8) INIT('10110011'B), B40 BIT(40);
   DCL BV BIT(12) VARYING INIT('101'B);
   DCL CA(3) CHAR(4) INIT('AAAA', 'BB', 'C');
   DCL CV(2) CHAR(6) VARYING INIT('XY', 'LONGER');
   DCL N FIXED BIN(31) INIT(-42), F FLOAT DEC(6) INIT(1.5);
   B40 = (20)'10'B;
   CALL SHOWB(B8);
   CALL SHOWB(B40);
   CALL SHOWB(BV);
   CALL SHOWB('1'B);
   CALL SHOWB(B8 & '00001111'B);
   CALL SETB(B8);
   PUT SKIP LIST('AFTER SETB', B8);
   CALL SHOWA(CA);
   CALL SETA(CA);
   PUT SKIP LIST('AFTER SETA', CA(1), CA(2), CA(3));
   CALL SHOWV(CV);
   CALL SHOWC('LITERAL');
   CALL SHOWC(CA(2) || CA(1));
 SHOWB: PROC(S);
   DCL S BIT(*);
   PUT SKIP LIST('SHOWB', S, LENGTH(S));
 END SHOWB;
 SETB: PROC(S);
   DCL S BIT(*);
   S = '1'B;
 END SETB;
 SHOWA: PROC(A);
   DCL A(*) CHAR(*);
   DCL I FIXED BIN(15);
   DO I = LBOUND(A, 1) TO HBOUND(A, 1);
     PUT SKIP LIST('SHOWA', I, A(I), LENGTH(A(I)));
   END;
 END SHOWA;
 SETA: PROC(A);
   DCL A(3) CHAR(*);
   A(2) = 'NEW VALUE';
   A(3) = A(1) || A(2);
 END SETA;
 SHOWV: PROC(A);
   DCL A(2) CHAR(*) VARYING;
   PUT SKIP LIST('SHOWV', A(1), LENGTH(A(1)), A(2), LENGTH(A(2)));
 END SHOWV;
 SHOWC: PROC(S);
   DCL S CHAR(*);
   PUT SKIP LIST('SHOWC', '<' || S || '>', LENGTH(S));
 END SHOWC;
 END T141STR;
