 T101FPA: PROC OPTIONS(MAIN);
   DCL OUT FILE STREAM OUTPUT PRINT;
   DCL TELL ENTRY(FILE, CHAR(5));
   DCL TELLP ENTRY(FILE, CHAR(5));
   OPEN FILE(OUT) TITLE('REPORT');
   PUT FILE(OUT) SKIP LIST('MAIN', 'ONE');
   CALL TELL(OUT, 'TWO');
   CALL TELLP(OUT, 'THREE');
   PUT FILE(OUT) SKIP LIST('MAIN', 'FOUR');
   CLOSE FILE(OUT);
   PUT SKIP LIST('DONE');
 TELL: PROC(G, S);
   DCL G FILE, S CHAR(5);
   PUT FILE(G) SKIP LIST('TELL', S);
 END TELL;
 TELLP: PROC(G, S);
   DCL G FILE PRINT, S CHAR(5);
   PUT FILE(G) SKIP LIST('TELLP', S);
 END TELLP;
 END T101FPA;
