 T90PICD: PROC OPTIONS(MAIN);
   DCL D FIXED DEC(15,5);
   DCL P0 PIC '999R';
   DCL P1 PIC '999I';
   DCL P2 PIC '(3)9V(2)9';
   DCL P3 PIC '(4)Z9';
   DCL P4 PIC 'S(5)9';
   DCL P5 PIC '(3)$9V.99';
   DCL P6 PIC 'ZZZ9';
   DCL P7 PIC '9999';
   DCL P8 PIC '--,--9';
   DCL P9 PIC '$$,$$9V.99';
   DCL P10 PIC 'ZZZ,ZZ9V.99';
   DCL P11 PIC 'ZZZ,ZZ9V.99';
   DCL P12 PIC '***,**9V.99';
   DCL P13 PIC 'SZZ9';
   DCL P14 PIC 'SZZ9';
   DCL P15 PIC 'ZZ9-';
   DCL P16 PIC 'ZZ9+';
   DCL P17 PIC 'ZZ9CR';
   DCL P18 PIC '9V.999';
   DCL P19 PIC 'V.999';
   DCL P20 PIC 'ZZZ.ZZ';
   DCL P21 PIC 'ZZZ.99';
   D = 1021; P0 = D;
   PUT SKIP EDIT('999R', '|', P0, '|')(A(16), A, A, A);
   D = -1021; P1 = D;
   PUT SKIP EDIT('999I', '|', P1, '|')(A(16), A, A, A);
   D = 123.45; P2 = D;
   PUT SKIP EDIT('(3)9V(2)9', '|', P2, '|')(A(16), A, A, A);
   D = 7; P3 = D;
   PUT SKIP EDIT('(4)Z9', '|', P3, '|')(A(16), A, A, A);
   D = -42; P4 = D;
   PUT SKIP EDIT('S(5)9', '|', P4, '|')(A(16), A, A, A);
   D = 5.5; P5 = D;
   PUT SKIP EDIT('(3)$9V.99', '|', P5, '|')(A(16), A, A, A);
   D = -25; P6 = D;
   PUT SKIP EDIT('ZZZ9', '|', P6, '|')(A(16), A, A, A);
   D = -25; P7 = D;
   PUT SKIP EDIT('9999', '|', P7, '|')(A(16), A, A, A);
   D = -1234; P8 = D;
   PUT SKIP EDIT('--,--9', '|', P8, '|')(A(16), A, A, A);
   D = 0.07; P9 = D;
   PUT SKIP EDIT('$$,$$9V.99', '|', P9, '|')(A(16), A, A, A);
   D = 0.5; P10 = D;
   PUT SKIP EDIT('ZZZ,ZZ9V.99', '|', P10, '|')(A(16), A, A, A);
   D = 1234.5; P11 = D;
   PUT SKIP EDIT('ZZZ,ZZ9V.99', '|', P11, '|')(A(16), A, A, A);
   D = -12.5; P12 = D;
   PUT SKIP EDIT('***,**9V.99', '|', P12, '|')(A(16), A, A, A);
   D = 5; P13 = D;
   PUT SKIP EDIT('SZZ9', '|', P13, '|')(A(16), A, A, A);
   D = -5; P14 = D;
   PUT SKIP EDIT('SZZ9', '|', P14, '|')(A(16), A, A, A);
   D = -5; P15 = D;
   PUT SKIP EDIT('ZZ9-', '|', P15, '|')(A(16), A, A, A);
   D = 5; P16 = D;
   PUT SKIP EDIT('ZZ9+', '|', P16, '|')(A(16), A, A, A);
   D = 5; P17 = D;
   PUT SKIP EDIT('ZZ9CR', '|', P17, '|')(A(16), A, A, A);
   D = 0.1234; P18 = D;
   PUT SKIP EDIT('9V.999', '|', P18, '|')(A(16), A, A, A);
   D = 0.5; P19 = D;
   PUT SKIP EDIT('V.999', '|', P19, '|')(A(16), A, A, A);
   D = 0.5; P20 = D;
   PUT SKIP EDIT('ZZZ.ZZ', '|', P20, '|')(A(16), A, A, A);
   D = 0.5; P21 = D;
   PUT SKIP EDIT('ZZZ.99', '|', P21, '|')(A(16), A, A, A);
 END T90PICD;
