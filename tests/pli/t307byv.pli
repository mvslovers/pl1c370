 T307BYV: PROC OPTIONS(MAIN);
   /* BYVALUE OF EXTERNAL PROCEDURES (PL/I FOR MVS & VM): POINTER AND
      FIXED BINARY(31) VALUES, A RESULT; THE CALLER'S VARIABLES KEEP
      THEIR VALUES; THE .PLI PASSES DUMMIES FOR PL/I (F) */
   DCL BV ENTRY(FIXED BIN(31), POINTER);
   DCL BF ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL N FIXED BIN(31) INIT(7);
   DCL C CHAR(4) INIT('ABCD');
   DCL P POINTER;
   P = ADDR(C);
   CALL BV((N), (P));
   PUT SKIP LIST(N, C);
   CALL BV(N + 100, ADDR(C));
   PUT SKIP LIST(BF((N)), BF(3) + 1, N);
 END T307BYV;
*PROCESS;
 BV: PROC(K, Q);
   DCL K FIXED BIN(31), Q POINTER;
   DCL S CHAR(4) BASED(Q);
   PUT SKIP LIST('BV', K, S);
   K = K * 2;
   S = 'WXYZ';
   PUT SKIP LIST('BV', K);
 END BV;
*PROCESS;
 BF: PROC(K) RETURNS(FIXED BIN(31));
   DCL K FIXED BIN(31);
   K = K + 1;
   RETURN(K * 10);
 END BF;
