 T260STG: PROC OPTIONS(MAIN);
   /* TIER 103: STORAGE AND CURRENTSTORAGE (GC33-0009-4, SC26-3114-01;
      #223), AND A CONNECTED PARAMETER */
   DCL H FIXED BIN(15), W FIXED BIN(31), D FIXED DEC(7,2);
   DCL F FLOAT DEC(6), L FLOAT DEC(16), C CHAR(10), P PTR;
   DCL V CHAR(20) VARYING INIT('ABC'), BT BIT(12) VARYING INIT('1'B);
   DCL AR(5) FIXED BIN(31), VA(2) CHAR(5) VARYING;
   DCL 1 S, 2 X FIXED BIN(31), 2 Y CHAR(4);
   DCL AREA1 AREA(100), Q PTR, Z FIXED BIN(31) BASED(Q);
   DCL R(20) FIXED BIN(31), K FIXED BIN(15);
   R(1) = STG(H); R(2) = STG(W); R(3) = STG(D); R(4) = STG(F);
   R(5) = STG(L); R(6) = STG(C); R(7) = STG(P); R(8) = STG(V);
   R(9) = CSTG(V); R(10) = CSTG(BT); R(11) = STORAGE(AR);
   R(12) = STG(AR(3)); R(13) = STG(VA); R(14) = CURRENTSTORAGE(VA);
   R(15) = STG(S); R(16) = STG(AREA1); R(17) = CSTG(AREA1);
   ALLOCATE Z IN(AREA1);
   R(18) = CSTG(AREA1);
   V = 'ABCDEFG'; R(19) = CSTG(V);
   CALL SUMS(AR, K);
   R(20) = K;
   PUT SKIP LIST(R);
 SUMS: PROC(A, N);
   DCL A(*) FIXED BIN(31) CONNECTED, N FIXED BIN(15);
   N = HBOUND(A, 1);
 END SUMS;
 END T260STG;
