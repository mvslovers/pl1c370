 T207IO: PROC OPTIONS(MAIN);
   DCL REPORT FILE RECORD, R CHAR(4), I FIXED BIN(15);
   DCL UNB FILE RECORD UNBUFFERED;
   DCL (A, B) FIXED DEC(5), X FIXED BIN(15), C CHAR(3);
   OPEN FILE(REPORT) OUTPUT;
   DO I = 1 TO 6;
     R = 'REC' || SUBSTR('123456', I, 1);
     WRITE FILE(REPORT) FROM(R);
   END;
   CLOSE FILE(REPORT);
   OPEN FILE(REPORT) INPUT;
   READ FILE(REPORT) IGNORE(2);
   READ FILE(REPORT) INTO(R);
   PUT SKIP LIST('AFTER IGNORE(2)', R);
   READ FILE(REPORT);
   READ FILE(REPORT) INTO(R);
   PUT SKIP LIST('AFTER READ', R);
   READ FILE(REPORT) IGNORE(0);
   READ FILE(REPORT) INTO(R);
   PUT SKIP LIST('AFTER IGNORE(0)', R);
   ON ENDFILE(REPORT) PUT SKIP LIST('ENDFILE', ONCODE);
   I = 3;
   READ FILE(REPORT) IGNORE(I);
   PUT SKIP LIST('AFTER IGNORE(3)', R);
   CLOSE FILE(REPORT);
   OPEN FILE(UNB) OUTPUT;
   WRITE FILE(UNB) FROM(R);
   CLOSE FILE(UNB);
   OPEN FILE(UNB) INPUT;
   R = '';
   READ FILE(UNB) INTO(R);
   PUT SKIP LIST('UNBUFFERED', R);
   CLOSE FILE(UNB);
   GET LIST(A, B) COPY;
   PUT SKIP LIST('GOT', A, B);
   GET DATA(X) COPY;
   PUT SKIP LIST('GOT', X);
   GET EDIT(C) (A(3)) COPY;
   PUT SKIP LIST('GOT', C);
   ON TRANSMIT(SYSIN) PUT SKIP LIST('TRANSMIT', ONCODE, ONFILE);
   SIGNAL TRANSMIT(SYSIN);
   REVERT TRANSMIT(SYSIN);
   PUT SKIP LIST('BEFORE');
   SIGNAL TRANSMIT(SYSIN);
   PUT SKIP LIST('AFTER');
 END T207IO;
