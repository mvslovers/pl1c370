 T244GAP: PROC OPTIONS(MAIN);
   /* TIER 92: INDEX OF BIT STRINGS, UNSPEC OF AN EXPRESSION,
      REDUCIBLE AND IRREDUCIBLE IN A DECLARATION (T245RED: ON THE
      PROCEDURE STATEMENT, WHICH PL/I (F) REFUSES) */
   DCL B BIT(16) INIT('0011010011110000'B), E BIT(4) INIT('1111'B);
   DCL V BIT(8) VARYING INIT(''B), C CHAR(8) INIT('XX1101YY');
   DCL I FIXED BIN(31) INIT(41), H FIXED BIN(15) INIT(7);
   DCL D FIXED DEC(5) INIT(123), F FLOAT DEC(6) INIT(1);
   DCL P PTR, S BIT(32);
   DCL R1 ENTRY RETURNS(FIXED BIN(15)) REDUCIBLE;
   DCL R2 ENTRY RETURNS(FIXED BIN(15)) IRREDUCIBLE;
   PUT SKIP LIST(INDEX(B, '1101'B), INDEX(B, E), INDEX(B, '111'B));
   PUT SKIP LIST(INDEX(B, '0000000'B), INDEX(B, V), INDEX(V, B));
   PUT SKIP LIST(INDEX(SUBSTR(B, 5), '1'B), INDEX(B || E, '01111'B));
   PUT SKIP LIST(INDEX(C, '1101'B), INDEX('1101'B, '01'));
   P = ADDR(I);
   S = UNSPEC(ADDR(I));
   PUT SKIP LIST(S = UNSPEC(P));
   PUT SKIP LIST(UNSPEC(I + 1), UNSPEC(I * 2));
   PUT SKIP LIST(UNSPEC(H + H));
   PUT SKIP LIST(UNSPEC(D + 1));
   PUT SKIP LIST(UNSPEC(F * 2));
   PUT SKIP LIST(UNSPEC(B & '1111000011110000'B));
   PUT SKIP LIST(R1, R2);
 R1: PROC RETURNS(FIXED BIN(15));
   RETURN(1);
 END R1;
 R2: PROC RETURNS(FIXED BIN(15));
   RETURN(2);
 END R2;
 END T244GAP;
