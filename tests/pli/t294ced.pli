 T294CED: PROC OPTIONS(MAIN);
   /* PUT EDIT OF COMPLEX VALUES (#2 C4): THE C FORMAT ITEM WITH ONE
      AND TWO ITEMS, F, E AND P; A REAL VALUE MEETING C, A COMPLEX
      VALUE MEETING F (ITS IMAGINARY PART NOT EDITED) */
   DCL X FLOAT DEC(6) INIT(4.5);
   DCL F COMPLEX FLOAT DEC(6) INIT(1.5+2.5I);
   DCL A COMPLEX FLOAT DEC(6) INIT(12.5-3.25I);
   DCL B COMPLEX FIXED DEC(5,2) INIT(-1.5+2.25I);
   DCL D COMPLEX FLOAT DEC(16) INIT(1.5E10+2.5E-3I);
   DCL I FIXED BIN(15);
   PUT EDIT(A)(C(F(8,2))) SKIP;
   PUT EDIT(A)(C(F(8,2),E(12,4))) SKIP;
   PUT EDIT(B)(C(F(7,2))) SKIP;
   PUT EDIT(B)(C(P'S99V.99')) SKIP;
   PUT EDIT(B)(C(P'99V.99',P'S99V.99')) SKIP;
   PUT EDIT(B, 'I')(C(F(7,2)), A) SKIP;
   PUT EDIT(D)(C(E(14,6))) SKIP;
   PUT EDIT(A, B)(2 C(F(9,3))) SKIP;
   PUT EDIT(A, 7, B)(C(F(8,1)), F(3), C(F(8,1))) SKIP;
   PUT EDIT(-A)(C(E(11,3,4))) SKIP;
   PUT EDIT('[', A, ']')(A, C(F(6,1)), A) SKIP;
   PUT EDIT(X)(C(F(6,1))) SKIP;
   PUT EDIT(X, 7)(C(F(6,1),F(4)), F(3)) SKIP;
   PUT EDIT(F)(F(6,1)) SKIP;
   PUT EDIT(F, 9)(F(6,1), F(6,1)) SKIP;
   PUT EDIT((A, B DO I = 1 TO 2))(C(F(8,2)), C(E(10,2))) SKIP;
   PUT SKIP LIST('END');
 END T294CED;
