 T291CMF: PROC OPTIONS(MAIN);
   /* MATHEMATICAL FUNCTIONS OF COMPLEX FLOAT VALUES, SHORT (#2 C3):
      SQRT, EXP, LOG, SIN, COS, SINH, COSH, TAN, TANH, ATAN, ATANH IN
      EACH QUADRANT AND ON THE AXES; A FIXED ARGUMENT */
   DCL (A,C) COMPLEX FLOAT DEC(6);
   DCL P COMPLEX FIXED DEC(3,1) INIT(1.5-0.5I);
   DCL I FIXED BIN(15);
   DCL V(8) COMPLEX FLOAT DEC(6) INIT(1+1I, -1+1I, 0.5-2I, -3-0.25I,
       2, -2, 0.25+0.5I, -0.75I);
   DO I = 1 TO 8;
     A = V(I);
     PUT SKIP LIST(A, SQRT(A), EXP(A));
     PUT SKIP LIST(LOG(A), SIN(A), COS(A));
     PUT SKIP LIST(SINH(A), COSH(A), TAN(A));
     PUT SKIP LIST(TANH(A), ATAN(A), ATANH(A));
   END;
   A = 1E-30+2E-30I; PUT SKIP LIST(SQRT(A), LOG(A));
   A = 1E70-3E70I; PUT SKIP LIST(SQRT(A), LOG(A));
   C = SQRT(P); PUT SKIP LIST(C, EXP(P)*2, REAL(LOG(P)));
 END T291CMF;
