 T115AER: PROC OPTIONS(MAIN);
   DCL A AREA(48) BASED(AP), B AREA(400) BASED(BP), (AP, BP, P) PTR;
   DCL X CHAR(16) BASED(P), (K, Z) FIXED BIN(31), NXT LABEL;
   DCL C AREA(8), OB OFFSET(B), OW FIXED BIN(31) BASED(OQ), OQ PTR;
   ALLOCATE A;
   ALLOCATE B;
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE);
     GO TO NXT;
   END;
   NXT = L1;
   DO K = 1 TO 5;
     ALLOCATE X IN(A) SET(P);
   END;
 L1: PUT SKIP LIST('K', K);
   NXT = L2;
   C = A;
   PUT SKIP LIST('AFTER ASSIGN');
 L2: NXT = L3;
   SIGNAL AREA;
   PUT SKIP LIST('AFTER SIGNAL');
 L3: ON AREA BEGIN;
     PUT SKIP LIST('SWITCH', ONCODE);
     AP = BP;
   END;
   ALLOCATE X IN(A) SET(P);
   OB = P;
   OQ = ADDR(OB);
   PUT SKIP LIST('IN B AT', OW);
   C = EMPTY;
   PUT SKIP LIST('EMPTIED');
 END T115AER;
