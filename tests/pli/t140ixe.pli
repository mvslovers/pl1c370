 T140IXE: PROC OPTIONS(MAIN);
   /* INDEXED with embedded keys (RKP > 0): unblocked E, blocked C;
      a KEYFROM or KEY that differs from the embedded key is KEY 55 */
   DCL E FILE RECORD KEYED ENV(INDEXED);
   DCL C FILE RECORD KEYED ENV(INDEXED);
   DCL REC CHAR(20), KC CHAR(5), (N, I, NE) FIXED BIN(31);
   DCL P PIC'9999', L LABEL;
   ON KEY(E) PUT SKIP LIST('KEY E', ONCODE, ONKEY);
   ON KEY(C) PUT SKIP LIST('KEY C', ONCODE, ONKEY);
   NE = 0;
   ON ERROR BEGIN;
     NE = NE + 1;
     PUT SKIP LIST('ERROR', ONCODE);
     IF NE < 20 THEN GO TO L;
   END;
   OPEN FILE(E) SEQUENTIAL OUTPUT;
   DO I = 1 TO 4;
     P = I;
     REC = 'ABCD' || 'E' || P || ' EMB ' || P;
     WRITE FILE(E) FROM(REC) KEYFROM('E' || P);
   END;
   REC = 'ABCDZZZZZ MISMATCH';
   WRITE FILE(E) FROM(REC) KEYFROM('E0009');
   CLOSE FILE(E);
   CALL LISTE('E CREATED');
   OPEN FILE(E) DIRECT UPDATE;
   READ FILE(E) INTO(REC) KEY('E0002');
   PUT SKIP LIST('E READ 2', REC);
   READ FILE(E) INTO(REC) KEY('ZZZZZ');
   PUT SKIP LIST('E READ Z', REC);
   REC = '....E0007 NEW 7';
   WRITE FILE(E) FROM(REC) KEYFROM('E0007');
   REC = 'ABCDE0009 WRONG';
   WRITE FILE(E) FROM(REC) KEYFROM('E0005');
   REC = 'ABCDE0003 REWR';
   REWRITE FILE(E) FROM(REC) KEY('E0003');
   REC = 'ABCDE0009 WRONG';
   REWRITE FILE(E) FROM(REC) KEY('E0001');
   DELETE FILE(E) KEY('E0004');
   CLOSE FILE(E);
   CALL LISTE('E UPDATED');
   OPEN FILE(E) SEQUENTIAL INPUT;
   READ FILE(E) INTO(REC) KEY('E0003');
   PUT SKIP LIST('E SEQ KEY 3', REC);
   CLOSE FILE(E);
   OPEN FILE(C) SEQUENTIAL OUTPUT;
   DO I = 1 TO 6;
     P = I;
     REC = 'XXC' || P || ' BLK RKP 2';
     WRITE FILE(C) FROM(REC) KEYFROM('C' || P);
   END;
   REC = 'XXC0009 WRONG';
   WRITE FILE(C) FROM(REC) KEYFROM('C0008');
   CLOSE FILE(C);
   CALL LISTC('C CREATED');
   L = S1;
   OPEN FILE(C) DIRECT UPDATE;
   READ FILE(C) INTO(REC) KEY('C0002');
   PUT SKIP LIST('C READ 2', REC);
   DELETE FILE(C) KEY('C0002');
   DELETE FILE(C) KEY('C0003');
   REC = 'YYC0006 NO READ';
   REWRITE FILE(C) FROM(REC) KEY('C0006');
 S1: L = S2;
   READ FILE(C) INTO(REC) KEY('C0004');
   REC = 'YYC0004 REWR';
   REWRITE FILE(C) FROM(REC) KEY('C0004');
   READ FILE(C) INTO(REC) KEY('C0005');
   REC = 'YYC0009 REWR';
   REWRITE FILE(C) FROM(REC) KEY('C0005');
   REC = 'ZZC0007 NEW';
   WRITE FILE(C) FROM(REC) KEYFROM('C0007');
   REC = 'ZZC0009 NEW';
   WRITE FILE(C) FROM(REC) KEYFROM('C0008');
 S2: L = S3;
   CLOSE FILE(C);
   CALL LISTC('C UPDATED');
   OPEN FILE(C) SEQUENTIAL UPDATE;
   READ FILE(C) INTO(REC) KEYTO(KC);
   DELETE FILE(C);
   READ FILE(C) INTO(REC) KEYTO(KC);
   REC = 'QQC0004 SEQ';
   REWRITE FILE(C) FROM(REC);
 S3: L = S4;
   CLOSE FILE(C);
   CALL LISTC('C SEQUPD');
 S4: PUT SKIP LIST('LAST');
   REVERT ERROR;
   REVERT KEY(C);
   OPEN FILE(C) SEQUENTIAL OUTPUT;
   REC = 'XXC0001 OK';
   WRITE FILE(C) FROM(REC) KEYFROM('C0002');
   PUT SKIP LIST('NOT REACHED');
 LISTC: PROC(T);
   DCL T CHAR(*);
   OPEN FILE(C) SEQUENTIAL INPUT;
   ON ENDFILE(C) GO TO EOF;
   DO WHILE('1'B);
     READ FILE(C) INTO(REC) KEYTO(KC);
     PUT SKIP LIST(T, KC, REC);
   END;
 EOF:
   CLOSE FILE(C);
 END LISTC;
 LISTE: PROC(T);
   DCL T CHAR(*);
   OPEN FILE(E) SEQUENTIAL INPUT;
   ON ENDFILE(E) GO TO EOF;
   DO WHILE('1'B);
     READ FILE(E) INTO(REC) KEYTO(KC);
     PUT SKIP LIST(T, KC, REC);
   END;
 EOF:
   CLOSE FILE(E);
 END LISTE;
 END T140IXE;
