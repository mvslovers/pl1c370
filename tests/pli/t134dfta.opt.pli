 T134DFA: PROC OPTIONS(MAIN);
   DEFAULT RANGE(*) VALUE(AREA(200));
   DCL A AREA, B AREA(64), 1 S, 2 C AREA, 2 N FIXED BIN(31);
   DCL W FIXED BIN(31) BASED(Q), Q PTR, X CHAR(8) BASED(P), P PTR;
   DCL K FIXED BIN(31);
   Q = ADDR(A);
   PUT SKIP LIST('A', W);
   Q = ADDR(B);
   PUT SKIP LIST('B', W);
   Q = ADDR(S.C);
   PUT SKIP LIST('C', W);
   ON AREA GO TO FULL;
   DO K = 1 TO 100;
     ALLOCATE X IN(A) SET(P);
   END;
 FULL: PUT SKIP LIST('A HOLDS', K - 1);
 END T134DFA;
