 T215EVR: PROC OPTIONS(MAIN);
   /* the twin of t215evr.opt.pli: the calls and files the variables
      stand for, written out */
   DCL TWICE ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15));
   DCL SQUARE ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15));
   DCL REPORT FILE STREAM OUTPUT;
   DCL I FIXED BIN(15) INIT(0);
   PUT LIST(TWICE(5));
   PUT LIST(SQUARE(5));
   CALL HELLO;
   PUT FILE(REPORT) LIST('TO REPORT');
   PUT FILE(REPORT) SKIP LIST('AGAIN');
   DO I = 1 TO 3;
      CALL SHOW(SYSPRINT, I);
   END;
 TWICE: PROC(X) RETURNS(FIXED BIN(15));
   DCL X FIXED BIN(15);
   RETURN(X * 2);
 END TWICE;
 SQUARE: PROC(X) RETURNS(FIXED BIN(15));
   DCL X FIXED BIN(15);
   RETURN(X * X + I);
 END SQUARE;
 HELLO: PROC;
   PUT SKIP LIST('HELLO');
 END HELLO;
 SHOW: PROC(H, N);
   DCL H FILE, N FIXED BIN(15);
   PUT FILE(H) SKIP LIST('LINE', N);
 END SHOW;
 END T215EVR;
