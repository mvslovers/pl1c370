 T176SUS: PROC OPTIONS(MAIN);
   DCL SETSUC ENTRY(BIT(1));
   DCL (SUC, FAIL) ENTRY RETURNS(BIT(1));
   DCL COUNT ENTRY RETURNS(FIXED BIN(15));
   PUT SKIP LIST(SUC, FAIL, COUNT);
   CALL SETSUC('0'B);
   PUT SKIP LIST(SUC, FAIL, COUNT);
   CALL SETSUC('1'B);
   PUT SKIP LIST(SUC, FAIL, COUNT);
   IF SUC THEN PUT SKIP LIST('SUCCESS');
   IF ¬FAIL THEN PUT SKIP LIST('NOT FAILED');
 END T176SUS;
*PROCESS;
 SETSUC: PROC(VAL);
   DCL VAL BIT(*);
   DCL PVLSEUS BIT(1) STATIC EXTERNAL INIT('1'B);
   DCL N FIXED BIN(15) STATIC INIT(0);
   PVLSEUS = VAL;
   N = N + 1;
   RETURN;
 FAIL: ENTRY RETURNS(BIT(1));
   RETURN(¬PVLSEUS);
 SUC: ENTRY RETURNS(BIT(1));
   RETURN(PVLSEUS);
 COUNT: ENTRY RETURNS(FIXED BIN(15));
   RETURN(N);
 END SETSUC;
