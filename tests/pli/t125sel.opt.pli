 T125SEL: PROC OPTIONS(MAIN);
   DCL (I, N, CALLS) FIXED BIN(31), MONTH CHAR(3), YEAR FIXED BIN(15);
   DCL NO_DAYS FIXED BIN(15), M(5) CHAR(3) INIT('JAN', 'FEB', 'APR',
       'SEP', 'DEC'), NXT LABEL;
   DCL F ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   CALLS = 0;
   DO I = 1 TO 6;
     SELECT (I);
       WHEN (1, 3) PUT SKIP LIST(I, 'ONE OR THREE');
       WHEN (2) DO;
         N = I * 10;
         PUT SKIP LIST(I, 'TWO', N);
       END;
       WHEN (5) ;
       OTHERWISE PUT SKIP LIST(I, 'OTHER');
     END;
   END;
   DO I = 1 TO 5;
     MONTH = M(I);
     DO YEAR = 1975, 1976;
       SELECT (MONTH);
         WHEN ('FEB') SELECT (MOD(YEAR, 4));
           WHEN (0) NO_DAYS = 29;
           OTHERWISE NO_DAYS = 28;
         END;
         WHEN ('APR', 'JUN', 'SEP', 'NOV') NO_DAYS = 30;
         OTHERWISE NO_DAYS = 31;
       END;
       PUT SKIP LIST(MONTH, YEAR, NO_DAYS);
     END;
   END;
   DO I = -2 TO 2;
     SELECT;
       WHEN (I < 0) PUT SKIP LIST(I, 'NEGATIVE');
       WHEN (I = 0) PUT SKIP LIST(I, 'ZERO');
       OTHERWISE PUT SKIP LIST(I, 'POSITIVE');
     END;
   END;
   SELECT (F(2));
     WHEN (F(1), F(2), F(3)) PUT SKIP LIST('MATCHED', CALLS);
   END;
   SELECT;
     OTHERWISE PUT SKIP LIST('ONLY OTHERWISE');
   END;
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR');
     GO TO NXT;
   END;
   NXT = OUT;
   SELECT (7);
     WHEN (1) PUT SKIP LIST('NO');
   END;
 OUT: PUT SKIP LIST('END');
 F: PROC(X) RETURNS(FIXED BIN(31));
   DCL X FIXED BIN(31);
   CALLS = CALLS + 1;
   PUT SKIP LIST('F', X);
   RETURN(X);
 END F;
 END T125SEL;
