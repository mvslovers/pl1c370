 T221ING: PROC OPTIONS(MAIN);
   /* INITIAL WITH GROUPS: (N)(ITEM, ...), NESTED */
   DCL A(6) FIXED BIN(15) INIT((2)(3, 4), 5, 6);
   DCL B(8) FIXED BIN(15) INIT((2)(1, (2)(7, 8)), 9);
   DCL C(4) FIXED BIN(15) STATIC INIT((2)(1, 2));
   PUT LIST(A);
   PUT SKIP LIST(B);
   PUT SKIP LIST(C);
 END T221ING;
