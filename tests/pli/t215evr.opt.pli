 T215EVR: PROC OPTIONS(MAIN);
   /* ANSI X3.53-1976's ENTRY and FILE variables (VARIABLE, CM24):
      PL/I (F) has ENTRY and FILE parameters only */
   DCL E ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15)) VARIABLE;
   DCL P ENTRY VARIABLE;
   DCL (F, G) FILE VARIABLE;
   DCL REPORT FILE STREAM OUTPUT;
   DCL I FIXED BIN(15) INIT(0);
   E = TWICE;
   PUT LIST(E(5));
   E = SQUARE;
   PUT LIST(E(5));
   P = HELLO;
   CALL P;
   F = REPORT;
   PUT FILE(F) LIST('TO REPORT');
   G = F;
   PUT FILE(G) SKIP LIST('AGAIN');
   F = SYSPRINT;
   DO I = 1 TO 3;
      CALL SHOW(F, I);
   END;
 TWICE: PROC(X) RETURNS(FIXED BIN(15));
   DCL X FIXED BIN(15);
   RETURN(X * 2);
 END TWICE;
 SQUARE: PROC(X) RETURNS(FIXED BIN(15));
   DCL X FIXED BIN(15);
   RETURN(X * X + I);
 END SQUARE;
 HELLO: PROC;
   PUT SKIP LIST('HELLO');
 END HELLO;
 SHOW: PROC(H, N);
   DCL H FILE, N FIXED BIN(15);
   PUT FILE(H) SKIP LIST('LINE', N);
 END SHOW;
 END T215EVR;
