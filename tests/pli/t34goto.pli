 T34GOTO: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31) INIT(0);
   DCL P ENTRY;
   ON ZERODIVIDE GO TO OUT;
   CALL P;
   PUT SKIP LIST('NOT REACHED');
 OUT:
   PUT SKIP LIST('OUT', ONCODE);
   CALL Q;
   PUT SKIP LIST('MAIN AFTER');
   CALL Q2;
   PUT SKIP LIST('NOT REACHED 2');
 MAINL:
   PUT SKIP LIST('AT MAINL');
 P: PROC;
   DCL K FIXED BIN(31) INIT(0);
   PUT SKIP LIST('IN P');
   K = 1 / K;
   PUT SKIP LIST('P NOT REACHED');
 END P;
 Q: PROC;
   DCL K FIXED BIN(31) INIT(0);
   ON ZERODIVIDE PUT SKIP LIST('Q ZD');
   K = 1 / K;
   REVERT ZERODIVIDE;
   PUT SKIP LIST('Q AFTER REVERT');
   ON ZERODIVIDE PUT SKIP LIST('Q ZD AGAIN');
   K = 0;
   K = 1 / K;
 END Q;
 Q2: PROC;
   PUT SKIP LIST('IN Q2');
   GO TO MAINL;
 END Q2;
 END T34GOTO;
