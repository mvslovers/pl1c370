 T31SIG: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31) INIT(0);
   DCL P ENTRY;
   ON CONDITION(MINE) PUT SKIP LIST('MINE', ONCODE);
   SIGNAL CONDITION(MINE);
   PUT SKIP LIST('AFTER MINE');
   SIGNAL CONDITION(OTHER);
   PUT SKIP LIST('AFTER OTHER');
   ON ZERODIVIDE PUT SKIP LIST('MAIN ZD');
   CALL P;
   I = 0;
   I = 1 / I;
   PUT SKIP LIST('BACK IN MAIN');
   REVERT ZERODIVIDE;
   SIGNAL ZERODIVIDE;
   PUT SKIP LIST('NOT REACHED');
 P: PROC;
   DCL K FIXED BIN(31) INIT(0);
   K = 1 / K;
   PUT SKIP LIST('P AFTER INHERITED');
   ON ZERODIVIDE PUT SKIP LIST('P ZD');
   K = 0;
   K = 1 / K;
   SIGNAL CONDITION(MINE);
   SIGNAL CONDITION(INP);
   PUT SKIP LIST('P END');
 END P;
 END T31SIG;
