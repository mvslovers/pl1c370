 T148BMP: PROC OPTIONS(MAIN);
   /* how PL/I (F) maps unaligned bit strings in structures, arrays */
   DCL REPORT FILE RECORD OUTPUT;
   DCL SEP CHAR(2) INIT('--');
   DCL 1 S1, 2 A BIT(3), 2 B BIT(2), 2 C CHAR(1);
   DCL 1 S2, 2 A CHAR(1), 2 B BIT(3), 2 C FIXED BIN(31);
   DCL 1 S3, 2 A BIT(1), 2 B FIXED BIN(15), 2 C BIT(2);
   DCL 1 S4, 2 A(3) BIT(3), 2 B BIT(2) ALIGNED, 2 C CHAR(1);
   DCL 1 S5, 2 T(3), 3 P BIT(2), 3 Q BIT(1), 2 C CHAR(1);
   DCL 1 S6, 2 V, 3 W BIT(4), 3 X BIT(5), 2 Y CHAR(1), 2 Z BIT(7);
   DCL 1 S7, 2 A BIT(9), 2 B BIT(9), 2 C BIT(9), 2 D CHAR(1);
   DCL X5(5) BIT(3);
   DCL 1 S8, 2 A FIXED DEC(3), 2 B BIT(4), 2 C FLOAT DEC(6);
   DCL I FIXED BIN(15);
   S1.A = '111'B; S1.B = '01'B; S1.C = 'A';
   WRITE FILE(REPORT) FROM(S1); WRITE FILE(REPORT) FROM(SEP);
   S2.A = 'B'; S2.B = '101'B; S2.C = 7;
   WRITE FILE(REPORT) FROM(S2); WRITE FILE(REPORT) FROM(SEP);
   S3.A = '1'B; S3.B = 3; S3.C = '11'B;
   WRITE FILE(REPORT) FROM(S3); WRITE FILE(REPORT) FROM(SEP);
   S4.A(1) = '100'B; S4.A(2) = '010'B; S4.A(3) = '001'B;
   S4.B = '11'B; S4.C = 'C';
   WRITE FILE(REPORT) FROM(S4); WRITE FILE(REPORT) FROM(SEP);
   DO I = 1 TO 3; S5.P(I) = '10'B; S5.Q(I) = '1'B; END;
   S5.C = 'D';
   WRITE FILE(REPORT) FROM(S5); WRITE FILE(REPORT) FROM(SEP);
   S6.W = '1111'B; S6.X = '10001'B; S6.Y = 'E'; S6.Z = '1010101'B;
   WRITE FILE(REPORT) FROM(S6); WRITE FILE(REPORT) FROM(SEP);
   S7.A = '111111111'B; S7.B = '000000001'B; S7.C = '100000001'B;
   S7.D = 'F';
   WRITE FILE(REPORT) FROM(S7); WRITE FILE(REPORT) FROM(SEP);
   X5 = '101'B; X5(5) = '111'B;
   WRITE FILE(REPORT) FROM(X5); WRITE FILE(REPORT) FROM(SEP);
   S8.A = 12; S8.B = '1001'B; S8.C = 1;
   WRITE FILE(REPORT) FROM(S8); WRITE FILE(REPORT) FROM(SEP);
   PUT SKIP LIST('DONE', S4.A(2), S5.P(3), S7.B, X5(2));
 END T148BMP;
