 T120DO2: PROC OPTIONS(MAIN);
   DCL (I, J, B) FIXED BIN(31), H FIXED BIN(15), X FLOAT BIN(21);
   DCL D FIXED DEC(7,1), S CHAR(200) VARYING;
   DCL P ENTRY(FIXED BIN(31));
   S = '';
   DO I = 1, 3;
     DO J = I TO 1 BY -1, 9;
       S = S || CHAR(10 * I + J);
     END;
   END;
   PUT SKIP LIST('NESTED', S);
   S = '';
   B = -3;
   DO H = 10 TO -5 BY B;
     B = 100;
     S = S || CHAR(H);
   END;
   PUT SKIP LIST('BY ONCE', S, H);
   S = '';
   DO I = 1 TO 5 BY 2 WHILE(I < 4);
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('WHILE BY', S, I);
   DO X = 1E0 BY 0.5E0 TO 2E0;
     PUT SKIP LIST('FLOAT BIN', X);
   END;
   DO D = 0 TO 1.25E0 BY 0.5;
     PUT SKIP LIST('DEC TO FLOAT', D);
   END;
   S = '';
   DO I = 3 TO 1, 4 TO 3, 5 WHILE(I = 5);
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('EMPTY SPECS', S, I);
   S = '';
   J = 0;
   DO I = 1 BY 1 WHILE(J < 3), 100;
     J = J + 1;
     IF I = 2 THEN I = 10;
     S = S || CHAR(I);
   END;
   PUT SKIP LIST('CHANGE', S, I, J);
   CALL P(3);
   S = REPEAT('ABCDEFGHIJ', 18);
   PUT SKIP LIST('LONG', S, 'NEXT');
   PUT SKIP LIST(SUBSTR(S, 1, 120), 'AFTER');
   PUT SKIP LIST(SUBSTR(S, 1, 121));
 P: PROC(N) RECURSIVE;
   DCL (N, K) FIXED BIN(31);
   DO K = N, N * 10 WHILE(N > 1);
     PUT SKIP LIST('LEVEL', N, K);
     IF K = N & N > 1 THEN CALL P(N - 1);
   END;
 END P;
 END T120DO2;
