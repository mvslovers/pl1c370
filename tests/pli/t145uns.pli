 T145UNS: PROC OPTIONS(MAIN);
   /* UNSPEC of more than 32 bits: the variable's own bytes */
   DCL C CHAR(6) INIT('ABC123'), F FLOAT DEC(16) INIT(-2.5);
   DCL D FIXED DEC(9,2) INIT(-1234567.89), B BIT(40);
   DCL A AREA(20), X FIXED BIN(31) BASED(P), P POINTER;
   DCL U BIT(64), V BIT(16);
   B = '1100110011001100110011001100110011001100'B;
   PUT SKIP LIST(UNSPEC(C));
   PUT SKIP LIST(UNSPEC(F));
   PUT SKIP LIST(UNSPEC(D));
   PUT SKIP LIST(UNSPEC(B));
   ALLOCATE X IN(A) SET(P);
   X = 5;
   PUT SKIP LIST(SUBSTR(UNSPEC(A), 1, 96));
   U = UNSPEC(F);
   V = SUBSTR(UNSPEC(C), 9, 16);
   PUT SKIP LIST(U, V, LENGTH(UNSPEC(C)));
   IF UNSPEC(C) = UNSPEC('ABC123') THEN PUT SKIP LIST('EQUAL');
 END T145UNS;
