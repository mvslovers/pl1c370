 T202ANS: PROC OPTIONS(MAIN);
   /* ANSI X3.53-1976 functions (9.4.4): OFFSET(p, a), POINTER(o, a),
      ONFIELD, PAGENO and the PAGENO pseudo-variable, VALID */
   DCL A AREA(200) BASED(Q), X FIXED BIN(31) BASED(P), (P, P2, Q) PTR;
   DCL O OFFSET(A), O1 OFFSET(A);
   DCL N1 PIC '999', C1 CHAR(3) DEF N1;
   DCL N2 PIC 'ZZ9', C2 CHAR(3) DEF N2;
   DCL N3 PIC '99.9', C3 CHAR(4) DEF N3;
   DCL K PIC 'AA99X', CK CHAR(5) DEF K;
   DCL (I, J) FIXED BIN(15) INIT(0), D CHAR(20) VARYING;
   ALLOCATE A;
   ALLOCATE X IN(A) SET(P);
   ALLOCATE X IN(A) SET(P);
   P->X = 77;
   O1 = OFFSET(P, A);
   P2 = POINTER(O1, A);
   PUT SKIP LIST(UNSPEC(O1), P2->X, P2 = P);
   O = OFFSET(P2, A);
   P = POINTER(O, A);
   PUT SKIP LIST(O = O1, P->X);
   ON NAME(SYSIN) BEGIN;
     D = ONFIELD;
     PUT SKIP LIST('ONFIELD', D);
   END;
   GET DATA(I, J);
   PUT SKIP LIST(I, J);
   PUT SKIP LIST('PAGE', PAGENO(SYSPRINT));
   PUT PAGE LIST('PAGE', PAGENO(SYSPRINT));
   PAGENO(SYSPRINT) = 10;
   PUT SKIP LIST('PAGE', PAGENO(SYSPRINT));
   PUT PAGE LIST('PAGE', PAGENO(SYSPRINT));
   N1 = 123;
   PUT SKIP LIST(VALID(N1), N1);
   C1 = '1A3';
   PUT SKIP LIST(VALID(N1), C1);
   N2 = 12;
   PUT SKIP LIST(VALID(N2), C2);
   C2 = '012';
   PUT SKIP LIST(VALID(N2), C2);
   N3 = 45;
   PUT SKIP LIST(VALID(N3), C3);
   C3 = '4.50';
   PUT SKIP LIST(VALID(N3), C3);
   CK = 'AB12%';
   PUT SKIP LIST(VALID(K), CK);
   CK = 'A112%';
   PUT SKIP LIST(VALID(K), CK);
   CK = ' B 2Z';
   PUT SKIP LIST(VALID(K), CK);
 END T202ANS;
