 T211LSZ: PROC OPTIONS(MAIN);
   DCL (I, N) FIXED BIN(15);
   DCL S CHAR(26) INIT('ABCDEFGHIJKLMNOPQRSTUVWXYZ');
   N = 4;
   OPEN FILE(SYSPRINT) LINESIZE(N * 12 + 2) PAGESIZE(N + 2);
   PUT LIST(1, 2, 3, 4, 5);
   PUT SKIP LIST(S, S);
   DO I = 1 TO 6;
     PUT SKIP LIST(I, LINENO(SYSPRINT));
   END;
   PUT SKIP EDIT((60)'X') (A);
   PUT SKIP EDIT('END') (A);
   PUT SKIP DATA(N, I);
 END T211LSZ;
