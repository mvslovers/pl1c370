 T68MAT2: PROC OPTIONS(MAIN);
   DCL (A,B) FLOAT DEC(6), (C,D) FLOAT DEC(16);
   A = 100E0; C = 100E0; B = SIN(A); D = SIN(C);
   PUT SKIP LIST('SIN', A, B, D);
   A = -3E0; C = -3E0; B = SIN(A); D = SIN(C);
   PUT SKIP LIST('SIN', A, B, D);
   A = 1E0; C = 1E0; B = COS(A); D = COS(C);
   PUT SKIP LIST('COS', A, B, D);
   A = 0.5E0; C = 0.5E0; B = COS(A); D = COS(C);
   PUT SKIP LIST('COS', A, B, D);
   A = 100E0; C = 100E0; B = COS(A); D = COS(C);
   PUT SKIP LIST('COS', A, B, D);
   A = -3E0; C = -3E0; B = COS(A); D = COS(C);
   PUT SKIP LIST('COS', A, B, D);
   A = 1E0; C = 1E0; B = TAN(A); D = TAN(C);
   PUT SKIP LIST('TAN', A, B, D);
   A = 0.5E0; C = 0.5E0; B = TAN(A); D = TAN(C);
   PUT SKIP LIST('TAN', A, B, D);
   A = -2E0; C = -2E0; B = TAN(A); D = TAN(C);
   PUT SKIP LIST('TAN', A, B, D);
   A = 30E0; C = 30E0; B = SIND(A); D = SIND(C);
   PUT SKIP LIST('SIND', A, B, D);
   A = 45E0; C = 45E0; B = SIND(A); D = SIND(C);
   PUT SKIP LIST('SIND', A, B, D);
   A = 200E0; C = 200E0; B = SIND(A); D = SIND(C);
   PUT SKIP LIST('SIND', A, B, D);
   A = 30E0; C = 30E0; B = COSD(A); D = COSD(C);
   PUT SKIP LIST('COSD', A, B, D);
   A = 45E0; C = 45E0; B = COSD(A); D = COSD(C);
   PUT SKIP LIST('COSD', A, B, D);
   A = 200E0; C = 200E0; B = COSD(A); D = COSD(C);
   PUT SKIP LIST('COSD', A, B, D);
   A = 30E0; C = 30E0; B = TAND(A); D = TAND(C);
   PUT SKIP LIST('TAND', A, B, D);
   A = 45E0; C = 45E0; B = TAND(A); D = TAND(C);
   PUT SKIP LIST('TAND', A, B, D);
   A = 100E0; C = 100E0; B = TAND(A); D = TAND(C);
   PUT SKIP LIST('TAND', A, B, D);
   A = 1E0; C = 1E0; B = ATAN(A); D = ATAN(C);
   PUT SKIP LIST('ATAN', A, B, D);
   A = 0.5E0; C = 0.5E0; B = ATAN(A); D = ATAN(C);
   PUT SKIP LIST('ATAN', A, B, D);
   A = -20E0; C = -20E0; B = ATAN(A); D = ATAN(C);
   PUT SKIP LIST('ATAN', A, B, D);
 END T68MAT2;
