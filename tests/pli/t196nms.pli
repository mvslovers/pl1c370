 T196NMS: PROC OPTIONS(MAIN);
   /* NAME without an on-unit, SIGNAL, and with one */
   DCL (A, B) FIXED BIN(15) INIT(0), D CHAR(20) VARYING;
   PUT SKIP LIST('BEFORE');
   SIGNAL NAME(SYSIN);
   PUT SKIP LIST('AFTER');
   GET DATA(A, B);
   PUT SKIP LIST(A, B);
   ON NAME(SYSIN) BEGIN;
     D = DATAFIELD;
     PUT SKIP LIST(D, LENGTH(D));
   END;
   GET DATA(A, B);
   PUT SKIP LIST(A, B);
 END T196NMS;
