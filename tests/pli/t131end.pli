 T131END: PROC OPTIONS(MAIN);
   DCL (I, J, K, N) FIXED BIN(31), P ENTRY(FIXED BIN(31));
   N = 0;
 A: DO I = 1 TO 3;
     B: DO J = 1 TO 2;
       DO K = 1 TO 2;
         N = N + 1;
   END A;
   PUT SKIP LIST('NESTED', I, J, K, N);
   N = 0;
 C: DO I = 1 TO 2;
     DO J = 1 TO 3;
       N = N + 10;
     END;
     N = N + 1;
 L1: END C;
   PUT SKIP LIST('LABELLED', I, J, N);
   CALL P(5);
 P: PROC(X);
   DCL X FIXED BIN(31);
   IF X > 0 THEN DO;
     PUT SKIP LIST('IN P', X);
     DO I = 1 TO X;
       N = N + I;
 END P;
   PUT SKIP LIST('AFTER P', N);
 END T131END;
