 T107ENT: PROC OPTIONS(MAIN);
   DCL (N, R) FIXED BIN(31);
   DCL BUMP ENTRY(FIXED BIN(31)), SHOW ENTRY, RESET ENTRY;
   DCL STORE ENTRY(FIXED BIN(31));
   DCL GETV ENTRY RETURNS(FIXED BIN(31));
   DCL SQ ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   CALL RESET;
   CALL BUMP(5); CALL BUMP(7);
   CALL SHOW;
   R = GETV; PUT SKIP LIST('GETV', R);
   R = SQ(9); PUT SKIP LIST('SQ', R);
   CALL STORE(3);
   CALL SHOW;
 STORE: PROC(X);
   DCL X FIXED BIN(31), TOTAL FIXED BIN(31) STATIC INIT(0);
   TOTAL = X;
   PUT SKIP LIST('STORE', TOTAL);
   RETURN;
 BUMP: ENTRY(X);
   TOTAL = TOTAL + X;
   PUT SKIP LIST('BUMP', X, TOTAL);
   RETURN;
 RESET: ENTRY;
   TOTAL = 0;
   RETURN;
 SHOW: ENTRY;
   PUT SKIP LIST('SHOW', TOTAL);
 END STORE;
 GETV: PROC RETURNS(FIXED BIN(31));
   DCL Y FIXED BIN(31);
   RETURN(42);
 SQ: ENTRY(Y) RETURNS(FIXED BIN(31));
   RETURN(Y * Y);
 END GETV;
 END T107ENT;
