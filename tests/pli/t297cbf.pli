 T297CBF: PROC OPTIONS(MAIN);
   /* COMPLEX VALUES (#2 C5): ROUND, PRECISION, FIXED, FLOAT, BINARY,
      DECIMAL; SUM, PROD, POLY OF COMPLEX ARRAYS; ARRAY ASSIGNMENTS */
   DCL A COMPLEX FLOAT DEC(6) INIT(12.345-6.789I);
   DCL P COMPLEX FIXED DEC(7,3) INIT(12.345-6.789I);
   DCL ZA(3) COMPLEX FLOAT DEC(6) INIT(1+1I, 2-1I, 0.5I);
   DCL PA(3) COMPLEX FIXED DEC(5,1) INIT(1.5+1I, 2, -3I);
   PUT SKIP LIST(ROUND(P,1), ROUND(P,0), ROUND(A,2));
   PUT SKIP LIST(PRECISION(P,5,1), FIXED(A,7,2), FLOAT(P,6));
   PUT SKIP LIST(BINARY(P), DECIMAL(A), FIXED(P));
   PUT SKIP LIST(SUM(ZA), PROD(ZA));
   PUT SKIP LIST(SUM(PA), PROD(PA));
   PUT SKIP LIST(POLY(ZA, 2), POLY(ZA, 1I));
   ZA = ZA * 2;
   PUT SKIP LIST(ZA);
   ZA = ZA + PA;
   PUT SKIP LIST(ZA);
 END T297CBF;
