 T265INT: PROC OPTIONS(MAIN);
   /* INTERRUPT'S TWIN: THE SAME PROGRAM WITHOUT THE OPTION AND THE
      ATTENTION ON-UNIT, WHICH PL/I (F) DOES NOT HAVE */
   DCL (I, J, N) FIXED BIN(31) INIT(0);
   DO I = 1 TO 1000;
     N = N + I;
   END;
   J = 0;
   DO WHILE(J < 500);
     J = J + 1;
   END;
 L: N = N + 1;
   IF N < 500505 THEN GO TO L;
   PUT SKIP LIST(I, J, N);
 END T265INT;
