 T57LONG: PROC OPTIONS(MAIN);
   /* more than 8 KB of code: branches across all three bases */
   DCL (I, N) FIXED BIN(31) INIT(0), D FIXED DEC(7,2) INIT(1.25);
   DCL F FLOAT DEC(6) INIT(2.5), S CHAR(12) INIT('ABCDEFGHIJKL');
   DCL P ENTRY;
   GO TO FAR;
 BACK:
   PUT SKIP LIST('BACK', N);
   D = D * 1.5 + 0; F = F / 1.1 + 0;
   PUT SKIP LIST(0, D, F, SUBSTR(S, MOD(0, 10) + 1, 3));
   D = D * 1.5 + 1; F = F / 1.1 + 1;
   PUT SKIP LIST(1, D, F, SUBSTR(S, MOD(1, 10) + 1, 3));
   D = D * 1.5 + 2; F = F / 1.1 + 2;
   PUT SKIP LIST(2, D, F, SUBSTR(S, MOD(2, 10) + 1, 3));
   D = D * 1.5 + 3; F = F / 1.1 + 3;
   PUT SKIP LIST(3, D, F, SUBSTR(S, MOD(3, 10) + 1, 3));
   D = D * 1.5 + 4; F = F / 1.1 + 4;
   PUT SKIP LIST(4, D, F, SUBSTR(S, MOD(4, 10) + 1, 3));
   D = D * 1.5 + 5; F = F / 1.1 + 5;
   PUT SKIP LIST(5, D, F, SUBSTR(S, MOD(5, 10) + 1, 3));
   D = D * 1.5 + 6; F = F / 1.1 + 6;
   PUT SKIP LIST(6, D, F, SUBSTR(S, MOD(6, 10) + 1, 3));
   D = D * 1.5 + 7; F = F / 1.1 + 7;
   PUT SKIP LIST(7, D, F, SUBSTR(S, MOD(7, 10) + 1, 3));
   D = D * 1.5 + 8; F = F / 1.1 + 8;
   PUT SKIP LIST(8, D, F, SUBSTR(S, MOD(8, 10) + 1, 3));
   D = D * 1.5 + 9; F = F / 1.1 + 9;
   PUT SKIP LIST(9, D, F, SUBSTR(S, MOD(9, 10) + 1, 3));
   DO I = 1 TO 3; N = N + I * 9; END;
   IF N > 180 THEN PUT SKIP LIST('N', N); ELSE GO TO L9;
 L9: PUT SKIP LIST('L9');
   D = D * 1.5 + 10; F = F / 1.1 + 10;
   PUT SKIP LIST(10, D, F, SUBSTR(S, MOD(10, 10) + 1, 3));
   D = D * 1.5 + 11; F = F / 1.1 + 11;
   PUT SKIP LIST(11, D, F, SUBSTR(S, MOD(11, 10) + 1, 3));
   D = D * 1.5 + 12; F = F / 1.1 + 12;
   PUT SKIP LIST(12, D, F, SUBSTR(S, MOD(12, 10) + 1, 3));
   D = D * 1.5 + 13; F = F / 1.1 + 13;
   PUT SKIP LIST(13, D, F, SUBSTR(S, MOD(13, 10) + 1, 3));
   D = D * 1.5 + 14; F = F / 1.1 + 14;
   PUT SKIP LIST(14, D, F, SUBSTR(S, MOD(14, 10) + 1, 3));
   D = D * 1.5 + 15; F = F / 1.1 + 15;
   PUT SKIP LIST(15, D, F, SUBSTR(S, MOD(15, 10) + 1, 3));
   D = D * 1.5 + 16; F = F / 1.1 + 16;
   PUT SKIP LIST(16, D, F, SUBSTR(S, MOD(16, 10) + 1, 3));
   D = D * 1.5 + 17; F = F / 1.1 + 17;
   PUT SKIP LIST(17, D, F, SUBSTR(S, MOD(17, 10) + 1, 3));
   D = D * 1.5 + 18; F = F / 1.1 + 18;
   PUT SKIP LIST(18, D, F, SUBSTR(S, MOD(18, 10) + 1, 3));
   D = D * 1.5 + 19; F = F / 1.1 + 19;
   PUT SKIP LIST(19, D, F, SUBSTR(S, MOD(19, 10) + 1, 3));
   DO I = 1 TO 3; N = N + I * 19; END;
   IF N > 380 THEN PUT SKIP LIST('N', N); ELSE GO TO L19;
 L19: PUT SKIP LIST('L19');
   CALL P;
   GO TO DONE;
 FAR:
   N = 7;
   GO TO BACK;
 DONE:
   PUT SKIP LIST('DONE', N, D);
 P: PROC;
   ON ZERODIVIDE GO TO OUT;
   I = 0; I = 1 / I;
   PUT SKIP LIST('NOT REACHED');
 END P;
 OUT: PUT SKIP LIST('OUT');
 END T57LONG;
