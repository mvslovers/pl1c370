 (SUBRG): T62SUBR: PROC OPTIONS(MAIN);
   DCL A(5) FIXED BIN(31) INIT(1, 2, 3, 4, 5), I FIXED BIN(15);
   DCL B(2,3) FIXED BIN(15) INIT((6)0), N FIXED BIN(15) INIT(0);
   ON SUBSCRIPTRANGE BEGIN;
     N = N + 1;
     PUT SKIP LIST('SUBRG', ONCODE, N);
     IF N = 1 THEN GO TO L1;
     IF N = 2 THEN GO TO L2;
     GO TO L3;
   END;
   I = 6;
   PUT SKIP LIST(A(I));
 L1: I = 0; A(I) = 9;
 L2: PUT SKIP LIST(B(1, 4));
 L3: I = 5; PUT SKIP LIST(A(I));
   REVERT SUBSCRIPTRANGE;
   I = 7;
   PUT SKIP LIST(A(I));
   PUT SKIP LIST('NOT REACHED');
 END T62SUBR;
