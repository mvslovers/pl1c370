 T290CFA: PROC OPTIONS(MAIN);
   /* COMPLEX FIXED (#2): ABS, POWERS THAT STAY FIXED, ADD, MULTIPLY
      AND DIVIDE OF COMPLEX VALUES */
   DCL P COMPLEX FIXED DEC(5,2);
   DCL Q COMPLEX FIXED DEC(15,3);
   DCL U COMPLEX FIXED BIN(15);
   DCL V COMPLEX FIXED BIN(31,8);
   DCL D COMPLEX FIXED DEC(2);
   DCL E COMPLEX FIXED DEC(3,1);
   DCL (A,C) COMPLEX FLOAT DEC(6);
   DCL Y FIXED DEC(7,3);
   P = 3+4I; PUT SKIP LIST(ABS(P));
   P = 1+1I; PUT SKIP LIST(ABS(P));
   P = 0.01+0.01I; PUT SKIP LIST(ABS(P));
   P = -12.5I; PUT SKIP LIST(ABS(P), ABS(P) + 1);
   Q = 123456789012+1I; PUT SKIP LIST(ABS(Q));
   U = 1+1I; PUT SKIP LIST(ABS(U));
   U = 3-4I; PUT SKIP LIST(ABS(U));
   V = 1+1I; PUT SKIP LIST(ABS(V));
   PUT SKIP LIST(ABS(2I), ABS(3-4I));
   Y = ABS(P); PUT SKIP LIST(Y);
   D = 1+1I;
   PUT SKIP LIST(D**2, D**3, D**1);
   PUT SKIP LIST(D**4);
   E = 1.5-0.5I;
   PUT SKIP LIST(E**2, E**3);
   U = 2+1I;
   PUT SKIP LIST(U**2);
   P = 1.5+2.25I; Q = 3-0.5I;
   PUT SKIP LIST(ADD(P,Q,7,2), MULTIPLY(P,Q,9,3));
   PUT SKIP LIST(DIVIDE(P,Q,9,4), DIVIDE(P,Q,5,1));
   P = 2+3I;
   PUT SKIP LIST(ADD(P,1,6,1), MULTIPLY(P,2I,8,2));
   A = 1.5+2.25I; C = 3-0.5I;
   PUT SKIP LIST(ADD(A,C,6), MULTIPLY(A,C,6), DIVIDE(A,C,6));
 END T290CFA;
