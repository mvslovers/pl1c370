 T156SEP: PROC OPTIONS(MAIN);
   /* the external procedures compiled apart (t156sep.sep) */
   DCL SHOWIT ENTRY(CHAR(*), FIXED BIN(31));
   DCL LEVEL FIXED BIN(31) EXTERNAL;
   DCL NAME CHAR(8) EXTERNAL;
   DCL K FIXED BIN(31);
   PUT SKIP LIST('MAIN START', LEVEL, NAME);
   DO K = 1 TO 3;
     CALL SHOWIT('ITEM', K);
   END;
   PUT SKIP LIST('MAIN END', LEVEL, NAME);
 END T156SEP;
*PROCESS;
 SHOWIT: PROC(S, N);
   DCL S CHAR(*), N FIXED BIN(31);
   DCL LEVEL FIXED BIN(31) EXTERNAL INIT(10);
   DCL NAME CHAR(8) EXTERNAL INIT('INITIAL');
   DCL SQ ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   LEVEL = LEVEL + 1;
   NAME = S || 'X';
   PUT SKIP LIST(S, N, SQ(N), INNER(N));
 INNER: PROC(M) RETURNS(FIXED BIN(15));
   DCL M FIXED BIN(31);
   RETURN(M + LEVEL);
 END INNER;
 END SHOWIT;
*PROCESS;
 SQ: PROC(V) RETURNS(FIXED BIN(31));
   DCL V FIXED BIN(31);
   DCL NAME CHAR(8) EXTERNAL;
   PUT SKIP LIST('SQ SEES', NAME);
   RETURN(V * V);
 END SQ;
