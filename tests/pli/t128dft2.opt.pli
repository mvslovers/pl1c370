 T128DF2: PROC OPTIONS(MAIN);
   DEFAULT RANGE(P:R) VALUE(FIXED DECIMAL(7,2), FLOAT DECIMAL(10),
       CHARACTER(4)), RANGE(I) VALUE(FIXED BINARY(31));
   DEFAULT RANGE(NUM) PICTURE '9999';
   DEFAULT RANGE(XY) FIXED;
   DCL P1 FIXED, Q1 FLOAT, I1, R1 CHAR, NUMA, NUMB CHAR(2);
   DCL XY1, XYZ1;
   P1 = 12345.678;
   Q1 = 1E0 / 7;
   I1 = 123456;
   R1 = 'ABCDEFG';
   NUMA = 42;
   NUMB = 'ABC';
   XY1 = 3.14159;
   XYZ1 = 2.5;
   PUT SKIP LIST('MAIN', P1, Q1, I1, R1, NUMA, NUMB, XY1, XYZ1);
   CALL B;
 B: PROC;
   DEFAULT RANGE(XYZ) FLOAT;
   DCL XYZ2, XY2, P2 FIXED;
   XYZ2 = 1E0 / 3;
   XY2 = 2.75;
   P2 = 1.555;
   PUT SKIP LIST('B', XYZ2, XY2, P2);
   CALL C;
 C: PROC;
   DEFAULT RANGE(*);
   DCL P3 FIXED, Q3, J3;
   P3 = 1.555;
   Q3 = 1E0 / 3;
   J3 = 7000;
   PUT SKIP LIST('C', P3, Q3, J3);
 END C;
 END B;
 END T128DF2;
