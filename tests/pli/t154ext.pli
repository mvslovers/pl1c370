 T154EXT: PROC OPTIONS(MAIN);
   DCL ADDTO ENTRY(FIXED BIN(31), FIXED BIN(31));
   DCL TWICE ENTRY(FIXED DEC(5)) RETURNS(FIXED DEC(7));
   DCL N FIXED BIN(31) INIT(5), D FIXED DEC(5) INIT(123);
   DCL COUNT FIXED BIN(31) EXTERNAL INIT(100);
   DCL 1 SHARED EXTERNAL, 2 A CHAR(4), 2 B FIXED BIN(15);
   SHARED.A = 'MAIN';
   SHARED.B = 1;
   CALL ADDTO(N, 7);
   PUT SKIP LIST('N', N, 'COUNT', COUNT, SHARED.A, SHARED.B);
   PUT SKIP LIST('TWICE', TWICE(D));
   CALL ADDTO(N, -2);
   PUT SKIP LIST('N', N, 'COUNT', COUNT, SHARED.A, SHARED.B);
 END T154EXT;
*PROCESS;
 ADDTO: PROC(X, Y);
   DCL (X, Y) FIXED BIN(31);
   DCL COUNT FIXED BIN(31) EXTERNAL;
   DCL 1 SHARED EXTERNAL, 2 A CHAR(4), 2 B FIXED BIN(15);
   X = X + Y;
   COUNT = COUNT + 1;
   SHARED.A = 'ADD ';
   SHARED.B = SHARED.B + 10;
 END ADDTO;
*PROCESS;
 TWICE: PROC(V) RETURNS(FIXED DEC(7));
   DCL V FIXED DEC(5);
   RETURN(V * 2);
 END TWICE;
