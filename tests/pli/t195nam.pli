 T195NAM: PROC OPTIONS(MAIN);
   DCL (A, B, C) FIXED BIN(15) INIT(0), S CHAR(8) INIT('');
   DCL D CHAR(40) VARYING, N FIXED BIN(15) INIT(0);
   D = DATAFIELD;
   PUT SKIP LIST('OUT', LENGTH(D));
   ON NAME(SYSIN) BEGIN;
     N = N + 1;
     D = DATAFIELD;
     PUT SKIP LIST('NAME', N, ONCODE, ONFILE);
     PUT SKIP LIST('<' || D || '>', LENGTH(D));
   END;
   GET DATA(A, B);
   PUT SKIP LIST(A, B);
   GET DATA(A, B, S);
   PUT SKIP LIST(A, B, S);
   GET DATA(A, B);
   PUT SKIP LIST(A, B);
   SIGNAL NAME(SYSIN);
   REVERT NAME(SYSIN);
   GET DATA(A, B);
   PUT SKIP LIST(A, B, N);
   ON NAME(SYSIN) PUT SKIP LIST('LAST', DATAFIELD);
   GET DATA(C);
   PUT SKIP LIST(C);
 END T195NAM;
