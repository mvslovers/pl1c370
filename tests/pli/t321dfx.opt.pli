 T321DX: PROC OPTIONS(MAIN);
   /* A CROSS SECTION AS THE BASE OF DEFINED: THE ASTERISKS ARE THE
      DIMENSIONS OF THE DEFINED ARRAY, IN ORDER */
   DCL A(3,4) FIXED BIN(15) INIT((12)0);
   DCL B(2,3,4) CHAR(1) INIT((24)(1)'.');
   DCL X(4) FIXED BIN(15) DEF A(2,*);
   DCL Y(3) FIXED BIN(15) DEF A(*,4);
   DCL Z(3,4) CHAR(1) DEF B(2,*,*);
   DCL I FIXED BIN(15);
   X = 5;
   Y = 9;
   DO I = 1 TO 3;
     PUT SKIP LIST(A(I,1), A(I,2), A(I,3), A(I,4));
   END;
   PUT SKIP LIST(SUM(X), SUM(Y));
   Z(1,1) = 'A'; Z(3,4) = 'B'; Z(2,*) = 'C';
   PUT SKIP LIST(STRING(B));
 END T321DX;
