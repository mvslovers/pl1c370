 T168ENS: PROC OPTIONS(MAIN);
   /* ENTRY statements in an external procedure, OPTIONS(REENTRANT) */
   DCL (PUSH, POP, SHOW) ENTRY(FIXED BIN(31));
   DCL V FIXED BIN(31);
   V = 5;  CALL PUSH(V);
   V = 7;  CALL PUSH(V);
   CALL SHOW(V);
   CALL POP(V);
   PUT SKIP LIST('POPPED', V);
   CALL SHOW(V);
 END T168ENS;
*PROCESS;
 STACK: PROC(X) OPTIONS(REENTRANT);
   DCL X FIXED BIN(31);
   DCL S(10) FIXED BIN(31) STATIC, N FIXED BIN(15) STATIC INIT(0);
   PUT SKIP LIST('STACK ENTERED');
   RETURN;
 PUSH: ENTRY(X);
   N = N + 1;
   S(N) = X;
   RETURN;
 POP: ENTRY(X);
   X = S(N);
   N = N - 1;
   RETURN;
 SHOW: ENTRY(X);
   PUT SKIP LIST('DEPTH', N, 'TOP', S(N));
 END STACK;
