 T80HYER: PROC OPTIONS(MAIN);
   DCL (A, B) FLOAT DEC(6), (C, D) FLOAT DEC(16);
   DCL N FIXED BIN(15) INIT(0);
   ON ERROR BEGIN;
     PUT SKIP LIST('ERR', N, ONCODE);
     IF N = 1 THEN GO TO L2;
     IF N = 2 THEN GO TO L3;
     IF N = 3 THEN GO TO L4;
     IF N = 4 THEN GO TO L5;
     GO TO DONE;
   END;
   A = 1E0; N = 1; B = ATANH(A); PUT SKIP LIST('1 RET', B);
 L2: C = -1E0; N = 2; D = ATANH(C); PUT SKIP LIST('2 RET', D);
 L3: A = 200E0; N = 3; B = SINH(A); PUT SKIP LIST('3 RET', N);
 L4: C = 200E0; N = 4; D = COSH(C); PUT SKIP LIST('4 RET', N);
 L5: A = 2E0; N = 5; B = ATANH(A);
 DONE: PUT SKIP LIST('DONE', N);
 END T80HYER;
