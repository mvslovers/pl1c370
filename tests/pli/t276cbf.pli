 T276CBF: PROC OPTIONS(MAIN);
   /* REAL, IMAG, CONJG, COMPLEX AS FUNCTIONS AND PSEUDO-VARIABLES
      (#2) AND THE PRECISION OF COMPLEX(A,B) BY THE PUT LIST FIELD */
   DCL Z COMPLEX FLOAT DEC(6) INIT(3+4I);
   DCL Y COMPLEX FLOAT DEC(16);
   DCL W COMPLEX FIXED DEC(5,2) INIT(1.25-2.5I);
   DCL A FIXED DEC(3,1) INIT(12.5);
   DCL B FIXED DEC(5,0) INIT(678);
   DCL F6 FLOAT DEC(6) INIT(1.5);
   DCL F16 FLOAT DEC(16) INIT(2.5);
   DCL ZA(3) COMPLEX FLOAT DEC(6) INIT(1+1I, 2+2I, 3+3I);
   PUT SKIP LIST(REAL(Z), IMAG(Z), CONJG(Z));
   PUT SKIP LIST(REAL(W), IMAG(W), CONJG(W));
   PUT SKIP LIST(COMPLEX(A, B));
   PUT SKIP LIST(COMPLEX(F6, F16));
   PUT SKIP LIST(COMPLEX(A, F6));
   Y = COMPLEX(F6, F16);
   PUT SKIP LIST(Y);
   REAL(Z) = 9;
   PUT SKIP LIST(Z);
   IMAG(Z) = -1;
   PUT SKIP LIST(Z);
   COMPLEX(A, B) = W;
   PUT SKIP LIST(A, B);
 END T276CBF;
