 T153WC: PROC OPTIONS(MAIN);
   /* word counts: SYSIN lines split into words, a linked list in
      BASED storage kept in order, printed with pictures */
   DCL CARD CHAR(80), (I, J, K) FIXED BIN(15), WORD CHAR(16) VARYING;
   DCL 1 NODE BASED(P), 2 NEXT POINTER, 2 W CHAR(16) VARYING,
         2 CNT FIXED BIN(15);
   DCL (P, Q, HEAD, PREV) POINTER;
   DCL LETTERS CHAR(26) INIT('ABCDEFGHIJKLMNOPQRSTUVWXYZ');
   DCL NWORDS FIXED BIN(31) INIT(0), NLINES FIXED BIN(15) INIT(0);
   DCL PC PIC'ZZ9', PP PIC'ZZ9V.9', EOF BIT(1) INIT('0'B);
   HEAD = NULL;
   ON ENDFILE(SYSIN) EOF = '1'B;
   GET EDIT(CARD) (A(80));
   DO WHILE(¬EOF);
     NLINES = NLINES + 1;
     I = 1;
     DO WHILE(I <= 80);
       J = VERIFY(SUBSTR(CARD, I), LETTERS);
       IF J = 1 THEN I = I + 1;
       ELSE DO;
         IF J = 0 THEN K = 81 - I; ELSE K = J - 1;
         WORD = SUBSTR(CARD, I, K);
         I = I + K;
         CALL ADDWORD(WORD);
       END;
     END;
     GET EDIT(CARD) (A(80));
   END;
   PUT SKIP LIST('LINES', NLINES, 'WORDS', NWORDS);
   P = HEAD;
   DO WHILE(P ¬= NULL);
     PC = CNT;
     PP = CNT * 100E0 / NWORDS;
     PUT SKIP EDIT(W, PC, PP, '%') (A(16), A, X(2), A, A);
     P = NEXT;
   END;
   PUT SKIP LIST(TRANSLATE('HELLO WORLD', 'ABC', 'LOW'));
 ADDWORD: PROC(X);
   DCL X CHAR(16) VARYING;
   NWORDS = NWORDS + 1;
   PREV = NULL;
   Q = HEAD;
   DO WHILE(Q ¬= NULL);
     IF Q -> W = X THEN DO;
       Q -> CNT = Q -> CNT + 1;
       RETURN;
     END;
     IF Q -> W > X THEN GO TO INS;
     PREV = Q;
     Q = Q -> NEXT;
   END;
 INS:
   ALLOCATE NODE SET(P);
   P -> W = X;
   P -> CNT = 1;
   P -> NEXT = Q;
   IF PREV = NULL THEN HEAD = P;
   ELSE PREV -> NEXT = P;
 END ADDWORD;
 END T153WC;
