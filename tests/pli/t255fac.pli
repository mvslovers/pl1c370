 T255FAC: PROC OPTIONS(MAIN);
   /* TIER 99: FACTORED NAMES IN A STRUCTURE (GC28-8201-4, DECLARE;
      #267) */
   DCL 1 S, 2 (A, B) FIXED BIN(31) INIT(7), 2 C CHAR(3) INIT('XYZ'),
         2 T, 3 (D, E, F) FIXED DEC(5,1) INIT(1.5), 3 G BIT(4);
   DCL 1 V(2), 2 (P, Q) CHAR(2) INIT('AB', 'CD');
   DCL 1 W, 2 (H, K) (3,2) BINARY FIXED(15) INIT((6)4);
   G = '1010'B;
   PUT SKIP LIST(A, B, C);
   PUT SKIP LIST(D, E, F, G);
   PUT SKIP DATA(S);
   PUT SKIP LIST(STRING(S.C), P, Q);
   H(2,1) = 5; PUT SKIP LIST(H, K);
   B = 9; E = 2.5;
   PUT SKIP DATA(S);
 END T255FAC;
