 T314LB: PROC OPTIONS(MAIN);
   /* INITIAL OF LABEL VARIABLES (AUTOMATIC), ARRAYS TOO */
   DCL L LABEL INIT(B);
   DCL M(3) LABEL INIT(C1, C2, C3);
   DCL 1 S, 2 K LABEL INIT(D);
   DCL I FIXED BIN(15);
   GO TO L;
   PUT SKIP LIST('NOT HERE');
 B: PUT SKIP LIST('AT B');
   DO I = 3 TO 1 BY -1;
     GO TO M(I);
 C1:  PUT SKIP LIST('C1'); GO TO N;
 C2:  PUT SKIP LIST('C2'); GO TO N;
 C3:  PUT SKIP LIST('C3');
 N: END;
   GO TO S.K;
   PUT SKIP LIST('NOR HERE');
 D: PUT SKIP LIST('AT D');
   CALL P;
 P: PROC;
   DCL Q LABEL INIT(E);
   GO TO Q;
   PUT SKIP LIST('NO');
 E: PUT SKIP LIST('AT E');
 END P;
 END T314LB;
