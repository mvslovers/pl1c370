 T315BD: PROC OPTIONS(MAIN);
   /* BASED VARIABLES IN DATA-DIRECTED LISTS, THROUGH THE POINTER OF
      THEIR BASED ATTRIBUTE */
   DCL P POINTER, Q POINTER;
   DCL X FIXED DEC(5,2) ;
   DCL 1 S,
         2 A FIXED BIN(15),
         2 B CHAR(4),
         2 C(3) FIXED BIN(15);
   X = 12.5;
   A = 3; B = 'WXYZ'; C = 9;
   PUT DATA(X, S);
   GET DATA(X, S);
   PUT SKIP DATA(X, S);
   GET DATA(S);
   PUT SKIP DATA(S, X);
 END T315BD;
