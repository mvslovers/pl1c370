 T248DSP: PROC OPTIONS(MAIN);
   /* DISPLAY AND DISPLAY ... REPLY (GC28-8201-4, SECTION J; #218):
      THE REPLIES COME FROM T248DSP.REPLY; EVERY MESSAGE WITH REPLY
      BEGINS WITH THE TEST'S NAME */
   DCL R CHAR(10), V CHAR(20) VARYING, S CHAR(3) VARYING;
   DCL L CHAR(130), A(3) CHAR(4) INIT('AAAA', 'BBBB', 'CCCC');
   DCL N FIXED BIN(15) INIT(42), D FIXED DEC(5,2) INIT(-3.25);
   DCL F FLOAT DEC(6) INIT(1.5), B BIT(4) INIT('1010'B);
   DCL M CHAR(200) VARYING, I FIXED BIN(15);
   DCL Z CHAR(0) VARYING INIT('');
   DISPLAY('T248DSP PLAIN MESSAGE');
   DISPLAY(N);
   DISPLAY(D);
   DISPLAY(F);
   DISPLAY(B);
   DISPLAY('T248DSP ' || (80)'Y' || 'Z');
   M = '';
   DO I = 1 TO 20;
     M = M || 'T248' || CHAR(I) || (3)'-';
   END;
   DISPLAY(M);
   DISPLAY(Z);
   PUT SKIP LIST('AFTER EMPTY DISPLAY');
   DISPLAY('T248DSP REPLY R') REPLY(R);
   PUT SKIP LIST('<' || R || '>');
   DISPLAY('T248DSP REPLY V') REPLY(V);
   PUT SKIP LIST(LENGTH(V), '<' || V || '>');
   DISPLAY('T248DSP REPLY S') REPLY(S);
   PUT SKIP LIST(LENGTH(S), '<' || S || '>');
   L = (130)'X';
   DISPLAY('T248DSP REPLY L') REPLY(L);
   PUT SKIP LIST(SUBSTR(L, 1, 20), INDEX(L, 'X'));
   I = 2;
   DISPLAY('T248DSP REPLY A(' || CHAR(I) || ')') REPLY(A(I));
   PUT SKIP LIST(A);
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE);
     GO TO NEXT;
   END;
   DISPLAY(Z) REPLY(R);
   PUT SKIP LIST('NOT HERE');
 NEXT:
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR 2', ONCODE);
     GO TO DONE;
   END;
   DISPLAY('T248DSP REPLY Z') REPLY(Z);
   PUT SKIP LIST('NOT HERE EITHER');
 DONE:
   PUT SKIP LIST('DONE');
 END T248DSP;
