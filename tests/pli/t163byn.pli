 T163BYN: PROC OPTIONS(MAIN);
   DCL 1 A, 2 X FIXED BIN(15), 2 Y FIXED DEC(5), 2 S, 3 P FIXED DEC(3),
         3 Q FIXED BIN(15);
   DCL 1 B, 2 Y FIXED DEC(7), 2 W FIXED BIN(15),
         2 S, 3 Q FIXED BIN(31),
         3 R FIXED BIN(15), 2 X FIXED DEC(5);
   DCL 1 C, 2 X FIXED BIN(15), 2 Q FIXED BIN(15);
   A.X = 7; A.Y = 100; A.P = 123; A.Q = 4;
   B.Y = 5; B.W = 99; B.Q = 6; B.R = 5; B.X = 1;
   B = A + B, BY NAME;
   PUT SKIP LIST(B.Y, B.W, B.Q, B.R, B.X);
   B = A * 2, BY NAME;
   PUT SKIP LIST(B.Y, B.W, B.Q, B.R, B.X);
   C = A, BY NAME;
   PUT SKIP LIST(C.X, C.Q);
   PUT SKIP LIST(BOOL('1100'B, '1010'B, '0110'));
   PUT SKIP LIST(BOOL('1100'B, '1010'B, '0001'));
   PUT SKIP LIST(BOOL('1100'B, '1010'B, '0111'));
   PUT SKIP LIST(BOOL('1100'B, '10'B, '1001'));
   PUT SKIP LIST(BOOL('11001010'B, '10101100'B, '1110'));
   PUT SKIP LIST(BOOL('1'B, '0'B, '1101'B));
   PUT SKIP LIST(BOOL('101'B, '011'B, '1000'),
     LENGTH(BOOL('1'B, '011'B, '0110')));
 END T163BYN;
