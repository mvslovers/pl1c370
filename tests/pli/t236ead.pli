 T236EAD: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T236EAD.OPT.PLI: THE COMPARISONS AS
      SC26-3114-01 GIVES THEM, AND THE CALL THROUGH THE ENTRY */
   DCL SUB ENTRY;
   PUT SKIP LIST('1'B, '0'B, '0'B);
   CALL SUB;
   PUT SKIP LIST('1'B);
 END T236EAD;
*PROCESS;
 SUB: PROC;
   PUT SKIP LIST('IN SUB');
 END SUB;
