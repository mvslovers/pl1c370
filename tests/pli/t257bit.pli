 T257BIT: PROC OPTIONS(MAIN);
   /* TIER 100: INITIAL OF PACKED BIT STRINGS IN STATIC STORAGE
      (ARRAYS AND STRUCTURES, Q1EMP) */
   DCL B BIT(10) STATIC INIT('1011'B), C BIT(3) STATIC INIT('1'B);
   DCL A(3) BIT(10) STATIC INIT('1'B, '01'B, '0011'B);
   DCL 1 S STATIC, 2 X BIT(3) INIT('101'B), 2 Y BIT(10) INIT('11'B),
         2 Z(2) BIT(5) INIT('10001'B, '01110'B),
         2 W CHAR(2) INIT('OK');
   PUT SKIP LIST(B, C);
   PUT SKIP LIST(A);
   PUT SKIP LIST(X, Y, Z, W);
 END T257BIT;
