 T127DFT: PROC OPTIONS(MAIN);
   /* what the DEFAULT statements of t127dflt.opt.pli give
      (GC33-0009-4, chapter 7 and section J) */
   DCL A1 FIXED BINARY, B2 FIXED BINARY, C3 FIXED DECIMAL;
   DCL S1 CHAR(10) VARYING, S2 CHAR(3) VARYING, S3 BIT(1) VARYING;
   DCL PRECA FIXED DECIMAL(9,3), PRECB FLOAT DECIMAL(12),
       PRECC FIXED BINARY;
   DCL XP POINTER, XQ FIXED DECIMAL;
   DCL G1 FLOAT BINARY, H1 FIXED BINARY;
   DCL BETA FIXED BINARY, ZETA FLOAT DECIMAL;
   A1 = 7.9;
   B2 = -30000;
   C3 = 2.5;
   PUT SKIP LIST('A', A1, B2, C3);
   S1 = 'ABCDEFGHIJKLMNOP';
   S2 = 'XYZW';
   S3 = '101'B;
   PUT SKIP LIST('S', S1, LENGTH(S1), S2, LENGTH(S2), S3, LENGTH(S3));
   PRECA = 1 / 3;
   PRECB = 1E0 / 3;
   PRECC = 12345;
   PUT SKIP LIST('PREC', PRECA, PRECB, PRECC);
   XP = ADDR(A1);
   XQ = 4.5;
   PUT SKIP LIST('X', XP = ADDR(A1), XQ);
   G1 = 1E0 / 3;
   H1 = 3.7;
   PUT SKIP LIST('G H', G1, H1);
   BETA = 3.9;
   ZETA = 3.9;
   PUT SKIP LIST('IMPLICIT', BETA, ZETA);
   CALL INNER;
 INNER: PROC;
   DCL A9 FLOAT DECIMAL, B9 FIXED BINARY;
   A9 = 1E0 / 3;
   B9 = 2.6;
   PUT SKIP LIST('INNER', A9, B9);
 END INNER;
 END T127DFT;
