 T157SNP: PROC OPTIONS(MAIN);
   DCL (A, B) FIXED BIN(31), N FIXED BIN(15) INIT(0);
   ON ZERODIVIDE SNAP BEGIN;
     PUT SKIP LIST('IN ZERODIVIDE UNIT', ONCODE);
   END;
   A = 1; B = 0;
   PUT SKIP LIST('BEFORE');
   A = A / B;
   PUT SKIP LIST('AFTER 1');
   CALL INNER;
   ON CONDITION(MINE) SNAP SYSTEM;
   SIGNAL CONDITION(MINE);
   PUT SKIP LIST('AFTER 3');
   ON ENDPAGE(SYSPRINT) SNAP;
   ON ERROR SNAP BEGIN;
     N = N + 1;
     PUT SKIP LIST('IN ERROR UNIT', ONCODE);
     IF N < 3 THEN GO TO OUT;
   END;
   SIGNAL ERROR;
 OUT:
   PUT SKIP LIST('DONE');
 INNER: PROC;
   CALL DEEPER;
 DEEPER: PROC;
   SIGNAL ZERODIVIDE;
   PUT SKIP LIST('AFTER 2');
 END DEEPER;
 END INNER;
 END T157SNP;
