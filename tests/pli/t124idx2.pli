 T124ID2: PROC OPTIONS(MAIN);
   DCL IX FILE RECORD KEYED ENV(INDEXED);
   DCL REC CHAR(20), K CHAR(4), N FIXED BIN(31), I FIXED BIN(31);
   DCL KC CHAR(4);
   ON KEY(IX) PUT SKIP LIST('KEY', ONCODE, K);
   OPEN FILE(IX) SEQUENTIAL OUTPUT;
   DO I = 10 TO 90 BY 10;
     K = 'K' || SUBSTR('0123456789', I / 10 + 1, 1) || '0';
     REC = 'FIRST ' || K;
     WRITE FILE(IX) FROM(REC) KEYFROM(K);
   END;
   CLOSE FILE(IX);
   OPEN FILE(IX) DIRECT UPDATE;
   K = 'K50';
   DELETE FILE(IX) KEY(K);
   REC = 'AGAIN 50';
   REWRITE FILE(IX) FROM(REC) KEY(K);
   DELETE FILE(IX) KEY(K);
   WRITE FILE(IX) FROM(REC) KEYFROM(K);
   READ FILE(IX) INTO(REC) KEY(K);
   PUT SKIP LIST('READ', K, REC);
   DO I = 1 TO 9;
     K = 'K' || SUBSTR('0123456789', I + 1, 1) || '5';
     REC = 'ADDED ' || K;
     WRITE FILE(IX) FROM(REC) KEYFROM(K);
   END;
   K = 'A00';
   REC = 'LOWEST';
   WRITE FILE(IX) FROM(REC) KEYFROM(K);
   K = 'Z99';
   REC = 'HIGHEST';
   WRITE FILE(IX) FROM(REC) KEYFROM(K);
   CLOSE FILE(IX);
   N = 0;
   OPEN FILE(IX) SEQUENTIAL INPUT;
   ON ENDFILE(IX) GO TO EOF;
   DO WHILE('1'B);
     READ FILE(IX) INTO(REC) KEYTO(KC);
     N = N + 1;
     PUT SKIP LIST(N, KC, REC);
   END;
 EOF:
   CLOSE FILE(IX);
   OPEN FILE(IX) DIRECT INPUT;
   DO I = 1 TO 9;
     K = 'K' || SUBSTR('0123456789', I + 1, 1) || '5';
     READ FILE(IX) INTO(REC) KEY(K);
     PUT SKIP LIST('DIRECT', K, REC);
   END;
   CLOSE FILE(IX);
 END T124ID2;
