 T139IXB: PROC OPTIONS(MAIN);
   /* INDEXED, blocked with RKP=0: the key in front of the data; a
      REWRITE right after a READ of its key; READ KEY on SEQUENTIAL */
   DCL B FILE RECORD KEYED ENV(INDEXED);
   DCL RB CHAR(15), KC CHAR(5), (N, I, NE) FIXED BIN(31);
   DCL P PIC'9999', L LABEL;
   ON KEY(B) PUT SKIP LIST('KEY B', ONCODE, ONKEY);
   NE = 0;
   ON ERROR BEGIN;
     NE = NE + 1;
     PUT SKIP LIST('ERROR', ONCODE);
     IF NE < 20 THEN GO TO L;
   END;
   OPEN FILE(B) SEQUENTIAL OUTPUT;
   DO I = 1 TO 12;
     P = I * 2;
     RB = 'K' || P || ' BLK';
     WRITE FILE(B) FROM(RB) KEYFROM('K' || P);
   END;
   RB = 'XXXXX MISMATCH';
   WRITE FILE(B) FROM(RB) KEYFROM('K0030');
   CLOSE FILE(B);
   OPEN FILE(B) DIRECT UPDATE;
   L = S1;
   PUT SKIP LIST('S0 WRITE');
   RB = 'NEW FIVE';
   WRITE FILE(B) FROM(RB) KEYFROM('K0005');
   READ FILE(B) INTO(RB) KEY('K0030');
   PUT SKIP LIST('READ 30', RB);
   READ FILE(B) INTO(RB) KEY('XXXXX');
   PUT SKIP LIST('READ X', RB);
 S1: L = S2;
   PUT SKIP LIST('S1 READ REWRITE');
   READ FILE(B) INTO(RB) KEY('K0008');
   RB = 'REWR 8';
   REWRITE FILE(B) FROM(RB) KEY('K0008');
 S2: L = S3;
   PUT SKIP LIST('S2 REWRITE');
   RB = 'REWR 10';
   REWRITE FILE(B) FROM(RB) KEY('K0010');
 S3: L = S4;
   PUT SKIP LIST('S3 DELETE');
   DELETE FILE(B) KEY('K0012');
 S4: L = S5;
   PUT SKIP LIST('S4 READ DELETE');
   READ FILE(B) INTO(RB) KEY('K0014');
   DELETE FILE(B) KEY('K0014');
 S5: L = S6;
   PUT SKIP LIST('S5 OTHER KEY');
   READ FILE(B) INTO(RB) KEY('K0012');
   RB = 'OTHER KEY';
   REWRITE FILE(B) FROM(RB) KEY('K0014');
 S6: L = S7;
   PUT SKIP LIST('S6 TWICE');
   READ FILE(B) INTO(RB) KEY('K0016');
   READ FILE(B) INTO(RB) KEY('K0018');
   RB = 'REWR 18';
   REWRITE FILE(B) FROM(RB) KEY('K0018');
   RB = 'REWR 18 AGAIN';
   REWRITE FILE(B) FROM(RB) KEY('K0018');
 S7: L = S8;
   CLOSE FILE(B);
   CALL LISTB('DIRECT');
   OPEN FILE(B) SEQUENTIAL UPDATE;
   PUT SKIP LIST('S8 SEQ UPDATE');
   READ FILE(B) INTO(RB) KEYTO(KC);
   RB = 'SEQ REWR';
   REWRITE FILE(B) FROM(RB);
   READ FILE(B) INTO(RB) KEYTO(KC);
   DELETE FILE(B);
 S8: L = S9;
   CLOSE FILE(B);
   OPEN FILE(B) SEQUENTIAL INPUT;
   READ FILE(B) INTO(RB) KEY('K0012');
   PUT SKIP LIST('SEQ KEY 12', RB);
   READ FILE(B) INTO(RB) KEYTO(KC);
   PUT SKIP LIST('SEQ NEXT', KC, RB);
   READ FILE(B) INTO(RB) KEY('K0004');
   READ FILE(B) INTO(RB) KEYTO(KC);
   PUT SKIP LIST('SEQ AFTER 4', KC, RB);
   READ FILE(B) INTO(RB) KEY('K0011');
   PUT SKIP LIST('SEQ KEY 11', RB);
   READ FILE(B) INTO(RB) KEYTO(KC);
   PUT SKIP LIST('SEQ AFTER 11', KC, RB);
   CLOSE FILE(B);
   OPEN FILE(B) SEQUENTIAL UPDATE;
   READ FILE(B) INTO(RB) KEY('K0020');
   RB = 'REWR 20';
   REWRITE FILE(B) FROM(RB);
   READ FILE(B) INTO(RB) KEYTO(KC);
   PUT SKIP LIST('SEQ NEXT', KC, RB);
 S9: L = S10;
   CLOSE FILE(B);
   CALL LISTB('SEQUPD');
 S10: PUT SKIP LIST('DONE');
 LISTB: PROC(T);
   DCL T CHAR(*);
   N = 0;
   OPEN FILE(B) SEQUENTIAL INPUT;
   ON ENDFILE(B) GO TO EOF;
   DO WHILE('1'B);
     READ FILE(B) INTO(RB) KEYTO(KC);
     N = N + 1;
     PUT SKIP LIST(T, KC, RB);
   END;
 EOF:
   CLOSE FILE(B);
   PUT SKIP LIST(T, N);
 END LISTB;
 END T139IXB;
