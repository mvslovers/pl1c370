 T179FMT: PROC OPTIONS(MAIN);
   DCL (N, I, J) FIXED BIN(15), A(6) FIXED BIN(15) INIT(1,2,3,4,5,6);
   N = 3;
   PUT SKIP EDIT((A(I) DO I = 1 TO 6))
     ((N) F(4), X(2), (N - 1) F(3), F(5));
   N = 2;
   PUT SKIP EDIT('AB', 'CD', 'EF') ((N) A(3), A);
   PUT SKIP EDIT((A(I) DO I = 1 TO 6)) ((N) (F(3), X(1)), (N+1) F(2));
   N = 0;
   PUT SKIP EDIT(7, 8) ((N) F(5), F(3), (N) X(9), F(3));
   N = -1;
   PUT SKIP EDIT(9) ((N) F(5), F(3));
   DO J = 1 TO 3;
     PUT SKIP EDIT((A(I) DO I = 1 TO J)) ((J) (F(2), (J) X(1)));
   END;
   N = 2;
   PUT SKIP EDIT(1, 2, 3, 4, 5) ((N) F(2), COLUMN(10));
 END T179FMT;
