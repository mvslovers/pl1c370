 T180LNG: PROC OPTIONS(MAIN);
   DCL COMPUTEVALUE ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL SHOWRESULTS ENTRY(FIXED BIN(31));
   DCL TOTALCOUNTER FIXED BIN(31) EXTERNAL INIT(5);
   CALL SHOWRESULTS(COMPUTEVALUE(7));
   PUT SKIP LIST('TOTAL', TOTALCOUNTER);
 END T180LNG;
*PROCESS;
 COMPUTEVALUE: PROC(X) RETURNS(FIXED BIN(31));
   DCL X FIXED BIN(31);
   DCL TOTALCOUNTER FIXED BIN(31) EXTERNAL;
   TOTALCOUNTER = TOTALCOUNTER + X;
   RETURN(X * X);
 END COMPUTEVALUE;
*PROCESS;
 SHOWRESULTS: PROC(V);
   DCL V FIXED BIN(31);
   PUT SKIP LIST('RESULT', V);
 END SHOWRESULTS;
