 T308MOD: PROC OPTIONS(MAIN);
   /* MOD OF FLOAT AND OF SCALED VALUES, Y OF EITHER SIGN; FLOAT
      SUBSCRIPTS, TRUNCATED */
   DCL (X, Y) FLOAT DEC(6);
   DCL (D, E) FLOAT DEC(16);
   DCL P FIXED DEC(7,2) INIT(17.25);
   DCL Q FIXED DEC(5,1) INIT(5.5);
   DCL B FIXED BIN(31,4) INIT(10.5);
   DCL A(5) FIXED BIN(15) INIT(10, 20, 30, 40, 50);
   DCL I FIXED BIN(15);
   X = 17.5; Y = 5;
   PUT SKIP LIST(MOD(X, Y), MOD(-X, Y), MOD(X, -Y), MOD(-X, -Y));
   D = 1E10; E = 3;
   PUT SKIP LIST(MOD(D, E), MOD(0.75E0, 0.5E0));
   PUT SKIP LIST(MOD(P, Q), MOD(-P, Q), MOD(P, 3), MOD(10, Q));
   PUT SKIP LIST(MOD(B, 3), MOD(B, 2.5), MOD(P, B));
   X = 2.7;
   PUT SKIP LIST(A(X), A(X + 1), A(1.9E0));
   I = 3; PUT SKIP LIST(A(I / 2), A(2.5));
 END T308MOD;
