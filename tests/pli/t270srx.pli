 T270SRX: PROC OPTIONS(MAIN);
   /* ERROR IN A SORT EXIT, NO ON-UNIT: SIGNAL ERROR IN E15'S
      THIRD CALL.  THE SORT IS FINISHED FIRST, THEN THE PROGRAM ENDS
      WITH 2000 AND THE RETURN CODE E15 SET LAST, 12
      PL/I (F): IHESRTD, IHESARC */
   DCL IHESRTD ENTRY(CHAR(30), CHAR(30), FIXED BIN(31), FIXED BIN(31),
                     ENTRY, ENTRY);
   DCL IHESARC ENTRY(FIXED BIN(31));
   DCL RC FIXED BIN(31) INIT(-1);
   DCL K FIXED BIN(15) STATIC INIT(0);
   CALL IHESRTD(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, E15, E35);
   PUT SKIP LIST('RETURNED', RC);
 E15: PROC RETURNS(CHAR(80));
   K = K + 1;
   PUT SKIP LIST('E15', K);
   IF K = 3 THEN SIGNAL ERROR;
   CALL IHESARC(12);
   RETURN(SUBSTR('EDCBA', K, 1));
 END E15;
 E35: PROC(REC);
   DCL REC CHAR(80);
   PUT SKIP LIST('E35', SUBSTR(REC, 1, 1));
   CALL IHESARC(4);
 END E35;
 END T270SRX;
