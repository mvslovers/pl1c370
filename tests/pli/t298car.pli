 T298CAR: PROC OPTIONS(MAIN);
   /* COMPLEX ARGUMENTS, PARAMETERS AND RETURNS (#2 C5): BY REFERENCE
      AND THROUGH DUMMIES, A REAL ARGUMENT FOR A COMPLEX PARAMETER,
      SHORT AND LONG RESULTS, A RESULT FROM A REAL VALUE */
   DCL A COMPLEX FLOAT DEC(6) INIT(1.5-2I);
   DCL D COMPLEX FLOAT DEC(16) INIT(3+4I);
   DCL P COMPLEX FIXED DEC(5,2) INIT(1.25+0.5I);
   DCL X FLOAT DEC(6) INIT(2);
   DCL ZA(3) COMPLEX FLOAT DEC(6) INIT(1+1I, 2+2I, 3+3I);
   DCL SUB ENTRY(COMPLEX FLOAT DEC(6), COMPLEX FIXED DEC(5,2));
   DCL F ENTRY(COMPLEX FLOAT DEC(6)) RETURNS(COMPLEX FLOAT DEC(6));
   DCL G ENTRY(COMPLEX FLOAT DEC(16)) RETURNS(COMPLEX FLOAT DEC(16));
   DCL H ENTRY((*) COMPLEX FLOAT DEC(6)) RETURNS(COMPLEX FLOAT DEC(6));
   DCL R ENTRY(FLOAT DEC(6)) RETURNS(COMPLEX FLOAT DEC(6));
   CALL SUB(A, P);
   PUT SKIP LIST(A, P);
   CALL SUB(X, 2.5+1I);
   PUT SKIP LIST(F(A), F(X), F(2I));
   PUT SKIP LIST(G(D), G(A), REAL(F(A)) + 1);
   PUT SKIP LIST(H(ZA), R(3), ZA(2) * F(ZA(1)));
   A = F(A) * 2 + F(F(A));
   PUT SKIP LIST(A);
 SUB: PROC(Z, Q);
   DCL Z COMPLEX FLOAT DEC(6), Q COMPLEX FIXED DEC(5,2);
   Z = Z * 2I;
   Q = Q + 1;
   PUT SKIP LIST('SUB', Z, Q);
 END SUB;
 F: PROC(Z) RETURNS(COMPLEX FLOAT DEC(6));
   DCL Z COMPLEX FLOAT DEC(6);
   RETURN(CONJG(Z) + 1);
 END F;
 G: PROC(Z) RETURNS(COMPLEX FLOAT DEC(16));
   DCL Z COMPLEX FLOAT DEC(16);
   RETURN(Z * Z);
 END G;
 H: PROC(V) RETURNS(COMPLEX FLOAT DEC(6));
   DCL V(*) COMPLEX FLOAT DEC(6), S COMPLEX FLOAT DEC(6) INIT(0);
   DCL I FIXED BIN(15);
   DO I = LBOUND(V,1) TO HBOUND(V,1);
     S = S + V(I);
   END;
   RETURN(S);
 END H;
 R: PROC(Y) RETURNS(COMPLEX FLOAT DEC(6));
   DCL Y FLOAT DEC(6);
   RETURN(Y);
 END R;
 END T298CAR;
