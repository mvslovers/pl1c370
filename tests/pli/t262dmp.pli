 T262DMP: PROC OPTIONS(MAIN);
   /* PLIDUMP'S TWIN: PL/I (F)'S IHEDUMC GOES ON; IHEDUMP ENDS THE
      PROGRAM WITHOUT FINISH (WITH 3000 PLUS THE RETURN CODE, WHERE
      PLIDUMP GIVES 1000: T262DMP.CC) */
   DCL IHEDUMC ENTRY(FIXED BIN(31)), IHEDUMP ENTRY(FIXED BIN(31));
   DCL IHESARC ENTRY(FIXED BIN(31));
   DCL A FIXED BIN(31) INIT(12345), S CHAR(8) INIT('ABCDEFGH');
   ON FINISH PUT SKIP LIST('FINISH');
   PUT SKIP LIST('BEFORE');
   CALL IHEDUMC(1);
   PUT SKIP LIST('AFTER C');
   CALL P;
   PUT SKIP LIST('AFTER P', A, S);
   ON ZERODIVIDE BEGIN;
     CALL IHEDUMC(5);
     PUT SKIP LIST('IN ZD');
   END;
   SIGNAL ZERODIVIDE;
   CALL IHESARC(7);
   CALL IHEDUMP(0);
   PUT SKIP LIST('AFTER S');
 P: PROC;
   BEGIN;
     CALL IHEDUMC(2);
     CALL IHEDUMC(3);
   END;
 END P;
 END T262DMP;
