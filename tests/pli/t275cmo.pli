 T275CMO: PROC OPTIONS(MAIN);
   /* MODE CONVERSIONS (#2): REAL = COMPLEX, COMPLEX = REAL, MIXED
      OPERANDS, COMPLEX TO CHARACTER, = AND NOT = */
   DCL Z COMPLEX FLOAT DEC(6) INIT(3+4I);
   DCL W COMPLEX FIXED DEC(5,2) INIT(1.25-2.5I);
   DCL V COMPLEX FIXED BIN(15) INIT(2+3I);
   DCL X FLOAT DEC(6);
   DCL N FIXED DEC(5,2);
   DCL C30 CHAR(30);
   DCL C8 CHAR(8);
   DCL B BIT(1);
   X = Z;
   PUT SKIP LIST('X = Z', X);
   N = W;
   PUT SKIP LIST('N = W', N);
   Z = 7;
   PUT SKIP LIST('Z = 7', Z);
   Z = 3+4I;
   PUT SKIP LIST('Z + 1', Z + 1);
   PUT SKIP LIST('Z + W', Z + W);
   PUT SKIP LIST('W + V', W + V);
   PUT SKIP LIST('V - 1', V - 1);
   PUT SKIP LIST('-W', -W);
   PUT SKIP LIST('W + 2.5', W + 2.5);
   C30 = W;
   PUT SKIP LIST('C30 = W <' || C30 || '>');
   C30 = Z;
   PUT SKIP LIST('C30 = Z <' || C30 || '>');
   C30 = V;
   PUT SKIP LIST('C30 = V <' || C30 || '>');
   C8 = W;
   PUT SKIP LIST('C8 = W <' || C8 || '>');
   B = Z = 3+4I;
   PUT SKIP LIST('Z = 3+4I', B);
   B = Z = 3+5I;
   PUT SKIP LIST('Z = 3+5I', B);
   B = W ¬= V;
   PUT SKIP LIST('W NE V', B);
 END T275CMO;
