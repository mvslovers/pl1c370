 T81OVF: PROC OPTIONS(MAIN);
   DCL (A, B) FLOAT DEC(6), (C, D) FLOAT DEC(16);
   DCL (N, K) FIXED BIN(15) INIT(0);
   ON OVERFLOW BEGIN;
     K = K + 1; PUT SKIP LIST('OVF', N, ONCODE, K);
     IF K > 20 THEN STOP;
   END;
   A = 7E75; C = 7E75; B = 1; D = 1;
   N = 1; B = A * A; PUT SKIP LIST('1', B, UNSPEC(B));
   N = 2; D = C * C; PUT SKIP LIST('2', D);
   N = 3; B = A / 1E-70; PUT SKIP LIST('3', B);
   N = 4; B = A + A; PUT SKIP LIST('4', B);
   N = 5; D = C + C; PUT SKIP LIST('5', D);
   N = 6; D = -C - C; PUT SKIP LIST('6', D);
   N = 7; (NOOVERFLOW): B = A * A; PUT SKIP LIST('7', B);
   N = 8; B = A * A * 2; PUT SKIP LIST('8', B);
   ON OVERFLOW BEGIN;
     K = K + 1; PUT SKIP LIST('IN', N, ONCODE, K);
     IF K < 13 THEN B = A * A;
     PUT SKIP LIST('OUT', K);
   END;
   N = 9; B = A * A; PUT SKIP LIST('9', B);
   REVERT OVERFLOW;
   ON ERROR BEGIN; PUT SKIP LIST('ERR', N, ONCODE); GO TO DONE; END;
   N = 10; D = C * C; PUT SKIP LIST('10', D);
 DONE: PUT SKIP LIST('DONE', N, K);
 END T81OVF;
