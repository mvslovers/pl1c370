 T322IC: PROC OPTIONS(MAIN);
   /* INITIAL CALL FOR FACTORED NAMES: THE CALL MADE FOR EACH */
   DCL N FIXED BIN(15) INIT(0);
   CALL Q;
 Q: PROC;
   DCL (A, B, C) FIXED BIN(15);
   CALL COUNT(N); CALL COUNT(N); CALL COUNT(N);
   PUT SKIP LIST('IN Q', N);
 END Q;
 COUNT: PROC(K);
   DCL K FIXED BIN(15);
   K = K + 1;
   PUT SKIP LIST('COUNT', K);
 END COUNT;
 END T322IC;
