 T98BITS: PROC OPTIONS(MAIN);
   DCL L BIT(40) INIT('1010101010101010101010101010101010101010'B);
   DCL M BIT(48), V BIT(64) VARYING, W BIT(8) VARYING;
   DCL S BIT(4), N FIXED BIN(31), C CHAR(50);
   PUT SKIP LIST(L);
   M = L; PUT SKIP LIST(M);
   V = L; PUT SKIP LIST(V, LENGTH(V));
   V = '101'B; PUT SKIP LIST(V, LENGTH(V));
   W = L; PUT SKIP LIST(W, LENGTH(W));
   V = V || L; PUT SKIP LIST(V, LENGTH(V));
   M = ¬L; PUT SKIP LIST(M);
   M = L & '1111'B; PUT SKIP LIST(M);
   V = L | '0101'B; PUT SKIP LIST(V, LENGTH(V));
   S = SUBSTR(L, 3, 4); PUT SKIP LIST(S);
   V = SUBSTR(L, 30); PUT SKIP LIST(V, LENGTH(V));
   IF L > M THEN PUT SKIP LIST('L GT M');
   IF '1'B = '1000'B THEN PUT SKIP LIST('PAD EQ');
   IF V THEN PUT SKIP LIST('V TRUE');
   V = ''B; PUT SKIP LIST(V, LENGTH(V));
   IF V THEN PUT SKIP LIST('EMPTY TRUE');
   ELSE PUT SKIP LIST('EMPTY FALSE');
   C = L; PUT SKIP LIST(C);
   N = SUBSTR(L, 1, 31); PUT SKIP LIST(N);
   PUT SKIP DATA(L, W);
   PUT SKIP EDIT(L, W)(A, X(1), A);
 END T98BITS;
