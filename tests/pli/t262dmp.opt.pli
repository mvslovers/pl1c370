 T262DMP: PROC OPTIONS(MAIN);
   /* PLIDUMP (SC33-0006-7, P. 289; #225): C GOES ON, S ENDS THE
      PROGRAM WITHOUT FINISH, 1000 PLUS PLIRETC'S CODE (T262DMP.CC);
      THE DUMP ITSELF GOES TO DD PL1DUMP AND IS NOT COMPARED */
   DCL A FIXED BIN(31) INIT(12345), S CHAR(8) INIT('ABCDEFGH');
   ON FINISH PUT SKIP LIST('FINISH');
   PUT SKIP LIST('BEFORE');
   CALL PLIDUMP('TFC', 'FIRST DUMP');
   PUT SKIP LIST('AFTER C');
   CALL P;
   PUT SKIP LIST('AFTER P', A, S);
   ON ZERODIVIDE BEGIN;
     CALL PLIDUMP('TB', 5);
     PUT SKIP LIST('IN ZD');
   END;
   SIGNAL ZERODIVIDE;
   CALL PLIRETC(7);
   CALL PLIDUMP('NTNFS');
   PUT SKIP LIST('AFTER S');
 P: PROC;
   BEGIN;
     CALL PLIDUMP;
     CALL PLIDUMP('NTNFH', 'FRAMES');
   END;
 END P;
 END T262DMP;
