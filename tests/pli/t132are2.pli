 T132AR2: PROC OPTIONS(MAIN);
   DCL 1 S, 2 N FIXED BIN(31), 2 A AREA(100), 2 C CHAR(3);
   DCL AA(3) AREA(40), B AREA(100);
   DCL X CHAR(8) BASED(P), P PTR, W(4) FIXED BIN(31) BASED(Q), Q PTR;
   DCL K FIXED BIN(31);
   DCL USE ENTRY(AREA(*), FIXED BIN(31));
   DCL USE2 ENTRY(AREA(100));
   S.N = 7;
   S.C = 'END';
   Q = ADDR(S.A);
   PUT SKIP LIST('S.A', W(1), W(2), W(3), W(4), S.N, S.C);
   ALLOCATE X IN(S.A) SET(P);
   P->X = 'IN S.A';
   PUT SKIP LIST('AFTER', W(1), W(2));
   DO K = 1 TO 3;
     Q = ADDR(AA(K));
     PUT SKIP LIST('AA', K, W(1), W(2));
   END;
   ALLOCATE X IN(AA(2)) SET(P);
   ALLOCATE X IN(AA(2)) SET(P);
   Q = ADDR(AA(2));
   PUT SKIP LIST('AA(2)', W(1), W(2));
   AA(3) = AA(2);
   Q = ADDR(AA(3));
   PUT SKIP LIST('AA(3)', W(1), W(2));
   CALL USE(S.A, 1);
   CALL USE(AA(1), 2);
   B = S.A;
   CALL USE2(B);
   Q = ADDR(B);
   PUT SKIP LIST('B', W(1), W(2));
   PUT SKIP LIST('ADDR', ADDR(S.A) = ADDR(S.N));
 USE: PROC(R, I);
   DCL R AREA(*), I FIXED BIN(31), Y CHAR(16) BASED(T), T PTR;
   DCL V(4) FIXED BIN(31) BASED(U), U PTR;
   ALLOCATE Y IN(R) SET(T);
   U = ADDR(R);
   PUT SKIP LIST('USE', I, V(1), V(2));
 END USE;
 USE2: PROC(R);
   DCL R AREA(100), Y CHAR(16) BASED(T), T PTR;
   DCL V(4) FIXED BIN(31) BASED(U), U PTR;
   ALLOCATE Y IN(R) SET(T);
   U = ADDR(R);
   PUT SKIP LIST('USE2', V(1), V(2));
 END USE2;
 END T132AR2;
