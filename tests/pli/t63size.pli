 T63SIZE: PROC OPTIONS(MAIN);
   DCL D FIXED DEC(3), E FIXED DEC(5) INIT(12345), H FIXED BIN(15);
   DCL I FIXED BIN(31) INIT(100000), N FIXED BIN(15) INIT(0);
   ON SIZE BEGIN;
     N = N + 1;
     PUT SKIP LIST('SIZE', ONCODE, N);
   END;
   D = E;
   PUT SKIP LIST('NO PREFIX', D);
   (SIZE): D = E;
   PUT SKIP LIST('A', D);
   (SIZE): H = I;
   PUT SKIP LIST('B', H);
   (SIZE): D = 999;
   PUT SKIP LIST('C', D);
   (SIZE): D = E / 100;
   PUT SKIP LIST('D', D);
   CALL P;
   REVERT SIZE;
   (SIZE): D = E;
   PUT SKIP LIST('NOT REACHED');
 (SIZE): P: PROC;
   DCL F FIXED DEC(2);
   F = E;
   PUT SKIP LIST('P', F);
 END P;
 END T63SIZE;
