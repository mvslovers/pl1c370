 T261PPB: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T261PPB.OPT.PLI: THE PREPROCESSOR'S OUTPUT
      WRITTEN OUT (GC33-0009-4, CHAPTER 16) */
   DCL B CHAR(2) INIT('B1'), YY CHAR(2) INIT('Y2');
   PUT SKIP LIST(3, 5, B, YY, 00001, 00002);
   PUT SKIP LIST('Q+R', 'S ALONE', 'U ALONE');
   PUT SKIP LIST(LENGTH('16 OCT 26 16.40.14'));
 END T261PPB;
