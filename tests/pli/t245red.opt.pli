 T245RED: PROC OPTIONS(MAIN);
   /* TIER 92: REDUCIBLE AND IRREDUCIBLE ON THE PROCEDURE STATEMENT
      (SC26-3114-01); PL/I (F) TAKES THEM IN A DECLARATION ONLY */
   DCL (R1, R2) ENTRY RETURNS(FIXED BIN(15));
   PUT SKIP LIST(R1, R2, R1 + R2);
 R1: PROC RETURNS(FIXED BIN(15)) REDUCIBLE;
   RETURN(1);
 END R1;
 R2: PROC RETURNS(FIXED BIN(15)) IRREDUCIBLE;
   RETURN(2);
 END R2;
 END T245RED;
