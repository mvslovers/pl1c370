 P16NPR: PROC OPTIONS(MAIN);
    /* WHAT A STREAM FILE THAT IS NOT PRINT WRITES, RECORD BY RECORD */
    DCL REPORT FILE STREAM OUTPUT;
    DCL K FIXED BIN(31) INIT(3);
    PUT FILE(REPORT) LIST('A', K);
    PUT FILE(REPORT) SKIP LIST('B');
    PUT FILE(REPORT) SKIP EDIT('C') (A);
    PUT FILE(REPORT) SKIP EDIT('D', 'E') (A, X(2), A);
    PUT FILE(REPORT) SKIP LIST(1, 2, 3);
    PUT FILE(REPORT) SKIP EDIT(K) (F(5));
    PUT FILE(REPORT) SKIP;
    PUT FILE(REPORT) SKIP LIST('LAST');
    PUT SKIP LIST('WRITTEN');
 END P16NPR;
