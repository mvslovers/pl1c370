 T67MAT1: PROC OPTIONS(MAIN);
   DCL (A,B) FLOAT DEC(6), (C,D) FLOAT DEC(16);
   A = 2E0; C = 2E0; B = SQRT(A); D = SQRT(C);
   PUT SKIP LIST('SQRT', A, B, D);
   A = 0.5E0; C = 0.5E0; B = SQRT(A); D = SQRT(C);
   PUT SKIP LIST('SQRT', A, B, D);
   A = 1E10; C = 1E10; B = SQRT(A); D = SQRT(C);
   PUT SKIP LIST('SQRT', A, B, D);
   A = 0E0; C = 0E0; B = SQRT(A); D = SQRT(C);
   PUT SKIP LIST('SQRT', A, B, D);
   A = 1E0; C = 1E0; B = EXP(A); D = EXP(C);
   PUT SKIP LIST('EXP', A, B, D);
   A = -2.5E0; C = -2.5E0; B = EXP(A); D = EXP(C);
   PUT SKIP LIST('EXP', A, B, D);
   A = 0.001E0; C = 0.001E0; B = EXP(A); D = EXP(C);
   PUT SKIP LIST('EXP', A, B, D);
   A = 50E0; C = 50E0; B = EXP(A); D = EXP(C);
   PUT SKIP LIST('EXP', A, B, D);
   A = 2E0; C = 2E0; B = LOG(A); D = LOG(C);
   PUT SKIP LIST('LOG', A, B, D);
   A = 0.1E0; C = 0.1E0; B = LOG(A); D = LOG(C);
   PUT SKIP LIST('LOG', A, B, D);
   A = 1E20; C = 1E20; B = LOG(A); D = LOG(C);
   PUT SKIP LIST('LOG', A, B, D);
   A = 1E0; C = 1E0; B = LOG(A); D = LOG(C);
   PUT SKIP LIST('LOG', A, B, D);
   A = 2E0; C = 2E0; B = LOG10(A); D = LOG10(C);
   PUT SKIP LIST('LOG10', A, B, D);
   A = 1000E0; C = 1000E0; B = LOG10(A); D = LOG10(C);
   PUT SKIP LIST('LOG10', A, B, D);
   A = 0.3E0; C = 0.3E0; B = LOG10(A); D = LOG10(C);
   PUT SKIP LIST('LOG10', A, B, D);
   A = 2E0; C = 2E0; B = LOG2(A); D = LOG2(C);
   PUT SKIP LIST('LOG2', A, B, D);
   A = 10E0; C = 10E0; B = LOG2(A); D = LOG2(C);
   PUT SKIP LIST('LOG2', A, B, D);
   A = 0.75E0; C = 0.75E0; B = LOG2(A); D = LOG2(C);
   PUT SKIP LIST('LOG2', A, B, D);
   A = 1E0; C = 1E0; B = SIN(A); D = SIN(C);
   PUT SKIP LIST('SIN', A, B, D);
   A = 0.5E0; C = 0.5E0; B = SIN(A); D = SIN(C);
   PUT SKIP LIST('SIN', A, B, D);
 END T67MAT1;
