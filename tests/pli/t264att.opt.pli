 T264ATT: PROC OPTIONS(MAIN);
   /* THE ATTENTION CONDITION (GC33-0009-4, P. 393; #226): SIGNAL
      ENTERS THE ON-UNIT, ONCODE 1400, AND GOES ON AFTER IT; WITHOUT AN
      ON-UNIT THE SIGNAL IS IGNORED.  PL/I (F) HAS NO ATTENTION, SO THE
      TWIN SPELLS OUT WHAT THE ON-UNITS PRINT */
   DCL N FIXED BIN(15) INIT(0);
   PUT SKIP LIST('START');
   SIGNAL ATTENTION;
   PUT SKIP LIST('NO UNIT, IGNORED');
   ON ATTENTION BEGIN;
     N = N + 1;
     PUT SKIP LIST('ATTENTION', N, ONCODE);
   END;
   SIGNAL ATTENTION;
   PUT SKIP LIST('AFTER THE UNIT', N);
   CALL P;
   SIGNAL ATTN;
   REVERT ATTENTION;
   SIGNAL ATTENTION;
   PUT SKIP LIST('REVERTED', N);
 P: PROC;
   ON ATTN PUT SKIP LIST('INNER UNIT', ONCODE);
   SIGNAL ATTN;
 END P;
 END T264ATT;
