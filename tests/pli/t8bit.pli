 P5BIT: PROC OPTIONS(MAIN);
    /* BIT STRINGS: CONSTANTS, OPERATORS, COMPARISONS, OUTPUT */
    DCL B1 BIT(1);
    DCL B8 BIT(8) INIT('10100000'B);
    DCL B3 BIT(3);
    DCL (I,J) FIXED BIN(15);
    PUT SKIP LIST('B8', B8, '1'B, '0110'B);
    I = 1; J = 2;
    B1 = I < J;   PUT SKIP LIST('I<J', B1);
    B1 = I > J;   PUT SKIP LIST('I>J', B1);
    PUT SKIP LIST('CMP', I = J, I ¬= J);
    PUT SKIP LIST('NOT', ¬B8, ¬B1);
    PUT SKIP LIST('AND', B8 & '11110000'B);
    PUT SKIP LIST('OR', B8 | '00000101'B);
    B3 = B8;      PUT SKIP LIST('B3=B8', B3);
    B8 = '11'B;   PUT SKIP LIST('B8=11', B8);
    IF B1 THEN PUT SKIP LIST('WRONG');
    ELSE PUT SKIP LIST('B1 FALSE');
    IF ¬B1 THEN PUT SKIP LIST('NOT B1');
    IF B8 = '11000000'B THEN PUT SKIP LIST('BIT EQ PADDED');
    IF '1'B THEN PUT SKIP LIST('CONST TRUE');
    IF B8 THEN PUT SKIP LIST('ANY BIT');
 END P5BIT;
