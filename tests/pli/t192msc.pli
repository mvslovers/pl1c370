 T192MSC: PROC OPTIONS(MAIN);
   DCL (I, J, K) FIXED BIN(15) INIT(0);
   DCL A(5) FIXED BIN(15) INIT(1, 2, 3, 4, 5);
   DCL (N1, N2, N3, N4, N5, N6) FIXED BIN(15), S CHAR(20) VARYING;
   DCL D CHAR(6), T CHAR(9), Z FIXED DEC(5) INIT(0);
   PUT SKIP LIST(1, 2, 3);
   N1 = COUNT(SYSPRINT);
   PUT SKIP LIST(A);
   N2 = COUNT(SYSPRINT);
   PUT SKIP EDIT('X', 7) (A, F(3));
   N3 = COUNT(SYSPRINT);
   PUT SKIP DATA(I, J);
   N4 = COUNT(SYSPRINT);
   PUT SKIP;
   N5 = COUNT(SYSPRINT);
   PUT SKIP LIST(N1, N2, N3, N4, N5);
   GET LIST(I, J, K);
   N6 = COUNT(SYSIN);
   PUT SKIP LIST(N6, I + J + K);
   GET LIST(A);
   PUT SKIP LIST(COUNT(SYSIN), A(5));
   PUT SKIP LIST(LINENO(SYSPRINT));
   PUT SKIP(3) LIST(LINENO(SYSPRINT));
   PUT PAGE LIST(LINENO(SYSPRINT));
   PUT SKIP LIST(LINENO(SYSPRINT));
   PUT LIST(LINENO(SYSPRINT));
   PUT SKIP(0) LIST('OVER');
   PUT LIST(LINENO(SYSPRINT));
   D = DATE; T = TIME;
   PUT SKIP LIST(LENGTH(D), LENGTH(T));
   PUT SKIP LIST(VERIFY(D, '0123456789'), VERIFY(T, '0123456789'));
   PUT SKIP LIST(SUBSTR(D, 3, 2) <= '12', SUBSTR(T, 1, 2) <= '23');
   S = ONLOC;
   PUT SKIP LIST('ONLOC OUTSIDE', LENGTH(S), ONCOUNT);
   ON ZERODIVIDE BEGIN;
     S = ONLOC;
     PUT SKIP LIST('ZDIV IN', S, LENGTH(S), ONCOUNT);
   END;
   ON CONDITION(MINE) PUT SKIP LIST('MINE IN', ONLOC);
   SIGNAL ZERODIVIDE;
   SIGNAL CONDITION(MINE);
   CALL SUBP;
   CALL ALT;
   PUT SKIP LIST('DONE', ONLOC || '|');
 SUBP: PROC;
   SIGNAL CONDITION(MINE);
   SIGNAL ZERODIVIDE;
   RETURN;
 ALT: ENTRY;
   SIGNAL CONDITION(MINE);
 END SUBP;
 END T192MSC;
