 T325FVM: PROC OPTIONS(MAIN);
   /* TIER 129: FILE MEMBERS OF A STRUCTURE AND FILE ARRAYS, FILE
      VARIABLES BY IMPLICATION (SC26-3114-01, VARIABLE ATTRIBUTE) */
   DCL REPORT FILE STREAM OUTPUT;
   DCL 1 W, 2 TAG CHAR(4) INIT('WORK'), 2 OUTF FILE,
         2 N FIXED BIN(15) INIT(7), 2 FS(2) FILE;
   DCL FA(3) FILE;
   DCL I FIXED BIN(15);
   OUTF = REPORT;
   PUT FILE(OUTF) LIST('TO REPORT', N);
   W.FS(1) = SYSPRINT;
   FS(2) = OUTF;
   DO I = 1 TO 2;
      PUT FILE(FS(I)) SKIP LIST(TAG, I);
   END;
   FA(2) = W.FS(1);
   FA(3) = FS(2);
   CALL SHOW(FA(2), 'TO SYSPRINT');
   CALL SHOW(FA(3), 'TO REPORT');
 SHOW: PROC(F, S);
   DCL F FILE, S CHAR(*);
   PUT FILE(F) SKIP LIST(S);
 END SHOW;
 END T325FVM;
