 P13REC: PROC OPTIONS(MAIN);
    /* RECORD I/O: READ INTO, WRITE FROM, ENDFILE, STRUCTURE MAPPING */
    DCL SYSIN FILE RECORD INPUT;
    DCL REPORT FILE RECORD OUTPUT;
    DCL CARD CHAR(80);
    DCL L CHAR(20);
    DCL 1 S,
          2 A CHAR(3) INIT('ABC'),
          2 H FIXED BIN(15) INIT(258),
          2 B CHAR(1) INIT('Z'),
          2 F FIXED BIN(31) INIT(-1),
          2 D FIXED DEC(3) INIT(-5);
    DCL N FIXED BIN(15) INIT(0);
    DCL EOF BIT(1) INIT('0'B);
    ON ENDFILE(SYSIN) EOF = '1'B;
    READ FILE(SYSIN) INTO(CARD);
    DO WHILE(¬EOF);
       N = N + 1;
       PUT SKIP LIST(N, SUBSTR(CARD, 1, 20));
       L = SUBSTR(CARD, 1, 20);
       WRITE FILE(REPORT) FROM(L);
       READ FILE(SYSIN) INTO(CARD);
    END;
    WRITE FILE(REPORT) FROM(S);
    PUT SKIP LIST('RECORDS', N);
 END P13REC;
