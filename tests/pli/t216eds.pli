 T216EDS: PROC OPTIONS(MAIN);
   /* AN ENTRY PARAMETER DECLARED WITH DESCRIPTORS: ARE THE
      ARGUMENTS OF A CALL THROUGH IT CONVERTED TO THEM? */
   DCL TWICE ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15));
   DCL TWICF ENTRY(FLOAT DEC(6)) RETURNS(FLOAT DEC(6));
   DCL D FIXED DEC(5) INIT(21);
   CALL USE(TWICE, TWICF);
 USE: PROC(P, Q);
   DCL P ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(15));
   DCL Q ENTRY(FLOAT DEC(6)) RETURNS(FLOAT DEC(6));
   PUT LIST(P(5), P(D), P(2.6), Q(3), Q(D));
 END USE;
 TWICE: PROC(X) RETURNS(FIXED BIN(15));
   DCL X FIXED BIN(15);
   RETURN(X * 2);
 END TWICE;
 TWICF: PROC(X) RETURNS(FLOAT DEC(6));
   DCL X FLOAT DEC(6);
   RETURN(X * 2);
 END TWICF;
 END T216EDS;
