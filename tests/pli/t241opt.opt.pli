 T241OPT: PROC OPTIONS(MAIN);
   /* OPTIONAL ARGUMENTS AND BYVALUE OF AN OPTIONS(ASSEMBLER) ENTRY
      (SC26-3114-01): AN OMITTED ARGUMENT IS A WORD OF ZEROS, ITS
      HIGH-ORDER BIT ON WHEN IT IS THE LAST; BYVALUE PASSES THE
      VALUES THEMSELVES */
   DCL T5 ENTRY(FIXED BIN(31), FIXED BIN(31) OPTIONAL,
     FIXED BIN(31) OPTIONAL) EXTERNAL('ASMTST') OPTIONS(ASM RETCODE);
   DCL ASMVAL ENTRY(FIXED BIN(31), FIXED BIN(31))
     OPTIONS(ASSEMBLER BYVALUE RETCODE);
   DCL (FIVE INIT(5), A INIT(7), N INIT(40)) FIXED BIN(31);
   CALL T5(FIVE, *, *);   PUT SKIP LIST(PLIRETV);
   CALL T5(FIVE, A, *);   PUT SKIP LIST(PLIRETV);
   CALL T5(FIVE, *, A);   PUT SKIP LIST(PLIRETV);
   CALL T5(FIVE);         PUT SKIP LIST(PLIRETV);
   CALL ASMVAL(N, 2);     PUT SKIP LIST(PLIRETV);
   CALL PLIRETC(0);
 END T241OPT;
