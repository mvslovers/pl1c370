 T65NO: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31) INIT(0), J FIXED BIN(31),
       N FIXED BIN(15) INIT(0);
   DCL D FIXED DEC(15) INIT(999999999999999), C CHAR(2) INIT('1X');
   DCL F FLOAT DEC(6) INIT(1E-40);
   DCL G ENTRY(FIXED BIN(15)) RETURNS(FIXED BIN(31));
   ON ZERODIVIDE PUT SKIP LIST('ZD');
   ON FIXEDOVERFLOW PUT SKIP LIST('FOFL');
   ON CONVERSION BEGIN; PUT SKIP LIST('CONV'); ONSOURCE = '0'; END;
   ON UNDERFLOW PUT SKIP LIST('UFL');
   (NOZERODIVIDE): J = 5 / I;
   PUT SKIP LIST('AFTER NOZDIV');
   (NOFIXEDOVERFLOW): D = D + 1;
   PUT SKIP LIST('AFTER NOFOFL');
   (NOCONVERSION): J = C;
   PUT SKIP LIST('AFTER NOCONV');
   (NOUNDERFLOW): F = F * F;
   PUT SKIP LIST('AFTER NOUFL', F);
   (NOSIZE): J = 1;
   (NOSUBSCRIPTRANGE): J = 2;
   (NOCONVERSION): DO N = 1 TO 1; J = C; END;
   PUT SKIP LIST('AFTER DO');
   (NOCONVERSION): J = G(1);
   PUT SKIP LIST('AFTER G', J);
   N = 0;
   PUT SKIP LIST('END', N);
 G: PROC(K) RETURNS(FIXED BIN(31));
   DCL K FIXED BIN(15), M FIXED BIN(31), CC CHAR(2) INIT('2Y');
   M = CC;
   RETURN(M + K);
 END G;
 END T65NO;
