 T114AFR: PROC OPTIONS(MAIN);
   DCL A AREA(200), R POINTER, K FIXED BIN(31), NXT LABEL;
   DCL D AREA, S AREA(16);
   DCL C1 CHAR(1) BASED(R);
   DCL C2 CHAR(2) BASED(R);
   DCL C3 CHAR(3) BASED(R);
   DCL C4 CHAR(4) BASED(R);
   DCL C5 CHAR(5) BASED(R);
   DCL C7 CHAR(7) BASED(R);
   DCL C8 CHAR(8) BASED(R);
   DCL C9 CHAR(9) BASED(R);
   DCL C12 CHAR(12) BASED(R);
   DCL C15 CHAR(15) BASED(R);
   DCL C16 CHAR(16) BASED(R);
   DCL C17 CHAR(17) BASED(R);
   DCL C20 CHAR(20) BASED(R);
   DCL C24 CHAR(24) BASED(R);
   DCL C25 CHAR(25) BASED(R);
   DCL C100 CHAR(100) BASED(R);
   ON AREA GO TO NXT;
   A = EMPTY; K = 0; NXT = D1;
   DO WHILE('1'B); ALLOCATE C1 IN(A) SET(R); K = K + 1; END;
 D1: PUT SKIP LIST(1, K);
   A = EMPTY; K = 0; NXT = D2;
   DO WHILE('1'B); ALLOCATE C2 IN(A) SET(R); K = K + 1; END;
 D2: PUT SKIP LIST(2, K);
   A = EMPTY; K = 0; NXT = D3;
   DO WHILE('1'B); ALLOCATE C3 IN(A) SET(R); K = K + 1; END;
 D3: PUT SKIP LIST(3, K);
   A = EMPTY; K = 0; NXT = D4;
   DO WHILE('1'B); ALLOCATE C4 IN(A) SET(R); K = K + 1; END;
 D4: PUT SKIP LIST(4, K);
   A = EMPTY; K = 0; NXT = D5;
   DO WHILE('1'B); ALLOCATE C5 IN(A) SET(R); K = K + 1; END;
 D5: PUT SKIP LIST(5, K);
   A = EMPTY; K = 0; NXT = D7;
   DO WHILE('1'B); ALLOCATE C7 IN(A) SET(R); K = K + 1; END;
 D7: PUT SKIP LIST(7, K);
   A = EMPTY; K = 0; NXT = D8;
   DO WHILE('1'B); ALLOCATE C8 IN(A) SET(R); K = K + 1; END;
 D8: PUT SKIP LIST(8, K);
   A = EMPTY; K = 0; NXT = D9;
   DO WHILE('1'B); ALLOCATE C9 IN(A) SET(R); K = K + 1; END;
 D9: PUT SKIP LIST(9, K);
   A = EMPTY; K = 0; NXT = D12;
   DO WHILE('1'B); ALLOCATE C12 IN(A) SET(R); K = K + 1; END;
 D12: PUT SKIP LIST(12, K);
   A = EMPTY; K = 0; NXT = D15;
   DO WHILE('1'B); ALLOCATE C15 IN(A) SET(R); K = K + 1; END;
 D15: PUT SKIP LIST(15, K);
   A = EMPTY; K = 0; NXT = D16;
   DO WHILE('1'B); ALLOCATE C16 IN(A) SET(R); K = K + 1; END;
 D16: PUT SKIP LIST(16, K);
   A = EMPTY; K = 0; NXT = D17;
   DO WHILE('1'B); ALLOCATE C17 IN(A) SET(R); K = K + 1; END;
 D17: PUT SKIP LIST(17, K);
   A = EMPTY; K = 0; NXT = D20;
   DO WHILE('1'B); ALLOCATE C20 IN(A) SET(R); K = K + 1; END;
 D20: PUT SKIP LIST(20, K);
   A = EMPTY; K = 0; NXT = D24;
   DO WHILE('1'B); ALLOCATE C24 IN(A) SET(R); K = K + 1; END;
 D24: PUT SKIP LIST(24, K);
   A = EMPTY; K = 0; NXT = D25;
   DO WHILE('1'B); ALLOCATE C25 IN(A) SET(R); K = K + 1; END;
 D25: PUT SKIP LIST(25, K);
   A = EMPTY; K = 0; NXT = D100;
   DO WHILE('1'B); ALLOCATE C100 IN(A) SET(R); K = K + 1; END;
 D100: PUT SKIP LIST(100, K);
   K = 0; NXT = ED8;
   DO WHILE('1'B); ALLOCATE C8 IN(D) SET(R); K = K + 1; END;
 ED8: PUT SKIP LIST('D', 8, K);
   K = 0; NXT = ES1;
   DO WHILE('1'B); ALLOCATE C1 IN(S) SET(R); K = K + 1; END;
 ES1: PUT SKIP LIST('S', 1, K);
   K = 0; NXT = ES8;
   DO WHILE('1'B); ALLOCATE C8 IN(S) SET(R); K = K + 1; END;
 ES8: PUT SKIP LIST('S', 8, K);
   CALL FREES;
 FREES: PROC;
   DCL A AREA(200) BASED(AP), AP PTR, H(4) FIXED BIN(31) BASED(AP);
   DCL C8 CHAR(8) BASED(R), C16 CHAR(16) BASED(R), R PTR;
   DCL C24 CHAR(24) BASED(R), C32 CHAR(32) BASED(R);
   DCL C12 CHAR(12) BASED(R);
   DCL (P1, P2, P3, P4, P5, P6) PTR, O OFFSET(A);
   DCL OW FIXED BIN(31) BASED(OQ), OQ PTR;
   DCL I FIXED BIN(15), TT CHAR(8);
   ALLOCATE A;
   OQ = ADDR(O);
   ALLOCATE C8 IN(A) SET(P1);
   ALLOCATE C16 IN(A) SET(P2);
   ALLOCATE C24 IN(A) SET(P3);
   ALLOCATE C8 IN(A) SET(P4);
   ALLOCATE C32 IN(A) SET(P5);
   ALLOCATE C8 IN(A) SET(P6);
   TT = 'SIX'; CALL SHOW;
   FREE P2->C16 IN(A);
   TT = 'FREE 2'; CALL SHOW;
   FREE P4->C8 IN(A);
   TT = 'FREE 4'; CALL SHOW;
   ALLOCATE C8 IN(A) SET(P4);
   TT = 'ALLOC 8'; CALL SHOW;
   FREE P3->C24 IN(A);
   TT = 'FREE 3'; CALL SHOW;
   ALLOCATE C12 IN(A) SET(P3);
   TT = 'ALLOC 12'; CALL SHOW;
   FREE P6->C8 IN(A);
   TT = 'FREE 6'; CALL SHOW;
   FREE P5->C32 IN(A);
   TT = 'FREE 5'; CALL SHOW;
   FREE P4->C8 IN(A);
   TT = 'FREE 4'; CALL SHOW;
   FREE P3->C12 IN(A);
   TT = 'FREE 3'; CALL SHOW;
   FREE P1->C8 IN(A);
   TT = 'FREE 1'; CALL SHOW;
   ALLOCATE C8 IN(A) SET(P1);
   TT = 'ALLOC 8'; CALL SHOW;
 SHOW: PROC;
   PUT SKIP LIST(TT, H(1), H(2), H(3), H(4));
   O = P1; PUT LIST(OW); O = P2; PUT LIST(OW);
   O = P3; PUT LIST(OW); O = P4; PUT LIST(OW);
   O = P5; PUT LIST(OW); O = P6; PUT LIST(OW);
 END SHOW;
 END FREES;
 END T114AFR;
