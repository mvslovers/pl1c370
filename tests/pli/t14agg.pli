 T14AGG: PROC OPTIONS(MAIN);
    /* STATIC AGGREGATES, ARRAY EXPRESSIONS, NESTED SUBSCRIPTS */
    DCL SA(4) STATIC FIXED BIN(31) INIT(10,20,(2)-5);
    DCL 1 SS STATIC,
          2 N FIXED DEC(5,1) INIT(12.5),
          2 L(3) CHAR(2) INIT('X1','X2','X3'),
          2 F BIT(4) INIT('1100'B);
    DCL (A,B,C)(3) FIXED BIN(15);
    DCL M(2,3) FIXED DEC(3,0);
    DCL V(3) CHAR(5) VARYING INIT('ONE','TWO','THREE');
    DCL G(2) BIT(2) INIT('01'B,'10'B);
    DCL 1 R(2),
          2 P FIXED BIN(15),
          2 T(3) FIXED BIN(15);
    DCL 1 Z,
          2 Z1 FIXED BIN(31),
          2 Z2 FIXED DEC(5,2);
    DCL (I,J,K) FIXED BIN(15);
    PUT SKIP LIST('SA', SA);
    PUT SKIP LIST('SS', SS);
    B = 4;
    C(1) = 1; C(2) = 2; C(3) = 3;
    A = B * C + C;
    PUT SKIP LIST('A', A);
    M = 7;
    M(2,1) = -1;
    PUT SKIP LIST('M', M);
    DO I = 1 TO 2;
       R(I).P = I;
       DO J = 1 TO 3;
          R(I).T(J) = I * 100 + J;
       END;
    END;
    K = 2;
    PUT SKIP LIST('RT', R(K).T(K+1), R.T, R.P);
    PUT SKIP LIST('V', V, LENGTH(V(3)));
    PUT SKIP LIST('G', G, G(1) | G(2));
    Z = 3;
    PUT SKIP LIST('Z', Z);
    DO I = 1 TO SA(1) - 7;
       PUT LIST(I);
    END;
    SA(C(3)) = SA(C(1)) + SA(C(2));
    PUT SKIP LIST('SA3', SA(3));
 END T14AGG;
