 T313LI: PROC OPTIONS(MAIN);
   /* LIKE CARRIES THE MEMBERS' INITIAL; A STATIC STRING OF MORE
      THAN 256 CHARACTERS WITH INITIAL */
   DCL 1 T STATIC,
         2 A FIXED BIN(15) INIT(5),
         2 B CHAR(3) INIT('XYZ'),
         2 C(3) FIXED DEC(3) INIT(1, 2, 3),
         2 D,
           3 E FLOAT DEC(6) INIT(2.5),
           3 F CHAR(2);
   DCL 1 S LIKE T;
   DCL 1 U STATIC LIKE T;
   DCL 1 W LIKE T.D;
   DCL L CHAR(300) STATIC INIT('BEGIN');
   DCL M CHAR(450) VARYING STATIC
         INIT('THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG''S BACK');
   PUT SKIP LIST(S.A, S.B, S.C, S.E);
   PUT SKIP LIST(U.A, U.B, U.C, U.E);
   PUT SKIP LIST(W.E);
   PUT SKIP LIST(LENGTH(L), SUBSTR(L, 1, 8), SUBSTR(L, 290) || '|');
   PUT SKIP LIST(LENGTH(M), M);
 END T313LI;
