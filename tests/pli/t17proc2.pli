 T17PRC2: PROC OPTIONS(MAIN);
    /* FUNCTION TYPES, ARRAY ARGUMENTS, NESTING, STATIC IN A PROC */
    DCL TAB(5) FIXED BIN(31) INIT(4,8,15,16,23);
    DCL I FIXED BIN(15);
    DCL HALF ENTRY(FIXED DEC(7,2)) RETURNS(FIXED DEC(7,2));
    DCL WORD ENTRY(FIXED BIN(15)) RETURNS(CHAR(8) VARYING);
    DCL ODD ENTRY(FIXED BIN(31)) RETURNS(BIT(1));
    DCL SUMOF RETURNS(FIXED BIN(31));
    DCL NEXTNO RETURNS(FIXED BIN(15));
    DCL SHOW ENTRY(CHAR(5));
    DCL LEVEL1 ENTRY(FIXED BIN(31));
    PUT SKIP LIST('HALF', HALF(7), HALF(2.5));
    PUT SKIP LIST('WORD', WORD(1), WORD(3), LENGTH(WORD(2)));
    DO I = 1 TO 5;
       IF ODD(TAB(I)) THEN PUT SKIP LIST('ODD', TAB(I));
    END;
    PUT SKIP LIST('SUM', SUMOF(TAB));
    PUT SKIP LIST('NEXT', NEXTNO, NEXTNO, NEXTNO);
    PUT SKIP LIST('TAB', TAB(NEXTNO - 2));
    CALL SHOW('AB');
    CALL SHOW(I);
    CALL LEVEL1(10);
 HALF: PROC(X) RETURNS(FIXED DEC(7,2));
    DCL X FIXED DEC(7,2);
    RETURN(X / 2);
 END HALF;
 WORD: PROC(N) RETURNS(CHAR(8) VARYING);
    DCL N FIXED BIN(15);
    IF N = 1 THEN RETURN('ONE');
    IF N = 2 THEN RETURN('TWO');
    RETURN('MANY');
 END WORD;
 ODD: PROC(V) RETURNS(BIT(1));
    DCL V FIXED BIN(31);
    RETURN(MOD(V, 2) = 1);
 END ODD;
 SUMOF: PROC(A) RETURNS(FIXED BIN(31));
    DCL A(5) FIXED BIN(31);
    DCL (K, S) FIXED BIN(31);
    S = 0;
    DO K = 1 TO 5;
       S = S + A(K);
    END;
    RETURN(S);
 END SUMOF;
 NEXTNO: PROC RETURNS(FIXED BIN(15));
    DCL COUNT STATIC FIXED BIN(15) INIT(0);
    COUNT = COUNT + 1;
    RETURN(COUNT);
 END NEXTNO;
 SHOW: PROC(T);
    DCL T CHAR(5);
    PUT SKIP LIST('SHOW', T, '|');
 END SHOW;
 LEVEL1: PROC(P1);
    DCL P1 FIXED BIN(31);
    DCL L1 FIXED BIN(31) INIT(100);
    CALL LEVEL2;
    PUT SKIP LIST('LEVEL1', P1, L1);
 LEVEL2: PROC;
    DCL L2 FIXED BIN(31) INIT(1);
    CALL LEVEL3;
    PUT SKIP LIST('LEVEL2', L2);
 LEVEL3: PROC;
    L1 = L1 + P1;
    L2 = L2 + 1;
    P1 = P1 * 2;
    I = 99;
    IF L2 > 0 THEN GO TO DONE;
    PUT SKIP LIST('SKIPPED');
 DONE: PUT SKIP LIST('LEVEL3', I);
 END LEVEL3;
 END LEVEL2;
 END LEVEL1;
 END T17PRC2;
