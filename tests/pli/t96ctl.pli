 T96CTL: PROC OPTIONS(MAIN);
   DCL X FIXED BIN(31) CONTROLLED;
   DCL C CHAR(5) CTL INIT('FIRST');
   DCL A(3) FIXED DEC(5) CTL INIT(1, 2, 3);
   DCL 1 S CTL, 2 N FIXED BIN(15) INIT(7), 2 T CHAR(3) INIT('ABC');
   PUT SKIP LIST(ALLOCATION(X), ALLOCATION(C));
   ALLOCATE X; X = 1;
   ALLOCATE X; X = 2;
   ALLOCATE X; X = 3;
   PUT SKIP LIST(X, ALLOCATION(X));
   FREE X; PUT SKIP LIST(X);
   FREE X; PUT SKIP LIST(X);
   FREE X; PUT SKIP LIST(ALLOCATION(X));
   ALLOCATE C; PUT SKIP LIST(C); C = 'SECND';
   ALLOCATE C; PUT SKIP LIST(C);
   FREE C; PUT SKIP LIST(C);
   ALLOCATE A; A(2) = 20; ALLOCATE A; PUT SKIP LIST(A);
   FREE A; PUT SKIP LIST(A);
   ALLOCATE S; S.N = S.N + 1; PUT SKIP DATA(S);
   ALLOCATE S, X; X = 9; PUT SKIP DATA(S, X);
   FREE S, X; PUT SKIP DATA(S);
   CALL USE;
   PUT SKIP LIST(X, ALLOCATION(X));
 USE: PROC;
   ALLOCATE X; X = 42;
 END USE;
 END T96CTL;
