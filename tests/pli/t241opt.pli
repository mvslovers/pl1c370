 T241OPT: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T241OPT.OPT.PLI, WHICH CANNOT OMIT AN
      ARGUMENT OR PASS ONE BY VALUE: THE CODES ASMTST AND ASMVAL GIVE
      (10 * ARGUMENTS + OMITTED ONES; THE SUM) */
   DCL (R1 INIT(32), R2 INIT(31), R4 INIT(10), R5 INIT(42))
     FIXED BIN(31);
   PUT SKIP LIST(R1);
   PUT SKIP LIST(R2);
   PUT SKIP LIST(R2);
   PUT SKIP LIST(R4);
   PUT SKIP LIST(R5);
 END T241OPT;
