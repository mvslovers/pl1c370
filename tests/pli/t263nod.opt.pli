 T263NOD: PROC OPTIONS(MAIN);
   /* PLIDUMP WITHOUT A DD: IBM013I (SC33-0027-5), NO DUMP, AND THE
      OPTIONS STILL DECIDE (#225).  PL/I (F) ENDS IN AN ABEND THERE, SO
      THE TWIN WRITES THE MESSAGES ITSELF */
   ON FINISH PUT SKIP LIST('FINISH');
   PUT SKIP LIST('BEFORE');
   CALL PLIDUMP('C');
   PUT SKIP LIST('AFTER C');
   CALL PLIDUMP('S', 'GONE');
   PUT SKIP LIST('AFTER S');
 END T263NOD;
