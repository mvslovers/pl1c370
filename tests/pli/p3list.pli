 P3LIST: PROC OPTIONS(MAIN);
    DCL C5 CHAR(5) INIT('AB CD');
    DCL CE CHAR(1) INIT(' ');
    DCL V VARYING CHAR(30) INIT('VARYING');
    DCL VE VARYING CHAR(10) INIT('');
    DCL CL CHAR(30) INIT('ABCDEFGHIJKLMNOPQRSTUVWXYZ0123');
    DCL H FIXED BIN(15);
    DCL W FIXED BIN(31);
    DCL D50 FIXED DEC(5,0);
    DCL D72 FIXED DEC(7,2);
    DCL D150 FIXED DEC(15,0);
    DCL D33 FIXED DEC(3,3);
    DCL D11 FIXED DEC(1,0);
    DCL I FIXED BIN(15);
    PUT LIST('A');
    PUT LIST('B');
    PUT SKIP LIST('C5=', C5, 'CE=', CE);
    PUT SKIP LIST('V=', V, 'VE=', VE, 'END');
    PUT SKIP LIST('CL=', CL, 'NEXT');
    H = 0;      PUT SKIP LIST('H0', H);
    H = 7;      PUT SKIP LIST('H7', H);
    H = -7;     PUT SKIP LIST('HM7', H);
    H = 32767;  PUT SKIP LIST('HMAX', H);
    H = -32767; PUT SKIP LIST('HMIN', H);
    W = 0;      PUT SKIP LIST('W0', W);
    W = 123456; PUT SKIP LIST('W', W);
    W = -123456; PUT SKIP LIST('WM', W);
    W = 2147483647; PUT SKIP LIST('WMAX', W);
    W = -2147483647; PUT SKIP LIST('WMIN', W);
    D50 = 0;     PUT SKIP LIST('D50 0', D50);
    D50 = 12345; PUT SKIP LIST('D50', D50);
    D50 = -42;   PUT SKIP LIST('D50M', D50);
    D72 = 12345.67; PUT SKIP LIST('D72', D72);
    D72 = -0.05; PUT SKIP LIST('D72M', D72);
    D72 = 0;     PUT SKIP LIST('D72 0', D72);
    D150 = 999999999999999; PUT SKIP LIST('D150', D150);
    D33 = -0.125; PUT SKIP LIST('D33M', D33);
    D11 = 5;     PUT SKIP LIST('D11', D11);
    PUT SKIP LIST('LIT', 42, -3, 1.50, 'IT''S');
    PUT SKIP(2) LIST('AFTER SKIP2');
    PUT SKIP(0) LIST('OVERPRINT');
    PUT SKIP LIST('ROW');
    DO I = 1 TO 12;
       PUT LIST(I);
    END;
    PUT PAGE LIST('NEW PAGE');
    PUT SKIP LIST('LAST');
 END P3LIST;
