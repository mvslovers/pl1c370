 T109PP: PROC OPTIONS(MAIN);
   %DECLARE (N, I) FIXED, (A, T, MSG) CHARACTER;
   %N = 3;
   %A = 'B+C';
   %MSG = 'HELLO' || ' WORLD';
   DCL (B, C, X) FIXED BIN(31), V(N) FIXED BIN(31);
   B = 10; C = 5;
   X = A; PUT SKIP LIST('X', X);
   PUT SKIP LIST('N', N, 'A IN A STRING', '/* N */');
   %I = 1;
   %LAB: ;
   V(I) = I * 100;
   %I = I + 1;
   %IF I <= N %THEN %GO TO LAB;
   PUT SKIP LIST(V);
   %IF N > 2 %THEN %DO;
   PUT SKIP LIST('BIG N');
   %END;
   %ELSE %DO;
   PUT SKIP LIST('SMALL N');
   %END;
   %T = SUBSTR('ABCDEF', 2, 3);
   PUT SKIP LIST('T');
   PUT SKIP LIST(T);
   %DEACTIVATE N;
   DCL N FIXED BIN(15) INIT(77);
   PUT SKIP LIST('NOW N', N);
   %ACTIVATE N;
   PUT SKIP LIST('AGAIN', N);
   %DO I = 1 TO 2;
   PUT SKIP LIST('DO', I);
   %END;
 END T109PP;
