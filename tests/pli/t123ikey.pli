 T123IKY: PROC OPTIONS(MAIN);
   DCL IX FILE RECORD KEYED ENV(INDEXED);
   DCL REC CHAR(20), NXT LABEL, KC CHAR(3), I FIXED BIN(31);
   DCL K CHAR(6);
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE);
     GO TO NXT;
   END;
   OPEN FILE(IX) SEQUENTIAL OUTPUT;
   DO I = 1 TO 9;
     K = 'K' || SUBSTR('123456789', I, 1);
     REC = 'REC ' || K;
     WRITE FILE(IX) FROM(REC) KEYFROM(K);
   END;
   NXT = L1;
   WRITE FILE(IX) FROM(REC) KEYFROM('K5');
 L1: CLOSE FILE(IX);
   OPEN FILE(IX) DIRECT UPDATE;
   NXT = L2;
   READ FILE(IX) INTO(REC) KEY('K0');
 L2: NXT = L3;
   WRITE FILE(IX) FROM(REC) KEYFROM('K3');
 L3: NXT = L4;
   SIGNAL KEY(IX);
 L4: CLOSE FILE(IX);
   OPEN FILE(IX) SEQUENTIAL INPUT;
   READ FILE(IX) INTO(REC) KEYTO(KC);
   PUT SKIP LIST('FIRST', KC, REC);
   CLOSE FILE(IX);
   PUT SKIP LIST('END');
 END T123IKY;
