 %PROCESS LANGLVL(SPROG);
 T239SPR: PROC OPTIONS(MAIN);
   /* LANGLVL(SPROG) (SC26-3114-01, "POINTER OPERATIONS"): P + N,
      P - N, N + P, P2 - P1, POINTERS COMPARED BY < AND >, AND
      BASED(POINTERVALUE(16)), THE CVT POINTER IN THE PSA */
   DCL A(4) FIXED BIN(31) INIT(10, 20, 30, 40), X FIXED BIN(31) BASED;
   DCL (P, Q) PTR, N FIXED BIN(31), B BIT(8) INIT('00000100'B);
   DCL CVTPTR PTR BASED(POINTERVALUE(16));
   P = ADDR(A(1));
   Q = P + 8;      PUT SKIP LIST(Q -> X);
   Q = Q - 4;      PUT SKIP LIST(Q -> X);
   Q = 12 + P;     PUT SKIP LIST(Q -> X);
   Q = P + B;      PUT SKIP LIST(Q -> X);
   N = Q - P;      PUT SKIP LIST(N);
   PUT SKIP LIST(Q > P, Q < P, P <= P, Q >= P);
   PUT SKIP LIST(BINARYVALUE(CVTPTR) > 0);
 END T239SPR;
