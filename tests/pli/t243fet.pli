 T243FET: PROC OPTIONS(MAIN);
   /* THE PL/I (F) TWIN OF T243FET.OPT.PLI, WITHOUT FETCH: ASMTST
      LINKED IN, THE CODES IT AND ASMVAL GIVE */
   DCL ASMTST ENTRY;
   DCL (ONE INIT(1), A INIT(40), B INIT(2), C INIT(0), R INIT(4))
     FIXED BIN(31);
   CALL ASMTST(ONE, A, B, C);  PUT SKIP LIST(C, R);
   CALL ASMTST(ONE, C, B, A);  PUT SKIP LIST(A, R);
   R = 45;                     PUT SKIP LIST(R);
 END T243FET;
