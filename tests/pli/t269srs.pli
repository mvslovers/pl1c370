 T269SRS: PROC OPTIONS(MAIN);
   /* STOP IN A SORT EXIT: E35'S SECOND CALL STOPS.  THE SORT
      IS FINISHED FIRST, THEN FINISH AND THE END WITH 1000: THE RETURN
      CODE IS 0 BEFORE EACH CALL OF E35
      PL/I (F): IHESRTD, IHESARC */
   DCL IHESRTD ENTRY(CHAR(30), CHAR(30), FIXED BIN(31), FIXED BIN(31),
                     ENTRY, ENTRY);
   DCL IHESARC ENTRY(FIXED BIN(31));
   DCL RC FIXED BIN(31) INIT(-1);
   DCL (K, N) FIXED BIN(15) STATIC INIT(0);
   ON FINISH PUT SKIP LIST('FINISH', N);
   CALL IHESRTD(' SORT FIELDS=(1,8,CH,A) ',
                ' RECORD TYPE=F,LENGTH=(80) ', 50000, RC, E15, E35);
   PUT SKIP LIST('RETURNED', RC);
 E15: PROC RETURNS(CHAR(80));
   K = K + 1;
   IF K > 5 THEN DO;
     CALL IHESARC(8);
     RETURN('');
   END;
   CALL IHESARC(12);
   RETURN(SUBSTR('EDCBA', K, 1));
 END E15;
 E35: PROC(REC);
   DCL REC CHAR(80);
   N = N + 1;
   PUT SKIP LIST('E35', SUBSTR(REC, 1, 1));
   IF N = 2 THEN STOP;
   CALL IHESARC(4);
 END E35;
 END T269SRS;
