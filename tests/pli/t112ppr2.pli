 T112PP: PROC OPTIONS(MAIN);
   %DECLARE FACT ENTRY(FIXED) RETURNS(FIXED);
   %DECLARE GEN ENTRY(CHARACTER, FIXED) RETURNS(CHARACTER);
   %DECLARE PAD ENTRY(FIXED, FIXED) RETURNS(FIXED);
   %DECLARE (F5, P) FIXED;
   DCL (S1, S2, S3) FIXED BIN(31) INIT(0);
   %DEACTIVATE PAD;
   DCL PAD FIXED BIN(31) INIT(99);
   %ACTIVATE PAD;
   %F5 = FACT(5);
   PUT SKIP LIST('FACT', F5, FACT(3));
   GEN(S, 3)
   PUT SKIP LIST(S1, S2, S3);
   %P = PAD(4);
   PUT SKIP LIST('PAD', P);
   %DEACTIVATE PAD;
   PUT SKIP LIST('VAR', PAD);
   %FACT: PROC(N) RETURNS(FIXED);
     DECLARE (N, F, I) FIXED;
     F = 1;
     DO I = 2 TO N; F = F * I; END;
     RETURN(F);
   %END FACT;
   %GEN: PROC(STEM, K) RETURNS(CHARACTER);
     DECLARE STEM CHARACTER, K FIXED, (I, J) FIXED, OUT CHARACTER;
     OUT = '';
     DO I = 1 TO K;
       J = I * 10;
       OUT = OUT || STEM || SUBSTR('123', I, 1) || '=' || J || ';';
     END;
     IF K < 9 THEN GO TO DONE;
     OUT = 'NEVER';
     DONE: RETURN(OUT);
   %END GEN;
   %PAD: PROC(A, B) RETURNS(FIXED);
     DECLARE (A, B) FIXED;
     RETURN(A + B + 100);
   %END PAD;
 END T112PP;
