 RXLNK: PROC(EFPLCOM, EFPLBARG, EFPLEARG, EFPLFB, EFPLARG, EFPLEVAL)
   OPTIONS(MAIN);
   /* TIER 98: AN EXTERNAL FUNCTION LINKED TO TWICE (XDRIVER, '2*'),
      ITS RETURN CODE BY PL/I (F)'S IHESARC (#220) */
   DCL (EFPLCOM, EFPLBARG, EFPLEARG, EFPLFB) FIXED BIN(31);
   DCL (EFPLARG, EFPLEVAL) PTR;
   DCL 1 EVB BASED(EFPLEVAL), 2 PAD1 FIXED BIN(31),
         2 SIZE FIXED BIN(31), 2 LEN FIXED BIN(31),
         2 PAD2 FIXED BIN(31), 2 DATA CHAR(256);
   DCL N FIXED BIN(31) STATIC INIT(0), IHESARC ENTRY(FIXED BIN(31));
   N = N + 1;
   PUT SKIP LIST('CALL', N);
   LEN = 3;
   SUBSTR(DATA, 1, 3) = 'R' || SUBSTR(CHAR(N), 10, 2);
   CALL IHESARC(N + 4);
 END RXLNK;
