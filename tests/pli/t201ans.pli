 T201ANS: PROC OPTIONS(MAIN);
   /* the PL/I (F) twin of t201ans.opt.pli: ASIN(x) is
      ATAN(y, SQRT(1 - y*y)), ACOS(x) ATAN(SQRT(1 - y*y), y), y the
      FLOAT of x; SUBTRACT(x, y, p, q) ADD(x, -y, p, q); DOT a loop;
      EVERY and SOME their values by ANSI 9.4.4.33 and 9.4.4.73 */
   DCL X FLOAT DEC(6) INIT(0.5), Y FLOAT DEC(16) INIT(-0.25E0);
   DCL D FIXED DEC(5,2) INIT(1.25), I FIXED BIN(15) INIT(0);
   DCL U(3) FLOAT DEC(6) INIT(1, 2, 3);
   DCL W(3) FLOAT DEC(6) INIT(4, 5, 6);
   DCL F(3) FIXED DEC(5,1) INIT(1.5, 2, 2.5), G(3) FIXED DEC(5,1)
       INIT(2, 3, 4);
   DCL (T1, T3) FLOAT DEC(6), T2 FIXED DEC(7,2), K FIXED BIN(15);
   PUT SKIP LIST(ATAN(X, SQRT(1 - X*X)), ATAN(SQRT(1 - X*X), X));
   PUT SKIP LIST(ATAN(Y, SQRT(1 - Y*Y)), ATAN(SQRT(1 - Y*Y), Y));
   PUT SKIP LIST(ATAN(FLOAT(1), SQRT(1 - FLOAT(1)*FLOAT(1))),
     ATAN(SQRT(1 - FLOAT(-1)*FLOAT(-1)), FLOAT(-1)),
     ATAN(FLOAT(0), SQRT(1 - FLOAT(0)*FLOAT(0))),
     ATAN(SQRT(1 - FLOAT(1)*FLOAT(1)), FLOAT(1)));
   PUT SKIP LIST(ATAN(FLOAT(D - 1),
       SQRT(1 - FLOAT(D - 1)*FLOAT(D - 1))),
     ATAN(SQRT(1 - FLOAT(I)*FLOAT(I)), FLOAT(I)));
   PUT SKIP LIST(ADD(D, -0.5, 5, 2), ADD(7, -9, 3, 0));
   PUT SKIP LIST(ADD(X, -1E0, 6), ADD(D, -D, 4, 1));
   T1 = 0; T2 = 0; T3 = 0;
   DO K = 1 TO 3;
     T1 = T1 + U(K) * W(K);
     T2 = ADD(T2, MULTIPLY(F(K), G(K), 7, 2), 7, 2);
     T3 = T3 + U(K) * U(K);
   END;
   PUT SKIP LIST(T1, T2, T3);
   PUT SKIP LIST('0'B, '1'B);
   PUT SKIP LIST('0'B, '0'B, '1'B, '1'B);
   PUT SKIP LIST('0'B, '1'B, '1'B, '0'B);
   PUT SKIP LIST('B(1) ALL ONES');
   PUT SKIP LIST('C ALL ZEROS');
 END T201ANS;
