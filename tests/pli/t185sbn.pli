 T185SBN: PROC OPTIONS(MAIN);
   DCL R FIXED BIN(15,3) INIT(5.5), S FIXED BIN(31,8) INIT(-2.25);
   DCL T FIXED BIN(15,3), U FIXED BIN(31,16), I FIXED BIN(15);
   DCL D FIXED DEC(7,3), F FLOAT DEC(6), C CHAR(12);
   DCL A(3) FIXED BIN(15,2) INIT(1.25, 2.5, 3.75);
   PUT SKIP LIST(R, S, A(1), A(3));
   T = R + 1;
   PUT SKIP LIST(T, R * 2, R / 4, R + S);
   U = 1.1;
   PUT SKIP LIST(U, U * 3);
   I = R;
   D = R;
   F = S;
   PUT SKIP LIST(I, D, F);
   T = 0.3;
   PUT SKIP LIST(T, UNSPEC(T));
   T = -1.875;
   I = T;
   PUT SKIP LIST(T, I);
   C = R;
   PUT SKIP LIST(C || '|');
   S = 1000.5;
   PUT SKIP EDIT(R, S) (F(8,3), F(10,2));
   PUT SKIP DATA(R, S);
   T = R; R = T * T;
   PUT SKIP LIST(R, R > 30, R = 30.25);
   DO T = 0.5 TO 2 BY 0.5;
     PUT SKIP LIST(T);
   END;
 END T185SBN;
