 T45FGE: PROC OPTIONS(MAIN);
   DCL (A,B,C,D) FLOAT DEC(6), (L1,L2) FLOAT DEC(16);
   DCL N FIXED BIN(15) INIT(0);
   ON CONVERSION BEGIN;
     N = N + 1;
     PUT SKIP LIST('CONV', ONCODE, ONSOURCE);
     ONSOURCE = '0';
   END;
   GET EDIT(A, B, C, D) (E(10,2), E(10,2), F(6,1), F(6,1));
   L1 = A; L2 = B; PUT SKIP LIST(L1, L2);
   L1 = C; L2 = D; PUT SKIP LIST(L1, L2);
   GET SKIP EDIT(A, B) (E(10,2), F(6,2));
   L1 = A; L2 = B; PUT SKIP LIST(L1, L2, N);
   GET SKIP EDIT(A) (E(10,0));
   PUT SKIP LIST(A, N);
 END T45FGE;
